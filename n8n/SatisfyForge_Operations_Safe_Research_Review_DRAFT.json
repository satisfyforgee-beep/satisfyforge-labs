          "mode": "id"
        },
        "filterByFormula": "={Dedup Key}='{{ $(\"Build Safe Payload\").first().json.dedupKey.replace(/'/g,\"\\'\") }}' ",
        "options": {}
      },
      "alwaysOutputData": true,
