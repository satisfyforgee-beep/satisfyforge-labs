    {
      "id": "fc9933ec-0c4e-42a9-8f35-238a23bca386",
      "name": "Extract Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        100
      ],
      "parameters": {
        "jsCode": "const src=$input.first().json;\nconst p=$(\"Build Safe Payload\").first().json;\nlet text='';\nif (typeof src === 'string') text=src;\nelse if (typeof src.data === 'string') text=src.data;\nelse if (typeof src.body === 'string') text=src.body;\nelse text=JSON.stringify(src);\ntext=text.replace(/<script[\\s\\S]*?<\\/script>/gi,' ').replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim();\nconst evidence=text.slice(0,1200) || 'Public source fetched; no extractable text found.';\nreturn [{json:{...p,evidence}}];"
      }
    },
