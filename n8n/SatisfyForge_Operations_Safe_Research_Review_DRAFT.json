      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -980,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{\n  topic: 'SatisfyForge safe research test',\n  query: 'Validate a public source and route it to human review',\n  sourceUrl: 'https://example.com/',\n  sourceTitle: 'Example Domain',\n  proposedAction: 'Review research finding only',\n  workflowClass: 'Research',\n  accountIdentity: 'UNVERIFIED_TEST_ONLY',\n  identityVerified: false,\n  liveActionAllowed: false,\n  freeResourceVerified: true\n}}];"
      }
    },
    {
      "id": "eaa698b8-3f0c-4203-afec-82eb35f8f385",
      "name": "Build Safe Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -760,
        0
      ],
      "parameters": {
        "jsCode": "const x = $input.first().json;\nfunction norm(s=''){return String(s).trim().toLowerCase().replace(/\\s+/g,' ')}\nlet canonical=x.sourceUrl||'';\ntry {\n  const u=new URL(canonical);\n  u.hash='';\n  for (const k of [...u.searchParams.keys()]) if (/^(utm_|fbclid|gclid)/i.test(k)) u.searchParams.delete(k);\n  canonical=u.toString().replace(/\\/$/,'');\n} catch(e) {}\nconst dedupKey=['sf','research',norm(x.accountIdentity),norm(x.topic),norm(canonical)].join('|');\nreturn [{json:{...x,canonicalUrl:canonical,dedupKey,researchKey:dedupKey,queueId:'TEST-QUEUE-SAFE-001',researchId:'TEST-RESEARCH-SAFE-001',verificationStatus:'Needs Review',reviewStatus:'Needs Review',lastChecked:new Date().toISOString(),gateStatus:'BLOCKED_UNTIL_IDENTITY_AND_REVIEW'}}];"
      }
    },
