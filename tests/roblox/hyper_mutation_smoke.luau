assert(count("Cave Crystal 1")==1,"crystal activity missing")
assert(count("Sky Summit")==1,"parkour summit missing")
assert(count("Dome Start")==1,"dome activity missing")
assert(count("Festival Button 3")==1,"festival activity missing")
