 UDim2.new(.62,0,0,30),UDim2.new(.02,0,0,111),Color3.fromRGB(255,221,119))
local hint=text("Hint","EXPLORE PORTALS • DRIVE CARS • HARVEST CROPS • VISIT JAPAN &amp; CASTLES",
