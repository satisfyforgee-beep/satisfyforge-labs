 SUPERCAR={name="Performance Sedan Trim",speed=57,model="RED"},
 HYPERCAR={name="Hyper Performance Sedan Trim",speed=63,model="RED"},
 CLASSIC_CAR={name="Classic Sedan Trim",speed=35,model="WHITE"},
}
Catalog.ShopLocations={
 TECH="Creator Technology Store",APPAREL="Clothing Boutique",
 HOME="Home Supply Store",VEHICLE="Vehicle and Marine Dealer",
 PROPERTY="Real Estate Agency",BUSINESS="Business Licensing Office",
 GARDEN="City Garden &amp; Nursery",
}
Catalog.BusinessPayouts={CAFE_BUSINESS=90,AUTO_BUSINESS=190,
 MEDIA_BUSINESS=270,REALTY_BUSINESS=360,CLOTHING_BUSINESS=130,
 RESTAURANT_BUSINESS=230,DELIVERY_BUSINESS=210,TECH_BUSINESS=310,
 CONSTRUCTION_BUSINESS=390,
 LANDSCAPE_BUSINESS=230,FARM_BUSINESS=360,FLORIST_BUSINESS=115,
 BAKERY_BUSINESS=165,MARINA_BUSINESS=590,BOAT_RENTAL_BUSINESS=410,
 HOTEL_BUSINESS=760,GYM_BUSINESS=280,BARBER_BUSINESS=145,
 PET_CARE_BUSINESS=185,MEDIA_NETWORK_BUSINESS=910,SOFTWARE_BUSINESS=720,
 PROPERTY_DEVELOPMENT_BUSINESS=1350}
function Catalog.SanitizeOwned(raw)
 local clean={}
 if type(raw)=="table" then
  for _,entry in ipairs(Catalog.Items) do
   if raw[entry.id]==true then clean[entry.id]=true end
  end
 end
 return clean
end
function Catalog.SanitizeCareer(value)
 return type(value)=="string" and Catalog.CareerById[value] and value or "UNEMPLOYED"
end
return Catalog
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="11">
      <Properties>
        <string name="Name">PrestigeCatalog</string>
        <string name="Source">-- Earned prestige catalog. Every item is earned with in-game coins.
-- NO Robux product IDs or purchase prompts are configured in this prototype.
local Catalog={}
Catalog.Items={
 {id="CITY_WRAP",name="Midnight City Car Wrap",category="vehicle",
  level=3,coins=450,description="Deep midnight paint for your personal car"},
 {id="ESTATE_ROOF",name="Modern Estate Roof",category="home",
  level=5,coins=1200,description="Slate roof and warm exterior lighting"},
 {id="PLATINUM_WRAP",name="Platinum Hypercar Finish",category="vehicle",
  level=10,coins=3800,description="Reflective platinum finish for personal vehicles"},
 {id="HOME_GARAGE",name="Luxury Home Garage",category="home",
  level=12,coins=6000,wood=10,metal=8,
  description="Build a full garage and private driveway at your house"},
 {id="SNOWMOBILE_LICENSE",name="Snowmobile Driver License",category="vehicle",
  level=5,coins=1400,description="Earn permanent access to ride snowmobiles"},
 {id="JETPACK_LICENSE",name="Jetpack Pilot License",category="vehicle",
  level=7,coins=2200,description="Unlock jetpack launches at the Arctic station"},
 {id="FLIGHT_LICENSE",name="Flying Car Pilot License",category="vehicle",
  level=12,coins=6500,description="Unlock flying cars for advanced exploration"},
 {id="AURORA_TRAIL",name="Aurora Legend Trail",category="avatar",
  level=18,coins=9000,description="An animated glowing trail following your character"},
}
Catalog.ById={}
for _,entry in ipairs(Catalog.Items) do Catalog.ById[entry.id]=entry end
function Catalog.ValidateOwned(value)
 local clean={}
 if type(value)=="table" then
  for _,entry in ipairs(Catalog.Items) do
   if value[entry.id]==true then clean[entry.id]=true end
  end
 end
 return clean
end
function Catalog.PriceText(entry)
 local extra=(entry.wood and (" + "..entry.wood.." wood + "..entry.metal.." metal")) or ""
 return entry.coins.." coins"..extra.." | level "..entry.level
end
return Catalog
</string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="13">
      <Properties>
        <string name="Name">BoatService</string>
        <string name="Source">-- Rift Raiders v0.12 | First navigable earned-coin watercraft.
-- Watercraft are original modular Roblox geometry, not imported photoreal meshes.
-- All spawning and travel are validated on the server; no Robux payments.
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local Boat={}
Boat.Vessels={
 KAYAK={name="Kayak",speed=13,length=14,beam=3,level=2},
 FISHING_BOAT={name="Fishing Boat",speed=21,length=24,beam=10,level=8},
 JET_SKI={name="Jet Ski",speed=45,length=12,beam=4,level=10},
 PONTOON={name="Pontoon",speed=20,length=32,beam=15,level=14},
 SAILBOAT={name="Sailboat",speed=23,length=34,beam=12,level=14},
 SPEEDBOAT={name="Speedboat",speed=53,length=28,beam=10,level=16},
 CABIN_CRUISER={name="Cabin Cruiser",speed=34,length=39,beam=13,level=25},
 YACHT={name="Luxury Yacht",speed=27,length=48,beam=17,level=24},
 LUXURY_YACHT={name="Superyacht",speed=33,length=65,beam=22,level=45},
}
local active={}
local cooldown={}
local region=Vector3.new(760,0,520)
local pier=Vector3.new(610,3,520)
local dockPart=nil
local dockFolder=nil
local elapsed=0
local function part(parent,name,size,cf,color,material,solid)
 local p=Instance.new("Part")
 p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color
 p.Anchored=true;p.CanCollide=solid==true;p.CanTouch=false
 p.Material=material or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=parent
 return p
end
local function modelHull(parent,cf,vehicle)
 local b=vehicle.beam;local length=vehicle.length
 local main=part(parent,"Marine Hull",Vector3.new(b,2.9,length*.72),
  cf*CFrame.new(0,-1,3),Color3.fromRGB(234,239,237),
  Enum.Material.SmoothPlastic,true)
 main.Shape=Enum.PartType.Cylinder
 main.CFrame=main.CFrame*CFrame.Angles(0,0,math.pi*.5)
 -- Strong rub rail, tapered forward bow and a nonslip deck.
 local nose=Instance.new("WedgePart")
 nose.Name="Sloped Boat Bow";nose.Size=Vector3.new(b,3,length*.32)
 nose.CFrame=cf*CFrame.new(0,-.65,-length*.35)*CFrame.Angles(0,math.pi,0)
 nose.Color=Color3.fromRGB(231,234,229);nose.Material=Enum.Material.SmoothPlastic
 nose.Anchored=true;nose.CanCollide=true;nose.Parent=parent
 part(parent,"Nonslip Marine Deck",Vector3.new(b-.6,.45,length*.67),
  cf*CFrame.new(0,.05,2.6),Color3.fromRGB(191,207,210),
  Enum.Material.Concrete,true)
 for _,side in ipairs({-1,1}) do
  part(parent,"Hull Rub Rail",Vector3.new(.33,.4,length*.7),
   cf*CFrame.new(side*b*.49,-.15,2.5),
   Color3.fromRGB(58,80,103),Enum.Material.Metal,false)
 end
 if vehicle.length&gt;=28 then
  part(parent,"Captain Console",Vector3.new(3,2.5,2),
   cf*CFrame.new(1,1.55,0),Color3.fromRGB(65,80,94),Enum.Material.Metal,true)
  local glass=part(parent,"Windshield",Vector3.new(b*.58,3,.3),
   cf*CFrame.new(0,3,-3)*CFrame.Angles(math.rad(-20),0,0),
   Color3.fromRGB(106,177,195),Enum.Material.Glass,false)
  glass.Transparency=.33
 end
 if vehicle.length&gt;=35 then
  local cabin=part(parent,"Marine Cabin Walls",
   Vector3.new(b*.68,5,length*.22),cf*CFrame.new(0,3,8),
   Color3.fromRGB(236,232,216),Enum.Material.SmoothPlastic,true)
  local roof=part(parent,"Marine Cabin Roof",Vector3.new(b*.76,.5,length*.27),
   cf*CFrame.new(0,6,8),Color3.fromRGB(83,111,134),
   Enum.Material.Metal,true)
  for _,side in ipairs({-1,1}) do
   local window=part(parent,"Cabin Window",Vector3.new(.15,2,4),
    cf*CFrame.new(side*b*.345,3.7,8),
    Color3.fromRGB(70,132,158),Enum.Material.Glass,false)
   window.Transparency=.2
  end
 end
 if vehicle.length&gt;=48 then
  part(parent,"Upper Sun Deck",Vector3.new(b*.66,.45,length*.3),
   cf*CFrame.new(0,6.5,7),Color3.fromRGB(220,218,209),
   Enum.Material.WoodPlanks,true)
  for _,side in ipairs({-1,1}) do
   part(parent,"Yacht Sun Deck Railing",Vector3.new(.18,2.3,length*.33),
    cf*CFrame.new(side*b*.35,7.7,7),
    Color3.fromRGB(191,204,210),Enum.Material.Metal,false)
  end
 end
 if vehicle.length&lt;20 then
  part(parent,"Personal Watercraft Cowling",Vector3.new(b*.9,1.1,length*.4),
   cf*CFrame.new(0,.85,-1),Color3.fromRGB(61,130,164),Enum.Material.Metal,true)
 end
 local motor=part(parent,"Outboard Engine",Vector3.new(2.6,2.8,2.8),
  cf*CFrame.new(0,-.6,length*.49),Color3.fromRGB(52,65,77),
  Enum.Material.Metal,false)
 for _,side in ipairs({-1,1}) do
  local navigation=part(parent,"Marine Navigation Light",Vector3.new(.55,.55,.55),
   cf*CFrame.new(side*b*.4,2,-length*.28),
   side==-1 and Color3.fromRGB(224,78,70) or
   Color3.fromRGB(80,207,120),Enum.Material.Neon,false)
  navigation.Shape=Enum.PartType.Ball
 end
 return main
end
local function spawnModel(player,id,cf)
 local vessel=Boat.Vessels[id]
 local m=Instance.new("Model")
 m.Name=player.DisplayName.."'s "..vessel.name
 m:SetAttribute("OwnerUserId",player.UserId)
 m:SetAttribute("VesselType",id)
 m:SetAttribute("SpeedLimit",vessel.speed)
 m.Parent=dockFolder
 local hull=modelHull(m,cf,vessel)
 local seat=Instance.new("VehicleSeat")
 seat.Name="Boat Driver Seat";seat.Size=Vector3.new(2,1.1,2)
 seat.CFrame=cf*CFrame.new(0,2,1.8)
 seat.Color=Color3.fromRGB(69,85,103);seat.Material=Enum.Material.Fabric
 seat.Anchored=true;seat.CanCollide=true;seat.Parent=m
 m.PrimaryPart=hull
 local foam=Instance.new("ParticleEmitter")
 foam.Name="Boat Wake";foam.Enabled=false
 foam.Texture="rbxasset://textures/particles/sparkles_main.dds"
 foam.Rate=17;foam.Lifetime=NumberRange.new(.3,.7)
 foam.Speed=NumberRange.new(1,3)
 foam.SpreadAngle=Vector2.new(15,15)
 foam.Parent=hull
 return m,seat,foam
end
local function inSea(pos)
 return pos.X&gt;=605 and pos.X&lt;=920 and
  pos.Z&gt;=332 and pos.Z&lt;=710 and pos.Y&gt;=-2 and pos.Y&lt;=18
end
function Boat.Spawn(player,id)
 if type(id)~="string" or not Boat.Vessels[id] then
  return false,"CHOOSE AN AVAILABLE BOAT TYPE."
 end
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not root or (root.Position-pier).Magnitude&gt;100 then
  return false,"VISIT THE OCEAN MARINA BOAT LAUNCH TO SPAWN A BOAT."
 end
 if player:GetAttribute("RRLifeOwn_"..id)~=true then
  return false,"BUY THIS BOAT WITH EARNED COINS AT THE VEHICLE DEALER FIRST."
 end
 local now=os.clock()
 if now-(cooldown[player] or -1000)&lt;7 then
  return false,"WAIT BEFORE LAUNCHING ANOTHER VESSEL."
 end
 cooldown[player]=now
 local previous=active[player]
 if previous and previous.model then previous.model:Destroy() end
 local spot=Vector3.new(650,1.2,520)
 local cf=CFrame.lookAt(spot,spot+Vector3.new(0,0,-1))
 local m,seat,wake=spawnModel(player,id,cf)
 active[player]={model=m,seat=seat,position=spot,speed=0,kind=id,
  wake=wake,lastOccupied=now}
 return true,Boat.Vessels[id].name:upper().." LAUNCHED! USE THE DRIVER SEAT TO STEER."
end
function Boat.Build(world)
 local Terrain=workspace.Terrain
 Terrain:FillBlock(CFrame.new(730,-9,520),Vector3.new(450,12,400),
  Enum.Material.Water)
 local folder=Instance.new("Folder");folder.Name="Navigable Ocean Marina";folder.Parent=world
 dockFolder=folder
 for i=0,5 do
  part(folder,"Marina Plank "..i,Vector3.new(15,.8,13),
   CFrame.new(583+i*9,2.7,520),
   Color3.fromRGB(157,114,78),Enum.Material.WoodPlanks,true)
 end
 for _,z in ipairs({-6,6}) do
  for x=578,638,12 do
   part(folder,"Marine Dock Post",Vector3.new(1.3,7,1.3),
    CFrame.new(x,.3,520+z),
    Color3.fromRGB(112,85,69),Enum.Material.Wood,true)
  end
 end
 dockPart=part(folder,"Public Marina Boat Launch",Vector3.new(7,4,4),
  CFrame.new(600,6.1,520),Color3.fromRGB(54,106,134),
  Enum.Material.Metal,true)
 local p=Instance.new("ProximityPrompt")
 p.Name="Boat Launch Prompt";p.ActionText="LAUNCH OWNED BOAT"
 p.ObjectText="MARINA • SELECT YOUR BOAT IN LIFE MENU"
 p.MaxActivationDistance=14;p.HoldDuration=.3;p.Parent=dockPart
 p.Triggered:Connect(function(player)
  for _,id in ipairs({"FISHING_BOAT","JET_SKI","PONTOON","SPEEDBOAT",
   "SAILBOAT","CABIN_CRUISER","YACHT","LUXURY_YACHT","KAYAK"}) do
   if player:GetAttribute("RRLifeOwn_"..id) then
    Boat.Spawn(player,id)
    break
   end
  end
 end)
 folder:SetAttribute("BoatModels",9)
 elapsed=0
 RunService.Heartbeat:Connect(function(dt)
  elapsed+=dt
  if elapsed&lt;.06 then return end
  local step=math.min(elapsed,.12);elapsed=0
  for player,boat in pairs(active) do
   if not player.Parent or not boat.model or not boat.model.Parent then
    if boat.model then boat.model:Destroy() end
    active[player]=nil
   else
    local hum=boat.seat.Occupant
    local driver=hum and Players:GetPlayerFromCharacter(hum.Parent)
    if driver==player and hum.Health&gt;0 then
     boat.lastOccupied=os.clock()
     local v=Boat.Vessels[boat.kind]
     local throttle=math.clamp(boat.seat.ThrottleFloat,-1,1)
     local turn=math.clamp(boat.seat.SteerFloat,-1,1)
     local goal=throttle*v.speed
     boat.speed+=(goal-boat.speed)*math.min(1,step*1.4)
     if math.abs(throttle)&lt;.05 then boat.speed*=math.max(0,1-step*.7) end
     local cf=boat.model:GetPivot()
     local yaw=-turn*step*1.1*math.clamp(math.abs(boat.speed)/18,.2,1)
     local rot=cf*CFrame.Angles(0,yaw,0)
     local nextPos=rot.Position+rot.LookVector*boat.speed*step
     if inSea(nextPos) then
      nextPos=Vector3.new(nextPos.X,1.2,nextPos.Z)
      boat.model:PivotTo(rot-rot.Position+nextPos)
      boat.wake.Enabled=math.abs(boat.speed)&gt;5
     else
      boat.speed=0;boat.wake.Enabled=false
     end
    elseif os.clock()-boat.lastOccupied&gt;300 then
     boat.model:Destroy();active[player]=nil
    end
   end
  end
 end)
 Players.PlayerRemoving:Connect(function(player)
  local boat=active[player]
  if boat and boat.model then boat.model:Destroy() end
  active[player]=nil;cooldown[player]=nil
 end)
 return Vector3.new(600,8,520)
end
return Boat
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="14">
      <Properties>
        <string name="Name">DowntownPopulation</string>
        <string name="Source">-- v0.10 LIVING DOWNTOWN: R15 citizens and detailed moving traffic.
-- Uses Roblox's own R15 rig generation and the script-free official sedan visual.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local ServerStorage=game:GetService("ServerStorage")

local Population={}
local heartbeatConnection=nil
local citizens={}
local traffic={}

local skins={
 Color3.fromRGB(236,196,159),Color3.fromRGB(195,143,107),
 Color3.fromRGB(128,91,70),Color3.fromRGB(226,174,132),
 Color3.fromRGB(162,112,84),Color3.fromRGB(96,69,55),
}
local shirts={
 Color3.fromRGB(53,91,129),Color3.fromRGB(126,71,92),
 Color3.fromRGB(76,111,84),Color3.fromRGB(111,95,67),
 Color3.fromRGB(64,69,82),Color3.fromRGB(133,98,63),
}
local pants={
 Color3.fromRGB(38,43,52),Color3.fromRGB(54,56,61),
 Color3.fromRGB(42,53,65),Color3.fromRGB(57,49,45),
}
local names={"Alex","Jordan","Morgan","Taylor","Casey","Riley","Avery","Cameron"}
-- Public classic Roblox hair accessories verified in Studio. They cost the
-- player nothing and give the generated R15 citizens recognizable silhouettes.
local hairIds={"63690008","16630147","376548738"}
local dialogues={
 "I am heading to work. The Employment Center is near the front block.",
 "Motor Row is where people shop for vehicles. You still have to earn the coins.",
 "City Tech sells phones and creator gear if you want to build a following.",
 "The community pantry and public benches can help if your needs get low.",
 "Metro Realty handles apartments and homes once you have built up your career.",
 "City Commerce is where business owners collect their simulated revenue.",
 "Police patrol the district. High wanted heat can still get you arrested.",
 "There are more worlds outside downtown through the WORLD menu.",
}

local function safeDescription(index)
 local d=Instance.new("HumanoidDescription")
 local skin=skins[(index-1)%#skins+1]
 local top=shirts[(index-1)%#shirts+1]
 local bottom=pants[(index-1)%#pants+1]
 d.HeadColor=skin; d.LeftArmColor=skin; d.RightArmColor=skin
 d.TorsoColor=top; d.LeftLegColor=bottom; d.RightLegColor=bottom
 d.HeightScale=.96+(index%4)*.025
 d.WidthScale=.92+(index%3)*.035
 d.DepthScale=.94+(index%2)*.04
 d.HeadScale=.98; d.BodyTypeScale=.28; d.ProportionScale=.18
 d.HairAccessory=hairIds[(index-1)%#hairIds+1]
 return d
end

local function walkAnimation(humanoid)
 local animator=humanoid:FindFirstChildOfClass("Animator")
 if not animator then animator=Instance.new("Animator"); animator.Parent=humanoid end
 local animation=Instance.new("Animation")
 animation.Name="Downtown Walk Animation"
 animation.AnimationId="rbxassetid://507777826" -- Roblox R15 walk
 local ok,track=pcall(function() return animator:LoadAnimation(animation) end)
 if ok and track then
  track.Name="Downtown Walk"
  track.Looped=true
  track.Priority=Enum.AnimationPriority.Movement
  track:Play(.2,1,1)
  return track
 end
 animation:Destroy()
 return nil
end

local function citizen(parent,index,start,route,tellPlayer,world)
 local description=safeDescription(index)
 local ok,model=pcall(function()
  return Players:CreateHumanoidModelFromDescription(description,Enum.HumanoidRigType.R15)
 end)
 description:Destroy()
 if not ok or not model then return nil end
 model.Name="Downtown Citizen "..index
 model:SetAttribute("NPCType","R15Citizen")
 model:SetAttribute("CitizenName",names[(index-1)%#names+1])
 model:SetAttribute("Behavior","Walking")
 model.Parent=parent
 local humanoid=model:FindFirstChildOfClass("Humanoid")
 local root=model:FindFirstChild("HumanoidRootPart")
 if not humanoid or not root then model:Destroy(); return nil end
 humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
 humanoid.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
 humanoid.WalkSpeed=7.4+(index%4)*.65
 humanoid.AutoRotate=true
 humanoid.BreakJointsOnDeath=false
 root.CanCollide=false
 local talkAnchor=model:FindFirstChild("UpperTorso") or model:FindFirstChild("Head")
 if talkAnchor then
  local talk=Instance.new("ProximityPrompt")
  talk.Name="Talk to Citizen"
  talk.ActionText="TALK"
  talk.ObjectText=model:GetAttribute("CitizenName")
  talk.HoldDuration=.25; talk.MaxActivationDistance=9
  talk.RequiresLineOfSight=false; talk.Parent=talkAnchor
  talk.Triggered:Connect(function(player)
   if tellPlayer then tellPlayer(player,model:GetAttribute("CitizenName")..": "..dialogues[index]) end
   if world then
    world:SetAttribute("DowntownConversations",(world:GetAttribute("DowntownConversations") or 0)+1)
   end
  end)
 end
 pcall(function() root:SetNetworkOwner(nil) end)
 model:PivotTo(CFrame.new(start+Vector3.new(0,3.2,0)))
 local track=walkAnimation(humanoid)
 local state={model=model,humanoid=humanoid,root=root,route=route,index=2,walkTrack=track}
 table.insert(citizens,state)
 task.spawn(function()
  while model.Parent and humanoid.Health&gt;0 do
   local target=route[state.index]
   humanoid:MoveTo(target)
   local reached=humanoid.MoveToFinished:Wait()
   if model.Parent and humanoid.Health&gt;0 then
    if not reached and (root.Position-target).Magnitude&gt;24 then
     model:PivotTo(CFrame.new(target+Vector3.new(0,3.2,0)))
    end
    state.index=state.index%#route+1
    task.wait(.35+(index%3)*.2)
   end
  end
 end)
 return model
end

local function makeTrafficSedan(parent,index,startIndex,route)
 local template=ServerStorage:FindFirstChild("OfficialSedanVisual")
 if not template then return nil end
 local m=template:Clone()
 m.Name="Downtown Traffic Sedan "..index
 m:SetAttribute("NPCType","DetailedTraffic")
 m:SetAttribute("VisualModel","Official Modern City Sedan")
 m:SetAttribute("DistanceTravelled",0)
 m.Parent=parent
 for _,node in ipairs(m:GetDescendants()) do
  if node:IsA("LuaSourceContainer") then
   node:Destroy()
  elseif node:IsA("BasePart") then
   node.Anchored=true; node.CanCollide=false; node.CanTouch=false
   node.CanQuery=false
  end
 end
 local pos=route[startIndex]
 local nextIndex=startIndex%#route+1
 local direction=(route[nextIndex]-pos).Unit
 m:PivotTo(CFrame.lookAt(pos,pos+direction)*CFrame.Angles(0,math.pi,0))
 local state={model=m,position=pos,route=route,index=nextIndex,
  speed=18+index*1.5,distance=0,lastAttribute=0}
 table.insert(traffic,state)
 return m
end

function Population.Build(world,cityModel,options)
 options=options or {}
 if heartbeatConnection then heartbeatConnection:Disconnect(); heartbeatConnection=nil end
 citizens={}; traffic={}
 local old=world:FindFirstChild("Living Modern Downtown")
 if old then old:Destroy() end
 local folder=Instance.new("Folder")
 folder.Name="Living Modern Downtown"
 folder.Parent=world
 folder:SetAttribute("CitizenCount",8)
 folder:SetAttribute("TrafficCount",4)
 folder:SetAttribute("RigType","R15")
 folder:SetAttribute("TrafficVisual","Official Modern City Sedan")

 -- Two citizens cross the welcome block immediately so downtown feels alive
 -- from the first camera view instead of only at the far perimeter.
 local frontA=Vector3.new(-32,0,2238)
 local frontB=Vector3.new(32,0,2238)
 local rightA=Vector3.new(108,0,2260)
 local rightB=Vector3.new(108,0,2460)
 local backA=Vector3.new(85,0,2472)
 local backB=Vector3.new(-85,0,2472)
 local leftA=Vector3.new(-108,0,2460)
 local leftB=Vector3.new(-108,0,2260)
 local pedestrianRoutes={
  {frontA,frontB,frontA},
  {frontB,frontA,frontB},
  {rightA,rightB,rightA},
  {rightB,rightA,rightB},
  {backA,backB,backA},
  {backB,backA,backB},
  {leftA,leftB,leftA},
  {leftB,leftA,leftB},
 }
 world:SetAttribute("DowntownConversations",0)
 for i,route in ipairs(pedestrianRoutes) do
  citizen(folder,i,route[1],route,options.tell,world)
 end

 -- Keep the front traffic lane behind the third-person camera at spawn.
 -- This prevents a non-colliding sedan from visually passing through the camera.
 local roadRoute={
  Vector3.new(-128,4.5,2200),Vector3.new(128,4.5,2200),
  Vector3.new(128,4.5,2502),Vector3.new(-128,4.5,2502),
 }
 for i=1,4 do makeTrafficSedan(folder,i,i,roadRoute) end

 if cityModel then
  cityModel:SetAttribute("LivingDowntownIntegrated",true)
  cityModel:SetAttribute("DetailedCitizenCount",#citizens)
  cityModel:SetAttribute("DetailedTrafficCount",#traffic)
 end
 world:SetAttribute("DowntownTrafficDistance",0)
 local elapsed=0
 heartbeatConnection=RunService.Heartbeat:Connect(function(dt)
  if not world.Parent or not folder.Parent then return end
  elapsed+=dt
  if elapsed&lt;.09 then return end
  local step=math.min(elapsed,.14); elapsed=0
  local totalDistance=0
  for _,car in ipairs(traffic) do
   local m=car.model
   if m and m.Parent then
    local goal=car.route[car.index]
    local delta=goal-car.position
    if delta.Magnitude&lt;2.2 then
     car.index=car.index%#car.route+1
     goal=car.route[car.index]
     delta=goal-car.position
    end
    if delta.Magnitude&gt;.01 then
     local direction=delta.Unit
     local amount=math.min(delta.Magnitude,car.speed*step)
     car.position+=direction*amount
     car.distance+=amount
     local cf=CFrame.lookAt(car.position,car.position+direction)*CFrame.Angles(0,math.pi,0)
     m:PivotTo(cf)
     if car.distance-car.lastAttribute&gt;=6 then
      car.lastAttribute=car.distance
      m:SetAttribute("DistanceTravelled",math.floor(car.distance))
     end
    end
    totalDistance+=car.distance
   end
  end
  world:SetAttribute("DowntownTrafficDistance",math.floor(totalDistance))
 end)
 return {folder=folder,citizens=#citizens,traffic=#traffic}
end

return Population
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">HomeLiving</string>
        <string name="Source">-- v0.13 Home Living: lockable front doors, ownership-validated furniture
-- and equipment used inside physical homes. No Robux or real purchases.
local TweenService=game:GetService("TweenService")
local Home={}
local function piece(parent,name,size,cf,color,material,solid)
 local p=Instance.new("Part")
 p.Name=name;p.Size=size;p.CFrame=cf
 p.Material=material or Enum.Material.WoodPlanks
 p.Color=color or Color3.fromRGB(149,118,93)
 p.Anchored=true;p.CanCollide=solid==true;p.CanTouch=false
 p.TopSurface=Enum.SurfaceType.Smooth
 p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
 return p
end
local function device(parent,base,fn,action,name)
 local prompt=Instance.new("ProximityPrompt")
 prompt.Name="Home "..name
 prompt.ActionText=action;prompt.ObjectText=name
 prompt.MaxActivationDistance=10;prompt.HoldDuration=.25
 prompt.RequiresLineOfSight=false;prompt.Parent=base
 prompt.Triggered:Connect(fn)
 return prompt
end
local function inRange(player,part,range)
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 return root and (root.Position-part.Position).Magnitude&lt;(range or 14)
end
local function addLamp(model,location,shade)
 local lamp=piece(model,"Warm Interior Ceiling Lamp",Vector3.new(2,.4,2),
  CFrame.new(location),shade,Enum.Material.Metal,false)
 local light=Instance.new("PointLight")
 light.Brightness=1.5;light.Range=22;light.Shadows=true
 light.Color=Color3.fromRGB(255,222,173);light.Parent=lamp
 local globe=piece(model,"Frosted Lamp Diffuser",Vector3.new(1.25,.5,1.25),
  CFrame.new(location-Vector3.new(0,.4,0)),
  Color3.fromRGB(250,234,205),Enum.Material.Glass,false)
 globe.Transparency=.16
end
local function sofaUpgrade(model,center,width)
 local pos=center+Vector3.new(-width*.25,5,-2)
 local base=piece(model,"Purchased Couch Cushions",Vector3.new(8,1.25,3),
  CFrame.new(pos+Vector3.new(0,.55,-.1)),
  Color3.fromRGB(81,112,129),Enum.Material.Fabric,true)
 for _,x in ipairs({-2.55,0,2.55}) do
  piece(model,"Upholstered Sofa Cushion",Vector3.new(2.1,.4,2.25),
   CFrame.new(pos+Vector3.new(x,1.22,-.15)),
   Color3.fromRGB(100,131,144),Enum.Material.Fabric,false)
 end
 for _,x in ipairs({-4.0,4.0}) do
  piece(model,"Sofa Armrest",Vector3.new(.8,2.05,3),
   CFrame.new(pos+Vector3.new(x,1,-.1)),
   Color3.fromRGB(86,111,125),Enum.Material.Fabric,true)
 end
 return base
end
local function homeDoor(model,center,player,handlers)
 local hinge=CFrame.new(center+Vector3.new(-2.7,7.05,-13.95))
 local shut=hinge*CFrame.new(2.7,0,0)
 local open=hinge*CFrame.Angles(0,math.rad(104),0)*CFrame.new(2.7,0,0)
 local door=piece(model,"Security Entrance Door",Vector3.new(5.25,7.65,.45),
  shut,Color3.fromRGB(95,83,77),Enum.Material.WoodPlanks,true)
 local handle=piece(model,"Front Door Handle",Vector3.new(.5,.5,.5),
  shut*CFrame.new(1.7,-.1,-.45),Color3.fromRGB(183,165,121),
  Enum.Material.Metal,false)
 local lockPanel=piece(model,"Door Smart Lock",Vector3.new(.75,1,.22),
  CFrame.new(center+Vector3.new(3.7,7.2,-13.65)),
  Color3.fromRGB(50,65,69),Enum.Material.Metal,false)
 local lockLight=piece(model,"Door Lock Indicator",Vector3.new(.28,.28,.16),
  lockPanel.CFrame*CFrame.new(0,.2,-.18),
  Color3.fromRGB(209,70,61),Enum.Material.Neon,false)
 local busy=false;local opened=false
 local function change(openNow)
  if busy then return end
  busy=true;opened=openNow
  if openNow then door.CanCollide=false end
  local tween=TweenService:Create(door,TweenInfo.new(.65,Enum.EasingStyle.Sine),
   {CFrame=openNow and open or shut})
  local hTween=TweenService:Create(handle,
   TweenInfo.new(.65,Enum.EasingStyle.Sine),
   {CFrame=(openNow and open or shut)*CFrame.new(1.7,-.1,-.45)})
  tween:Play();hTween:Play();tween.Completed:Wait()
  if door.Parent then door.CanCollide=not openNow end
  busy=false
 end
 local function ownerProfile()
  local state=handlers.getProfile(player)
  return state and state.life or nil
 end
 local prompt=device(model,door,function(visitor)
  if not inRange(visitor,door,12) then return end
  local owner=ownerProfile()
  if not owner then return end
  if visitor~=player and owner.homeLocked then
   handlers.tell(visitor,"THIS HOME IS LOCKED • ASK THE OWNER TO UNLOCK IT.")
   return
  end
  if busy then return end
  change(not opened)
  handlers.tell(visitor,opened and "HOME DOOR OPENED." or "HOME DOOR CLOSED.")
 end,"OPEN / CLOSE","Front Door")
 local lockPrompt=device(model,lockPanel,function(visitor)
  if visitor~=player or not inRange(visitor,lockPanel,12) then return end
  local state=ownerProfile()
  if not state then return end
  state.homeLocked=not state.homeLocked
  lockLight.Color=state.homeLocked and Color3.fromRGB(209,70,61)
   or Color3.fromRGB(90,196,114)
  lockPanel:SetAttribute("Locked",state.homeLocked)
  handlers.sync(player)
  handlers.tell(player,state.homeLocked and
   "YOUR HOME IS LOCKED TO VISITORS." or "YOUR HOME IS OPEN TO VISITORS.")
 end,"LOCK / UNLOCK","Owner Home Security")
 local state=ownerProfile()
 lockPanel:SetAttribute("Locked",not state or state.homeLocked)
 if state and not state.homeLocked then
  lockLight.Color=Color3.fromRGB(90,196,114)
 end
 door:SetAttribute("OwnerUserId",player.UserId)
 return door,lockPanel
end
function Home.Furnish(model,center,width,floors,player,owned,handlers)
 -- All interactions use the server-held original owner, never a client-supplied user id.
 addLamp(model,center+Vector3.new(0,12,0),Color3.fromRGB(94,85,76))
 if floors&gt;=2 then
  addLamp(model,center+Vector3.new(0,21,0),Color3.fromRGB(95,88,81))
 end
 homeDoor(model,center,player,handlers)
 local function restore(node,needs,cooldown,notice)
  local clock=-1000
  device(model,node,function(visitor)
   if visitor~=player or not inRange(visitor,node,12) then return end
   local state=handlers.getProfile(player)
   if not state or not state.life then return end
   local now=os.clock()
   if now-clock&lt;cooldown then
    handlers.tell(player,"FINISH USING THIS APPLIANCE BEFORE TRYING AGAIN.")
    return
   end
   clock=now
   for k,n in pairs(needs) do
    state.life.needs[k]=math.min(100,state.life.needs[k]+n)
   end
   handlers.sync(player)
   handlers.tell(player,notice)
  end,"USE","Your "..node.Name)
 end
 if owned.COUCH or owned.FURNITURE then
  sofaUpgrade(model,center,width)
 end
 if owned.SMART_TV or owned.GAME_CONSOLE or owned.HOME_PROJECTOR then
  local tv=piece(model,"Wall Mounted Smart TV",
   Vector3.new(8.1,4.1,.38),
   CFrame.new(center+Vector3.new(-width*.25,8.2,-10.75)),
   Color3.fromRGB(19,25,31),Enum.Material.Glass,false)
  local screen=piece(model,"Home TV Display",
   Vector3.new(7.6,3.65,.16),
   tv.CFrame*CFrame.new(0,0,-.28),
   Color3.fromRGB(67,125,157),Enum.Material.Glass,false)
  screen.Transparency=.12
  restore(tv,{fun=24},35,"WATCHED TELEVISION • FUN +24!")
  if owned.GAME_CONSOLE then
   local console=piece(model,"Game Console Dock",Vector3.new(2.1,.45,1.6),
    CFrame.new(center+Vector3.new(-width*.25,5,-10)),
    Color3.fromRGB(36,45,56),Enum.Material.Metal,false)
   restore(console,{fun=43},45,"PLAYED VIDEO GAMES • FUN +43!")
  end
 end
 if owned.FRIDGE or owned.KITCHEN_APPLIANCES then
  local fridge=piece(model,"Home Refrigerator",Vector3.new(2.6,6,2.4),
   CFrame.new(center+Vector3.new(width*.43,7,10)),
   Color3.fromRGB(203,215,219),Enum.Material.Metal,true)
  piece(model,"Freezer Door",Vector3.new(2.45,2.1,.16),
   fridge.CFrame*CFrame.new(0,1.55,-1.24),
   Color3.fromRGB(188,203,209),Enum.Material.Metal,false)
  piece(model,"Fridge Handle",Vector3.new(.18,1.2,.2),
   fridge.CFrame*CFrame.new(-.85,.7,-1.38),
   Color3.fromRGB(62,68,75),Enum.Material.Metal,false)
  restore(fridge,{hunger=40},60,"ATE A MEAL FROM THE FRIDGE • HUNGER +40!")
 end
 if owned.DINING_TABLE then
  local spot=center+Vector3.new(width*.28,5.1,-7.2)
  local top=piece(model,"Purchased Dining Table",Vector3.new(6.6,.55,3.4),
   CFrame.new(spot),Color3.fromRGB(124,85,62),Enum.Material.WoodPlanks,true)
  for _,x in ipairs({-2.5,2.5}) do
   for _,z in ipairs({-1,1}) do
    piece(model,"Dining Table Leg",Vector3.new(.45,1.3,.45),
     top.CFrame*CFrame.new(x,-.8,z),
     Color3.fromRGB(103,74,55),Enum.Material.Wood,true)
   end
  end
  for _,z in ipairs({-3,3}) do
   piece(model,"Dining Chair",Vector3.new(2,1,1.7),
    CFrame.new(spot+Vector3.new(0,-.45,z)),
    Color3.fromRGB(158,122,85),Enum.Material.Wood,true)
  end
 end
 if owned.BOOKSHELF then
  local base=piece(model,"Oak Bookcase",Vector3.new(4.2,7,.9),
   CFrame.new(center+Vector3.new(-width*.43,7.5,2)),
   Color3.fromRGB(109,81,58),Enum.Material.Wood,true)
  for _,y in ipairs({-1.8,-.3,1.2,2.6}) do
   piece(model,"Library Shelf",Vector3.new(4,.15,.94),
    base.CFrame*CFrame.new(0,y,0),
    Color3.fromRGB(165,124,81),Enum.Material.Wood,false)
  end
  restore(base,{fun=12},40,"READ A BOOK • FUN +12!")
 end
 if owned.WASHER_DRYER then
  local washer=piece(model,"Home Washing Machine",Vector3.new(3.2,3,2.7),
   CFrame.new(center+Vector3.new(-width*.34,5.5,6.1)),
   Color3.fromRGB(211,219,225),Enum.Material.Metal,true)
  local drum=piece(model,"Laundry Washer Window",Vector3.new(1.6,1.6,.16),
   washer.CFrame*CFrame.new(0,0,-1.45),
   Color3.fromRGB(95,155,184),Enum.Material.Glass,false)
  drum.Shape=Enum.PartType.Ball
  restore(washer,{hygiene=30},50,"CLEANED CLOTHES • HYGIENE +30!")
 end
 if owned.KING_BED or owned.BED_SET then
  local mattress=piece(model,"Purchased King Mattress",Vector3.new(7.8,.65,9.8),
   CFrame.new(center+Vector3.new(width*.25,5.6,4)),
   Color3.fromRGB(235,227,215),Enum.Material.Fabric,true)
  piece(model,"Bedspread",Vector3.new(7.9,.18,5),
   mattress.CFrame*CFrame.new(0,.45,-1.8),
   Color3.fromRGB(134,156,164),Enum.Material.Fabric,false)
 end
 if owned.BABY_CRIB then
  local crib=piece(model,"Nursery Crib Base",Vector3.new(3.5,.65,5),
   CFrame.new(center+Vector3.new(width*.38,4.7,-5)),
   Color3.fromRGB(217,214,194),Enum.Material.Wood,true)
  for _,side in ipairs({-1,1}) do
   for i=1,6 do
    piece(model,"Nursery Safety Rail",Vector3.new(.17,2.7,.17),
     crib.CFrame*CFrame.new(side*1.63,1.5,-2.2+i*.63),
     Color3.fromRGB(230,226,206),Enum.Material.Wood,false)
   end
  end
 end
 if owned.PET_BED or owned.DOG_HOUSE or owned.CAT_TREE then
  local dogBed=piece(model,"Companion Pet Cushion",Vector3.new(3,.4,2.9),
   CFrame.new(center+Vector3.new(-width*.37,4.1,4.2)),
   Color3.fromRGB(162,117,91),Enum.Material.Fabric,false)
 end
 if owned.WORKSTATION or owned.DESKTOP_PC or owned.LAPTOP then
  local desk=piece(model,"Creator Work Desk",Vector3.new(4,.5,2.2),
   CFrame.new(center+Vector3.new(width*.37,6.1,-.4)),
   Color3.fromRGB(133,102,79),Enum.Material.Wood,true)
  local screen=piece(model,"Home Computer Monitor",Vector3.new(2.3,1.5,.3),
   desk.CFrame*CFrame.new(0,1.1,.2),
   Color3.fromRGB(52,78,99),Enum.Material.Glass,false)
  restore(desk,{fun=20},40,"WORKED ON YOUR COMPUTER • FUN +20!")
 end
 model:SetAttribute("FurniturePieces",#model:GetDescendants())
end
return Home
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="16">
      <Properties>
        <string name="Name">LifeCityVisuals</string>
        <string name="Source">-- v0.7 original procedural architectural detailing for Life City.
-- No Toolbox scripts, third-party meshes, external IDs or unlicensed assets.
-- A polished blockout with masonry, shopfronts, fixtures, landscaping, street furniture.
local Lighting=game:GetService("Lighting")
local Detail={}
local center=Vector3.new(0,0,1600)
local function part(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=cf; p.Anchored=true
 p.Material=material or Enum.Material.SmoothPlastic
 p.Color=color or Color3.fromRGB(180,180,180)
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 p.CanCollide=collide==true; p.CanTouch=false
 p.Parent=parent; return p
end
local function beam(parent,name,size,pos,color,material)
 return part(parent,name,size,CFrame.new(pos),color,material,false)
end
local function cylinder(parent,name,size,cf,color,material)
 local p=part(parent,name,size,cf,color,material,false)
 p.Shape=Enum.PartType.Cylinder
 return p
end
local function sphere(parent,name,size,cf,color,material)
 local p=part(parent,name,size,cf,color,material,false)
 p.Shape=Enum.PartType.Ball
 return p
end
local function sign(parent,name,size,pos,color,letters)
 local base=beam(parent,name,size,pos,color,Enum.Material.Metal)
 local face=Instance.new("SurfaceGui"); face.Name="Painted Shop Sign"
 face.Face=Enum.NormalId.Front; face.CanvasSize=Vector2.new(680,140)
 face.LightInfluence=.25; face.Parent=base
 local label=Instance.new("TextLabel")
 label.Size=UDim2.fromScale(1,1)
 label.BackgroundTransparency=1
 label.Text=letters; label.TextScaled=true
 label.Font=Enum.Font.GothamBlack
 label.TextColor3=Color3.fromRGB(246,242,228)
 label.Parent=face
 return base
end
local function light(parent,name,pos,color,range)
 local body=beam(parent,name,Vector3.new(1.1,.4,1.1),
  pos,Color3.fromRGB(242,229,195),Enum.Material.Neon)
 local l=Instance.new("PointLight"); l.Range=range or 15; l.Brightness=.65
 l.Color=color or Color3.fromRGB(255,232,192); l.Shadows=false; l.Parent=body
end
local function tree(parent,pos,index)
 local m=Instance.new("Model"); m.Name="Street Tree "..index; m.Parent=parent
 local trunk=cylinder(m,"Bark",Vector3.new(2,12,2),
  CFrame.new(pos+Vector3.new(0,7,0)),Color3.fromRGB(105,83,66),Enum.Material.Wood)
 trunk.CanCollide=true
 for i=1,5 do
  local theta=(i-1)*math.pi*2/5
  local delta=Vector3.new(math.cos(theta)*3,0,math.sin(theta)*3)
  sphere(m,"Leaf Canopy",Vector3.new(9,8,9),
   CFrame.new(pos+Vector3.new(0,15,0)+delta),
   i%2==0 and Color3.fromRGB(61,123,73) or Color3.fromRGB(76,143,86),
   Enum.Material.Grass)
 end
 beam(m,"Mulch Bed",Vector3.new(9,.35,9),
  pos+Vector3.new(0,.2,0),Color3.fromRGB(101,81,63),Enum.Material.Ground)
end
local function bench(parent,pos)
 for _,x in ipairs({-3,3}) do
  beam(parent,"Bench Leg",Vector3.new(.5,2.3,.6),
   pos+Vector3.new(x,1.4,0),Color3.fromRGB(65,72,76),Enum.Material.Metal)
 end
 for _,z in ipairs({-.8,0,.8}) do
  beam(parent,"Wood Bench Seat",Vector3.new(7,.3,.7),
   pos+Vector3.new(0,2.6,z),Color3.fromRGB(125,91,62),Enum.Material.WoodPlanks)
 end
 beam(parent,"Bench Back",Vector3.new(7,2,.35),
  pos+Vector3.new(0,3.6,1.1),Color3.fromRGB(129,97,69),Enum.Material.WoodPlanks)
end
local function planter(parent,pos)
 cylinder(parent,"Stone Planter",Vector3.new(6,1.8,6),
  CFrame.new(pos+Vector3.new(0,1,0)),Color3.fromRGB(150,153,151),Enum.Material.Concrete)
 cylinder(parent,"Planter Soil",Vector3.new(5.5,.2,5.5),
  CFrame.new(pos+Vector3.new(0,2,0)),Color3.fromRGB(87,70,53),Enum.Material.Ground)
 for i=1,5 do
  local angle=i*math.pi*2/5
  local p=pos+Vector3.new(math.cos(angle)*1.7,2.8,math.sin(angle)*1.7)
  sphere(parent,"Garden Shrub",Vector3.new(2.2,2.5,2.2),
   CFrame.new(p),Color3.fromRGB(60+i*4,112+i*3,70),Enum.Material.Grass)
 end
end
local function lampPost(parent,pos)
 local m=Instance.new("Model"); m.Name="City Streetlamp"; m.Parent=parent
 cylinder(m,"Streetlight Pole",Vector3.new(.55,20,.55),
  CFrame.new(pos+Vector3.new(0,10,0)),Color3.fromRGB(65,74,83),Enum.Material.Metal)
 beam(m,"Streetlight Arm",Vector3.new(5,.45,.45),
  pos+Vector3.new(2.4,19.7,0),Color3.fromRGB(65,74,83),Enum.Material.Metal)
 local bulb=beam(m,"Warm Streetlight",Vector3.new(2,.35,1.2),
  pos+Vector3.new(4.7,19.3,0),Color3.fromRGB(252,232,173),Enum.Material.Neon)
 local spot=Instance.new("SpotLight"); spot.Face=Enum.NormalId.Bottom
 spot.Range=28; spot.Angle=95; spot.Brightness=1.2
 spot.Color=Color3.fromRGB(255,230,184); spot.Parent=bulb
end
local function product(parent,category,index,pos)
 local color=({
  TECH=Color3.fromRGB(68,92,115),
  APPAREL=Color3.fromRGB(164,104,127),
  HOME=Color3.fromRGB(161,137,96),
  VEHICLE=Color3.fromRGB(76,119,153),
  PROPERTY=Color3.fromRGB(175,162,139),
  BUSINESS=Color3.fromRGB(106,147,118)
 })[category] or Color3.fromRGB(135,140,146)
 if category=="APPAREL" then
  local mannequin=cylinder(parent,"Clothing Stand",Vector3.new(.7,3,.7),
   CFrame.new(pos+Vector3.new(0,1.6,0)),Color3.fromRGB(103,101,98),Enum.Material.Metal)
  mannequin.CanCollide=false
  local torso=beam(parent,"Displayed Jacket",Vector3.new(2.6,2.2,1),
   pos+Vector3.new(0,3.3,0),color,Enum.Material.Fabric)
  for _,x in ipairs({-1.8,1.8}) do
   beam(parent,"Jacket Sleeve",Vector3.new(.85,2.2,.9),
    pos+Vector3.new(x,3.2,0),color,Enum.Material.Fabric)
  end
 elseif category=="TECH" then
  local screen=beam(parent,"Product Display Screen",Vector3.new(2.9,2.1,.24),
   pos+Vector3.new(0,3,0),Color3.fromRGB(22,35,47),Enum.Material.Metal)
  local display=beam(parent,"Screen Glass",Vector3.new(2.5,1.7,.1),
   screen.Position+Vector3.new(0,0,-.2),Color3.fromRGB(63,137,164),Enum.Material.Glass)
  display.Transparency=.25
  beam(parent,"Device Base",Vector3.new(3.3,.35,2.1),
   pos+Vector3.new(0,1.8,0),color,Enum.Material.Metal)
 elseif category=="VEHICLE" then
  beam(parent,"Model Car Body",Vector3.new(4,1.3,2.1),
   pos+Vector3.new(0,2.6,0),color,Enum.Material.Metal)
  for _,x in ipairs({-1.4,1.4}) do
   for _,z in ipairs({-1.2,1.2}) do
    cylinder(parent,"Showroom Tire",Vector3.new(.5,1.3,1.3),
     CFrame.new(pos+Vector3.new(x,2,z))*CFrame.Angles(0,0,math.pi/2),
     Color3.fromRGB(37,41,45),Enum.Material.Rubber)
   end
  end
 elseif category=="PROPERTY" then
  beam(parent,"Architectural Model House",Vector3.new(3,2,2.8),
   pos+Vector3.new(0,2.7,0),color,Enum.Material.Brick)
  local roof=Instance.new("WedgePart"); roof.Name="Architectural Roof Model"
  roof.Size=Vector3.new(3.4,1.3,3.3)
  roof.CFrame=CFrame.new(pos+Vector3.new(0,4.2,0))
  roof.Anchored=true; roof.CanCollide=false
  roof.Material=Enum.Material.Slate; roof.Color=Color3.fromRGB(79,83,92)
  roof.Parent=parent
 else
  beam(parent,"Product Package",Vector3.new(2.5,2.2,2),
   pos+Vector3.new(0,2.7,0),color,Enum.Material.Wood)
  beam(parent,"Product Label",Vector3.new(1.9,.9,.08),
   pos+Vector3.new(0,2.9,-1.05),
   Color3.fromRGB(238,222,187),Enum.Material.SmoothPlastic)
 end
end
local function decorateStore(folder,building,category,pos)
 local trim=Color3.fromRGB(218,214,203)
 local metal=Color3.fromRGB(54,65,77)
 -- Floor-level storefront facade: cornice, corner piers, glazing frames.
 for _,x in ipairs({-16.7,16.7}) do
  beam(folder,"Facade Corner Pilaster",Vector3.new(1.3,15,1.5),
   pos+Vector3.new(x,10,-15.8),trim,Enum.Material.Limestone)
  beam(folder,"Facade Base Stone",Vector3.new(2.4,1.5,2),
   pos+Vector3.new(x,3,-15.8),Color3.fromRGB(155,157,157),Enum.Material.Concrete)
 end
 beam(folder,"Architectural Roof Cornice",Vector3.new(40,1.4,35),
  pos+Vector3.new(0,18.3,0),trim,Enum.Material.Limestone)
 beam(folder,"Second Cornice Shadow",Vector3.new(39,.4,34),
  pos+Vector3.new(0,19.2,0),metal,Enum.Material.Metal)
 sign(folder,"Facade Business Sign",Vector3.new(26,3.8,.6),
  pos+Vector3.new(0,15.6,-16.6),metal,building.Name:upper())
 for _,x in ipairs({-12,12}) do
  beam(folder,"Window Mullion",Vector3.new(.35,8,.6),
   pos+Vector3.new(x,8,-16.1),metal,Enum.Material.Metal)
  beam(folder,"Window Transom",Vector3.new(7,.3,.5),
   pos+Vector3.new(x,10,-16.1),metal,Enum.Material.Metal)
  beam(folder,"Window Sill",Vector3.new(8,.5,1.1),
   pos+Vector3.new(x,4,-16),trim,Enum.Material.Concrete)
 end
 -- Open glazed entrance with doors offset to keep center walkable.
 for _,x in ipairs({-2.8,2.8}) do
  local door=beam(folder,"Open Glass Door",Vector3.new(3.4,8,.25),
   pos+Vector3.new(x,7.3,-13.2),
   Color3.fromRGB(137,192,205),Enum.Material.Glass)
  door.Transparency=.5
  door.CFrame=door.CFrame*CFrame.Angles(0,x&lt;0 and -.7 or .7,0)
  cylinder(folder,"Door Pull",Vector3.new(.2,1.4,.2),
   CFrame.new(pos+Vector3.new(x,7.4,-13.8)),
   Color3.fromRGB(207,198,174),Enum.Material.Metal)
 end
 local awningColor=({
  TECH=Color3.fromRGB(67,108,133),
  APPAREL=Color3.fromRGB(147,86,111),
  HOME=Color3.fromRGB(124,122,87),
  VEHICLE=Color3.fromRGB(59,104,116),
  PROPERTY=Color3.fromRGB(120,119,99),
  BUSINESS=Color3.fromRGB(94,119,100)
 })[category]
 beam(folder,"Striped Store Awning",Vector3.new(30,.45,6),
  pos+Vector3.new(0,12.5,-18),awningColor,Enum.Material.Fabric)
 for i=-6,6 do
  if i%2==0 then
   beam(folder,"Awning Stripe",Vector3.new(2,.08,6),
    pos+Vector3.new(i*2.2,12.76,-18),
    Color3.fromRGB(227,220,199),Enum.Material.Fabric)
  end
 end
 -- Shelves and actual recognizable category-specific display props.
 for _,x in ipairs({-10,0,10}) do
  for _,z in ipairs({-2,10}) do
   local shelf=beam(folder,"Display Shelf",Vector3.new(7,.45,4),
    pos+Vector3.new(x,4.2,z),Color3.fromRGB(121,98,78),Enum.Material.WoodPlanks)
   shelf.CanCollide=true
   product(folder,category,math.floor(x+z),pos+Vector3.new(x,2.6,z))
  end
 end
 for _,x in ipairs({-12,12}) do
  light(folder,"Recessed Ceiling Light",pos+Vector3.new(x,16.2,4),
   Color3.fromRGB(255,232,201),16)
 end
 beam(folder,"Concrete Sidewalk",Vector3.new(39,.55,14),
  pos+Vector3.new(0,2.2,-24),Color3.fromRGB(173,175,169),Enum.Material.Concrete).CanCollide=true
end
local function decorateJobTask(folder,target)
 local job=target:GetAttribute("Job")
 local step=target:GetAttribute("Step")
 local pos=target.Position
 local m=Instance.new("Model")
 m.Name="Workplace Props "..job.." "..step
 m.Parent=folder
 local function box(name,size,offset,color,material)
  return beam(m,name,size,pos+offset,color,material)
 end
 local function tube(name,size,offset,color)
  return cylinder(m,name,size,CFrame.new(pos+offset),color,Enum.Material.Metal)
 end
 if job=="FIREFIGHTER" then
  if step==2 then
   local flame=box("Training Fire",Vector3.new(3,3,2),
    Vector3.new(0,3,0),Color3.fromRGB(232,99,43),Enum.Material.Neon)
   local fire=Instance.new("Fire"); fire.Heat=4; fire.Size=5; fire.Parent=flame
  else
   tube("Fire Hose Reel",Vector3.new(1.3,4,4),
    Vector3.new(0,2.6,0),Color3.fromRGB(181,55,48))
  end
 elseif job=="PARAMEDIC" or job=="VETERINARIAN" then
  box("Medical Examination Bed",Vector3.new(7,1,3.5),
   Vector3.new(0,3.1,0),Color3.fromRGB(229,235,228),Enum.Material.Fabric)
  box("Medical Cabinet",Vector3.new(2,3,1),
   Vector3.new(-3,3,0),Color3.fromRGB(152,179,177),Enum.Material.Metal)
 elseif job=="BARISTA" or job=="CHEF" then
  box("Kitchen Worktop",Vector3.new(7,.5,3),
   Vector3.new(0,3.1,0),Color3.fromRGB(189,193,188),Enum.Material.Marble)
  for x=-2,2,2 do
   tube("Kitchen Cup or Pot",Vector3.new(1.2,1.2,1.2),
    Vector3.new(x,4,0),Color3.fromRGB(221,225,217))
  end
 elseif job=="MECHANIC" then
  box("Vehicle Engine Block",Vector3.new(5,2,3),
   Vector3.new(0,3.2,0),Color3.fromRGB(76,88,98),Enum.Material.Metal)
  for x=-1,1 do
   tube("Engine Piston",Vector3.new(1,1.6,1.6),
    Vector3.new(x*1.3,4.6,0),Color3.fromRGB(144,153,157))
  end
 elseif job=="POLICE" then
  box("Police Dispatch Terminal",Vector3.new(3.2,2.3,.3),
   Vector3.new(0,4.3,0),Color3.fromRGB(44,77,111),Enum.Material.Glass)
 elseif job=="CONSTRUCTION" then
  for x=-2,2,2 do
   box("Stacked Bricks",Vector3.new(2,1.3,3),
    Vector3.new(x,3.3,0),Color3.fromRGB(164,112,85),Enum.Material.Brick)
  end
 elseif job=="FARMER" then
  for x=-2,2,2 do
   sphere(m,"Produce Harvest",Vector3.new(1.7,1.7,1.7),
    CFrame.new(pos+Vector3.new(x,3.2,0)),
    Color3.fromRGB(122,174,65),Enum.Material.Grass)
  end
 elseif job=="SANITATION" then
  for x=-2,2,2 do
   tube("Recycling Bin",Vector3.new(2.1,3,2.1),
    Vector3.new(x,3.1,0),Color3.fromRGB(74,146,110))
  end
 elseif job=="ELECTRICIAN" then
  box("Electrical Breaker Panel",Vector3.new(4,4,.8),
   Vector3.new(0,4.1,0),Color3.fromRGB(143,151,151),Enum.Material.Metal)
  for x=-1,1 do
   box("Circuit Breaker",Vector3.new(.6,.6,.2),
    Vector3.new(x,4.3,-.5),Color3.fromRGB(55,62,66),Enum.Material.Metal)
  end
 elseif job=="PLUMBER" then
  for x=-2,2,2 do
   tube("Pipe Fitting",Vector3.new(1.4,3,1.4),
    Vector3.new(x,3.5,0),Color3.fromRGB(169,172,173))
  end
 elseif job=="PHOTOGRAPHER" or job=="CREATOR" then
  box("Camera on Tripod",Vector3.new(2,1.4,1.2),
   Vector3.new(0,5,0),Color3.fromRGB(39,45,56),Enum.Material.Metal)
  for x=-2,2,2 do
   tube("Studio Tripod",Vector3.new(.25,4,.25),
    Vector3.new(x,3,0),Color3.fromRGB(80,86,90))
  end
 elseif job=="PILOT" then
  box("Flight Simulator Console",Vector3.new(6,2.5,2),
   Vector3.new(0,3.8,0),Color3.fromRGB(46,66,88),Enum.Material.Metal)
  box("Cockpit Display",Vector3.new(4,1.6,.15),
   Vector3.new(0,4.3,-1.1),Color3.fromRGB(56,145,184),Enum.Material.Glass)
 elseif job=="MUSICIAN" then
  box("Performance Speaker",Vector3.new(3,4,2),
   Vector3.new(0,4,0),Color3.fromRGB(49,51,60),Enum.Material.Metal)
  for y=-1,1,2 do
   cylinder(m,"Speaker Cone",Vector3.new(.3,1.2,1.2),
    CFrame.new(pos+Vector3.new(0,4+y,-1.1))*CFrame.Angles(0,0,math.pi/2),
    Color3.fromRGB(101,105,112),Enum.Material.Rubber)
  end
 elseif job=="TEACHER" then
  box("Classroom Whiteboard",Vector3.new(6,3,.2),
   Vector3.new(0,5,0),Color3.fromRGB(234,234,224),Enum.Material.SmoothPlastic)
 elseif job=="REAL_ESTATE_AGENT" then
  box("Home Staging Display",Vector3.new(5,2.5,3),
   Vector3.new(0,4,0),Color3.fromRGB(193,168,132),Enum.Material.Wood)
 else
  box("Workplace Parcel",Vector3.new(3,2,3),
   Vector3.new(0,3,0),Color3.fromRGB(164,130,96),Enum.Material.Wood)
 end
end
function Detail.Build(world)
 local folder=Instance.new("Folder"); folder.Name="Life City Architectural Details"
 folder.Parent=world
 local stores={
  {"TECH","Creator Technology Store",-112,-65},
  {"APPAREL","Clothing Boutique",-62,-65},
  {"HOME","Home Supply Store",-12,-65},
  {"VEHICLE","Vehicle and Marine Dealer",38,-65},
  {"PROPERTY","Real Estate Agency",88,-65},
  {"BUSINESS","Business Licensing Office",138,-65},
 }
 for _,row in ipairs(stores) do
  local category,name,x,z=unpack(row)
  local building=world:FindFirstChild(name,true)
  if building then
   decorateStore(folder,building,category,center+Vector3.new(x,0,z))
  end
 end
 -- City block landscaping and street furniture with actual collision where needed.
 for i,x in ipairs({-148,-100,-52,-4,44,92,148}) do
  local z=1538
  tree(folder,center+Vector3.new(x,3,z),i)
 end
 for _,x in ipairs({-135,-35,65,145}) do
  lampPost(folder,center+Vector3.new(x,3,17))
 end
 for _,x in ipairs({-135,-15,100}) do
  bench(folder,center+Vector3.new(x,3,-22))
 end
 for _,x in ipairs({-145,15,145}) do
  planter(folder,center+Vector3.new(x,3,36))
 end
 -- Pavement crossings, stop lines, sidewalk curb cuts and parking stalls.
 for _,x in ipairs({-90,90}) do
  for z=-10,10,4 do
   beam(folder,"Zebra Crossing Paint",Vector3.new(3,.09,2.5),
    center+Vector3.new(x,3.05,z),Color3.fromRGB(238,234,219))
  end
 end
 for i=-6,6 do
  local x=i*22
  beam(folder,"Parking Space Line",Vector3.new(.25,.1,16),
   center+Vector3.new(x,3.1,40),Color3.fromRGB(237,232,205))
 end
 for _,z in ipairs({-12,12}) do
  beam(folder,"Raised Sidewalk Curb",Vector3.new(328,.7,1),
   center+Vector3.new(0,3,z),Color3.fromRGB(184,185,181),Enum.Material.Concrete)
 end
 -- Career workstations show props for their particular profession, not bare buttons.
 for _,node in ipairs(world:GetDescendants()) do
  if node:IsA("BasePart") and node:GetAttribute("Job") and
   node:GetAttribute("Step") then
   decorateJobTask(folder,node)
  end
 end
 -- Public garden and pedestrian plaza for the job and home district.
 for _,x in ipairs({-150,-75,0,75,150}) do
  for _,z in ipairs({90,205}) do
   tree(folder,center+Vector3.new(x,3,z),math.floor(x+z))
  end
 end
 -- Curved architectural shapes using cylinders, spheres and wedge roofs.
 local plaza=beam(folder,"Employment Plaza",Vector3.new(90,.4,42),
  center+Vector3.new(-95,2.9,67),
  Color3.fromRGB(174,170,157),Enum.Material.Cobblestone)
 plaza.CanCollide=true
 local fountain=cylinder(folder,"Public Fountain Basin",Vector3.new(13,1.4,13),
  CFrame.new(center+Vector3.new(-30,3.8,105)),
  Color3.fromRGB(153,166,172),Enum.Material.Concrete)
 fountain.CanCollide=true
 cylinder(folder,"Fountain Pool",Vector3.new(11,.3,11),
  CFrame.new(center+Vector3.new(-30,4.65,105)),
  Color3.fromRGB(85,172,204),Enum.Material.Glass)
 local plume=part(folder,"Fountain Water Jet",Vector3.new(.9,7,.9),
  CFrame.new(center+Vector3.new(-30,8,105)),
  Color3.fromRGB(144,220,243),Enum.Material.Glass,false)
 plume.Transparency=.45
 local particles=Instance.new("ParticleEmitter")
 particles.Texture="rbxasset://textures/particles/sparkles_main.dds"
 particles.Rate=7; particles.Lifetime=NumberRange.new(.7,1.2)
 particles.Speed=NumberRange.new(2,5); particles.SpreadAngle=Vector2.new(15,15)
 particles.Parent=plume
 return folder
end
return Detail
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">LifeSimulation</string>
        <string name="Source">-- v0.6 LIFE CITY: in-game-only jobs, shops, creator career and law enforcement.
-- Server validates career, level, currency, ownership, cooldowns and proximity.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Terrain=workspace.Terrain
local Catalog=require(game:GetService("ReplicatedStorage"):WaitForChild("LifeCatalog"))
local Garden=require(script.Parent:WaitForChild("UrbanGardening"))
local Home=require(script.Parent:WaitForChild("HomeLiving"))
local Life={}
local context,world,folder
local stores={}
local workSites={}
local careerSites={}
local taskSites={}
-- v0.9: alternate interaction anchors embedded around the imported detailed
-- Modern Downtown. The original Life City remains fully functional.
local downtownStores={}
local downtownWorkSites={}
local downtownCareerSites={}
local downtownTaskSites={}
local downtownFineCounter=nil
local downtownFoodCounter=nil
local downtownRestCounter=nil
local policeUnits={}
local lastAction={}
local fineCounter=nil
local foodCounter=nil
local restCounter=nil
local publicMealCooldown={}
local propertySlots={}
local playerSlots={}
local playerProperties={}
local propertyBases={}
for row=0,1 do
 for col=0,5 do
  table.insert(propertyBases,Vector3.new(-155+col*62,0,2750+row*70))
 end
end
local jailCenter=Vector3.new(126,7,1655)
local townCenter=Vector3.new(0,0,1600)
local function part(parent,name,size,pos,color,material,collide)
 local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=pos
 p.Anchored=true; p.CanCollide=collide==true; p.CanTouch=false
 p.Material=material or Enum.Material.SmoothPlastic
 p.Color=color; p.Parent=parent
 return p
end
local function textSign(parent,name,position,color)
 local anchor=part(parent,"Store Sign Anchor",Vector3.one,position,color,nil,false)
 anchor.Transparency=1
 local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(260,55)
 gui.MaxDistance=160; gui.AlwaysOnTop=true; gui.Parent=anchor
 local t=Instance.new("TextLabel"); t.Size=UDim2.fromScale(1,1)
 t.BackgroundTransparency=1; t.Text=name; t.TextScaled=true
 t.TextColor3=color; t.TextStrokeTransparency=.2
 t.Font=Enum.Font.GothamBlack; t.Parent=gui
end
local function prompt(node,actionText,objectText,callback)
 local p=Instance.new("ProximityPrompt")
 p.ActionText=actionText; p.ObjectText=objectText
 p.MaxActivationDistance=13; p.HoldDuration=.5
 p.RequiresLineOfSight=false; p.Parent=node
 p.Triggered:Connect(callback)
end
local function root(player)
 return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end
local function nearby(player,anchor,distance)
 local r=root(player)
 return r and anchor and (r.Position-anchor.Position).Magnitude&lt;=(distance or 20)
end
local function nearbyEither(player,a,b,distance)
 return nearby(player,a,distance) or nearby(player,b,distance)
end
local function profile(player)
 return context and context.getProfile(player)
end
local function tell(player,msg) context.tell(player,msg) end
function Life.Normalize(value)
 value=type(value)=="table" and value or {}
 return {
  career=Catalog.SanitizeCareer(value.career),
  owned=Catalog.SanitizeOwned(value.owned),
  garden=Garden.Normalize(value.garden),
  homeLocked=value.homeLocked~=false,
  selectedCar=type(value.selectedCar)=="string" and
   Catalog.CarChoices[value.selectedCar] and
   type(value.owned)=="table" and value.owned[value.selectedCar]==true and
   value.selectedCar or "",
  followers=math.clamp(math.floor(tonumber(value.followers) or 0),0,10000000),
  uploads=math.clamp(math.floor(tonumber(value.uploads) or 0),0,1000000),
  shifts=math.clamp(math.floor(tonumber(value.shifts) or 0),0,1000000),
  reputation=math.clamp(math.floor(tonumber(value.reputation) or 0),0,1000000),
  fines=math.clamp(math.floor(tonumber(value.fines) or 0),0,1000000),
  arrests=math.clamp(math.floor(tonumber(value.arrests) or 0),0,100000),
  needs={
   hunger=math.clamp(math.floor(tonumber(type(value.needs)=="table" and value.needs.hunger) or 100),0,100),
   energy=math.clamp(math.floor(tonumber(type(value.needs)=="table" and value.needs.energy) or 100),0,100),
   hygiene=math.clamp(math.floor(tonumber(type(value.needs)=="table" and value.needs.hygiene) or 100),0,100),
   fun=math.clamp(math.floor(tonumber(type(value.needs)=="table" and value.needs.fun) or 100),0,100),
  },
  lastWork=0,lastPost=0,lastBusiness=0,lastHome=-100,
  jailUntil=0,activeShift=nil,
 }
end
function Life.Serialize(value)
 local s=Life.Normalize(value)
 return {career=s.career,owned=s.owned,followers=s.followers,
  uploads=s.uploads,shifts=s.shifts,reputation=s.reputation,
  fines=s.fines,arrests=s.arrests,needs=s.needs,garden=s.garden,
  homeLocked=s.homeLocked,selectedCar=s.selectedCar}
end
function Life.Sync(player)
 local s=profile(player)
 if not s or not s.life then return end
 local life=s.life
 player:SetAttribute("RRLifeCareer",life.career)
 player:SetAttribute("RRLifeHomeLocked",life.homeLocked)
 player:SetAttribute("RRLifeHomePlot",
  playerProperties[player] and playerSlots[player] or 0)
 player:SetAttribute("RRLifeSelectedCar",life.selectedCar)
 player:SetAttribute("RRLifeFun",life.needs.fun)
 Garden.SyncPlayer(player,life.garden)
 player:SetAttribute("RRLifeHunger",life.needs.hunger)
 player:SetAttribute("RRLifeEnergy",life.needs.energy)
 player:SetAttribute("RRLifeHygiene",life.needs.hygiene)
 player:SetAttribute("RRLifeFollowers",life.followers)
 player:SetAttribute("RRLifeUploads",life.uploads)
 player:SetAttribute("RRLifeShifts",life.shifts)
 player:SetAttribute("RRLifeReputation",life.reputation)
 player:SetAttribute("RRLifeFines",life.fines)
 player:SetAttribute("RRLifeArrests",life.arrests)
 player:SetAttribute("RRLifeJailed",os.clock()&lt;life.jailUntil)
 player:SetAttribute("RRLifeJailRemaining",
  math.max(0,math.ceil(life.jailUntil-os.clock())))
 for _,item in ipairs(Catalog.Items) do
  player:SetAttribute("RRLifeOwn_"..item.id,life.owned[item.id]==true)
 end
 local shift=life.activeShift
 player:SetAttribute("RRLifeShift",shift and shift.id or "")
 player:SetAttribute("RRLifeTaskStep",shift and shift.progress or 0)
 local nextTarget=shift and taskSites[shift.id] and taskSites[shift.id][shift.progress+1]
 player:SetAttribute("RRLifeTaskName",nextTarget and
  nextTarget:GetAttribute("TaskLabel") or
  (shift and "RETURN TO YOUR WORKPLACE FOR WAGES" or ""))
 player:SetAttribute("RRLifeCarTier",
  life.owned.SPORTS_CAR and "SPORTS" or
  life.owned.SEDAN and "SEDAN" or "STARTER")
end
local function venue(parent,name,pos,shade)
 local building=Instance.new("Model"); building.Name=name
 building.Parent=parent
 local floor=part(building,"Floor",Vector3.new(36,1,32),
  pos+Vector3.new(0,2,0),Color3.fromRGB(135,137,139),Enum.Material.Concrete,true)
 part(building,"Back Wall",Vector3.new(36,14,1),
  pos+Vector3.new(0,9,15),shade,Enum.Material.Brick,true)
 for _,x in ipairs({-17.5,17.5}) do
  part(building,"Side Wall",Vector3.new(1,14,32),
   pos+Vector3.new(x,9,0),shade,Enum.Material.Brick,true)
 end
 for _,x in ipairs({-11,11}) do
  part(building,"Front Wall",Vector3.new(14,14,1),
   pos+Vector3.new(x,9,-15),shade,Enum.Material.Brick,true)
 end
 part(building,"Door Frame",Vector3.new(7,3,1),
  pos+Vector3.new(0,15,-15),Color3.fromRGB(63,76,91),Enum.Material.Metal,true)
 part(building,"Roof",Vector3.new(38,1.8,34),
  pos+Vector3.new(0,17,0),Color3.fromRGB(43,53,70),Enum.Material.Slate,true)
 for _,x in ipairs({-12,12}) do
  local glass=part(building,"Shopfront Glass",Vector3.new(7,7,.3),
   pos+Vector3.new(x,8,-15.6),Color3.fromRGB(157,206,228),Enum.Material.Glass,false)
  glass.Transparency=.35
 end
 local counter=part(building,"Shop Counter",Vector3.new(13,3,3),
  pos+Vector3.new(0,4,6),Color3.fromRGB(118,95,74),Enum.Material.Wood,true)
 textSign(building,name,pos+Vector3.new(0,22,-17),Color3.fromRGB(245,229,183))
 return counter
end
local function officer(parent,id,start)
 local m=Instance.new("Model"); m.Name="AI Police Officer "..id; m.Parent=parent
 m:SetAttribute("Behavior","Patrol")
 local torso=part(m,"Police Uniform",Vector3.new(2.4,3.2,1.5),
  start,Color3.fromRGB(32,51,92),Enum.Material.Fabric,false)
 m.PrimaryPart=torso
 part(m,"Head",Vector3.new(1.6,1.6,1.6),start+Vector3.new(0,2.4,0),
  Color3.fromRGB(191,144,110),Enum.Material.SmoothPlastic,false).Shape=Enum.PartType.Ball
 part(m,"Police Cap",Vector3.new(2,.45,2),start+Vector3.new(0,3.3,0),
  Color3.fromRGB(23,32,59),Enum.Material.Fabric,false)
 for _,x in ipairs({-1.5,1.5}) do
  part(m,"Arm",Vector3.new(.7,2.7,.9),start+Vector3.new(x,-.1,0),
   Color3.fromRGB(35,53,91),Enum.Material.Fabric,false)
 end
 for _,x in ipairs({-.6,.6}) do
  part(m,"Leg",Vector3.new(.9,2.6,1),start+Vector3.new(x,-2.9,0),
   Color3.fromRGB(35,40,51),Enum.Material.Fabric,false)
 end
 local city=start.Z&gt;1500
 local route=city and {
  start,start+Vector3.new(-26,0,-8),start+Vector3.new(-40,0,24),
  start+Vector3.new(5,0,33)
 } or {
  start,start+Vector3.new(22,0,0),start+Vector3.new(22,0,18),
  start+Vector3.new(0,0,18)
 }
 table.insert(policeUnits,{model=m,home=start,position=start,target=nil,
  started=0,route=route,routeIndex=2})
end
function Life.Build(targetWorld,options)
 context=options; world=targetWorld
 folder=Instance.new("Folder"); folder.Name="Life City Simulation"; folder.Parent=world
 Terrain:FillBlock(CFrame.new(townCenter+Vector3.new(0,-4,0)),
  Vector3.new(350,12,580),Enum.Material.Grass)
 textSign(folder,"LIFE CITY • BUILD YOUR STORY",
  townCenter+Vector3.new(0,22,-8),Color3.fromRGB(251,226,162))
 textSign(folder,"JOBS • STORES • HOMES • CREATOR STUDIO • POLICE",
  townCenter+Vector3.new(0,16,-8),Color3.fromRGB(167,224,228))
 part(folder,"Life City Boulevard",Vector3.new(320,.8,20),
  townCenter+Vector3.new(0,2.5,0),Color3.fromRGB(59,63,69),Enum.Material.Asphalt,true)
 for i=-8,8 do
  part(folder,"Boulevard Lane Marking",Vector3.new(9,.08,.6),
   townCenter+Vector3.new(i*18,3,0),Color3.fromRGB(239,218,128),
   Enum.Material.SmoothPlastic,false)
 end
 local entries={
  {"TECH","Creator Technology Store",-112,-65,Color3.fromRGB(86,127,163)},
  {"APPAREL","Clothing Boutique",-62,-65,Color3.fromRGB(150,107,157)},
  {"HOME","Home Supply Store",-12,-65,Color3.fromRGB(140,127,104)},
  {"VEHICLE","Vehicle and Marine Dealer",38,-65,Color3.fromRGB(88,137,143)},
  {"PROPERTY","Real Estate Agency",88,-65,Color3.fromRGB(122,139,103)},
  {"BUSINESS","Business Licensing Office",138,-65,Color3.fromRGB(157,127,89)},
  {"GARDEN","City Garden &amp; Nursery",-145,-115,Color3.fromRGB(76,143,84)},
 }
 for _,entry in ipairs(entries) do
  local category,name,x,z,color=unpack(entry)
  local counter=venue(folder,name,townCenter+Vector3.new(x,0,z),color)
  stores[category]=counter
  prompt(counter,"BROWSE","Shop: "..name,function(player)
   tell(player,"OPEN LIFE SHOP • "..name.." • WALK NEAR THE COUNTER TO BUY")
  end)
 end
 -- Dedicated owner neighborhood, separate from job stations and downtown.
 Terrain:FillBlock(CFrame.new(0,-4,2785),
  Vector3.new(430,12,230),Enum.Material.Grass)
 local neighborhood=Instance.new("Folder")
 neighborhood.Name="Residential Estates Neighborhood"
 neighborhood.Parent=folder
 for _,z in ipairs({2711,2781}) do
  part(neighborhood,"Residential Asphalt Road",Vector3.new(420,.65,14),
   Vector3.new(0,2.4,z),Color3.fromRGB(59,63,68),
   Enum.Material.Asphalt,true)
  for x=-196,196,28 do
   part(neighborhood,"Neighborhood Street Lane",Vector3.new(11,.1,.45),
    Vector3.new(x,2.8,z),Color3.fromRGB(233,215,149),
    Enum.Material.Concrete,false)
  end
 end
 for i,location in ipairs(propertyBases) do
  part(neighborhood,"Home Plot "..i,Vector3.new(46,.5,51),
   location+Vector3.new(0,2.4,0),Color3.fromRGB(88,124,82),
   Enum.Material.Grass,true)
  local sign=part(neighborhood,"Property Lot Plaque "..i,Vector3.new(5,3,.4),
   location+Vector3.new(-20,5,-19),
   Color3.fromRGB(99,94,81),Enum.Material.Wood,true)
  sign:SetAttribute("LotNumber",i)
 end
 textSign(neighborhood,"RESIDENTIAL ESTATES • OWNED HOMES",
  Vector3.new(0,20,2688),Color3.fromRGB(226,232,202))
 local license=stores.BUSINESS
 prompt(license,"COLLECT REVENUE","Owned Business Earnings",function(player)
  Life.Process(player,"BusinessCollect")
 end)
 local careerCounter=venue(folder,"Career and Employment Center",
  townCenter+Vector3.new(-95,0,67),Color3.fromRGB(88,128,117))
 for i,career in ipairs(Catalog.Careers) do
  local row=math.floor((i-1)/7)
  local col=(i-1)%7
  local board=part(folder,"Career Board "..career.id,Vector3.new(4.6,4.6,1),
   careerCounter.Position+Vector3.new((col-3)*5.3,4,-12+row*8),
   Color3.fromRGB(57,83,115),Enum.Material.Metal,false)
  careerSites[career.id]=board
  prompt(board,"APPLY",career.name.." • Level "..career.level,function(player)
   Life.Process(player,"Career",career.id)
  end)
 end
 local sites={
  {"RETAIL","Retail Register",-62,69,Color3.fromRGB(110,169,133)},
  {"COURIER","Courier Dispatch",-30,69,Color3.fromRGB(118,148,181)},
  {"BARISTA","Cafe Counter",5,69,Color3.fromRGB(158,112,82)},
  {"MECHANIC","Repair Bay",42,69,Color3.fromRGB(119,133,150)},
  {"CONSTRUCTION","Construction Site",79,69,Color3.fromRGB(172,143,81)},
  {"POLICE","Police Patrol Desk",115,69,Color3.fromRGB(62,91,156)},
  {"CREATOR","Media Recording Studio",-8,24,Color3.fromRGB(145,95,160)},
  {"PARAMEDIC","Ambulance Medical Response",-123,135,Color3.fromRGB(232,228,220)},
  {"FIREFIGHTER","Fire and Rescue Station",-84,135,Color3.fromRGB(175,59,55)},
  {"CHEF","Restaurant Kitchen",-45,135,Color3.fromRGB(191,124,64)},
  {"FARMER","Greenhouse Farming",-6,135,Color3.fromRGB(88,154,91)},
  {"TEACHER","Community Classroom",33,135,Color3.fromRGB(122,145,184)},
  {"SANITATION","Recycling Depot",72,135,Color3.fromRGB(85,150,133)},
  {"ELECTRICIAN","Electrical Workshop",111,135,Color3.fromRGB(224,170,72)},
  {"PLUMBER","Plumbing Workshop",-123,184,Color3.fromRGB(93,153,197)},
  {"VETERINARIAN","Veterinary Clinic",-84,184,Color3.fromRGB(134,181,152)},
  {"REAL_ESTATE_AGENT","Property Sales Office",-45,184,Color3.fromRGB(166,143,111)},
  {"PHOTOGRAPHER","Photo Studio",-6,184,Color3.fromRGB(166,117,174)},
  {"PILOT","Flight Training Academy",33,184,Color3.fromRGB(91,133,174)},
  {"MUSICIAN","Recording and Rehearsal",72,184,Color3.fromRGB(179,99,141)},
 }
 local added=0
 for _,career in ipairs(Catalog.Careers) do
  if Catalog.CareerTasks[career.id] then
   added+=1
   local col=(added-1)%10
   local row=math.floor((added-1)/10)
   table.insert(sites,{career.id,career.name.." Workstation",
    -146+col*32,232+row*38,Color3.fromRGB(96,128,143)})
  end
 end
 Terrain:FillBlock(CFrame.new(townCenter+Vector3.new(0,-4,315)),
  Vector3.new(340,12,360),Enum.Material.Grass)
 for _,entry in ipairs(sites) do
  local id,name,x,z,color=unpack(entry)
  local node=part(folder,name,Vector3.new(8,5,5),
   townCenter+Vector3.new(x,5,z),color,Enum.Material.Metal,true)
  node:SetAttribute("CareerSite",id)
  workSites[id]=node
  prompt(node,id=="CREATOR" and "RECORD VIDEO" or "WORK SHIFT",name,
   function(player) Life.Process(player,id=="CREATOR" and "Publish" or "Work",id) end)
  textSign(folder,name,node.Position+Vector3.new(0,9,0),color)
  if id~="CREATOR" then
   local steps={
    RETAIL={"SCAN CUSTOMER ITEMS","STOCK DISPLAY SHELF"},
    COURIER={"PICK UP PARCEL","DELIVER TO CUSTOMER"},
    BARISTA={"PREPARE COFFEE ORDER","SERVE CUSTOMER"},
    MECHANIC={"INSPECT ENGINE","REPLACE WORN PART"},
    CONSTRUCTION={"MEASURE BUILD SITE","INSTALL BUILDING MATERIAL"},
    POLICE={"CHECK INCIDENT REPORT","INTERVIEW WITNESS"},
    PARAMEDIC={"CHECK PATIENT VITALS","APPLY FIRST AID"},
    FIREFIGHTER={"CHECK FIRE HOSE","EXTINGUISH TRAINING FIRE"},
    CHEF={"PREPARE INGREDIENTS","PLATE THE MEAL"},
    FARMER={"PLANT SEEDLINGS","HARVEST CROPS"},
    TEACHER={"PREPARE LESSON","TEACH CLASS"},
    SANITATION={"COLLECT RECYCLABLES","SORT WASTE"},
    ELECTRICIAN={"INSPECT CIRCUIT","RESTORE POWER"},
    PLUMBER={"INSPECT LEAK","REPAIR PIPE"},
    VETERINARIAN={"EXAMINE PET","ADMINISTER CARE"},
    REAL_ESTATE_AGENT={"STAGE PROPERTY","SHOW HOME TO CLIENT"},
    PHOTOGRAPHER={"SET UP LIGHTS","TAKE PORTRAIT"},
    PILOT={"RUN PRE-FLIGHT CHECK","CONFIRM LANDING PROCEDURE"},
    MUSICIAN={"TUNE INSTRUMENT","PERFORM ON STAGE"},
   }
   local actions=steps[id] or Catalog.CareerTasks[id]
   taskSites[id]={}
   for step=1,2 do
    local pos=node.Position+Vector3.new(step==1 and -12 or 12,-.4,9)
    local target=part(folder,"Job Task "..id.." "..step,
     Vector3.new(6,3,4),pos,
     step==1 and Color3.fromRGB(116,169,190) or
     Color3.fromRGB(184,141,94),Enum.Material.Metal,true)
    target:SetAttribute("Job",id); target:SetAttribute("Step",step)
    target:SetAttribute("TaskLabel",actions[step])
    taskSites[id][step]=target
    textSign(folder,actions[step],pos+Vector3.new(0,6,0),
     Color3.fromRGB(255,240,187))
    prompt(target,actions[step],name,function(player)
     Life.Process(player,"Task",id,step)
    end)
   end
  end
 end
 local jail=Instance.new("Model"); jail.Name="Life City Jail"; jail.Parent=folder
 part(jail,"Jail Floor",Vector3.new(38,1,38),
  jailCenter-Vector3.new(0,4,0),Color3.fromRGB(100,109,119),Enum.Material.Concrete,true)
 for _,z in ipairs({-19,19}) do
  part(jail,"Jail Wall",Vector3.new(38,16,1),
   jailCenter+Vector3.new(0,3,z),Color3.fromRGB(98,111,127),Enum.Material.Concrete,true)
 end
 for _,x in ipairs({-19,19}) do
  part(jail,"Jail Wall",Vector3.new(1,16,38),
   jailCenter+Vector3.new(x,3,0),Color3.fromRGB(98,111,127),Enum.Material.Concrete,true)
 end
 for i=-3,3 do
  part(jail,"Cell Bars",Vector3.new(.55,12,.55),
   jailCenter+Vector3.new(i*3,3,-17.8),Color3.fromRGB(57,65,78),Enum.Material.Metal,true)
 end
 textSign(jail,"POLICE • JAIL • FINES",jailCenter+Vector3.new(0,17,0),
  Color3.fromRGB(254,188,126))
 local fines=part(folder,"Fine Payment Counter",Vector3.new(6,4,4),
  townCenter+Vector3.new(125,5,26),Color3.fromRGB(109,144,179),Enum.Material.Metal,true)
 fineCounter=fines
 prompt(fines,"PAY FINE","Life City Court",function(player)
  Life.Process(player,"PayFine")
 end)
 local meal=part(folder,"Community Meal Station",Vector3.new(8,4,5),
  townCenter+Vector3.new(-50,5,114),
  Color3.fromRGB(156,126,88),Enum.Material.Wood,true)
 foodCounter=meal
 textSign(folder,"COMMUNITY KITCHEN • MEALS",
  meal.Position+Vector3.new(0,8,0),Color3.fromRGB(241,223,176))
 prompt(meal,"EAT MEAL","Community Kitchen",function(player)
  Life.Process(player,"Eat","COMMUNITY")
 end)
 local bench=part(folder,"Public Rest Bench",Vector3.new(9,2,4),
  townCenter+Vector3.new(20,4,115),
  Color3.fromRGB(121,95,74),Enum.Material.Wood,true)
 restCounter=bench
 prompt(bench,"REST","Public Park Bench",function(player)
  Life.Process(player,"Rest","PUBLIC")
 end)
 policeUnits={}
 officer(folder,1,Vector3.new(180,7,18))
 officer(folder,2,townCenter+Vector3.new(113,7,23))
 return townCenter+Vector3.new(0,7,0)
end
-- Connect the life simulation to the imported official Modern City art.
-- These are intentionally tiny/invisible interaction anchors around real mesh
-- buildings; we do not build another fake city out of primitive cubes.
function Life.AttachDowntown(cityModel)
 if not folder or not cityModel or not cityModel.Parent then return false end
 local old=folder:FindFirstChild("Modern Downtown Life Services")
 if old then old:Destroy() end
 local services=Instance.new("Folder")
 services.Name="Modern Downtown Life Services"
 services.Parent=folder
 local function anchor(name,pos,visible)
  local node=part(services,name,Vector3.new(4.5,3,.5),pos,
   Color3.fromRGB(37,47,56),Enum.Material.Metal,false)
  node.Transparency=visible and .08 or 1
  node.CanQuery=true
  return node
 end
 local function plaque(name,pos,title,subtitle,color)
  local node=anchor(name,pos,true)
  node.Size=Vector3.new(7,4,.45)
  node.Color=color or Color3.fromRGB(39,54,64)
  local gui=Instance.new("SurfaceGui")
  gui.Name="Downtown Business Sign"
  gui.Face=Enum.NormalId.Front
  gui.CanvasSize=Vector2.new(700,400)
  gui.LightInfluence=.25
  gui.Parent=node
  local main=Instance.new("TextLabel")
  main.Size=UDim2.new(.94,0,.55,0); main.Position=UDim2.new(.03,0,.04,0)
  main.BackgroundTransparency=1; main.Text=title; main.TextWrapped=true
  main.TextScaled=true; main.Font=Enum.Font.GothamBold
  main.TextColor3=Color3.fromRGB(244,237,213); main.Parent=gui
  local sub=Instance.new("TextLabel")
  sub.Size=UDim2.new(.94,0,.27,0); sub.Position=UDim2.new(.03,0,.66,0)
  sub.BackgroundTransparency=1; sub.Text=subtitle; sub.TextWrapped=true
  sub.TextScaled=true; sub.Font=Enum.Font.Gotham
  sub.TextColor3=Color3.fromRGB(151,208,220); sub.Parent=gui
  return node
 end
 -- One clean employment office replaces 20 giant floating career boards.
 local employment=plaque("Downtown Employment Center",Vector3.new(-73,5,2247),
  "CITY EMPLOYMENT","60 CAREERS • APPLY IN LIFE MENU",Color3.fromRGB(47,78,82))
 prompt(employment,"BROWSE JOBS","Downtown Employment Center",function(player)
  tell(player,"OPEN LIFE • CHOOSE ANY CAREER YOU QUALIFY FOR • APPLY HERE")
 end)
 for _,career in ipairs(Catalog.Careers) do downtownCareerSites[career.id]=employment end
 -- Real storefront row. Shopping stays server-validated and paid with earned coins.
 local storefronts={
  {"APPAREL",-50,"THREADS","CLOTHING &amp; FOOTWEAR"},
  {"TECH",-28,"CITY TECH","PHONES • COMPUTERS • CREATOR GEAR"},
  {"HOME",-6,"HOME &amp; MORE","FURNITURE • TOOLS • GROCERIES"},
  {"VEHICLE",18,"MOTOR ROW","CARS • BIKES • BOATS"},
  {"PROPERTY",42,"METRO REALTY","APARTMENTS • HOMES • LAND"},
  {"BUSINESS",68,"CITY COMMERCE","BUY &amp; RUN BUSINESSES"},
  {"GARDEN",77,"GARDEN NURSERY","SEEDS • TOOLS • LANDSCAPING"},
 }
 for _,entry in ipairs(storefronts) do
  local category,x,title,subtitle=unpack(entry)
  local node=plaque("Downtown Store "..category,
   Vector3.new(x,5,category=="GARDEN" and 2185 or 2247),
   title,subtitle,Color3.fromRGB(50,61,72))
  downtownStores[category]=node
  prompt(node,"SHOP",title,function(player)
   tell(player,"OPEN LIFE SHOP • "..title.." • PURCHASES USE EARNED IN-GAME COINS")
  end)
 end
 prompt(downtownStores.BUSINESS,"COLLECT REVENUE","Your Downtown Businesses",function(player)
  Life.Process(player,"BusinessCollect")
 end)
 -- Workplaces are spread around the actual imported city block. Invisible
 -- anchors preserve the official mesh art; prompts identify the real activity.
 local jobPositions={
  RETAIL=Vector3.new(-72,3,2263), BARISTA=Vector3.new(-36,3,2263),
  CREATOR=Vector3.new(0,3,2263), COURIER=Vector3.new(36,3,2263),
  MECHANIC=Vector3.new(72,3,2263),
  PARAMEDIC=Vector3.new(-100,3,2300), FIREFIGHTER=Vector3.new(-100,3,2340),
  CHEF=Vector3.new(-100,3,2380), FARMER=Vector3.new(-100,3,2420),
  CONSTRUCTION=Vector3.new(-100,3,2460),
  POLICE=Vector3.new(100,3,2300), TEACHER=Vector3.new(100,3,2340),
  SANITATION=Vector3.new(100,3,2380), ELECTRICIAN=Vector3.new(100,3,2420),
  PLUMBER=Vector3.new(100,3,2460),
  VETERINARIAN=Vector3.new(-70,3,2480), REAL_ESTATE_AGENT=Vector3.new(-35,3,2480),
  PHOTOGRAPHER=Vector3.new(0,3,2480), PILOT=Vector3.new(35,3,2480),
  MUSICIAN=Vector3.new(70,3,2480),
 }
 local taskLabels={
  RETAIL={"SCAN CUSTOMER ITEMS","STOCK DISPLAY SHELF"},
  COURIER={"PICK UP PARCEL","DELIVER TO CUSTOMER"},
  BARISTA={"PREPARE COFFEE ORDER","SERVE CUSTOMER"},
  MECHANIC={"INSPECT ENGINE","REPLACE WORN PART"},
  CONSTRUCTION={"MEASURE BUILD SITE","INSTALL BUILDING MATERIAL"},
  POLICE={"CHECK INCIDENT REPORT","INTERVIEW WITNESS"},
  PARAMEDIC={"CHECK PATIENT VITALS","APPLY FIRST AID"},
  FIREFIGHTER={"CHECK FIRE HOSE","EXTINGUISH TRAINING FIRE"},
  CHEF={"PREPARE INGREDIENTS","PLATE THE MEAL"},
  FARMER={"PLANT SEEDLINGS","HARVEST CROPS"},
  TEACHER={"PREPARE LESSON","TEACH CLASS"},
  SANITATION={"COLLECT RECYCLABLES","SORT WASTE"},
  ELECTRICIAN={"INSPECT CIRCUIT","RESTORE POWER"},
  PLUMBER={"INSPECT LEAK","REPAIR PIPE"},
  VETERINARIAN={"EXAMINE PET","ADMINISTER CARE"},
  REAL_ESTATE_AGENT={"STAGE PROPERTY","SHOW HOME TO CLIENT"},
  PHOTOGRAPHER={"SET UP LIGHTS","TAKE PORTRAIT"},
  PILOT={"RUN PRE-FLIGHT CHECK","CONFIRM LANDING PROCEDURE"},
  MUSICIAN={"TUNE INSTRUMENT","PERFORM ON STAGE"},
 }
 local addedCareers=0
 for _,career in ipairs(Catalog.Careers) do
  local pos=jobPositions[career.id]
  if not pos then
   addedCareers+=1
   local row=math.floor((addedCareers-1)/2)
   local side=addedCareers%2==1 and -1 or 1
   pos=Vector3.new(side*140,3,2192+row*17)
  end
  if pos then
   local site=anchor("Downtown Worksite "..career.id,pos,false)
   site:SetAttribute("CareerSite",career.id)
   downtownWorkSites[career.id]=site
   if Catalog.CareerTasks[career.id] then
    local note=plaque("Work Sign "..career.id,pos+Vector3.new(0,5,0),
     career.name:upper(),"START SHIFT • COMPLETE 2 TASKS",
     Color3.fromRGB(59,93,106))
    note.CanCollide=false
   end
   prompt(site,career.id=="CREATOR" and "RECORD VIDEO" or "WORK SHIFT",
    career.name,function(player)
     Life.Process(player,career.id=="CREATOR" and "Publish" or "Work",career.id)
    end)
   if career.id~="CREATOR" then
    downtownTaskSites[career.id]={}
    local labels=taskLabels[career.id] or Catalog.CareerTasks[career.id]
    local tangent=(math.abs(pos.X)&gt;90) and Vector3.new(0,0,8) or Vector3.new(8,0,0)
    for step=1,2 do
     local taskPos=pos+tangent*(step==1 and -1 or 1)
     local target=anchor("Downtown Job Task "..career.id.." "..step,taskPos,false)
     target:SetAttribute("Job",career.id); target:SetAttribute("Step",step)
     target:SetAttribute("TaskLabel",labels[step])
     downtownTaskSites[career.id][step]=target
     prompt(target,labels[step],career.name,function(player)
      Life.Process(player,"Task",career.id,step)
     end)
    end
   end
  end
 end
 -- Civic services integrated into the same walkable downtown block.
 downtownFineCounter=plaque("Downtown Court Payments",Vector3.new(88,5,2282),
  "CITY COURT","PAY FINES",Color3.fromRGB(66,76,91))
 prompt(downtownFineCounter,"PAY FINE","Downtown Court",function(player)
  Life.Process(player,"PayFine")
 end)
 downtownFoodCounter=anchor("Downtown Community Meal",Vector3.new(-88,3,2282),false)
 prompt(downtownFoodCounter,"EAT MEAL","Community Food Pantry",function(player)
  Life.Process(player,"Eat","COMMUNITY")
 end)
 downtownRestCounter=anchor("Downtown Public Rest",Vector3.new(0,3,2228),false)
 prompt(downtownRestCounter,"REST","Downtown Public Bench",function(player)
  Life.Process(player,"Rest","PUBLIC")
 end)
 -- Players can own and tend individual garden beds within walking distance.
 Garden.Build(world,{
  process=function(p,kind,arg) return Life.Process(p,kind,arg) end,
  getProfile=profile,tell=tell,sync=Life.Sync,reward=context.reward
 })
 -- Reuse genuine official Modern City tree meshes to landscape the estates.
 -- All source assets were stripped of executable scripts before import.
 local estate=folder:FindFirstChild("Residential Estates Neighborhood")
 local streetTrees=cityModel:FindFirstChild("StreetTrees",true)
 if estate and streetTrees then
  local source=streetTrees:GetChildren()
  local placed=0
  for row=0,1 do
   for i=1,6 do
    local tree=source[((i-1)%#source)+1]
    if tree and tree:IsA("Model") then
     local clone=tree:Clone()
     clone.Name="Official Estate Mesh Tree "..(row*6+i)
     clone.Parent=estate
     local cf,size=clone:GetBoundingBox()
     local target=Vector3.new(-186+(i-1)*73,2.6,2738+row*70)
     local bottom=cf.Position.Y-size.Y*.5
     clone:PivotTo(clone:GetPivot()+Vector3.new(
      target.X-cf.Position.X,target.Y-bottom,target.Z-cf.Position.Z))
     for _,part in ipairs(clone:GetDescendants()) do
      if part:IsA("BasePart") then
       part.Anchored=true
       part.CanTouch=false
       part.CanCollide=false
      end
     end
     placed+=1
    end
   end
  end
  estate:SetAttribute("OfficialMeshTrees",placed)
 end
 -- Two additional officers make the detailed district participate in the law system.
 officer(services,3,Vector3.new(-92,7,2295))
 officer(services,4,Vector3.new(92,7,2395))
 cityModel:SetAttribute("LifeSimulationIntegrated",true)
 cityModel:SetAttribute("DowntownCareerCount",#Catalog.Careers)
 return true
end

function Life.RefreshProperty(player)
 local s=profile(player)
 if not s or not s.life then return end
 local owned=s.life.owned
 local priority={
  "PRIVATE_ISLAND","VILLA","PENTHOUSE","MANSION","BEACH_HOUSE",
  "FARMHOUSE","LAKE_CABIN","TOWNHOUSE","STARTER_HOME",
  "CONDO","APARTMENT",
 }
 local tier=nil
 for _,candidate in ipairs(priority) do
  if owned[candidate] then tier=candidate;break end
 end
 local old=playerProperties[player]
 if old then old:Destroy(); playerProperties[player]=nil end
 if not tier then return end
 local slot=playerSlots[player]
 if not slot then return end
 local center=propertyBases[slot]
 local m=Instance.new("Model")
 m.Name="Owned "..tier.." "..player.UserId
 m:SetAttribute("OwnerUserId",player.UserId)
 m:SetAttribute("PropertyTier",tier)
 m.Parent=folder
 playerProperties[player]=m
 local luxury={PRIVATE_ISLAND=true,VILLA=true,PENTHOUSE=true,MANSION=true}
 local middle={BEACH_HOUSE=true,FARMHOUSE=true,LAKE_CABIN=true,
  TOWNHOUSE=true,STARTER_HOME=true}
 local width=luxury[tier] and 36 or middle[tier] and 29 or 24
 local floors=luxury[tier] and 3 or middle[tier] and 2 or 1
 local height=floors*10
 local color=luxury[tier] and Color3.fromRGB(216,211,199) or
  middle[tier] and Color3.fromRGB(183,143,115) or
  Color3.fromRGB(173,181,190)
 part(m,"Property Foundation",Vector3.new(width+3,1,30),
  center+Vector3.new(0,3,0),Color3.fromRGB(132,134,132),Enum.Material.Concrete,true)
 -- Walkable ground floor: four actual walls with an open doorway, not a solid cube.
 for _,x in ipairs({-width*.5,width*.5}) do
  part(m,"Property Side Wall",Vector3.new(1,height,26),
   center+Vector3.new(x,3+height*.5,0),color,Enum.Material.Brick,true)
 end
 part(m,"Property Rear Wall",Vector3.new(width,height,1),
  center+Vector3.new(0,3+height*.5,13),color,Enum.Material.Brick,true)
 for _,x in ipairs({-1,1}) do
  part(m,"Property Front Wall",Vector3.new((width-7)*.5,height,1),
   center+Vector3.new(x*(width+7)*.25,3+height*.5,-13),
   color,Enum.Material.Brick,true)
 end
 -- A player can enter, walk to furniture, and use the sofa/bed.
 local interior=Color3.fromRGB(204,194,175)
 part(m,"Interior Wood Floor",Vector3.new(width-2,.25,25),
  center+Vector3.new(0,3.65,0),Color3.fromRGB(145,105,77),
  Enum.Material.WoodPlanks,true)
 for _,x in ipairs({-width*.5+1,width*.5-1}) do
  part(m,"Interior Baseboard",Vector3.new(.2,.5,24),
   center+Vector3.new(x,4,0),interior,Enum.Material.Wood,false)
 end
 part(m,"Living Room Rug",Vector3.new(10,.1,7),
  center+Vector3.new(-width*.23,3.9,-2),
  Color3.fromRGB(122,137,148),Enum.Material.Fabric,false)
 part(m,"Sofa Seat",Vector3.new(7,1.3,3),
  center+Vector3.new(-width*.25,5,-2),
  Color3.fromRGB(94,123,127),Enum.Material.Fabric,true)
 part(m,"Sofa Back",Vector3.new(7,2.5,.9),
  center+Vector3.new(-width*.25,6,-.4),
  Color3.fromRGB(94,123,127),Enum.Material.Fabric,true)
 part(m,"Coffee Table",Vector3.new(5,.6,2.8),
  center+Vector3.new(-width*.25,4.7,-7),
  Color3.fromRGB(125,92,65),Enum.Material.Wood,true)
 part(m,"Bed Frame",Vector3.new(7,1,9),
  center+Vector3.new(width*.25,4.5,4),
  Color3.fromRGB(111,91,79),Enum.Material.Wood,true)
 part(m,"Bed Mattress",Vector3.new(6.6,.6,8.4),
  center+Vector3.new(width*.25,5.2,4),
  Color3.fromRGB(229,224,214),Enum.Material.Fabric,true)
 part(m,"Bed Pillow",Vector3.new(4,.5,1.8),
  center+Vector3.new(width*.25,5.8,7),
  Color3.fromRGB(243,241,230),Enum.Material.Fabric,false)
 part(m,"Kitchen Counter",Vector3.new(9,3,2.5),
  center+Vector3.new(-width*.25,5.3,9),
  Color3.fromRGB(159,160,154),Enum.Material.Marble,true)
 local kitchen=part(m,"Kitchen Sink",Vector3.new(2.2,.15,1.7),
  center+Vector3.new(-width*.25,6.9,8.9),
  Color3.fromRGB(91,104,110),Enum.Material.Metal,false)
 local sinkPrompt=Instance.new("ProximityPrompt")
 sinkPrompt.ActionText="WASH UP"; sinkPrompt.ObjectText="Home Kitchen"
 sinkPrompt.MaxActivationDistance=10; sinkPrompt.Parent=kitchen
 sinkPrompt.Triggered:Connect(function(p)
  if p==player then
   local state=profile(p)
   if state and state.life then
    state.life.needs.hygiene=100
    Life.Sync(p)
    tell(p,"SHOWERED AND FRESHENED UP • HYGIENE 100!")
   end
  end
 end)
 local bed=part(m,"Bed Interaction",Vector3.new(2,.2,2),
  center+Vector3.new(width*.25,6,4),
  Color3.fromRGB(229,224,214),Enum.Material.Fabric,false)
 bed.Transparency=1
 local restPrompt=Instance.new("ProximityPrompt")
 restPrompt.ActionText="REST"; restPrompt.ObjectText="Your Home"
 restPrompt.MaxActivationDistance=11; restPrompt.Parent=bed
 restPrompt.Triggered:Connect(function(p)
  if p==player then
   local state=profile(p)
   if state and state.life then
    state.life.needs.energy=100
    Life.Sync(p)
    tell(p,"SLEPT IN YOUR OWN BED • ENERGY 100!")
   end
  end
 end)
 for _,floorIndex in ipairs({2,3}) do
  if floorIndex&lt;=floors then
   part(m,"Upper Level Floor",Vector3.new(width-1,.7,25),
    center+Vector3.new(0,3+(floorIndex-1)*10,0),
    Color3.fromRGB(145,105,77),Enum.Material.WoodPlanks,true)
  end
 end
 -- Gabled two-slope roof with overhang, ridge, chimney and front porch.
 for _,side in ipairs({-1,1}) do
  local wedge=Instance.new("WedgePart")
  wedge.Name="Sloped Architectural Roof"
  wedge.Size=Vector3.new(29,5,(width+3)*.5)
  wedge.CFrame=CFrame.new(center+Vector3.new(
   side*(width+3)*.25,6.5+height,0))*
   CFrame.Angles(0,side==1 and math.pi*.5 or -math.pi*.5,0)
  wedge.Anchored=true; wedge.CanCollide=true
  wedge.Material=Enum.Material.Slate
  wedge.Color=Color3.fromRGB(62,71,82); wedge.Parent=m
 end
 part(m,"Roof Ridge Cap",Vector3.new(1,1.1,31),
  center+Vector3.new(0,9.2+height,0),
  Color3.fromRGB(57,63,73),Enum.Material.Metal,false)
 part(m,"Brick Chimney",Vector3.new(3,7,3),
  center+Vector3.new(width*.29,9+height,5),
  Color3.fromRGB(151,101,91),Enum.Material.Brick,true)
 part(m,"Front Porch",Vector3.new(12,.7,7),
  center+Vector3.new(0,3.4,-17),
  Color3.fromRGB(173,167,155),Enum.Material.Concrete,true)
 for _,x in ipairs({-5,5}) do
  local column=part(m,"Porch Column",Vector3.new(1.2,9,1.2),
   center+Vector3.new(x,8,-19),
   Color3.fromRGB(226,222,207),Enum.Material.Limestone,true)
  column.Shape=Enum.PartType.Cylinder
 end
 part(m,"Porch Overhang",Vector3.new(13,.8,7),
  center+Vector3.new(0,12.8,-17),
  Color3.fromRGB(65,75,85),Enum.Material.Slate,true)
 for _,z in ipairs({-21,-23}) do
  part(m,"Front Steps",Vector3.new(9,.55,2),
   center+Vector3.new(0,z==-21 and 2.7 or 2.2,z),
   Color3.fromRGB(165,162,152),Enum.Material.Concrete,true)
 end
 part(m,"Home Driveway",Vector3.new(11,.3,20),
  center+Vector3.new(width*.28,2.2,-25),
  Color3.fromRGB(151,153,150),Enum.Material.Concrete,true)
 for _,x in ipairs({-width*.5+3,width*.5-3}) do
  local shrub=part(m,"Front Garden Shrub",Vector3.new(4,3,4),
   center+Vector3.new(x,4,-17),
   Color3.fromRGB(68,123,75),Enum.Material.Grass,false)
  shrub.Shape=Enum.PartType.Ball
 end
 local houseLight=part(m,"Porch Light",Vector3.new(1.3,1.3,1.3),
  center+Vector3.new(0,10.8,-13.5),
  Color3.fromRGB(252,224,175),Enum.Material.Neon,false)
 local bulb=Instance.new("PointLight"); bulb.Brightness=.8; bulb.Range=12
 bulb.Color=Color3.fromRGB(255,223,175); bulb.Parent=houseLight
 for floorIndex=1,floors do
  for _,x in ipairs({-width*.28,width*.28}) do
   for _,z in ipairs({-13.2,13.2}) do
    local glass=part(m,"Property Window",Vector3.new(5,5,.25),
     center+Vector3.new(x,5+floorIndex*9-5,z),
     Color3.fromRGB(115,182,210),Enum.Material.Glass,false)
    glass.Transparency=.23
   end
  end
 end
 local originalDoor=part(m,"Property Entrance",Vector3.new(6,8,.5),
  center+Vector3.new(0,7,-13.5),
  Color3.fromRGB(76,92,108),Enum.Material.WoodPlanks,false)
 originalDoor.Transparency=1
 textSign(m,tier.." • "..player.DisplayName,
  center+Vector3.new(0,height+12,-15),Color3.fromRGB(255,235,169))
 Home.Furnish(m,center,width,floors,player,owned,{
  getProfile=profile,tell=tell,sync=Life.Sync,
 })
end
function Life.PlayerJoined(player)
 if playerSlots[player] then return end
 for i=1,#propertyBases do
  if not propertySlots[i] then
   propertySlots[i]=player; playerSlots[player]=i
   break
  end
 end
 Life.RefreshProperty(player)
 Garden.PlayerJoined(player)
end
function Life.PlayerRemoving(player)
 local slot=playerSlots[player]
 if slot then propertySlots[slot]=nil end
 playerSlots[player]=nil
 local m=playerProperties[player]
 if m then m:Destroy() end
 playerProperties[player]=nil
 lastAction[player]=nil
 publicMealCooldown[player]=nil
 Garden.PlayerRemoving(player)
end
function Life.GiveCamera(player)
 local s=profile(player)
 if not s or not s.life then return end
 Garden.GiveTools(player,s.life)
 if not s.life.owned.CAMERA then return end
 local backpack=player:FindFirstChildOfClass("Backpack")
 if not backpack then return end
 if backpack:FindFirstChild("Creator Camera") or
  (player.Character and player.Character:FindFirstChild("Creator Camera")) then return end
 local tool=Instance.new("Tool"); tool.Name="Creator Camera"
 tool.ToolTip="Equip at the Life City recording studio, then tap RECORD"
 tool.CanBeDropped=false; tool.RequiresHandle=true
 local handle=Instance.new("Part"); handle.Name="Handle"
 handle.Size=Vector3.new(2,1.4,1.3)
 handle.Material=Enum.Material.Metal; handle.Color=Color3.fromRGB(42,48,58)
 handle.CanCollide=false; handle.Massless=true; handle.Parent=tool
 local lens=Instance.new("Part"); lens.Name="Camera Lens"
 lens.Shape=Enum.PartType.Cylinder
 lens.Size=Vector3.new(.85,1.1,1.1)
 lens.Color=Color3.fromRGB(90,158,188)
 lens.Material=Enum.Material.Glass; lens.CanCollide=false; lens.Massless=true
 lens.CFrame=handle.CFrame*CFrame.new(0,0,-.85)*CFrame.Angles(0,0,math.rad(90))
 lens.Parent=tool
 local weld=Instance.new("WeldConstraint"); weld.Part0=handle
 weld.Part1=lens; weld.Parent=handle
 tool.Parent=backpack
end
function Life.IsJailed(player)
 local s=profile(player)
 return s and s.life and os.clock()&lt;s.life.jailUntil or false
end
function Life.Process(player,kind,arg,step)
 local s=profile(player)
 if not s or not s.life or type(kind)~="string" then return false end
 local life=s.life
 if Life.IsJailed(player) then
  tell(player,"YOU ARE SERVING A SHORT IN-GAME JAIL SENTENCE.")
  return false
 end
 local now=os.clock()
 if now-(lastAction[player] or -100)&lt;.35 then return false end
 lastAction[player]=now
 if kind=="Career" then
  local career=type(arg)=="string" and Catalog.CareerById[arg]
  if not career or not nearbyEither(player,careerSites[arg],downtownCareerSites[arg],17) then return false end
  if s.level&lt;career.level then
   tell(player,"REACH LEVEL "..career.level.." TO APPLY."); return false
  end
  if s.heat&gt;0 then tell(player,"CLEAR YOUR WANTED HEAT BEFORE APPLYING."); return false end
  life.career=arg
  life.activeShift=nil
  tell(player,"HIRED: "..career.name.."! FIND YOUR WORKPLACE.")
 elseif kind=="Work" then
  local career=type(arg)=="string" and Catalog.CareerById[arg]
  if not career or arg=="CREATOR" or life.career~=arg or
   not nearbyEither(player,workSites[arg],downtownWorkSites[arg],18) then return false end
  if life.needs.energy&lt;10 or life.needs.hunger&lt;10 then
   tell(player,"TOO TIRED OR HUNGRY TO WORK • REST OR EAT AT THE COMMUNITY KITCHEN.")
   return false
  end
  if now-life.lastWork&lt;12 then
   tell(player,"SHIFT REST BREAK • TRY AGAIN SHORTLY."); return false
  end
  if arg=="POLICE" and s.heat&gt;0 then
   tell(player,"POLICE OFFICERS MUST HAVE A CLEAR RECORD."); return false
  end
  if not life.activeShift or life.activeShift.id~=arg then
   life.activeShift={id=arg,started=now,progress=0,taskAt=0}
   tell(player,"SHIFT STARTED: "..career.name..
    " • COMPLETE THE TWO WORK TASKS MARKED NEARBY.")
   Life.Sync(player)
   return true
  end
  if life.activeShift.progress&lt;2 then
   tell(player,"COMPLETE BOTH WORK TASKS BEFORE COLLECTING YOUR WAGES.")
   return false
  end
  life.activeShift=nil
  life.lastWork=now; life.shifts+=1
  life.needs.energy=math.max(0,life.needs.energy-5)
  life.needs.hunger=math.max(0,life.needs.hunger-4)
  life.needs.hygiene=math.max(0,life.needs.hygiene-2)
  life.reputation=math.min(1000000,life.reputation+1)
  context.reward(player,career.wage,14,0)
  tell(player,"SHIFT COMPLETED! +"..career.wage.." COINS • +14 XP")
 elseif kind=="Task" then
  local shift=life.activeShift
  if type(arg)~="string" or not Catalog.CareerById[arg] or
   not shift or shift.id~=arg or life.career~=arg then return false end
  local expected=shift.progress+1
  if type(step)~="number" or step~=expected or step&gt;2 or
   (not taskSites[arg] and not downtownTaskSites[arg]) or
   not nearbyEither(player,taskSites[arg] and taskSites[arg][step],
    downtownTaskSites[arg] and downtownTaskSites[arg][step],15) then
   tell(player,"FOLLOW YOUR ASSIGNED WORK TASKS IN ORDER.")
   return false
  end
  if now-shift.started&lt;1.5 or
   (shift.progress&gt;0 and now-shift.taskAt&lt;1.5) then
   tell(player,"TAKE TIME TO COMPLETE YOUR WORK SAFELY.")
   return false
  end
  if arg=="PHOTOGRAPHER" and not life.owned.CAMERA then
   tell(player,"PHOTOGRAPHERS NEED A CAMERA FROM THE TECH STORE.")
   return false
  end
  if arg=="MUSICIAN" and not life.owned.GUITAR then
   tell(player,"MUSICIANS NEED A GUITAR FROM THE TECH STORE.")
   return false
  end
  shift.progress=step; shift.taskAt=now
  tell(player,step==2 and "ALL TASKS DONE! RETURN TO THE WORK STATION FOR WAGES."
   or "FIRST TASK COMPLETE! FIND THE SECOND WORK TASK.")
  Life.Sync(player)
  return true
 elseif kind=="Eat" then
  if arg~="COMMUNITY" or not nearbyEither(player,foodCounter,downtownFoodCounter,17) then return false end
  if now-(publicMealCooldown[player] or -1000)&lt;45 then
   tell(player,"THE KITCHEN IS PREPARING MORE MEALS • COME BACK SOON.")
   return false
  end
  publicMealCooldown[player]=now
  life.needs.hunger=math.min(100,life.needs.hunger+50)
  tell(player,"ATE A FREE COMMUNITY MEAL • HUNGER RESTORED!")
 elseif kind=="Rest" then
  if arg~="PUBLIC" or not nearbyEither(player,restCounter,downtownRestCounter,17) then return false end
  life.needs.energy=math.min(100,life.needs.energy+25)
  tell(player,"RESTED AT THE PARK • ENERGY RESTORED!")
 elseif kind=="GardenPlant" or kind=="GardenWater" or
   kind=="GardenHarvest" or kind=="GardenSell" then
  return Garden.Process(player,kind,arg,s) and (function()
   context.sync(player)
   return true
  end)() or false
 elseif kind=="GoHome" then
  local slot=playerSlots[player]
  if not slot or not playerProperties[player] then
   tell(player,"BUY A HOME AT METRO REALTY BEFORE YOU CAN MOVE IN.")
   return false
  end
  if now-(life.lastHome or -100)&lt;5 then return false end
  local char=player.Character
  if not char then return false end
  life.lastHome=now
  char:PivotTo(CFrame.new(propertyBases[slot]+Vector3.new(0,7,-23)))
  tell(player,"WELCOME HOME • LOT "..slot.." • USE THE SECURITY KEYPAD TO SET VISITOR ACCESS.")
 elseif kind=="SelectCar" then
  if type(arg)~="string" or not Catalog.CarChoices[arg] then
   return false
  end
  if not nearbyEither(player,stores.VEHICLE,downtownStores.VEHICLE,24) then
   tell(player,"VISIT THE VEHICLE DEALER TO SWITCH YOUR DAILY DRIVER.")
   return false
  end
  if not life.owned[arg] then
   tell(player,"BUY THIS CAR AT THE VEHICLE DEALER FIRST.")
   return false
  end
  life.selectedCar=arg
  tell(player,"GARAGE: "..Catalog.CarChoices[arg].name:upper()..
   " SELECTED. USE THE CAR BUTTON TO SPAWN IT.")
 elseif kind=="Buy" then
  local item=type(arg)=="string" and Catalog.ById[arg]
  if not item or not nearbyEither(player,stores[item.category],downtownStores[item.category],24) then
   tell(player,"VISIT THE CORRECT LIFE CITY STORE TO PURCHASE."); return false
  end
  local seedPacket=Garden.Crops[item.id]~=nil
  if life.owned[item.id] and not seedPacket then
   tell(player,"YOU ALREADY OWN THIS ITEM."); return false
  end
  if s.level&lt;item.level then
   tell(player,"REACH LEVEL "..item.level.." FIRST."); return false
  end
  if s.coins&lt;item.price then
   tell(player,"YOU NEED "..(item.price-s.coins).." MORE COINS."); return false
  end
  s.coins-=item.price
  life.owned[item.id]=true
  if Catalog.CarChoices[item.id] and life.selectedCar=="" then
   life.selectedCar=item.id
  end
  if seedPacket then
   life.garden.seeds[item.id]=math.min(99,(life.garden.seeds[item.id] or 0)+3)
   tell(player,"SEED PACK ADDED: 3 "..item.name.." PLANTINGS.")
  end
  if item.id=="CAMERA" or item.id=="GARDEN_TROWEL" or
   item.id=="WATERING_CAN" then Life.GiveCamera(player) end
  if item.category=="PROPERTY" or item.category=="HOME" or
   item.id=="SMART_TV" or item.id=="GAME_CONSOLE" or
   item.id=="WORKSTATION" or item.id=="DESKTOP_PC" or
   item.id=="LAPTOP" then
   Life.RefreshProperty(player)
  end
  tell(player,"PURCHASED: "..item.name.."! THIS IS AN IN-GAME ITEM.")
 elseif kind=="Publish" then
  if life.career~="CREATOR" or
   not nearbyEither(player,workSites.CREATOR,downtownWorkSites.CREATOR,18) then
   tell(player,"BECOME A CREATOR AND VISIT THE RECORDING STUDIO."); return false
  end
  if not life.owned.PHONE or not life.owned.CAMERA then
   tell(player,"BUY A PHONE AND CAMERA BEFORE RECORDING."); return false
  end
  if now-life.lastPost&lt;24 then
   tell(player,"EDIT YOUR NEXT VIDEO • WAIT FOR THE POST COOLDOWN."); return false
  end
  local char=player.Character
  if not char or not char:FindFirstChild("Creator Camera") then
   tell(player,"EQUIP YOUR CREATOR CAMERA BEFORE RECORDING.")
   return false
  end
  life.lastPost=now; life.uploads+=1
  local production=life.owned.WORKSTATION and 4 or life.owned.MIC and 2 or 1
  local newFollowers=math.min(1500,10+production*12+math.floor(life.followers*.04))
  life.followers=math.min(10000000,life.followers+newFollowers)
  life.reputation=math.min(1000000,life.reputation+production)
  local revenue=math.min(220,8+math.floor(life.followers/100)+production*4)
  context.reward(player,revenue,20+production*4,0)
  tell(player,"VIDEO POSTED! +"..newFollowers.." FOLLOWERS • +"..revenue.." COINS")
 elseif kind=="BusinessCollect" then
  if not nearbyEither(player,stores.BUSINESS,downtownStores.BUSINESS,24) then return false end
  if now-life.lastBusiness&lt;90 then
   tell(player,"YOUR BUSINESSES NEED TIME TO SERVE CUSTOMERS."); return false
  end
  local revenue=0
  for id,amount in pairs(Catalog.BusinessPayouts) do
   if life.owned[id] then revenue+=amount end
  end
  if revenue==0 then tell(player,"BUY A BUSINESS FIRST."); return false end
  life.lastBusiness=now
  context.reward(player,revenue,10,0)
  tell(player,"COLLECTED "..revenue.." COINS FROM YOUR BUSINESSES!")
 elseif kind=="PayFine" then
  if not nearbyEither(player,fineCounter,downtownFineCounter,20) then return false end
  if life.fines&lt;=0 then tell(player,"NO UNPAID FINES."); return false end
  local amount=math.min(s.coins,life.fines)
  s.coins-=amount; life.fines-=amount
  tell(player,"PAID "..amount.." COINS TOWARD COURT FINES.")
 else return false end
 context.sync(player)
 return true
end
local function arrest(player,s,officerUnit)
 if Life.IsJailed(player) then return end
 local life=s.life
 local fine=math.min(s.coins,math.max(15,math.floor(s.heat*.6)))
 s.coins-=fine
 life.fines=math.min(1000000,life.fines+math.floor(s.heat*.3))
 life.arrests+=1
 life.jailUntil=os.clock()+20
 s.heat=0
 officerUnit.model:SetAttribute("Behavior","Arrest")
 local char=player.Character
 if char then char:PivotTo(CFrame.new(jailCenter+Vector3.new(0,2,0))) end
 context.sync(player)
 tell(player,"ARRESTED BY POLICE! 20s JAIL • "..fine..
  " COIN FINE • YOUR GEAR IS SAFE.")
end
function Life.Start()
 local elapsed=0
 local needsElapsed=0
 RunService.Heartbeat:Connect(function(dt)
  if not world or not world.Parent then return end
  elapsed+=dt
  needsElapsed+=dt
  if needsElapsed&gt;=120 then
   needsElapsed=0
   for _,player in ipairs(Players:GetPlayers()) do
    local state=profile(player)
    if state and state.life then
     local needs=state.life.needs
     needs.energy=math.max(0,needs.energy-2)
     needs.hunger=math.max(0,needs.hunger-2)
     needs.hygiene=math.max(0,needs.hygiene-1)
     needs.fun=math.max(0,needs.fun-1)
     Life.Sync(player)
    end
   end
  end
  if elapsed&lt;.2 then return end
  local step=math.min(elapsed,.25); elapsed=0
  local now=os.clock()
  for _,player in ipairs(Players:GetPlayers()) do
   local s=profile(player)
   if s and s.life and s.life.jailUntil&gt;0 then
    if now&gt;=s.life.jailUntil then
     s.life.jailUntil=0
     local char=player.Character
     if char then char:PivotTo(CFrame.new(townCenter+Vector3.new(105,7,12))) end
     context.sync(player)
     tell(player,"RELEASED! YOU CAN RETURN TO WORK AND REBUILD REPUTATION.")
    elseif not nearby(player,
      {Position=jailCenter},20) then
     local char=player.Character
     if char then char:PivotTo(CFrame.new(jailCenter+Vector3.new(0,2,0))) end
    end
   end
  end
  for _,unit in ipairs(policeUnits) do
   local closest,dist=nil,85
   for _,player in ipairs(Players:GetPlayers()) do
    local s=profile(player)
    local r=root(player)
    if s and s.life and not Life.IsJailed(player) and
     s.heat&gt;=40 and r and (r.Position-unit.position).Magnitude&lt;dist then
     closest=player; dist=(r.Position-unit.position).Magnitude
    end
   end
   if closest then
    if unit.target~=closest then unit.target=closest; unit.started=now end
    unit.model:SetAttribute("Behavior","Pursuit")
    local r=root(closest)
    if r then
     local delta=Vector3.new(r.Position.X-unit.position.X,0,
      r.Position.Z-unit.position.Z)
     if delta.Magnitude&gt;1 then
      local direction=delta.Unit
      unit.position+=direction*math.min(delta.Magnitude,step*18)
      unit.model:PivotTo(CFrame.lookAt(unit.position,unit.position+direction))
     end
     if delta.Magnitude&lt;8 and now-unit.started&gt;5 then
      local s=profile(closest)
      if s then arrest(closest,s,unit) end
      unit.target=nil
     end
    end
   else
    unit.target=nil
    unit.model:SetAttribute("Behavior","Patrol")
    local goal=unit.route[unit.routeIndex]
    local delta=goal-unit.position
    if delta.Magnitude&lt;2 then
     unit.routeIndex=unit.routeIndex%#unit.route+1
    else
     local direction=delta.Unit
     unit.position+=direction*math.min(delta.Magnitude,step*6)
     unit.model:PivotTo(CFrame.lookAt(unit.position,unit.position+direction))
    end
   end
  end
 end)
 Players.PlayerRemoving:Connect(Life.PlayerRemoving)
end
return Life
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="18">
      <Properties>
        <string name="Name">ModernCityIntegration</string>
        <string name="Source">-- Official Roblox Modern City district integration.
-- Imported geometry and material variants originate from Roblox Studio's
-- built-in Modern City template. All imported executable scripts were removed.
-- World construction remains separate so this art can be reused in future games.
local Integration={}
local ORIGIN=Vector3.new(720,0,200)
local DESTINATION=Vector3.new(0,0,2350)
local DELTA=DESTINATION-ORIGIN

local function anchor(parent,name,size,position,color,material,collidable)
 local p=Instance.new("Part")
 p.Name=name; p.Anchored=true; p.CanCollide=collidable==true
 p.CanTouch=false; p.CanQuery=true
 p.Size=size; p.Position=position
 p.Material=material or Enum.Material.Metal
 p.Color=color or Color3.fromRGB(64,85,99)
 p.TopSurface=Enum.SurfaceType.Smooth
 p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=parent
 return p
end
local function board(parent,name,position,title,subtitle)
 local base=anchor(parent,name,Vector3.new(13,8,.8),position,
  Color3.fromRGB(33,47,62),Enum.Material.Metal,true)
 local face=Instance.new("SurfaceGui")
 face.Name="City Wayfinding Sign"
 face.Face=Enum.NormalId.Front
 face.CanvasSize=Vector2.new(850,520)
 face.LightInfluence=.25; face.Parent=base
 local main=Instance.new("TextLabel")
 main.BackgroundTransparency=1
 main.Size=UDim2.new(.94,0,.6,0)
 main.Position=UDim2.new(.03,0,.04,0)
 main.Text=title; main.TextWrapped=true
 main.Font=Enum.Font.GothamBold; main.TextScaled=true
 main.TextColor3=Color3.fromRGB(248,238,211); main.Parent=face
 local sub=Instance.new("TextLabel")
 sub.BackgroundTransparency=1
 sub.Size=UDim2.new(.94,0,.28,0)
 sub.Position=UDim2.new(.03,0,.65,0)
 sub.Text=subtitle; sub.TextWrapped=true
 sub.Font=Enum.Font.Gotham; sub.TextScaled=true
 sub.TextColor3=Color3.fromRGB(142,206,227); sub.Parent=face
 return base
end
local function portal(parent,position,title,description,callback)
 local base=board(parent,"Modern City Wayfinding Terminal",position,title,description)
 local prompt=Instance.new("ProximityPrompt")
 prompt.Name="Travel to "..title
 prompt.ActionText="TRAVEL"
 prompt.ObjectText=title
 prompt.HoldDuration=.3
 prompt.MaxActivationDistance=14
 prompt.RequiresLineOfSight=false
 prompt.Parent=base
 prompt.Triggered:Connect(callback)
 return base
end
function Integration.Build(world,spawn,tell)
 local imported=workspace:FindFirstChild("OfficialModernCityDistrict")
 if not imported or not imported:IsA("Model") then
  warn("Official Modern City art not loaded; leaving original hub spawn")
  return nil
 end
 -- The source art is a prebuilt street block around x=720,z=200. Move it
 -- to a new streaming-friendly region, keeping the original street layout.
 imported:PivotTo(imported:GetPivot()+DELTA)
 imported:SetAttribute("ArtSource","Official Roblox Studio Modern City Template")
 imported:SetAttribute("ImportedScriptsRemoved",true)
 imported:SetAttribute("OriginalCenter","720,0,200")
 imported:SetAttribute("WorldRegion","DOWNTOWN")
 imported.Name="OfficialModernCityDistrict"
 local folder=Instance.new("Folder")
 folder.Name="Downtown Wayfinding"
 folder.Parent=world
 -- The extracted city Model already contains its static asphalt foundation,
 -- so both edit mode and Play mode show buildings grounded in a real street.
 local pad=anchor(folder,"Downtown Arrival Sidewalk",Vector3.new(13,.35,11),
  Vector3.new(0,.68,2215),Color3.fromRGB(67,70,72),
  Enum.Material.Asphalt,true)
 -- Paint a recognizable pedestrian crossing at the welcome plaza.
 for i=-4,4 do
  anchor(folder,"Downtown Arrival Crosswalk",Vector3.new(2.5,.1,9),
   Vector3.new(i*3.8,.12,2196),
   Color3.fromRGB(233,230,215),Enum.Material.Concrete,false)
 end
 pad.Transparency=.12
 -- The city becomes the player's first impression, instead of the block arena.
 if spawn then
  spawn.CFrame=CFrame.new(0,1.5,2215)*CFrame.Angles(0,math.pi,0)
  spawn.Size=Vector3.new(9,1,9)
  spawn.Material=Enum.Material.Concrete
  spawn.Color=Color3.fromRGB(148,155,159)
  spawn.Transparency=1
  spawn.CanCollide=false
 end
 portal(folder,Vector3.new(23,7,2215),
  "LIFE CITY JOBS", "60 CAREERS • STORES • HOMES",function(player)
   if player.Character then
    player.Character:PivotTo(CFrame.new(0,7,1600))
    tell(player,"WELCOME TO LIFE CITY • START YOUR CAREER!")
   end
  end)
 portal(folder,Vector3.new(-23,7,2215),
  "RIFT ADVENTURES","PORTALS • SPORTS • CASTLES",function(player)
   if player.Character then
    player.Character:PivotTo(CFrame.new(0,6,0))
    tell(player,"RIFT ADVENTURES • ENTER THE HUB!")
   end
  end)
 portal(folder,Vector3.new(0,7,1675),
  "MODERN DOWNTOWN","REAL 3D CITY • SHOPS • STREETS",function(player)
   if player.Character then
    player.Character:PivotTo(CFrame.new(0,8,2215))
    tell(player,"WELCOME TO MODERN DOWNTOWN!")
   end
  end)
 -- Street traffic and shop props are decorative; never claim drivable assets
 -- are actually usable unless server-owned physics controls are implemented.
 return Vector3.new(0,8,2215)
end
return Integration
</string>
      </Properties>
    </Item>
    <Item class="Script" referent="19">
      <Properties>
        <string name="Name">RiftRaidersServer</string>
        <token name="RunContext">0</token>
        <string name="Source">-- RIFT RAIDERS: CHAOS ISLANDS. Original, free-to-play multiplayer prototype.
-- All rewards, combat, abilities and progression are validated on the server.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local DataStoreService=game:GetService("DataStoreService")
local HttpService=game:GetService("HttpService")
local Debris=game:GetService("Debris")
local ServerScriptService=game:GetService("ServerScriptService")
local WorldKit=require(ServerScriptService:WaitForChild("WorldKit"))
local WorldExpansion=require(ServerScriptService:WaitForChild("WorldExpansion"))
local WorldActivities=require(ServerScriptService:WaitForChild("WorldActivities"))
local WorldPolish=require(ServerScriptService:WaitForChild("WorldPolish"))
local Life=require(ServerScriptService:WaitForChild("LifeSimulation"))
local LifeCityVisuals=require(ServerScriptService:WaitForChild("LifeCityVisuals"))
local ModernCityIntegration=require(ServerScriptService:WaitForChild("ModernCityIntegration"))
local DowntownPopulation=require(ServerScriptService:WaitForChild("DowntownPopulation"))
local Catalog=require(ReplicatedStorage:WaitForChild("PrestigeCatalog"))
local Vehicles=require(ServerScriptService:WaitForChild("VehicleService"))
local Boats=require(ServerScriptService:WaitForChild("BoatService"))
local world=Instance.new("Folder"); world.Name="RiftRaidersWorld"; world.Parent=workspace
world:SetAttribute("Version","0.13.0")
world:SetAttribute("Phase","CALM")
world:SetAttribute("SecondsLeft",75)
local palette={Color3.fromRGB(54,232,244),Color3.fromRGB(255,96,164),Color3.fromRGB(171,110,255),Color3.fromRGB(255,209,75),Color3.fromRGB(91,244,149)}
local biomes={
 {id="CYBER",name="Neon Metropolis",center=Vector3.new(180,0,0),color=palette[1]},
 {id="CRYSTAL",name="Prism Wilds",center=Vector3.new(-180,0,0),color=palette[3]},
 {id="VOLCANO",name="Magma Outpost",center=Vector3.new(0,0,180),color=palette[2]},
 {id="SKY",name="Cloud Kingdom",center=Vector3.new(0,0,-180),color=palette[4]},
}
local function part(name,size,pos,color,material,collide)
 local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.Size=size; p.Position=pos
 p.Material=material or Enum.Material.SmoothPlastic; p.Color=color
 p.CanCollide=collide~=false; p.TopSurface=Enum.SurfaceType.Smooth
 p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=world; return p
end
local function sign(text,pos,color,width)
 local anchor=part("SignAnchor",Vector3.new(1,1,1),pos,color,nil,false)
 anchor.Transparency=1
 local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(width or 280,64)
 gui.MaxDistance=160; gui.AlwaysOnTop=true; gui.Parent=anchor
 local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(1,1)
 label.BackgroundTransparency=1; label.Text=text; label.TextScaled=true
 label.TextColor3=color; label.TextStrokeTransparency=.3
 label.Font=Enum.Font.GothamBlack; label.Parent=gui
 return anchor
end
local function glow(p,color,range)
 local light=Instance.new("PointLight"); light.Color=color; light.Range=range or 14
 light.Brightness=1.2; light.Parent=p
end
Lighting.ClockTime=16; Lighting.Brightness=2.5
Lighting.Ambient=Color3.fromRGB(120,132,179)
local atmosphere=Instance.new("Atmosphere"); atmosphere.Density=.18
atmosphere.Color=Color3.fromRGB(155,176,236); atmosphere.Parent=Lighting
local bloom=Instance.new("BloomEffect"); bloom.Intensity=.22; bloom.Threshold=1.8
bloom.Size=24; bloom.Parent=Lighting
part("Void Floor",Vector3.new(650,2,650),Vector3.new(0,-70,0),Color3.fromRGB(14,13,32),nil,false)
local hub=part("Central Hub",Vector3.new(120,4,120),Vector3.new(0,-1,0),Color3.fromRGB(38,45,85))
local spawn=Instance.new("SpawnLocation"); spawn.Name="RiftRaidersSpawn"
spawn.Neutral=true; spawn.Anchored=true; spawn.Size=Vector3.new(22,1,22)
spawn.Position=Vector3.new(0,2,0); spawn.Material=Enum.Material.Neon
spawn.Color=palette[5]; spawn.Parent=world
sign("RIFT RAIDERS | CHAOS ISLANDS",Vector3.new(0,23,0),palette[4],460)
sign("BLAST DRONES • COLLECT SHARDS • SEAL RIFTS",Vector3.new(0,15,0),palette[1],460)
-- Central arena, tower, rings and colored paths: readable on a small screen.
for i=1,8 do
 local angle=(i-1)*math.pi/4
 local pos=Vector3.new(math.cos(angle)*47,8,math.sin(angle)*47)
 local tower=part("Hub Beacon Pillar",Vector3.new(6,16,6),pos,palette[(i-1)%5+1],Enum.Material.Metal)
 local lamp=part("Hub Beacon Light",Vector3.new(8,2,8),pos+Vector3.new(0,9,0),palette[(i-1)%5+1],Enum.Material.Neon)
 glow(lamp,lamp.Color)
end
local bridgeData={
 {Vector3.new(90,0,0),Vector3.new(75,2,22)},
 {Vector3.new(-90,0,0),Vector3.new(75,2,22)},
 {Vector3.new(0,0,90),Vector3.new(22,2,75)},
 {Vector3.new(0,0,-90),Vector3.new(22,2,75)},
}
for i,b in ipairs(bridgeData) do
 local walkway=part("Safe Skybridge",b[2],b[1],palette[i],Enum.Material.SmoothPlastic)
 for side=-1,1,2 do
  local railSize=i&lt;=2 and Vector3.new(75,3,2) or Vector3.new(2,3,75)
  local offset=i&lt;=2 and Vector3.new(0,2,side*11) or Vector3.new(side*11,2,0)
  part("Bridge Rail",railSize,b[1]+offset,Color3.fromRGB(31,40,76),Enum.Material.Metal)
 end
end
local shards={}
local drones={}
local beacons={}
-- Co-op Chaos Titan: a shared boss that appears during Rift Surge.
local boss=part("Chaos Titan",Vector3.new(17,17,17),Vector3.new(0,17,0),
 palette[2],Enum.Material.Neon,false)
boss.Shape=Enum.PartType.Ball; boss.Transparency=1; boss.CanTouch=false
boss:SetAttribute("Health",0)
glow(boss,palette[2],35)
local bossActive=false; local bossHP=0; local bossContributors={}
local bossAttackAt=0
for index,biome in ipairs(biomes) do
 local center=biome.center
 local base=part(biome.id.." Island",Vector3.new(115,4,115),center+Vector3.new(0,-1,0),
  Color3.fromRGB(38+index*9,37+index*7,75+index*7))
 sign(biome.name:upper(),center+Vector3.new(0,22,0),biome.color,360)
 for i=1,8 do
  local angle=i*math.pi/4
  local x=math.cos(angle)*42; local z=math.sin(angle)*42
  local height=9+(i%3)*9
  local p=part(biome.id.." Landmark",Vector3.new(9,height,9),
   center+Vector3.new(x,height/2,z),Color3.fromRGB(30,40,74),Enum.Material.Metal)
  local cap=part(biome.id.." Glow Roof",Vector3.new(11,2,11),
   p.Position+Vector3.new(0,height/2+1,0),biome.color,Enum.Material.Neon,false)
  if index==2 then
   local crystal=part("Prism Spire",Vector3.new(5,height+8,5),
    p.Position+Vector3.new(0,7,0),biome.color,Enum.Material.Glass,false)
   crystal.CFrame=crystal.CFrame*CFrame.Angles(0,math.rad(i*30),math.rad(10))
  elseif index==3 then
   local fire=Instance.new("Fire"); fire.Size=7; fire.Heat=5; fire.Parent=cap
  elseif index==4 then
   local cloud=part("Cloud Platform",Vector3.new(16,2,16),
    p.Position+Vector3.new(0,height/2+8,0),Color3.fromRGB(235,239,255),nil,false)
   cloud.Shape=Enum.PartType.Ball
  end
 end
 local beacon=part("Rift Core "..biome.id,Vector3.new(10,13,10),
  center+Vector3.new(0,8,28),biome.color,Enum.Material.Neon,false)
 beacon.Shape=Enum.PartType.Ball; glow(beacon,biome.color,22)
 local prompt=Instance.new("ProximityPrompt"); prompt.ActionText="Seal Rift (12 shards)"
 prompt.ObjectText=biome.name; prompt.HoldDuration=1; prompt.MaxActivationDistance=14
 prompt.RequiresLineOfSight=false; prompt.Parent=beacon
 beacons[beacon]=biome
 sign("SEAL RIFT: 12 SHARDS",beacon.Position+Vector3.new(0,12,0),biome.color,280)
 for i=1,9 do
  local angle=i*math.pi*2/9
  local radius=20+(i%3)*10
  local orb=part("Rift Shard",Vector3.new(4,4,4),
   center+Vector3.new(math.cos(angle)*radius,5,math.sin(angle)*radius),
   palette[(index+i-2)%5+1],Enum.Material.Neon,false)
  orb.Shape=Enum.PartType.Ball; orb:SetAttribute("Biome",biome.id)
  glow(orb,orb.Color,10)
  table.insert(shards,orb)
 end
 for i=1,3 do
  local a=i*math.pi*2/3
  local spawnPos=center+Vector3.new(math.cos(a)*28,6,math.sin(a)*28)
  local drone=part("Rift Drone",Vector3.new(7,7,7),spawnPos,
   biome.color,Enum.Material.Neon,false)
  drone.Shape=Enum.PartType.Ball; drone:SetAttribute("Health",3)
  drone:SetAttribute("Biome",biome.id)
  glow(drone,biome.color)
  drones[drone]={home=spawnPos,health=3,alive=true,attackAt=0}
 end
end
-- Reusable hand-built asset kit populates the islands without external downloads.
WorldKit.Populate(world,biomes)
-- A small physical skill course with a real summit reward.
local sky=biomes[4].center
for i=1,5 do
 part("Cloud Jump "..i,Vector3.new(13,2,13),
  sky+Vector3.new(-27+i*10,4+i*5,-18+((i%2)*10)),
  Color3.fromRGB(228,239,255))
end
local summit=part("Cloud Summit",Vector3.new(13,3,13),
 sky+Vector3.new(23,32,-8),palette[4],Enum.Material.Neon,false)
sign("SUMMIT BONUS +80 COINS",summit.Position+Vector3.new(0,7,0),palette[4])
local event=Instance.new("RemoteEvent"); event.Name="RiftRaidersEvent"; event.Parent=ReplicatedStorage
local action=Instance.new("RemoteEvent"); action.Name="RiftRaidersAction"; action.Parent=ReplicatedStorage
local activitySignal=Instance.new("RemoteEvent"); activitySignal.Name="RiftActivitiesSignal"; activitySignal.Parent=ReplicatedStorage
-- Two reusable first-person/third-person sci-fi weapons. The server decides hits.
local ServerStorage=game:GetService("ServerStorage")
local function makeWeapon(name,color,length)
 local tool=Instance.new("Tool"); tool.Name=name
 tool.ToolTip="Aim with camera, tap or click to fire"
 tool.RequiresHandle=true; tool.CanBeDropped=false
 tool.Grip=CFrame.new(0,-.2,-.6)*CFrame.Angles(0,math.rad(90),0)
 local handle=Instance.new("Part"); handle.Name="Handle"
 handle.Size=Vector3.new(1,1.2,3.2); handle.Color=Color3.fromRGB(38,45,63)
 handle.Material=Enum.Material.Metal; handle.CanCollide=false; handle.Massless=true
 handle.Parent=tool
 local barrel=Instance.new("Part"); barrel.Name="Glowing Barrel"
 barrel.Size=Vector3.new(.7,.7,length); barrel.Material=Enum.Material.Neon
 barrel.Color=color; barrel.CanCollide=false; barrel.Massless=true
 barrel.CFrame=handle.CFrame*CFrame.new(0,0,-length*.45)
 barrel.Parent=tool
 local weld=Instance.new("WeldConstraint"); weld.Part0=handle; weld.Part1=barrel; weld.Parent=handle
 tool.Parent=ServerStorage
 return tool
end
local pulseTemplate=makeWeapon("Pulse Rifle",palette[1],4)
local scatterTemplate=makeWeapon("Scatter Blaster",palette[2],2.5)
local function grantWeapon(p,template)
 local backpack=p:FindFirstChildOfClass("Backpack")
 if not backpack then return end
 if backpack:FindFirstChild(template.Name) or (p.Character and p.Character:FindFirstChild(template.Name)) then return end
 template:Clone().Parent=backpack
end
local profiles={}
local store=nil
if not RunService:IsStudio() and game.GameId~=0 then
 store=DataStoreService:GetDataStore("RiftRaidersProfiles_v1")
end
local function cleanInt(n,max)
 return (type(n)=="number" and n==n and n&gt;=0) and math.clamp(math.floor(n),0,max) or 0
end
local function tell(p,msg) event:FireClient(p,tostring(msg)) end
local function applyTrail(p)
 local s=profiles[p]
 local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
 if not s or not root or not s.owned.AURORA_TRAIL then return end
 if root:FindFirstChild("AuroraLegendTrail") then return end
 local a=Instance.new("Attachment"); a.Name="AuroraTrailTop"
 a.Position=Vector3.new(0,1,0); a.Parent=root
 local b=Instance.new("Attachment"); b.Name="AuroraTrailBottom"
 b.Position=Vector3.new(0,-1,0); b.Parent=root
 local t=Instance.new("Trail"); t.Name="AuroraLegendTrail"
 t.Attachment0=a; t.Attachment1=b; t.Lifetime=.65
 t.MinLength=.12; t.LightEmission=.8; t.FaceCamera=true
 t.Color=ColorSequence.new(Color3.fromRGB(103,255,218),
  Color3.fromRGB(160,104,255))
 t.Transparency=NumberSequence.new(0.22,1)
 t.Parent=root
end
local function sync(p)
 local s=profiles[p]; if not s then return end
 p:SetAttribute("RRCoins",s.coins); p:SetAttribute("RRShards",s.shards)
 p:SetAttribute("RRLevel",s.level); p:SetAttribute("RRXP",s.xp)
 p:SetAttribute("RRBlaster",s.blaster); p:SetAttribute("RRShield",s.shieldOwned)
 p:SetAttribute("RRPet",s.petOwned); p:SetAttribute("RRSeals",s.seals)
 p:SetAttribute("RRScatter",s.scatterOwned)
 p:SetAttribute("RRQuestShards",s.quest.shards)
 p:SetAttribute("RRQuestDrones",s.quest.drones)
 p:SetAttribute("RRQuestSeals",s.quest.seals)
 local r=s.resources or {}
 p:SetAttribute("RRWood",r.wood or 0); p:SetAttribute("RRMetal",r.metal or 0)
 p:SetAttribute("RRFish",r.fish or 0); p:SetAttribute("RRHide",r.hide or 0)
 p:SetAttribute("RRToolkits",r.toolkit or 0)
 p:SetAttribute("RRHeat",s.heat or 0)
 p:SetAttribute("RRSportsWins",(s.jobs and s.jobs.sports) or 0)
 p:SetAttribute("RRHeists",(s.jobs and s.jobs.heists) or 0)
 p:SetAttribute("RRHouseOwned",(s.jobs and s.jobs.houseOwned) or false)
 for _,item in ipairs(Catalog.Items) do
  p:SetAttribute("RROwn_"..item.id,s.owned[item.id]==true)
 end
 p:SetAttribute("RRActiveVehicleWrap",
  s.owned.PLATINUM_WRAP and "PLATINUM" or
  s.owned.CITY_WRAP and "MIDNIGHT" or "DEFAULT")
 Life.Sync(p)
 local ls=p:FindFirstChild("leaderstats")
 if ls then
  ls.Level.Value=s.level; ls.Coins.Value=s.coins; ls.Rifts.Value=s.seals
 end
end
local function reward(p,coins,xp,shards)
 local s=profiles[p]; if not s then return end
 local boost=world:GetAttribute("Phase")=="SURGE" and 2 or 1
 s.coins=math.min(1000000,s.coins+math.max(0,coins or 0)*boost)
 s.shards=math.min(100000,s.shards+math.max(0,shards or 0))
 s.xp+=math.max(0,xp or 0)
 while s.xp&gt;=80+s.level*25 and s.level&lt;100 do
  s.xp-=80+s.level*25; s.level+=1
  s.coins=math.min(1000000,s.coins+50)
  tell(p,"LEVEL UP! LEVEL "..s.level.." +50 COINS")
 end
 sync(p)
end
-- Seven terrain-based regions, interactive landmarks and server-owned portals.
local newDestinations=WorldExpansion.Build(world,WorldKit,reward,tell,Vehicles.Spawn)
local activityDestinations=WorldActivities.Build(world,{
 getProfile=function(p) return profiles[p] end,
 reward=reward,sync=sync,tell=tell,signal=activitySignal,
 spawnVehicle=Vehicles.Spawn,hasVehicle=Vehicles.HasActive
})
WorldPolish.Build(world,WorldKit)
local lifeDestination=Life.Build(world,{
 getProfile=function(p) return profiles[p] end,
 reward=reward,sync=sync,tell=tell
})
LifeCityVisuals.Build(world)
local modernCityDestination=ModernCityIntegration.Build(world,spawn,tell)
local importedDowntown=workspace:FindFirstChild("OfficialModernCityDistrict")
if importedDowntown then
 Life.AttachDowntown(importedDowntown)
 DowntownPopulation.Build(world,importedDowntown,{tell=tell})
end
Life.Start()
local function quest(p,kind,n)
 local s=profiles[p]; if not s then return end
 s.quest[kind]=math.min(({shards=8,drones=3,seals=1})[kind],s.quest[kind]+(n or 1))
 if s.quest.shards==8 and s.quest.drones==3 and s.quest.seals==1 then
  s.quest={shards=0,drones=0,seals=0}
  reward(p,250,120,0); tell(p,"MISSION COMPLETE! +250 COINS +120 XP")
 end
 sync(p)
end
local function save(p)
 local s=profiles[p]
 if not store or not s or not s.loaded then return end
 local payload={version=7,coins=s.coins,shards=s.shards,level=s.level,xp=s.xp,
  blaster=s.blaster,shieldOwned=s.shieldOwned,petOwned=s.petOwned,
  scatterOwned=s.scatterOwned,seals=s.seals,
  resources={
   wood=cleanInt(s.resources.wood,9999),metal=cleanInt(s.resources.metal,9999),
   fish=cleanInt(s.resources.fish,9999),hide=cleanInt(s.resources.hide,9999),
   toolkit=cleanInt(s.resources.toolkit,9999)
  },
  jobs={
   sports=cleanInt(s.jobs.sports,100000),heists=cleanInt(s.jobs.heists,100000),
   bankCooldownUntil=cleanInt(s.jobs.bankCooldownUntil,9999999999),
   carCooldownUntil=cleanInt(s.jobs.carCooldownUntil,9999999999),
   houseOwned=s.jobs.houseOwned==true
  },
  prestige=Catalog.ValidateOwned(s.owned),
  life=Life.Serialize(s.life)}
 local key="Player_"..p.UserId
 local ok,err=pcall(function()
  store:UpdateAsync(key,function(previous)
   local value=type(previous)=="table" and previous or {}
   -- Never regress an existing account to an older schema.
   if type(value.version)=="number" and value.version&gt;7 then return nil end
   return payload
  end)
 end)
 if not ok then warn("RiftRaiders save failed",p.UserId,err) end
end
local function init(p)
 local s={coins=0,shards=0,level=1,xp=0,blaster=1,shieldOwned=false,
  petOwned=false,scatterOwned=false,seals=0,quest={shards=0,drones=0,seals=0},
  shardTimes={},beaconTimes={},summitAt=0,lastBlast=0,lastDash=0,lastShield=0,
  shieldUntil=0,travelAt=0,lastShoot=0,loaded=false,pet=nil,
  resources={wood=0,metal=0,fish=0,hide=0,toolkit=0},
  jobs={sports=0,heists=0,bankCooldownUntil=0,carCooldownUntil=0,
   houseOwned=false},owned={},life=Life.Normalize(nil),heat=0}
 if store then
  local ok,data=pcall(function() return store:GetAsync("Player_"..p.UserId) end)
  if ok then
   if type(data)=="table" and (data.version==nil or data.version==1 or data.version==2 or data.version==3 or data.version==4 or data.version==5 or data.version==6 or data.version==7) then
    s.coins=cleanInt(data.coins,1000000); s.shards=cleanInt(data.shards,100000)
    s.level=math.max(1,cleanInt(data.level,100)); s.xp=cleanInt(data.xp,100000)
    s.blaster=math.clamp(cleanInt(data.blaster,4),1,4)
    s.shieldOwned=data.shieldOwned==true; s.petOwned=data.petOwned==true
    s.scatterOwned=data.scatterOwned==true
    s.seals=cleanInt(data.seals,1000000)
    if type(data.resources)=="table" then
     for _,key in ipairs({"wood","metal","fish","hide","toolkit"}) do
      s.resources[key]=cleanInt(data.resources[key],9999)
     end
    end
    if type(data.jobs)=="table" then
     s.jobs.sports=cleanInt(data.jobs.sports,100000)
     s.jobs.heists=cleanInt(data.jobs.heists,100000)
     s.jobs.bankCooldownUntil=cleanInt(data.jobs.bankCooldownUntil,9999999999)
     s.jobs.carCooldownUntil=cleanInt(data.jobs.carCooldownUntil,9999999999)
     s.jobs.houseOwned=data.jobs.houseOwned==true
    end
    s.owned=Catalog.ValidateOwned(data.prestige)
    s.life=Life.Normalize(data.life)
   end
   s.loaded=true
  else
   warn("RiftRaiders load failed; save disabled for session",p.UserId,data)
  end
 end
 if not p.Parent then return end
 profiles[p]=s
 WorldActivities.PlayerJoined(p)
 Life.PlayerJoined(p)
 local ls=Instance.new("Folder"); ls.Name="leaderstats"; ls.Parent=p
 for _,name in ipairs({"Level","Coins","Rifts"}) do
  local v=Instance.new("IntValue"); v.Name=name; v.Parent=ls
 end
 sync(p)
 task.defer(function()
  -- Players start as ordinary citizens in downtown, not armed adventurers.
  Life.GiveCamera(p)
 end)
 p.CharacterAdded:Connect(function()
  task.wait(.25)
  if profiles[p] then
   sync(p)
   Life.GiveCamera(p)
   applyTrail(p)
  end
 end)
 tell(p,"WELCOME TO RIFTLIFE! EXPLORE DOWNTOWN • WORLD → LIFE CITY FOR JOBS!")
end
Players.PlayerAdded:Connect(init)
Players.PlayerRemoving:Connect(function(p)
 WorldActivities.PlayerRemoving(p)
 save(p)
 local s=profiles[p]; if s and s.pet then s.pet:Destroy() end
 profiles[p]=nil
end)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(init,p) end
task.spawn(function()
 while world.Parent do
  task.wait(90)
  for p in pairs(profiles) do task.spawn(save,p) end
 end
end)
if store then
 game:BindToClose(function()
  for p in pairs(profiles) do task.spawn(save,p) end
  task.wait(3)
 end)
end

local function rootFor(p)
 return p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end
local function spawnPet(p)
 local s=profiles[p]; if not s or not s.petOwned or s.pet then return end
 local pet=part("Riftling Companion",Vector3.new(3.4,3.4,3.4),
  Vector3.new(0,10,0),palette[3],Enum.Material.Neon,false)
 pet.Shape=Enum.PartType.Ball; pet.CanTouch=false; s.pet=pet
 glow(pet,pet.Color,12)
end
local marinaDestination=Boats.Build(world)
local destinations={HUB=Vector3.new(0,6,0),WATERFRONT=marinaDestination}
for _,b in ipairs(biomes) do destinations[b.id]=b.center+Vector3.new(0,6,0) end
for id,pos in pairs(newDestinations) do destinations[id]=pos end
for id,pos in pairs(activityDestinations) do destinations[id]=pos end
destinations.LIFE=lifeDestination
destinations.ESTATES=Vector3.new(0,8,2711)
if modernCityDestination then destinations.MODERN=modernCityDestination end
local function blast(p)
 local s=profiles[p]; local root=rootFor(p)
 if not s or not root then return end
 local now=os.clock()
 if now-s.lastBlast&lt;.55 then return end
 s.lastBlast=now
 if bossActive and (root.Position-boss.Position).Magnitude&lt;48 then
  bossHP=math.max(0,bossHP-s.blaster)
  boss:SetAttribute("Health",bossHP)
  bossContributors[p]=true
  tell(p,"CHAOS TITAN HIT! "..bossHP.." HP LEFT!")
  if bossHP==0 then
   bossActive=false; boss.Transparency=1
   world:SetAttribute("BossHealth",0)
   for contributor in pairs(bossContributors) do
    if profiles[contributor] then
     reward(contributor,300,120,10)
     tell(contributor,"TITAN DEFEATED! +300 COINS +10 SHARDS!")
    end
   end
   bossContributors={}
  else
   world:SetAttribute("BossHealth",bossHP)
  end
  return
 end
 local target=nil; local best=32
 for drone,d in pairs(drones) do
  if d.alive then
   local delta=drone.Position-root.Position
   local distance=delta.Magnitude
   if distance&lt;best then
    target=drone; best=distance
   end
  end
 end
 if not target then tell(p,"MOVE CLOSER TO A DRONE TO BLAST!"); return end
 local d=drones[target]
 d.health-=s.blaster
 target:SetAttribute("Health",math.max(0,d.health))
 tell(p,"ZAP! DRONE HIT "..s.blaster.." DAMAGE!")
 if d.health&lt;=0 then
  d.alive=false; target.Transparency=1; target.CanTouch=false
  reward(p,30,25,2); quest(p,"drones",1)
  tell(p,"DRONE DEFEATED! +30 COINS +2 SHARDS!")
  task.delay(9,function()
   if target.Parent then
    d.alive=true; d.health=3; target.Position=d.home
    target.Transparency=0; target.CanTouch=true
    target:SetAttribute("Health",3)
   end
  end)
 end
end
-- Long-range pulse and scatter weapons: the client supplies aim, never a hit.
local function shoot(p,aim,weaponName)
 local s=profiles[p]; local root=rootFor(p)
 if not s or not root or typeof(aim)~="Vector3" then return end
 if aim.X~=aim.X or aim.Y~=aim.Y or aim.Z~=aim.Z then return end
 if aim.Magnitude&lt;.9 or aim.Magnitude&gt;1.1 then return end
 if weaponName~="Pulse Rifle" and weaponName~="Scatter Blaster" then return end
 if weaponName=="Scatter Blaster" and not s.scatterOwned then return end
 local backpack=p:FindFirstChildOfClass("Backpack")
 if not ((p.Character and p.Character:FindFirstChild(weaponName)) or
  (backpack and backpack:FindFirstChild(weaponName))) then return end
 local now=os.clock()
 local scatter=weaponName=="Scatter Blaster"
 if now-s.lastShoot&lt;(scatter and .85 or .22) then return end
 s.lastShoot=now
 local origin=root.Position+Vector3.new(0,1.8,0)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={p.Character}
 params.IgnoreWater=true
 local count=scatter and 4 or 1
 local maxDistance=scatter and 70 or 125
 for i=1,count do
  local spread=scatter and Vector3.new((i-2.5)*.045,((i%2)*2-1)*.035,0) or Vector3.zero
  local direction=(aim+spread).Unit
  local hit=workspace:Raycast(origin,direction*maxDistance,params)
  local endpoint=hit and hit.Position or origin+direction*maxDistance
  local length=(endpoint-origin).Magnitude
  if length&gt;.1 then
   local tracer=Instance.new("Part"); tracer.Name="Pulse Tracer"
   tracer.Size=Vector3.new(.17,.17,length)
   tracer.CFrame=CFrame.lookAt((origin+endpoint)*.5,endpoint)
   tracer.Material=Enum.Material.Neon
   tracer.Color=scatter and palette[2] or palette[1]
   tracer.CanCollide=false; tracer.CanTouch=false; tracer.CanQuery=false
   tracer.Anchored=true; tracer.Parent=world
   Debris:AddItem(tracer,.12)
  end
  local target=hit and hit.Instance
  if target==boss and bossActive then
   bossHP=math.max(0,bossHP-1)
   boss:SetAttribute("Health",bossHP)
   bossContributors[p]=true
   world:SetAttribute("BossHealth",bossHP)
   if bossHP==0 then
    bossActive=false; boss.Transparency=1
    for contributor in pairs(bossContributors) do
     if profiles[contributor] then
      reward(contributor,300,120,10)
      tell(contributor,"TITAN DEFEATED! +300 COINS +10 SHARDS!")
     end
    end
    bossContributors={}
   end
  elseif target and drones[target] and drones[target].alive then
   local d=drones[target]
   d.health-=1
   target:SetAttribute("Health",math.max(0,d.health))
   if d.health&lt;=0 then
    d.alive=false; target.Transparency=1; target.CanTouch=false
    reward(p,30,25,2); quest(p,"drones",1)
    tell(p,"DRONE DOWN! +30 COINS +2 SHARDS!")
    task.delay(9,function()
     if target.Parent then
      d.alive=true; d.health=3; target.Position=d.home
      target.Transparency=0; target.CanTouch=true
      target:SetAttribute("Health",3)
     end
    end)
   end
  end
 end
end
for _,shard in ipairs(shards) do
 shard.Touched:Connect(function(hit)
  local char=hit:FindFirstAncestorOfClass("Model")
  local p=char and Players:GetPlayerFromCharacter(char)
  local s=p and profiles[p]; local root=p and rootFor(p)
  if not s or not root or (root.Position-shard.Position).Magnitude&gt;14 then return end
  local now=os.clock()
  if s.shardTimes[shard] and now-s.shardTimes[shard]&lt;25 then return end
  s.shardTimes[shard]=now
  reward(p,5,8,1); quest(p,"shards",1)
  tell(p,"+1 RIFT SHARD • +5 COINS")
 end)
end
for beacon,biome in pairs(beacons) do
 local prompt=beacon:FindFirstChildOfClass("ProximityPrompt")
 prompt.Triggered:Connect(function(p)
  local s=profiles[p]; local root=rootFor(p)
  if not s or not root or (root.Position-beacon.Position).Magnitude&gt;17 then return end
  local now=os.clock()
  if s.beaconTimes[beacon] and now-s.beaconTimes[beacon]&lt;50 then
   tell(p,"THIS RIFT NEEDS TIME TO RECHARGE!"); return
  end
  if s.shards&lt;12 then tell(p,"NEED 12 SHARDS TO SEAL THIS RIFT!"); return end
  s.shards-=12; s.beaconTimes[beacon]=now; s.seals+=1
  reward(p,75,80,0); quest(p,"seals",1)
  tell(p,"RIFT SEALED! "..biome.name:upper().." +75 COINS!")
 end)
end
summit.Touched:Connect(function(hit)
 local char=hit:FindFirstAncestorOfClass("Model")
 local p=char and Players:GetPlayerFromCharacter(char)
 local s=p and profiles[p]; local root=p and rootFor(p)
 if not s or not root or (root.Position-summit.Position).Magnitude&gt;15 then return end
 if root.Position.Y&lt;26 then return end
 local now=os.clock()
 if now-s.summitAt&lt;60 then return end
 s.summitAt=now
 reward(p,80,65,3)
 tell(p,"SKY SUMMIT! +80 COINS +3 SHARDS!")
end)
action.OnServerEvent:Connect(function(p,kind,arg,extra)
 local s=profiles[p]; local root=rootFor(p)
 if not s or not root or type(kind)~="string" then return end
 local now=os.clock()
 if kind=="LifeAction" then
  if type(arg)=="string" and #arg&lt;=24 then Life.Process(p,arg,extra) end
  return
 end
 if Life.IsJailed(p) then
  tell(p,"SERVE YOUR IN-GAME JAIL SENTENCE BEFORE TAKING ACTION.")
  return
 end
 if kind=="SpawnBoat" then
  local ok,message=Boats.Spawn(p,arg)
  tell(p,message)
  return
 end
 if kind=="ActivityHit" then
  if type(arg)=="string" and #arg&lt;32 then WorldActivities.Hit(p,arg) end
  return
 end
 if kind=="Blast" then blast(p); return end
 if kind=="Shoot" then shoot(p,arg,extra); return end
 if kind=="SpawnCar" or kind=="SpawnSnowmobile" or kind=="SpawnFlyingCar" then
  local vehicleKind=kind=="SpawnSnowmobile" and "snowmobile" or
   kind=="SpawnFlyingCar" and "flyingcar" or "car"
  local ok,message=Vehicles.Spawn(world,p,vehicleKind)
  tell(p,message)
  return
 end
 if kind=="Dash" then
  if now-s.lastDash&lt;6 then return end
  s.lastDash=now
  local direction=root.CFrame.LookVector
  root.AssemblyLinearVelocity=Vector3.new(direction.X*72,18,direction.Z*72)
  tell(p,"DASH!")
 elseif kind=="Shield" then
  if not s.shieldOwned then tell(p,"UNLOCK SHIELD IN SHOP FOR 150 COINS!"); return end
  if now-s.lastShield&lt;20 then return end
  s.lastShield=now; s.shieldUntil=now+6
  local char=p.Character
  if char then
   local old=char:FindFirstChild("RiftShield")
   if old then old:Destroy() end
   local force=Instance.new("ForceField"); force.Name="RiftShield"
   force.Parent=char
   task.delay(6,function() if force.Parent then force:Destroy() end end)
  end
  tell(p,"SHIELD ACTIVE FOR 6 SECONDS!")
 elseif kind=="Travel" then
  if type(arg)~="string" or not destinations[arg] then return end
  if now-s.travelAt&lt;2 then return end
  s.travelAt=now
  p.Character:PivotTo(CFrame.new(destinations[arg]))
  if arg=="MODERN" or arg=="LIFE" then
   -- Keep realistic life-simulation zones free of the fantasy rifle hotbar.
   for _,container in ipairs({p.Character,p:FindFirstChildOfClass("Backpack")}) do
    if container then
     for _,name in ipairs({"Pulse Rifle","Scatter Blaster"}) do
      local tool=container:FindFirstChild(name)
      if tool then tool:Destroy() end
     end
    end
   end
  else
   grantWeapon(p,pulseTemplate)
   if s.scatterOwned then grantWeapon(p,scatterTemplate) end
  end
  tell(p,"ARRIVED: "..arg)
 elseif kind=="BuyPrestige" then
  if type(arg)~="string" then return end
  local item=Catalog.ById[arg]
  if not item then return end
  if s.owned[item.id] then tell(p,"ALREADY OWNED: "..item.name); return end
  if s.level&lt;item.level then
   tell(p,item.name.." UNLOCKS AT LEVEL "..item.level); return
  end
  if s.coins&lt;item.coins then
   tell(p,"EARN "..(item.coins-s.coins).." MORE COINS FOR "..item.name); return
  end
  local wood=item.wood or 0; local metal=item.metal or 0
  if s.resources.wood&lt;wood or s.resources.metal&lt;metal then
   tell(p,"NEED "..wood.." WOOD AND "..metal.." METAL"); return
  end
  s.coins-=item.coins
  s.resources.wood-=wood; s.resources.metal-=metal
  s.owned[item.id]=true
  sync(p)
  WorldActivities.RefreshHouse(p)
  applyTrail(p)
  tell(p,"PRESTIGE UNLOCKED: "..item.name.."!")
  return
 elseif kind=="Buy" then
  if arg=="BLASTER" then
   if s.blaster&gt;=4 then tell(p,"BLASTER MAX LEVEL!"); return end
   local cost=s.blaster*90
   if s.coins&lt;cost then tell(p,"NEED "..cost.." COINS!"); return end
   s.coins-=cost; s.blaster+=1
   tell(p,"BLASTER UPGRADED TO LEVEL "..s.blaster.."!")
  elseif arg=="SHIELD" then
   if s.shieldOwned then tell(p,"SHIELD ALREADY OWNED!"); return end
   if s.coins&lt;150 then tell(p,"NEED 150 COINS!"); return end
   s.coins-=150; s.shieldOwned=true
   tell(p,"SHIELD UNLOCKED! PRESS SHIELD TO ACTIVATE!")
  elseif arg=="SCATTER" then
   if s.scatterOwned then tell(p,"SCATTER BLASTER ALREADY OWNED!"); return end
   if s.coins&lt;175 then tell(p,"NEED 175 COINS!"); return end
   s.coins-=175; s.scatterOwned=true
   grantWeapon(p,scatterTemplate)
   tell(p,"SCATTER BLASTER UNLOCKED! EQUIP IT FROM BACKPACK!")
  elseif arg=="PET" then
   if s.petOwned then tell(p,"RIFTLING ALREADY OWNED!"); return end
   if s.coins&lt;250 then tell(p,"NEED 250 COINS!"); return end
   s.coins-=250; s.petOwned=true; spawnPet(p)
   tell(p,"YOU ADOPTED A RIFTLING!")
  else return end
  sync(p)
 end
end)
local tickAccum=0
RunService.Heartbeat:Connect(function(dt)
 tickAccum+=dt
 if tickAccum&lt;.18 then return end
 local step=math.min(tickAccum,.3); tickAccum=0
 for drone,d in pairs(drones) do
  if d.alive then
   local closest=nil; local best=52
   for p,s in pairs(profiles) do
    local root=rootFor(p)
    local hum=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    if root and hum and hum.Health&gt;0 then
     local dist=(root.Position-drone.Position).Magnitude
     if dist&lt;best then closest=p; best=dist end
    end
   end
   if closest then
    local root=rootFor(closest)
    local delta=root.Position-drone.Position
    if delta.Magnitude&gt;4 then
     local nextPos=drone.Position+delta.Unit*math.min(delta.Magnitude,step*13)
     drone.Position=Vector3.new(nextPos.X,d.home.Y,nextPos.Z)
    elseif os.clock()-d.attackAt&gt;2.2 then
     d.attackAt=os.clock()
     local s=profiles[closest]
     if s and os.clock()&gt;s.shieldUntil then
      local hum=closest.Character and closest.Character:FindFirstChildOfClass("Humanoid")
      if hum then hum:TakeDamage(8) end
      tell(closest,"DRONE HIT! BLAST OR DASH TO ESCAPE!")
     end
    end
   else
    drone.Position=drone.Position:Lerp(d.home,.07)
   end
  end
 end
 if bossActive then
  boss.CFrame=boss.CFrame*CFrame.Angles(0,step*.5,0)
  if os.clock()-bossAttackAt&gt;2.4 then
   bossAttackAt=os.clock()
   for p,s in pairs(profiles) do
    local root=rootFor(p)
    if root and (root.Position-boss.Position).Magnitude&lt;24 and os.clock()&gt;s.shieldUntil then
     local hum=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
     if hum then hum:TakeDamage(10) end
     tell(p,"CHAOS TITAN SHOCKWAVE! DASH AWAY!")
    end
   end
  end
 end
 for p,s in pairs(profiles) do
  if s.petOwned and not s.pet then spawnPet(p) end
  local root=rootFor(p)
  if root and s.pet then s.pet.CFrame=root.CFrame*CFrame.new(3,3,3) end
 end
end)
task.spawn(function()
 while world.Parent do
  for remaining=75,0,-1 do
   world:SetAttribute("Phase","CALM")
   world:SetAttribute("SecondsLeft",remaining)
   task.wait(1)
  end
  world:SetAttribute("Phase","SURGE")
  bossHP=26; bossActive=true; bossContributors={}
  boss.Transparency=0; boss:SetAttribute("Health",bossHP)
  world:SetAttribute("BossHealth",bossHP)
  for _,p in ipairs(Players:GetPlayers()) do
   tell(p,"RIFT SURGE! DOUBLE COINS! DEFEAT THE CHAOS TITAN AT HUB!")
  end
  -- Do not tint the entire realistic downtown purple during fantasy surges.
  Lighting.Ambient=Color3.fromRGB(120,132,179)
  for remaining=25,0,-1 do
   world:SetAttribute("SecondsLeft",remaining)
   task.wait(1)
  end
  bossActive=false; bossHP=0; bossContributors={}
  boss.Transparency=1; boss:SetAttribute("Health",0)
  world:SetAttribute("BossHealth",0)
  Lighting.Ambient=Color3.fromRGB(120,132,179)
 end
end)
print("SF_RIFT_RAIDERS_SERVER_READY v0.13.0")
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">UrbanGardening</string>
        <string name="Source">-- Rift Raiders v0.12: usable downtown gardening and produce market.
-- All plots/actions are server-authoritative; purchases use earned coins.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Garden={}
Garden.Crops={
 TOMATO_SEEDS={name="Tomatoes",grow=55,yield=3,value=18,color=Color3.fromRGB(202,60,49)},
 CARROT_SEEDS={name="Carrots",grow=45,yield=4,value=12,color=Color3.fromRGB(237,137,52)},
 STRAWBERRY_SEEDS={name="Strawberries",grow=60,yield=3,value=24,color=Color3.fromRGB(207,54,68)},
 POTATO_SEEDS={name="Potatoes",grow=48,yield=4,value=11,color=Color3.fromRGB(165,119,83)},
 LETTUCE_SEEDS={name="Lettuce",grow=38,yield=3,value=11,color=Color3.fromRGB(109,168,80)},
 PEPPER_SEEDS={name="Bell Peppers",grow=58,yield=3,value=20,color=Color3.fromRGB(219,165,49)},
 CUCUMBER_SEEDS={name="Cucumbers",grow=55,yield=4,value=15,color=Color3.fromRGB(77,142,72)},
 CORN_SEEDS={name="Sweet Corn",grow=80,yield=4,value=22,color=Color3.fromRGB(242,198,74)},
 PUMPKIN_SEEDS={name="Pumpkins",grow=90,yield=2,value=54,color=Color3.fromRGB(222,113,49)},
 SUNFLOWER_SEEDS={name="Sunflowers",grow=60,yield=3,value=15,color=Color3.fromRGB(242,196,60)},
 BLUEBERRY_SEEDS={name="Blueberries",grow=80,yield=4,value=26,color=Color3.fromRGB(75,82,165)},
 ROSE_SEEDS={name="Roses",grow=75,yield=3,value=30,color=Color3.fromRGB(198,68,95)},
 APPLE_TREE_SEEDS={name="Apple Saplings",grow=105,yield=4,value=32,color=Color3.fromRGB(190,70,58)},
 WATERMELON_SEEDS={name="Watermelons",grow=100,yield=2,value=67,color=Color3.fromRGB(80,156,89)},
}
Garden.Order={
 "TOMATO_SEEDS","CARROT_SEEDS","STRAWBERRY_SEEDS","POTATO_SEEDS",
 "LETTUCE_SEEDS","PEPPER_SEEDS","CUCUMBER_SEEDS","CORN_SEEDS",
 "PUMPKIN_SEEDS","SUNFLOWER_SEEDS","BLUEBERRY_SEEDS",
 "ROSE_SEEDS","APPLE_TREE_SEEDS","WATERMELON_SEEDS"
}
local plots={}
local allocated={}
local gardenFolder=nil
local market=nil
local callbacks=nil
local elapsed=0
local function safeInt(value,max)
 return math.clamp(math.floor(tonumber(value) or 0),0,max)
end
function Garden.Normalize(raw)
 raw=type(raw)=="table" and raw or {}
 local crop=type(raw.crop)=="string" and Garden.Crops[raw.crop] and raw.crop or ""
 local now=os.time()
 local planted=safeInt(raw.plantedAt,now)
 if planted&lt;=0 then crop="";planted=0 end
 local inventory={}
 local seeds={}
 for id in pairs(Garden.Crops) do
  local stock=type(raw.seeds)=="table" and raw.seeds[id]
  local quantity=safeInt(stock,99)
  if quantity&gt;0 then seeds[id]=quantity end
  local qty=type(raw.produce)=="table" and raw.produce[id]
  local count=safeInt(qty,500)
  if count&gt;0 then inventory[id]=count end
 end
 return {
  crop=crop,plantedAt=planted,watered=raw.watered==true,
  harvests=safeInt(raw.harvests,100000),
  sales=safeInt(raw.sales,100000),
  produce=inventory,seeds=seeds,
 }
end
local function status(g)
 if not g or g.crop=="" then return "EMPTY" end
 local species=Garden.Crops[g.crop]
 if not species then return "EMPTY" end
 if os.time()-g.plantedAt&gt;=species.grow then
  return g.watered and "READY" or "NEEDS WATER"
 end
 return g.watered and "GROWING" or "DRY"
end
Garden.Status=status
function Garden.ProduceCount(g)
 local total=0
 if g then for _,qty in pairs(g.produce or {}) do total+=qty end end
 return total
end
local function block(parent,name,size,pos,color,material,collides)
 local item=Instance.new("Part")
 item.Name=name;item.Size=size;item.CFrame=CFrame.new(pos)
 item.Anchored=true;item.CanCollide=collides==true;item.CanTouch=false
 item.Material=material or Enum.Material.WoodPlanks
 item.Color=color;item.TopSurface=Enum.SurfaceType.Smooth
 item.BottomSurface=Enum.SurfaceType.Smooth;item.Parent=parent
 return item
end
local function ball(parent,name,size,pos,color,material)
 local item=block(parent,name,size,pos,color,material or Enum.Material.Grass,false)
 item.Shape=Enum.PartType.Ball;return item
end
local function pole(parent,name,size,pos,color,material)
 local item=block(parent,name,size,pos,color,material or Enum.Material.Wood,false)
 item.Shape=Enum.PartType.Cylinder;return item
end
local function prompt(base,action,label,fn)
 local p=Instance.new("ProximityPrompt")
 p.ActionText=action;p.ObjectText=label;p.HoldDuration=.4
 p.MaxActivationDistance=12;p.RequiresLineOfSight=false
 p.Parent=base;p.Triggered:Connect(fn)
 return p
end
local function label(base,title)
 local bill=Instance.new("BillboardGui")
 bill.Name="Garden Plot Label";bill.Size=UDim2.fromOffset(195,65)
 bill.StudsOffsetWorldSpace=Vector3.new(0,4,0)
 bill.MaxDistance=60;bill.AlwaysOnTop=false;bill.Parent=base
 local text=Instance.new("TextLabel")
 text.Name="Text";text.Size=UDim2.fromScale(1,1)
 text.BackgroundColor3=Color3.fromRGB(31,50,43);text.BackgroundTransparency=.12
 text.BorderSizePixel=0;text.Text=title;text.TextScaled=true
 text.TextWrapped=true;text.Font=Enum.Font.GothamBold
 text.TextColor3=Color3.fromRGB(246,237,214);text.Parent=bill
 return text
end
local function planter(index,pos)
 local m=Instance.new("Model")
 m.Name="Raised Garden Bed "..index;m.Parent=gardenFolder
 local frame=block(m,"Garden Cedar Foundation",Vector3.new(12,1,9),
  pos+Vector3.new(0,1,0),Color3.fromRGB(132,96,60),Enum.Material.WoodPlanks,true)
 local soil=block(m,"Organic Garden Soil",Vector3.new(10.4,.65,7.4),
  pos+Vector3.new(0,1.7,0),Color3.fromRGB(100,70,55),Enum.Material.Ground,true)
 for _,x in ipairs({-5.7,5.7}) do
  block(m,"Bed Cedar Border",Vector3.new(.65,1.7,9.6),
   pos+Vector3.new(x,2,0),Color3.fromRGB(156,120,75),Enum.Material.WoodPlanks,true)
 end
 for _,z in ipairs({-4.1,4.1}) do
  block(m,"Bed Cedar Border",Vector3.new(12,1.7,.65),
   pos+Vector3.new(0,2,z),Color3.fromRGB(156,120,75),Enum.Material.WoodPlanks,true)
 end
 local sign=block(m,"Garden Bed Number "..index,Vector3.new(1,.25,1),
  pos+Vector3.new(-4.4,3,3),Color3.fromRGB(180,151,93),Enum.Material.Metal,false)
 local text=label(sign,"PLOT "..index.."\nUNASSIGNED")
 local visible=Instance.new("Model")
 visible.Name="Garden Plants";visible.Parent=m
 local rec={model=m,base=soil,position=pos,label=text,vegetation=visible,owner=nil}
 prompt(soil,"TEND GARDEN","Your Garden Bed",function(player)
  if callbacks and callbacks.process then callbacks.process(player,"GardenWater") end
 end)
 table.insert(plots,rec)
end
local function updatePlants(rec,g)
 rec.vegetation:ClearAllChildren()
 if not g or g.crop=="" then return end
 local species=Garden.Crops[g.crop]
 if not species then return end
 local stage=status(g)
 local fully=(stage=="READY" or stage=="NEEDS WATER")
 local age=math.max(0,os.time()-g.plantedAt)
 local grown=fully and 1 or math.clamp(age/species.grow,.1,.82)
 local height=(species.name=="Sweet Corn" or species.name=="Sunflowers") and 8 or 4.5
 if species.name=="Apple Saplings" then height=9 end
 for i=1,4 do
  local x=i%2==0 and 2.65 or -2.65
  local z=i&lt;=2 and -1.6 or 1.6
  local center=rec.position+Vector3.new(x,2,z)
  local size=math.max(.9,height*grown)
  local stalk=pole(rec.vegetation,"Crop Stem "..i,Vector3.new(.35,size,.35),
   center+Vector3.new(0,size*.5,0),Color3.fromRGB(75,127,61))
  for j=1,3 do
   local radius=math.max(.7,1.15*grown)
   ball(rec.vegetation,"Natural Leaf "..j,Vector3.new(radius*1.5,.25,radius),
    center+Vector3.new(j%2==0 and -.9 or .9,1+j*size*.17,j==1 and .7 or -.5),
    Color3.fromRGB(70+6*j,138+2*j,72),Enum.Material.Grass)
  end
  if fully then
   for j=1,2 do
    local fruitSize=(species.name=="Pumpkins" or species.name=="Watermelons") and 2 or
     (species.name=="Tomatoes" or species.name=="Bell Peppers") and 1.1 or .8
    local y=(species.name=="Potatoes" or species.name=="Carrots") and 2.25 or (2.2+size*.6)
    ball(rec.vegetation,"Ripe "..species.name.." "..j,
     Vector3.new(fruitSize,fruitSize,fruitSize),
     center+Vector3.new(j==1 and -.6 or .7,y-center.Y,
      j==1 and -.4 or .4),species.color,Enum.Material.SmoothPlastic)
   end
  end
 end
end
function Garden.SyncPlayer(player,g)
 local rec=allocated[player]
 player:SetAttribute("RRLifeGardenPlot",rec and rec.model.Name or "WAIT FOR PLOT")
 player:SetAttribute("RRLifeGardenCrop",g and g.crop or "")
 player:SetAttribute("RRLifeGardenStatus",status(g))
 player:SetAttribute("RRLifeGardenHarvests",g and g.harvests or 0)
 player:SetAttribute("RRLifeGardenProduce",Garden.ProduceCount(g))
 for id in pairs(Garden.Crops) do
  player:SetAttribute("RRLifeSeed_"..id,g and g.seeds[id] or 0)
 end
end
local function refresh(player)
 local rec=allocated[player]
 local state=callbacks and callbacks.getProfile(player)
 local g=state and state.life and state.life.garden
 if rec then
  local description=g and g.crop~="" and Garden.Crops[g.crop].name or "UNPLANTED"
  rec.label.Text=player.DisplayName.."\n"..description..": "..status(g)
  rec.base:SetAttribute("OwnerUserId",player.UserId)
  rec.base:SetAttribute("Crop",g and g.crop or "")
  rec.base:SetAttribute("Stage",status(g))
  updatePlants(rec,g)
 end
 Garden.SyncPlayer(player,g)
end
local function decorativeTool(player,name,kind)
 local backpack=player:FindFirstChildOfClass("Backpack")
 if not backpack or backpack:FindFirstChild(name) or
  (player.Character and player.Character:FindFirstChild(name)) then return end
 local tool=Instance.new("Tool")
 tool.Name=name;tool.CanBeDropped=false;tool.RequiresHandle=true
 tool.ToolTip=kind=="CAN" and "Water your garden with the bed prompt" or
  "Use the Garden menu to plant seeds at your raised bed"
 local handle=Instance.new("Part")
 handle.Name="Handle";handle.Size=Vector3.new(.45,2.3,.45)
 handle.Material=Enum.Material.Wood;handle.Color=Color3.fromRGB(126,89,61)
 handle.CanCollide=false;handle.Massless=true
 handle.Parent=tool
 local function element(name,size,offset,color,shape)
  local p=Instance.new("Part");p.Name=name;p.Size=size
  p.Shape=shape or Enum.PartType.Block
  p.Color=color;p.Material=Enum.Material.Metal
  p.CanCollide=false;p.Massless=true;p.CFrame=handle.CFrame*CFrame.new(offset)
  p.Parent=tool
  local weld=Instance.new("WeldConstraint")
  weld.Part0=handle;weld.Part1=p;weld.Parent=p
 end
 if kind=="CAN" then
  element("Watering Can Metal Body",Vector3.new(1.3,1.7,1.3),
   Vector3.new(0,-.45,0),Color3.fromRGB(77,148,179),Enum.PartType.Cylinder)
  element("Watering Spout",Vector3.new(1.6,.45,.45),
   Vector3.new(1.25,-.75,0),Color3.fromRGB(87,157,187),
   Enum.PartType.Cylinder)
  element("Pouring Head",Vector3.new(.35,.75,.75),
   Vector3.new(2,-.75,0),Color3.fromRGB(111,168,193),
   Enum.PartType.Cylinder)
 else
  element("Trowel Steel Blade",Vector3.new(.85,1.9,.25),
   Vector3.new(0,-1.7,0),Color3.fromRGB(156,164,168))
 end
 tool.Parent=backpack
end
function Garden.GiveTools(player,life)
 if not life or not life.owned then return end
 if life.owned.GARDEN_TROWEL then decorativeTool(player,"Garden Trowel","TROWEL") end
 if life.owned.WATERING_CAN then decorativeTool(player,"Watering Can","CAN") end
end
function Garden.PlayerJoined(player)
 if allocated[player] then return end
 for _,rec in ipairs(plots) do
  if not rec.owner then
   rec.owner=player;allocated[player]=rec;refresh(player)
   break
  end
 end
end
function Garden.PlayerRemoving(player)
 local rec=allocated[player]
 if rec then
  rec.owner=nil;rec.label.Text="GARDEN BED\nAVAILABLE"
  rec.base:SetAttribute("OwnerUserId",0)
  rec.base:SetAttribute("Crop","");rec.base:SetAttribute("Stage","EMPTY")
  rec.vegetation:ClearAllChildren()
 end
 allocated[player]=nil
end
function Garden.PlotFor(player)
 return allocated[player] and allocated[player].base or nil
end
local function nearby(player,node,maxdist)
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 return root and node and (root.Position-node.Position).Magnitude&lt;(maxdist or 16)
end
function Garden.Process(player,kind,arg,s)
 if not callbacks or not s or not s.life then return false end
 local life=s.life;local g=life.garden
 local rec=allocated[player]
 if not rec then callbacks.tell(player,"ALL GARDEN PLOTS ARE OCCUPIED RIGHT NOW.");return false end
 local isAtPlot=nearby(player,rec.base,19)
 if kind=="GardenPlant" then
  if type(arg)~="string" or not Garden.Crops[arg] then return false end
  if not isAtPlot then callbacks.tell(player,"VISIT YOUR ASSIGNED RAISED BED IN THE DOWNTOWN COMMUNITY GARDEN.");return false end
  if g.crop~="" then callbacks.tell(player,"HARVEST YOUR EXISTING CROP FIRST.");return false end
  if not life.owned.GARDEN_TROWEL or (g.seeds[arg] or 0)&lt;=0 then
   callbacks.tell(player,"BUY A GARDEN TROWEL AND A FRESH SEED PACK AT THE NURSERY FIRST.");return false
  end
  g.seeds[arg]-=1
  g.crop=arg;g.plantedAt=os.time();g.watered=false
  callbacks.tell(player,"PLANTED "..Garden.Crops[arg].name.."! WATER YOUR GARDEN TO GROW.")
 elseif kind=="GardenWater" then
  if not isAtPlot or g.crop=="" then return false end
  if not life.owned.WATERING_CAN then
   callbacks.tell(player,"BUY A WATERING CAN AT THE GARDEN NURSERY.");return false
  end
  if g.watered then callbacks.tell(player,"THIS CROP IS ALREADY WATERED.");return false end
  g.watered=true;callbacks.tell(player,"WATERED "..Garden.Crops[g.crop].name.." • COME BACK WHEN RIPE!")
 elseif kind=="GardenHarvest" then
  if not isAtPlot or g.crop=="" or status(g)~="READY" then
   callbacks.tell(player,"THE CROP MUST GROW AND BE WATERED BEFORE HARVEST.");return false
  end
  local species=Garden.Crops[g.crop]
  local amount=species.yield+(life.owned.GARDEN_FERTILIZER and 1 or 0)
  g.produce[g.crop]=math.min(500,(g.produce[g.crop] or 0)+amount)
  g.crop="";g.plantedAt=0;g.watered=false;g.harvests+=1
  callbacks.reward(player,0,8,0)
  callbacks.tell(player,"HARVESTED "..amount.." "..species.name.."! SELL AT THE FARM MARKET.")
 elseif kind=="GardenSell" then
  if not nearby(player,market,23) then return false end
  local total=0
  for id,n in pairs(g.produce) do
   local crop=Garden.Crops[id]
   if crop then total+=n*crop.value end
  end
  if total&lt;=0 then callbacks.tell(player,"GROW AND HARVEST SOMETHING FIRST.");return false end
  g.produce={};g.sales+=1
  callbacks.reward(player,total,10,0)
  callbacks.tell(player,"SOLD YOUR HARVEST FOR "..total.." EARNED COINS!")
 else
  return false
 end
 refresh(player)
 return true
end
function Garden.Build(world,options)
 callbacks=options
 if gardenFolder then gardenFolder:Destroy() end
 gardenFolder=Instance.new("Folder")
 gardenFolder.Name="Downtown Community Garden";gardenFolder.Parent=world
 table.clear(plots);table.clear(allocated)
 block(gardenFolder,"Community Garden Grass Lawn",Vector3.new(180,.4,55),
  Vector3.new(0,.1,2168),Color3.fromRGB(78,125,73),Enum.Material.Grass,true)
 for index=1,16 do
  local col=(index-1)%8
  local row=math.floor((index-1)/8)
  planter(index,Vector3.new(-70+col*20,1.5,2160+row*18))
 end
 local stand=block(gardenFolder,"Downtown Farm Produce Market",Vector3.new(14,4,6),
  Vector3.new(90,4,2185),Color3.fromRGB(122,85,53),Enum.Material.WoodPlanks,true)
 market=stand
 -- Original market stall: canopy, produce baskets and visible harvests.
 for _,x in ipairs({-6,6}) do
  block(gardenFolder,"Produce Market Canopy Post",Vector3.new(.5,8,.5),
   Vector3.new(90+x,8,2185),
   Color3.fromRGB(135,113,82),Enum.Material.Wood,true)
 end
 block(gardenFolder,"Outdoor Farm Market Awning",Vector3.new(18,.6,9),
  Vector3.new(90,12.3,2185),Color3.fromRGB(92,153,95),
  Enum.Material.Fabric,false)
 for idx,x in ipairs({-4,0,4}) do
  block(gardenFolder,"Fresh Market Basket",Vector3.new(3,1,3),
   Vector3.new(90+x,6.5,2185),Color3.fromRGB(155,121,72),
   Enum.Material.WoodPlanks,false)
  for j=1,4 do
   ball(gardenFolder,"Market Organic Produce",
    Vector3.new(.75,.75,.75),
    Vector3.new(90+x+(j%2)*1,7.2,2185+math.floor(j/3)*1),
    idx==1 and Color3.fromRGB(210,68,62) or
    idx==2 and Color3.fromRGB(223,137,53) or
    Color3.fromRGB(80,161,78),Enum.Material.SmoothPlastic)
  end
 end
 label(stand,"FARM MARKET\nSELL YOUR PRODUCE")
 prompt(stand,"SELL HARVEST","Downtown Produce Market",function(player)
  if callbacks and callbacks.process then callbacks.process(player,"GardenSell") end
 end)
 gardenFolder:SetAttribute("GardenBedCount",#plots)
 gardenFolder:SetAttribute("CropVarieties",#Garden.Order)
 local lastStages={}
 elapsed=0
 RunService.Heartbeat:Connect(function(dt)
  if not gardenFolder or not gardenFolder.Parent then return end
  elapsed+=dt
  if elapsed&lt;5 then return end
  elapsed=0
  for p,rec in pairs(allocated) do
   local s=callbacks.getProfile(p)
   local g=s and s.life and s.life.garden
   local stage=status(g)
   if lastStages[p]~=stage then
    lastStages[p]=stage
    refresh(p)
   end
  end
 end)
 Players.PlayerRemoving:Connect(function(p)
  lastStages[p]=nil
 end)
 return gardenFolder
end
return Garden
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="21">
      <Properties>
        <string name="Name">VehicleService</string>
        <string name="Source">-- Reusable, server-controlled arcade hovercar service.
-- VehicleSeat supplies keyboard/gamepad/touch throttle and steering.
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local ServerStorage=game:GetService("ServerStorage")
local Kit=require(script.Parent:WaitForChild("WorldKit"))
local Expansion=require(script.Parent:WaitForChild("WorldExpansion"))
local LifeCatalog=require(game:GetService("ReplicatedStorage"):WaitForChild("LifeCatalog"))
local Cars={}
local active={}
local cooldown={}
local function permitted(v)
 if v.Y&lt;2 or v.Y&gt;40 then return false end
 local x,z=v.X,v.Z
 if math.abs(x)&lt;52 and math.abs(z)&lt;52 then return true end
 if math.abs(x)&lt;155 and math.abs(z-1600)&lt;115 then return true end
 if math.abs(x)&lt;135 and math.abs(z-2350)&lt;140 then return true end
 if math.abs(x-180)&lt;52 and math.abs(z)&lt;52 then return true end
 if math.abs(x+180)&lt;52 and math.abs(z)&lt;52 then return true end
 if math.abs(z-180)&lt;52 and math.abs(x)&lt;52 then return true end
 if math.abs(z+180)&lt;52 and math.abs(x)&lt;52 then return true end
 for _,region in ipairs(Expansion.Worlds) do
  local c=region.center
  if math.abs(x-c.X)&lt;68 and math.abs(z-c.Z)&lt;68 then return true end
 end
 if math.abs(x)&lt;129 and math.abs(z)&lt;9 then return true end
 if math.abs(z)&lt;129 and math.abs(x)&lt;9 then return true end
 return false
end
function Cars.Spawn(world,player,kind)
 kind=kind or "car"
 local now=os.clock()
 if cooldown[player] and now-cooldown[player]&lt;8 then return false,"WAIT BEFORE SPAWNING ANOTHER CAR" end
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not root or not permitted(root.Position) then return false,"GO TO A SAFE ISLAND TO SPAWN A VEHICLE" end
 if kind=="snowmobile" and (root.Position-Vector3.new(0,root.Position.Y,-520)).Magnitude&gt;75 then
  return false,"SNOWMOBILES ARE AVAILABLE IN SNOWBOUND NORTH!"
 end
 if kind~="car" and kind~="snowmobile" and kind~="flyingcar" and kind~="stolen" then
  return false,"UNKNOWN VEHICLE"
 end
 if kind=="snowmobile" and player:GetAttribute("RROwn_SNOWMOBILE_LICENSE")~=true then
  return false,"EARN THE SNOWMOBILE LICENSE IN THE COIN SHOP FIRST!"
 end
 if kind=="flyingcar" and player:GetAttribute("RROwn_FLIGHT_LICENSE")~=true then
  return false,"EARN THE FLYING CAR LICENSE IN THE COIN SHOP FIRST!"
 end
 cooldown[player]=now
 local previous=active[player]
 if previous and previous.model then previous.model:Destroy() end
 local direction=root.CFrame.LookVector
 local spot=root.Position+direction*17
 if not permitted(spot) then spot=root.Position end
 local cf=CFrame.lookAt(Vector3.new(spot.X,5,spot.Z),
  Vector3.new(spot.X+direction.X,5,spot.Z+direction.Z))
 local m,seat
 local stats
 if kind=="snowmobile" then
  m,seat=Expansion.Prefabs.Snowmobile(world,Vector3.new(spot.X,2,spot.Z),true)
 else
  local tier=player:GetAttribute("RRLifeCarTier")
  local wrap=player:GetAttribute("RRActiveVehicleWrap")
  local ownedPaint=wrap=="PLATINUM" and Color3.fromRGB(205,216,231) or
   wrap=="MIDNIGHT" and Color3.fromRGB(28,36,59) or
   Color3.fromRGB(74,215,245)
  if tier=="SPORTS" then ownedPaint=Color3.fromRGB(222,76,83)
  elseif tier=="SEDAN" then ownedPaint=Color3.fromRGB(111,146,164) end
  m,seat=Kit.Car(world,cf,
   kind=="flyingcar" and Color3.fromRGB(196,94,252) or
   kind=="stolen" and Color3.fromRGB(48,54,69) or ownedPaint,true)
  local choice=kind=="car" and player:GetAttribute("RRLifeSelectedCar") or nil
  stats=choice and LifeCatalog.CarChoices[choice] or nil
  if stats and player:GetAttribute("RRLifeOwn_"..choice)~=true then
   stats=nil;choice=nil
  end
  -- Roblox's own Modern City sedan model replaces the visible primitive car.
  -- We keep the existing server-controlled seat and invisible collision shell
  -- so players cannot gain control by injecting local physics or scripts.
  if kind=="car" or kind=="stolen" then
   local modelName=stats and stats.model=="RED" and
    "OfficialRedSedanVisual" or "OfficialSedanVisual"
   local template=ServerStorage:FindFirstChild(modelName)
   if template then
    for _,node in ipairs(m:GetChildren()) do
     if node:IsA("BasePart") and node~=seat then
      node.Transparency=1
      node.CastShadow=false
     end
    end
    local visual=template:Clone()
    visual.Name="Official Detailed Sedan Body"
    visual.Parent=m
    for _,node in ipairs(visual:GetDescendants()) do
     if node:IsA("Seat") or node:IsA("VehicleSeat") then
      node:Destroy()
     elseif node:IsA("BasePart") then
      node.Anchored=true; node.CanCollide=false; node.CanTouch=false
      node.CanQuery=false
     elseif node:IsA("LuaSourceContainer") then
      node:Destroy()
     end
    end
    visual:PivotTo(cf*CFrame.new(0,0,0)*CFrame.Angles(0,math.pi,0))
    m:SetAttribute("VisualModel","Official Modern City Sedan")
    m:SetAttribute("DetailedPaint",modelName=="OfficialRedSedanVisual" and "RED" or "WHITE")
    m:SetAttribute("SelectedVehicle",choice or "STARTER")
   end
  end
  if kind=="stolen" then m.Name="Mission Getaway Car" end
  if kind=="flyingcar" then
   m.Name="Player Flying Car"
   for _,x in ipairs({-3.5,3.5}) do
    local jet=Instance.new("Part"); jet.Name="Anti-Gravity Thruster"
    jet.Size=Vector3.new(2,1,4)
    jet.CFrame=cf*CFrame.new(x,-2,0)
    jet.Color=Color3.fromRGB(119,246,255); jet.Material=Enum.Material.Neon
    jet.Anchored=true; jet.CanCollide=false; jet.CanTouch=false; jet.Parent=m
   end
  end
 end
 m:SetAttribute("OwnerUserId",player.UserId)
 local speedLimit=kind=="car" and stats and stats.speed or 34
 m:SetAttribute("TopSpeed",speedLimit)
 active[player]={model=m,seat=seat,owner=player,lastOccupied=now,
  speed=0,kind=kind,topSpeed=speedLimit}
 return true,(kind=="snowmobile" and "SNOWMOBILE" or
  kind=="flyingcar" and "FLYING CAR" or
  kind=="stolen" and "MISSION GETAWAY CAR" or "HOVERCAR")..
  " SPAWNED! SIT IN THE DRIVER SEAT TO DRIVE."
end
function Cars.HasActive(player,kind)
 local car=active[player]
 return car~=nil and car.kind==kind and car.model~=nil and car.model.Parent~=nil
  and car.model:GetPivot().Position or nil
end
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
 elapsed+=dt
 if elapsed&lt;.06 then return end
 local step=math.min(elapsed,.12); elapsed=0
 for owner,car in pairs(active) do
  local m,seat=car.model,car.seat
  if not owner.Parent or not m.Parent then
   if m.Parent then m:Destroy() end
   active[owner]=nil
  else
   local hum=seat.Occupant
   local driver=hum and Players:GetPlayerFromCharacter(hum.Parent)
   if driver==owner and hum.Health&gt;0 then
    car.lastOccupied=os.clock()
    local throttle=math.clamp(seat.ThrottleFloat,-1,1)
    local steer=math.clamp(seat.SteerFloat,-1,1)
    car.speed+=(throttle*(car.topSpeed or 34)-car.speed)*math.min(1,step*3)
    if math.abs(throttle)&lt;.03 then car.speed*=math.max(0,1-step*2) end
    local current=m:GetPivot()
    local yaw=-steer*step*1.7*math.clamp(math.abs(car.speed)/20,.25,1)
    local turn=current*CFrame.Angles(0,yaw,0)
    local displacement=turn.LookVector*car.speed*step
    local climb=car.kind=="flyingcar" and math.clamp(21-current.Position.Y,-step*12,step*12) or 0
    local target=turn+Vector3.new(displacement.X,climb,displacement.Z)
    if permitted(target.Position) then
     m:PivotTo(target)
    else
     car.speed=0
    end
   elseif driver and driver~=owner then
    -- Other players cannot remotely take over someone else's paid personal car.
    hum.Sit=false
    car.speed=0
   elseif os.clock()-car.lastOccupied&gt;240 then
    m:Destroy(); active[owner]=nil
   end
  end
 end
end)
Players.PlayerRemoving:Connect(function(p)
 local car=active[p]
 if car and car.model then car.model:Destroy() end
 active[p]=nil; cooldown[p]=nil
end)
return Cars
</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="22">
      <Properties>
        <string name="Name">WorldActivities</string>
        <string name="Source">-- WORLD ACTIVITIES v0.4: original reusable server-authoritative minigames,
-- resource gathering, crafting and fictional crime jobs. No Robux transactions.
local Players=game:GetService("Players")
local Terrain=workspace.Terrain
local TweenService=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local Kit={}
local sessions={}
local cooldowns={}
local stolen={}
local plotOwners={}
local playerPlots={}
local playerHouses={}
local plotCenters={}
local housingFolder=nil
local stations={}
local activityDefs={}
local function part(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cf
 p.Anchored=true; p.CanCollide=collide~=false; p.CanTouch=collide~=false
 p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=parent
 return p
end
local function label(parent,title,pos,color)
 local anchor=part(parent,"Venue Sign",Vector3.new(1,1,1),CFrame.new(pos),color,nil,false)
 anchor.Transparency=1
 local gui=Instance.new("BillboardGui"); gui.Name="VenueLabel"
 gui.Size=UDim2.fromOffset(310,62); gui.MaxDistance=190
 gui.AlwaysOnTop=true; gui.Parent=anchor
 local text=Instance.new("TextLabel"); text.Size=UDim2.fromScale(1,1)
 text.BackgroundTransparency=1; text.Text=title; text.TextScaled=true
 text.Font=Enum.Font.GothamBlack; text.TextColor3=color
 text.TextStrokeTransparency=.2; text.Parent=gui
end
local function within(player,anchor,maxDistance)
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 return root and (root.Position-anchor.Position).Magnitude&lt;=(maxDistance or 18)
end
local function station(parent,id,title,actionText,position,color,callback)
 local base=part(parent,title,Vector3.new(6,6,6),CFrame.new(position),color,Enum.Material.Metal,true)
 base:SetAttribute("ActivityId",id)
 local p=Instance.new("ProximityPrompt")
 p.Name="ActivityPrompt"; p.ActionText=actionText; p.ObjectText=title
 p.HoldDuration=.35; p.MaxActivationDistance=12; p.RequiresLineOfSight=false
 p.Parent=base
 stations[id]=base
 p.Triggered:Connect(function(player)
  if within(player,base,17) then callback(player,id) end
 end)
 return base
end
local function safeResources(s)
 if type(s.resources)~="table" then s.resources={} end
 for _,key in ipairs({"wood","metal","fish","hide","toolkit"}) do
  local n=s.resources[key]
  s.resources[key]=(type(n)=="number" and n==n and n&gt;=0)
   and math.clamp(math.floor(n),0,9999) or 0
 end
 if type(s.jobs)~="table" then s.jobs={} end
 s.jobs.sports=math.clamp(tonumber(s.jobs.sports) or 0,0,100000)
 s.jobs.bankCooldownUntil=math.max(0,tonumber(s.jobs.bankCooldownUntil) or 0)
 s.jobs.carCooldownUntil=math.max(0,tonumber(s.jobs.carCooldownUntil) or 0)
 s.jobs.heists=math.clamp(tonumber(s.jobs.heists) or 0,0,100000)
 s.jobs.houseOwned=s.jobs.houseOwned==true
end
local function cd(player,id,duration)
 cooldowns[player]=cooldowns[player] or {}
 local now=os.clock()
 if now&lt;(cooldowns[player][id] or 0) then return false end
 cooldowns[player][id]=now+duration
 return true
end
local context=nil
local function profile(player)
 local s=context.getProfile(player)
 if s then safeResources(s) end
 return s
end
local function message(player,text) context.tell(player,text) end
local function give(player,coins,xp,shards)
 context.reward(player,coins,xp,shards or 0)
 context.sync(player)
end
local function actionVisual(id,anchor)
 if not anchor or not anchor.Parent then return end
 if id=="football" or id=="baseball" or id=="soccer" then
  local ball=Instance.new("Part"); ball.Name="Sports Shot Visual"
  ball.Shape=Enum.PartType.Ball
  ball.Size=Vector3.new(id=="baseball" and 1.1 or 2.5,
   id=="baseball" and 1.1 or 2.5,id=="baseball" and 1.1 or 2.5)
  ball.Material=Enum.Material.SmoothPlastic
  ball.Color=id=="football" and Color3.fromRGB(127,77,49) or Color3.fromRGB(244,246,242)
  ball.Anchored=true; ball.CanCollide=false; ball.CanTouch=false
  ball.Position=anchor.Position+Vector3.new(0,2,-4); ball.Parent=anchor.Parent
  local endPos=ball.Position+(id=="soccer" and Vector3.new(-33,0,0)
   or id=="football" and Vector3.new(35,0,0) or Vector3.new(0,0,-46))
  local top=endPos+Vector3.new(0,id=="soccer" and 10 or 22,0)
  local rise=TweenService:Create(ball,TweenInfo.new(.55,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
   {Position=top})
  local fall=TweenService:Create(ball,TweenInfo.new(.55,Enum.EasingStyle.Quad,Enum.EasingDirection.In),
   {Position=endPos})
  rise.Completed:Connect(function()
   if ball.Parent then fall:Play() end
  end)
  rise:Play(); Debris:AddItem(ball,1.4)
 elseif id=="fishing" then
  local splash=part(anchor.Parent,"Fishing Splash",Vector3.new(4,.4,4),
   CFrame.new(anchor.Position+Vector3.new(0,-2,-8)),
   Color3.fromRGB(119,220,255),Enum.Material.Neon,false)
  splash.Shape=Enum.PartType.Ball; splash.Transparency=.25
  TweenService:Create(splash,TweenInfo.new(.65),{
   Size=Vector3.new(9,.4,9),Transparency=1
  }):Play()
  Debris:AddItem(splash,.7)
 end
end
local function updateHeat(player,s,amount)
 s.heat=math.clamp((s.heat or 0)+amount,0,100)
 context.sync(player)
end
function Kit.Start(player,id)
 local def=activityDefs[id]
 local anchor=stations[id]
 local s=profile(player)
 if not def or not anchor or not s or not within(player,anchor,17) then return false end
 local now=os.clock()
 if sessions[player] and now-sessions[player].started&lt;3.8 then
  message(player,"FINISH YOUR CURRENT CHALLENGE FIRST!")
  return false
 end
 if not cd(player,"start_"..id,1.5) then return false end
 if not cd(player,"play_"..id,def.cooldown or 12) then
  message(player,"ACTIVITY RECHARGING!")
  return false
 end
 local delay=1.9+math.random()*0.7
 sessions[player]={id=id,started=now,delay=delay}
 context.signal:FireClient(player,{
  kind="skill",id=id,title=def.title,delay=delay,duration=3.5
 })
 message(player,def.title..": TAP THE ACTION BUTTON WHEN THE METER HITS THE TARGET!")
 return true
end
function Kit.Hit(player,id)
 local session=sessions[player]
 local def=activityDefs[id]
 local anchor=stations[id]
 local s=profile(player)
 if not s or not session or session.id~=id or not def or not anchor then return false end
 sessions[player]=nil
 if not within(player,anchor,19) then return false end
 local delta=math.abs(os.clock()-session.started-session.delay)
 if delta&gt;.58 then
  message(player,"MISSED! TRY AGAIN AFTER THE SHORT COOLDOWN.")
  return false
 end
 actionVisual(id,anchor)
 if id=="football" or id=="baseball" or id=="soccer" then
  s.jobs.sports+=1
  give(player,def.coins,def.xp,0)
  message(player,def.title.." SUCCESS! +"..def.coins.." COINS!")
 elseif id=="fishing" then
  s.resources.fish=math.min(9999,s.resources.fish+2)
  give(player,24,22,0)
  message(player,"CAUGHT 2 FISH! SELL YOUR CATCH AT THE MARKET!")
 elseif id=="hunting" then
  -- Fantasy tracking challenge; no gore, torture or realistic animal injuries.
  s.resources.hide=math.min(9999,s.resources.hide+1)
  give(player,28,24,0)
  message(player,"WILDLIFE TRACKED! +1 CRAFTING HIDE!")
 end
 context.sync(player)
 return true
end
function Kit.RefreshHouse(player)
 local s=profile(player)
 local m=playerHouses[player]
 if not s or not m then return end
 local roof=m:FindFirstChild("House Roof")
 if roof then
  roof.Color=s.owned.ESTATE_ROOF and Color3.fromRGB(51,63,75)
   or Color3.fromRGB(73,97,121)
  if s.owned.ESTATE_ROOF and not m:FindFirstChild("Estate Porch Light") then
   for _,x in ipairs({-8,8}) do
    local lamp=part(m,"Estate Porch Light",Vector3.new(1,2,1),
     CFrame.new(roof.Position+Vector3.new(x,-8,-15)),
     Color3.fromRGB(255,221,148),Enum.Material.Neon,false)
    local point=Instance.new("PointLight"); point.Brightness=1
    point.Range=20; point.Parent=lamp
   end
  end
 end
 if s.owned.HOME_GARAGE and not m:FindFirstChild("Luxury Garage") then
  local center=plotCenters[playerPlots[player]]
  if not center then return end
  local garage=Instance.new("Model"); garage.Name="Luxury Garage"
  garage.Parent=m
  local origin=center+Vector3.new(30,0,1)
  part(garage,"Garage Slab",Vector3.new(20,1,25),
   CFrame.new(origin+Vector3.new(0,2,0)),
   Color3.fromRGB(135,137,138),Enum.Material.Concrete,true)
  for _,x in ipairs({-10,10}) do
   part(garage,"Garage Wall",Vector3.new(1,12,25),
    CFrame.new(origin+Vector3.new(x,9,0)),
    Color3.fromRGB(205,206,195),Enum.Material.Concrete,true)
  end
  part(garage,"Garage Back Wall",Vector3.new(20,12,1),
   CFrame.new(origin+Vector3.new(0,9,12)),
   Color3.fromRGB(205,206,195),Enum.Material.Concrete,true)
  part(garage,"Garage Roof",Vector3.new(22,2,27),
   CFrame.new(origin+Vector3.new(0,16,0)),
   Color3.fromRGB(48,62,78),Enum.Material.Slate,true)
  part(garage,"Garage Door",Vector3.new(18,10,1),
   CFrame.new(origin+Vector3.new(0,8,-12)),
   Color3.fromRGB(101,123,141),Enum.Material.Metal,false)
  part(garage,"Driveway",Vector3.new(18,.5,20),
   CFrame.new(origin+Vector3.new(0,2,-24)),
   Color3.fromRGB(108,109,113),Enum.Material.Concrete,true)
  for _,x in ipairs({-6,6}) do
   local lamp=part(garage,"Garage Exterior Light",Vector3.new(1.5,1.5,1.5),
    CFrame.new(origin+Vector3.new(x,12,-13)),
    Color3.fromRGB(251,229,159),Enum.Material.Neon,false)
   local point=Instance.new("PointLight"); point.Range=16
   point.Brightness=.9; point.Parent=lamp
  end
 end
end
local function buildHouse(player)
 local slot=playerPlots[player]
 if not slot or not housingFolder then return false end
 if playerHouses[player] then return true end
 local center=plotCenters[slot]
 if not center then return false end
 local m=Instance.new("Model"); m.Name="Player Home "..player.UserId
 m:SetAttribute("OwnerUserId",player.UserId); m:SetAttribute("PlotId",slot)
 m.Parent=housingFolder
 local wood=Color3.fromRGB(185,155,124)
 local trim=Color3.fromRGB(230,218,196)
 local roof=Color3.fromRGB(73,97,121)
 local base=part(m,"Home Floor",Vector3.new(32,1,28),
  CFrame.new(center+Vector3.new(0,2,0)),Color3.fromRGB(165,154,140),
  Enum.Material.WoodPlanks,true)
 m.PrimaryPart=base
 for _,x in ipairs({-16,16}) do
  part(m,"Side Wall",Vector3.new(1,15,28),
   CFrame.new(center+Vector3.new(x,10,0)),wood,Enum.Material.WoodPlanks,true)
  part(m,"House Window",Vector3.new(1.2,5,6),
   CFrame.new(center+Vector3.new(x*1.01,11,-4)),
   Color3.fromRGB(139,213,237),Enum.Material.Glass,false)
 end
 part(m,"Back Wall",Vector3.new(32,15,1),
  CFrame.new(center+Vector3.new(0,10,14)),wood,Enum.Material.WoodPlanks,true)
 for _,x in ipairs({-10,10}) do
  part(m,"Front Wall",Vector3.new(12,15,1),
   CFrame.new(center+Vector3.new(x,10,-14)),wood,Enum.Material.WoodPlanks,true)
 end
 part(m,"Doorway Header",Vector3.new(8,4,1),
  CFrame.new(center+Vector3.new(0,15.5,-14)),wood,Enum.Material.WoodPlanks,true)
 part(m,"House Roof",Vector3.new(37,3,33),
  CFrame.new(center+Vector3.new(0,19,0)),roof,Enum.Material.Slate,true)
 part(m,"Front Porch",Vector3.new(13,1,8),
  CFrame.new(center+Vector3.new(0,2,-18)),trim,Enum.Material.WoodPlanks,true)
 part(m,"Bed",Vector3.new(7,2,11),
  CFrame.new(center+Vector3.new(-9,4,7)),Color3.fromRGB(91,141,180),
  Enum.Material.Fabric,true)
 part(m,"Table",Vector3.new(6,3,5),
  CFrame.new(center+Vector3.new(8,4,5)),Color3.fromRGB(113,80,54),
  Enum.Material.Wood,true)
 label(m,player.DisplayName.."'S HOME",center+Vector3.new(0,26,0),
  Color3.fromRGB(243,220,165))
 playerHouses[player]=m
 Kit.RefreshHouse(player)
 return true
end
function Kit.PlayerJoined(player)
 local s=profile(player)
 if not s then return end
 for i=1,#plotCenters do
  if not plotOwners[i] then
   plotOwners[i]=player; playerPlots[player]=i
   player:SetAttribute("RRPlot",i)
   if s.jobs.houseOwned then buildHouse(player) end
   return
  end
 end
 message(player,"ALL HOME PLOTS ARE OCCUPIED ON THIS SERVER.")
end
function Kit.Perform(player,id)
 local anchor=stations[id]
 local s=profile(player)
 if not anchor or not s or not within(player,anchor,17) then return false end
 local r=s.resources
 if string.sub(id,1,11)=="gather_wood" then
  if not cd(player,id,18) then message(player,"TREES ARE REGROWING!"); return false end
  r.wood=math.min(9999,r.wood+2)
  give(player,8,10); message(player,"+2 WOOD +8 COINS")
 elseif string.sub(id,1,12)=="gather_metal" then
  if not cd(player,id,18) then message(player,"SCRAP IS REPLENISHING!"); return false end
  r.metal=math.min(9999,r.metal+2)
  give(player,8,10); message(player,"+2 METAL +8 COINS")
 elseif id=="craft_toolkit" then
  if r.wood&lt;2 or r.metal&lt;3 then
   message(player,"TOOLKIT NEEDS 2 WOOD + 3 METAL!"); return false
  end
  r.wood-=2; r.metal-=3; r.toolkit=math.min(9999,r.toolkit+1)
  context.sync(player); message(player,"CRAFTED A TOOLKIT!")
 elseif id=="sell_fish" then
  if r.fish&lt;1 then message(player,"CATCH FISH AT THE MARINA FIRST!"); return false end
  local amount=math.min(10,r.fish)
  r.fish-=amount; give(player,amount*18,amount*2)
  message(player,"SOLD "..amount.." FISH FOR "..(amount*18).." COINS!")
 elseif id=="build_house" then
  if s.jobs.houseOwned then message(player,"YOU ALREADY OWN A HOME!"); return false end
  if s.level&lt;2 then message(player,"HOME BUILDING UNLOCKS AT LEVEL 2!"); return false end
  if not playerPlots[player] then message(player,"NO FREE HOME PLOTS THIS SERVER!"); return false end
  if r.wood&lt;8 or r.metal&lt;6 then
   message(player,"HOUSE NEEDS 8 WOOD + 6 METAL!"); return false
  end
  r.wood-=8; r.metal-=6; s.jobs.houseOwned=true
  buildHouse(player)
  give(player,0,100)
  message(player,"HOME BUILT! VISIT YOUR PERSONAL PLOT!")
 elseif id=="bank_heist" then
  if s.level&lt;3 then message(player,"BANK JOB UNLOCKS AT LEVEL 3!"); return false end
  if (s.heat or 0)&gt;45 then message(player,"TOO MUCH HEAT! WAIT FOR THE ALERT TO CLEAR!"); return false end
  if r.toolkit&lt;1 then message(player,"CRAFT A TOOLKIT AT THE HUB WORKSHOP!"); return false end
  if os.time()&lt;s.jobs.bankCooldownUntil then
   message(player,"THE BANK IS ON LOCKDOWN!"); return false
  end
  r.toolkit-=1
  s.jobs.bankCooldownUntil=os.time()+300
  s.jobs.heists+=1
  updateHeat(player,s,75)
  give(player,250,145,3)
  message(player,"VAULT HEIST COMPLETE! +250 COINS • WANTED LEVEL HIGH!")
 elseif id=="steal_car" then
  if s.level&lt;2 then message(player,"VEHICLE MISSION UNLOCKS AT LEVEL 2!"); return false end
  if r.toolkit&lt;1 then message(player,"NEED A CRAFTED TOOLKIT TO HOTWIRE!"); return false end
  if os.time()&lt;s.jobs.carCooldownUntil then message(player,"GARAGE SECURITY ALERT!"); return false end
  if (s.heat or 0)&gt;70 then message(player,"LOSE YOUR WANTED LEVEL FIRST!"); return false end
  local ok,reason=context.spawnVehicle(context.world,player,"stolen")
  if not ok then message(player,reason); return false end
  r.toolkit-=1; s.jobs.carCooldownUntil=os.time()+180
  stolen[player]=true
  updateHeat(player,s,40)
  message(player,"FICTIONAL CAR HEIST! DRIVE TO THE CHOP SHOP!")
 elseif id=="chop_shop" then
  if not stolen[player] then message(player,"NO MISSION CAR TO SELL!"); return false end
  local carPosition=context.hasVehicle(player,"stolen")
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if not carPosition or not root or (carPosition-root.Position).Magnitude&gt;45 then
   message(player,"BRING YOUR MISSION GETAWAY CAR TO THE CHOP SHOP!"); return false
  end
  stolen[player]=nil
  updateHeat(player,s,20)
  give(player,110,65)
  message(player,"CAR DELIVERY COMPLETE! +110 COINS!")
 else
  return false
 end
 context.sync(player)
 return true
end
local function sports(parent,center)
 local turf=Color3.fromRGB(56,134,83)
 Terrain:FillBlock(CFrame.new(center+Vector3.new(0,-4,0)),
  Vector3.new(280,12,225),Enum.Material.Grass)
