	<Item class="ServerScriptService" referent="12">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">2d8304864d25a21c0ae57211000003b7</UniqueId>
		</Properties>
		<Item class="ModuleScript" referent="13">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- v0.10 LIVING DOWNTOWN: R15 citizens and detailed moving traffic.
-- Uses Roblox's own R15 rig generation and the script-free official sedan visual.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local ServerStorage=game:GetService("ServerStorage")

local Population={}
local heartbeatConnection=nil
local citizens={}
local traffic={}

local skins={
 Color3.fromRGB(236,196,159),Color3.fromRGB(195,143,107),
 Color3.fromRGB(128,91,70),Color3.fromRGB(226,174,132),
 Color3.fromRGB(162,112,84),Color3.fromRGB(96,69,55),
}
local shirts={
 Color3.fromRGB(53,91,129),Color3.fromRGB(126,71,92),
 Color3.fromRGB(76,111,84),Color3.fromRGB(111,95,67),
 Color3.fromRGB(64,69,82),Color3.fromRGB(133,98,63),
}
local pants={
 Color3.fromRGB(38,43,52),Color3.fromRGB(54,56,61),
 Color3.fromRGB(42,53,65),Color3.fromRGB(57,49,45),
}
local names={"Alex","Jordan","Morgan","Taylor","Casey","Riley","Avery","Cameron"}
-- Public classic Roblox hair accessories verified in Studio. They cost the
-- player nothing and give the generated R15 citizens recognizable silhouettes.
local hairIds={"63690008","16630147","376548738"}
local dialogues={
 "I am heading to work. The Employment Center is near the front block.",
 "Motor Row is where people shop for vehicles. You still have to earn the coins.",
 "City Tech sells phones and creator gear if you want to build a following.",
 "The community pantry and public benches can help if your needs get low.",
 "Metro Realty handles apartments and homes once you have built up your career.",
 "City Commerce is where business owners collect their simulated revenue.",
 "Police patrol the district. High wanted heat can still get you arrested.",
 "There are more worlds outside downtown through the WORLD menu.",
}

local function safeDescription(index)
 local d=Instance.new("HumanoidDescription")
 local skin=skins[(index-1)%#skins+1]
 local top=shirts[(index-1)%#shirts+1]
 local bottom=pants[(index-1)%#pants+1]
 d.HeadColor=skin; d.LeftArmColor=skin; d.RightArmColor=skin
 d.TorsoColor=top; d.LeftLegColor=bottom; d.RightLegColor=bottom
 d.HeightScale=.96+(index%4)*.025
 d.WidthScale=.92+(index%3)*.035
 d.DepthScale=.94+(index%2)*.04
 d.HeadScale=.98; d.BodyTypeScale=.28; d.ProportionScale=.18
 d.HairAccessory=hairIds[(index-1)%#hairIds+1]
 return d
end

local function walkAnimation(humanoid)
 local animator=humanoid:FindFirstChildOfClass("Animator")
 if not animator then animator=Instance.new("Animator"); animator.Parent=humanoid end
 local animation=Instance.new("Animation")
 animation.Name="Downtown Walk Animation"
 animation.AnimationId="rbxassetid://507777826" -- Roblox R15 walk
 local ok,track=pcall(function() return animator:LoadAnimation(animation) end)
 if ok and track then
  track.Name="Downtown Walk"
  track.Looped=true
  track.Priority=Enum.AnimationPriority.Movement
  track:Play(.2,1,1)
  return track
 end
 animation:Destroy()
 return nil
end

local function citizen(parent,index,start,route,tellPlayer,world)
 local description=safeDescription(index)
 local ok,model=pcall(function()
  return Players:CreateHumanoidModelFromDescription(description,Enum.HumanoidRigType.R15)
 end)
 description:Destroy()
 if not ok or not model then return nil end
 model.Name="Downtown Citizen "..index
 model:SetAttribute("NPCType","R15Citizen")
 model:SetAttribute("CitizenName",names[(index-1)%#names+1])
 model:SetAttribute("Behavior","Walking")
 model.Parent=parent
 local humanoid=model:FindFirstChildOfClass("Humanoid")
 local root=model:FindFirstChild("HumanoidRootPart")
 if not humanoid or not root then model:Destroy(); return nil end
 humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
 humanoid.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
 humanoid.WalkSpeed=7.4+(index%4)*.65
 humanoid.AutoRotate=true
 humanoid.BreakJointsOnDeath=false
 root.CanCollide=false
 local talkAnchor=model:FindFirstChild("UpperTorso") or model:FindFirstChild("Head")
 if talkAnchor then
  local talk=Instance.new("ProximityPrompt")
  talk.Name="Talk to Citizen"
  talk.ActionText="TALK"
  talk.ObjectText=model:GetAttribute("CitizenName")
  talk.HoldDuration=.25; talk.MaxActivationDistance=9
  talk.RequiresLineOfSight=false; talk.Parent=talkAnchor
  talk.Triggered:Connect(function(player)
   if tellPlayer then tellPlayer(player,model:GetAttribute("CitizenName")..": "..dialogues[index]) end
   if world then
    world:SetAttribute("DowntownConversations",(world:GetAttribute("DowntownConversations") or 0)+1)
   end
  end)
 end
 pcall(function() root:SetNetworkOwner(nil) end)
 model:PivotTo(CFrame.new(start+Vector3.new(0,3.2,0)))
 local track=walkAnimation(humanoid)
 local state={model=model,humanoid=humanoid,root=root,route=route,index=2,walkTrack=track}
 table.insert(citizens,state)
 task.spawn(function()
  while model.Parent and humanoid.Health>0 do
   local target=route[state.index]
   humanoid:MoveTo(target)
   local reached=humanoid.MoveToFinished:Wait()
   if model.Parent and humanoid.Health>0 then
    if not reached and (root.Position-target).Magnitude>24 then
     model:PivotTo(CFrame.new(target+Vector3.new(0,3.2,0)))
    end
    state.index=state.index%#route+1
    task.wait(.35+(index%3)*.2)
   end
  end
 end)
 return model
end

local function makeTrafficSedan(parent,index,startIndex,route)
 local template=ServerStorage:FindFirstChild("OfficialSedanVisual")
 if not template then return nil end
 local m=template:Clone()
 m.Name="Downtown Traffic Sedan "..index
 m:SetAttribute("NPCType","DetailedTraffic")
 m:SetAttribute("VisualModel","Official Modern City Sedan")
 m:SetAttribute("DistanceTravelled",0)
 m.Parent=parent
 for _,node in ipairs(m:GetDescendants()) do
  if node:IsA("LuaSourceContainer") then
   node:Destroy()
  elseif node:IsA("BasePart") then
   node.Anchored=true; node.CanCollide=false; node.CanTouch=false
   node.CanQuery=false
  end
 end
 local pos=route[startIndex]
 local nextIndex=startIndex%#route+1
 local direction=(route[nextIndex]-pos).Unit
 m:PivotTo(CFrame.lookAt(pos,pos+direction)*CFrame.Angles(0,math.pi,0))
 local state={model=m,position=pos,route=route,index=nextIndex,
  speed=18+index*1.5,distance=0,lastAttribute=0}
 table.insert(traffic,state)
 return m
end

function Population.Build(world,cityModel,options)
 options=options or {}
 if heartbeatConnection then heartbeatConnection:Disconnect(); heartbeatConnection=nil end
 citizens={}; traffic={}
 local old=world:FindFirstChild("Living Modern Downtown")
 if old then old:Destroy() end
 local folder=Instance.new("Folder")
 folder.Name="Living Modern Downtown"
 folder.Parent=world
 folder:SetAttribute("CitizenCount",8)
 folder:SetAttribute("TrafficCount",4)
 folder:SetAttribute("RigType","R15")
 folder:SetAttribute("TrafficVisual","Official Modern City Sedan")

 -- Two citizens cross the welcome block immediately so downtown feels alive
 -- from the first camera view instead of only at the far perimeter.
 local frontA=Vector3.new(-32,0,2238)
 local frontB=Vector3.new(32,0,2238)
 local rightA=Vector3.new(108,0,2260)
 local rightB=Vector3.new(108,0,2460)
 local backA=Vector3.new(85,0,2472)
 local backB=Vector3.new(-85,0,2472)
 local leftA=Vector3.new(-108,0,2460)
 local leftB=Vector3.new(-108,0,2260)
 local pedestrianRoutes={
  {frontA,frontB,frontA},
  {frontB,frontA,frontB},
  {rightA,rightB,rightA},
  {rightB,rightA,rightB},
  {backA,backB,backA},
  {backB,backA,backB},
  {leftA,leftB,leftA},
  {leftB,leftA,leftB},
 }
 world:SetAttribute("DowntownConversations",0)
 for i,route in ipairs(pedestrianRoutes) do
  citizen(folder,i,route[1],route,options.tell,world)
 end

 -- Keep the front traffic lane behind the third-person camera at spawn.
 -- This prevents a non-colliding sedan from visually passing through the camera.
 local roadRoute={
  Vector3.new(-128,4.5,2180),Vector3.new(128,4.5,2180),
  Vector3.new(128,4.5,2502),Vector3.new(-128,4.5,2502),
 }
 for i=1,4 do makeTrafficSedan(folder,i,i,roadRoute) end

 if cityModel then
  cityModel:SetAttribute("LivingDowntownIntegrated",true)
  cityModel:SetAttribute("DetailedCitizenCount",#citizens)
  cityModel:SetAttribute("DetailedTrafficCount",#traffic)
 end
 world:SetAttribute("DowntownTrafficDistance",0)
 local elapsed=0
 heartbeatConnection=RunService.Heartbeat:Connect(function(dt)
  if not world.Parent or not folder.Parent then return end
  elapsed+=dt
  if elapsed<.09 then return end
  local step=math.min(elapsed,.14); elapsed=0
  local totalDistance=0
  for _,car in ipairs(traffic) do
   local m=car.model
   if m and m.Parent then
    local goal=car.route[car.index]
    local delta=goal-car.position
    if delta.Magnitude<2.2 then
     car.index=car.index%#car.route+1
     goal=car.route[car.index]
     delta=goal-car.position
    end
    if delta.Magnitude>.01 then
     local direction=delta.Unit
     local amount=math.min(delta.Magnitude,car.speed*step)
     car.position+=direction*amount
     car.distance+=amount
     local cf=CFrame.lookAt(car.position,car.position+direction)*CFrame.Angles(0,math.pi,0)
     m:PivotTo(cf)
     if car.distance-car.lastAttribute>=6 then
      car.lastAttribute=car.distance
      m:SetAttribute("DistanceTravelled",math.floor(car.distance))
     end
    end
    totalDistance+=car.distance
   end
  end
  world:SetAttribute("DowntownTrafficDistance",math.floor(totalDistance))
 end)
 return {folder=folder,citizens=#citizens,traffic=#traffic}
end

return Population
]]></ProtectedString>
				<string name="ScriptGuid">{1e0d8b1b-019e-4f75-8c0e-9952b58c21b9}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">DowntownPopulation</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2d8304864d25a21c0ae57211000003de</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="14">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- v0.7 original procedural architectural detailing for Life City.
-- No Toolbox scripts, third-party meshes, external IDs or unlicensed assets.
-- A polished blockout with masonry, shopfronts, fixtures, landscaping, street furniture.
local Lighting=game:GetService("Lighting")
local Detail={}
local center=Vector3.new(0,0,1600)
local function part(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=cf; p.Anchored=true
 p.Material=material or Enum.Material.SmoothPlastic
 p.Color=color or Color3.fromRGB(180,180,180)
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 p.CanCollide=collide==true; p.CanTouch=false
 p.Parent=parent; return p
end
local function beam(parent,name,size,pos,color,material)
 return part(parent,name,size,CFrame.new(pos),color,material,false)
end
local function cylinder(parent,name,size,cf,color,material)
 local p=part(parent,name,size,cf,color,material,false)
 p.Shape=Enum.PartType.Cylinder
 return p
end
local function sphere(parent,name,size,cf,color,material)
 local p=part(parent,name,size,cf,color,material,false)
 p.Shape=Enum.PartType.Ball
 return p
end
local function sign(parent,name,size,pos,color,letters)
 local base=beam(parent,name,size,pos,color,Enum.Material.Metal)
 local face=Instance.new("SurfaceGui"); face.Name="Painted Shop Sign"
 face.Face=Enum.NormalId.Front; face.CanvasSize=Vector2.new(680,140)
 face.LightInfluence=.25; face.Parent=base
 local label=Instance.new("TextLabel")
 label.Size=UDim2.fromScale(1,1)
 label.BackgroundTransparency=1
 label.Text=letters; label.TextScaled=true
 label.Font=Enum.Font.GothamBlack
 label.TextColor3=Color3.fromRGB(246,242,228)
 label.Parent=face
 return base
end
local function light(parent,name,pos,color,range)
 local body=beam(parent,name,Vector3.new(1.1,.4,1.1),
  pos,Color3.fromRGB(242,229,195),Enum.Material.Neon)
 local l=Instance.new("PointLight"); l.Range=range or 15; l.Brightness=.65
 l.Color=color or Color3.fromRGB(255,232,192); l.Shadows=false; l.Parent=body
end
local function tree(parent,pos,index)
 local m=Instance.new("Model"); m.Name="Street Tree "..index; m.Parent=parent
 local trunk=cylinder(m,"Bark",Vector3.new(2,12,2),
  CFrame.new(pos+Vector3.new(0,7,0)),Color3.fromRGB(105,83,66),Enum.Material.Wood)
 trunk.CanCollide=true
 for i=1,5 do
  local theta=(i-1)*math.pi*2/5
  local delta=Vector3.new(math.cos(theta)*3,0,math.sin(theta)*3)
  sphere(m,"Leaf Canopy",Vector3.new(9,8,9),
   CFrame.new(pos+Vector3.new(0,15,0)+delta),
   i%2==0 and Color3.fromRGB(61,123,73) or Color3.fromRGB(76,143,86),
   Enum.Material.Grass)
 end
 beam(m,"Mulch Bed",Vector3.new(9,.35,9),
  pos+Vector3.new(0,.2,0),Color3.fromRGB(101,81,63),Enum.Material.Ground)
end
local function bench(parent,pos)
 for _,x in ipairs({-3,3}) do
  beam(parent,"Bench Leg",Vector3.new(.5,2.3,.6),
   pos+Vector3.new(x,1.4,0),Color3.fromRGB(65,72,76),Enum.Material.Metal)
 end
 for _,z in ipairs({-.8,0,.8}) do
  beam(parent,"Wood Bench Seat",Vector3.new(7,.3,.7),
   pos+Vector3.new(0,2.6,z),Color3.fromRGB(125,91,62),Enum.Material.WoodPlanks)
 end
 beam(parent,"Bench Back",Vector3.new(7,2,.35),
  pos+Vector3.new(0,3.6,1.1),Color3.fromRGB(129,97,69),Enum.Material.WoodPlanks)
end
local function planter(parent,pos)
 cylinder(parent,"Stone Planter",Vector3.new(6,1.8,6),
  CFrame.new(pos+Vector3.new(0,1,0)),Color3.fromRGB(150,153,151),Enum.Material.Concrete)
 cylinder(parent,"Planter Soil",Vector3.new(5.5,.2,5.5),
  CFrame.new(pos+Vector3.new(0,2,0)),Color3.fromRGB(87,70,53),Enum.Material.Ground)
 for i=1,5 do
  local angle=i*math.pi*2/5
  local p=pos+Vector3.new(math.cos(angle)*1.7,2.8,math.sin(angle)*1.7)
  sphere(parent,"Garden Shrub",Vector3.new(2.2,2.5,2.2),
   CFrame.new(p),Color3.fromRGB(60+i*4,112+i*3,70),Enum.Material.Grass)
 end
end
local function lampPost(parent,pos)
 local m=Instance.new("Model"); m.Name="City Streetlamp"; m.Parent=parent
 cylinder(m,"Streetlight Pole",Vector3.new(.55,20,.55),
  CFrame.new(pos+Vector3.new(0,10,0)),Color3.fromRGB(65,74,83),Enum.Material.Metal)
 beam(m,"Streetlight Arm",Vector3.new(5,.45,.45),
  pos+Vector3.new(2.4,19.7,0),Color3.fromRGB(65,74,83),Enum.Material.Metal)
 local bulb=beam(m,"Warm Streetlight",Vector3.new(2,.35,1.2),
  pos+Vector3.new(4.7,19.3,0),Color3.fromRGB(252,232,173),Enum.Material.Neon)
 local spot=Instance.new("SpotLight"); spot.Face=Enum.NormalId.Bottom
 spot.Range=28; spot.Angle=95; spot.Brightness=1.2
 spot.Color=Color3.fromRGB(255,230,184); spot.Parent=bulb
end
local function product(parent,category,index,pos)
 local color=({
  TECH=Color3.fromRGB(68,92,115),
  APPAREL=Color3.fromRGB(164,104,127),
  HOME=Color3.fromRGB(161,137,96),
  VEHICLE=Color3.fromRGB(76,119,153),
  PROPERTY=Color3.fromRGB(175,162,139),
  BUSINESS=Color3.fromRGB(106,147,118)
 })[category] or Color3.fromRGB(135,140,146)
 if category=="APPAREL" then
  local mannequin=cylinder(parent,"Clothing Stand",Vector3.new(.7,3,.7),
   CFrame.new(pos+Vector3.new(0,1.6,0)),Color3.fromRGB(103,101,98),Enum.Material.Metal)
  mannequin.CanCollide=false
  local torso=beam(parent,"Displayed Jacket",Vector3.new(2.6,2.2,1),
   pos+Vector3.new(0,3.3,0),color,Enum.Material.Fabric)
  for _,x in ipairs({-1.8,1.8}) do
   beam(parent,"Jacket Sleeve",Vector3.new(.85,2.2,.9),
    pos+Vector3.new(x,3.2,0),color,Enum.Material.Fabric)
  end
 elseif category=="TECH" then
  local screen=beam(parent,"Product Display Screen",Vector3.new(2.9,2.1,.24),
   pos+Vector3.new(0,3,0),Color3.fromRGB(22,35,47),Enum.Material.Metal)
  local display=beam(parent,"Screen Glass",Vector3.new(2.5,1.7,.1),
   screen.Position+Vector3.new(0,0,-.2),Color3.fromRGB(63,137,164),Enum.Material.Glass)
  display.Transparency=.25
  beam(parent,"Device Base",Vector3.new(3.3,.35,2.1),
   pos+Vector3.new(0,1.8,0),color,Enum.Material.Metal)
 elseif category=="VEHICLE" then
  beam(parent,"Model Car Body",Vector3.new(4,1.3,2.1),
   pos+Vector3.new(0,2.6,0),color,Enum.Material.Metal)
  for _,x in ipairs({-1.4,1.4}) do
   for _,z in ipairs({-1.2,1.2}) do
    cylinder(parent,"Showroom Tire",Vector3.new(.5,1.3,1.3),
     CFrame.new(pos+Vector3.new(x,2,z))*CFrame.Angles(0,0,math.pi/2),
     Color3.fromRGB(37,41,45),Enum.Material.Rubber)
   end
  end
 elseif category=="PROPERTY" then
  beam(parent,"Architectural Model House",Vector3.new(3,2,2.8),
   pos+Vector3.new(0,2.7,0),color,Enum.Material.Brick)
  local roof=Instance.new("WedgePart"); roof.Name="Architectural Roof Model"
  roof.Size=Vector3.new(3.4,1.3,3.3)
  roof.CFrame=CFrame.new(pos+Vector3.new(0,4.2,0))
  roof.Anchored=true; roof.CanCollide=false
  roof.Material=Enum.Material.Slate; roof.Color=Color3.fromRGB(79,83,92)
  roof.Parent=parent
 else
  beam(parent,"Product Package",Vector3.new(2.5,2.2,2),
   pos+Vector3.new(0,2.7,0),color,Enum.Material.Wood)
  beam(parent,"Product Label",Vector3.new(1.9,.9,.08),
   pos+Vector3.new(0,2.9,-1.05),
   Color3.fromRGB(238,222,187),Enum.Material.SmoothPlastic)
 end
end
local function decorateStore(folder,building,category,pos)
 local trim=Color3.fromRGB(218,214,203)
 local metal=Color3.fromRGB(54,65,77)
 -- Floor-level storefront facade: cornice, corner piers, glazing frames.
 for _,x in ipairs({-16.7,16.7}) do
  beam(folder,"Facade Corner Pilaster",Vector3.new(1.3,15,1.5),
   pos+Vector3.new(x,10,-15.8),trim,Enum.Material.Limestone)
  beam(folder,"Facade Base Stone",Vector3.new(2.4,1.5,2),
   pos+Vector3.new(x,3,-15.8),Color3.fromRGB(155,157,157),Enum.Material.Concrete)
 end
 beam(folder,"Architectural Roof Cornice",Vector3.new(40,1.4,35),
  pos+Vector3.new(0,18.3,0),trim,Enum.Material.Limestone)
 beam(folder,"Second Cornice Shadow",Vector3.new(39,.4,34),
  pos+Vector3.new(0,19.2,0),metal,Enum.Material.Metal)
 sign(folder,"Facade Business Sign",Vector3.new(26,3.8,.6),
  pos+Vector3.new(0,15.6,-16.6),metal,building.Name:upper())
 for _,x in ipairs({-12,12}) do
  beam(folder,"Window Mullion",Vector3.new(.35,8,.6),
   pos+Vector3.new(x,8,-16.1),metal,Enum.Material.Metal)
  beam(folder,"Window Transom",Vector3.new(7,.3,.5),
   pos+Vector3.new(x,10,-16.1),metal,Enum.Material.Metal)
  beam(folder,"Window Sill",Vector3.new(8,.5,1.1),
   pos+Vector3.new(x,4,-16),trim,Enum.Material.Concrete)
 end
 -- Open glazed entrance with doors offset to keep center walkable.
 for _,x in ipairs({-2.8,2.8}) do
  local door=beam(folder,"Open Glass Door",Vector3.new(3.4,8,.25),
   pos+Vector3.new(x,7.3,-13.2),
   Color3.fromRGB(137,192,205),Enum.Material.Glass)
  door.Transparency=.5
  door.CFrame=door.CFrame*CFrame.Angles(0,x<0 and -.7 or .7,0)
  cylinder(folder,"Door Pull",Vector3.new(.2,1.4,.2),
   CFrame.new(pos+Vector3.new(x,7.4,-13.8)),
   Color3.fromRGB(207,198,174),Enum.Material.Metal)
 end
 local awningColor=({
  TECH=Color3.fromRGB(67,108,133),
  APPAREL=Color3.fromRGB(147,86,111),
  HOME=Color3.fromRGB(124,122,87),
  VEHICLE=Color3.fromRGB(59,104,116),
  PROPERTY=Color3.fromRGB(120,119,99),
  BUSINESS=Color3.fromRGB(94,119,100)
 })[category]
 beam(folder,"Striped Store Awning",Vector3.new(30,.45,6),
  pos+Vector3.new(0,12.5,-18),awningColor,Enum.Material.Fabric)
 for i=-6,6 do
  if i%2==0 then
   beam(folder,"Awning Stripe",Vector3.new(2,.08,6),
    pos+Vector3.new(i*2.2,12.76,-18),
    Color3.fromRGB(227,220,199),Enum.Material.Fabric)
  end
 end
 -- Shelves and actual recognizable category-specific display props.
 for _,x in ipairs({-10,0,10}) do
  for _,z in ipairs({-2,10}) do
   local shelf=beam(folder,"Display Shelf",Vector3.new(7,.45,4),
    pos+Vector3.new(x,4.2,z),Color3.fromRGB(121,98,78),Enum.Material.WoodPlanks)
   shelf.CanCollide=true
   product(folder,category,math.floor(x+z),pos+Vector3.new(x,2.6,z))
  end
 end
 for _,x in ipairs({-12,12}) do
  light(folder,"Recessed Ceiling Light",pos+Vector3.new(x,16.2,4),
   Color3.fromRGB(255,232,201),16)
 end
 beam(folder,"Concrete Sidewalk",Vector3.new(39,.55,14),
  pos+Vector3.new(0,2.2,-24),Color3.fromRGB(173,175,169),Enum.Material.Concrete).CanCollide=true
end
local function decorateJobTask(folder,target)
 local job=target:GetAttribute("Job")
 local step=target:GetAttribute("Step")
 local pos=target.Position
 local m=Instance.new("Model")
 m.Name="Workplace Props "..job.." "..step
 m.Parent=folder
 local function box(name,size,offset,color,material)
  return beam(m,name,size,pos+offset,color,material)
 end
 local function tube(name,size,offset,color)
  return cylinder(m,name,size,CFrame.new(pos+offset),color,Enum.Material.Metal)
 end
 if job=="FIREFIGHTER" then
  if step==2 then
   local flame=box("Training Fire",Vector3.new(3,3,2),
    Vector3.new(0,3,0),Color3.fromRGB(232,99,43),Enum.Material.Neon)
   local fire=Instance.new("Fire"); fire.Heat=4; fire.Size=5; fire.Parent=flame
  else
   tube("Fire Hose Reel",Vector3.new(1.3,4,4),
    Vector3.new(0,2.6,0),Color3.fromRGB(181,55,48))
  end
 elseif job=="PARAMEDIC" or job=="VETERINARIAN" then
  box("Medical Examination Bed",Vector3.new(7,1,3.5),
   Vector3.new(0,3.1,0),Color3.fromRGB(229,235,228),Enum.Material.Fabric)
  box("Medical Cabinet",Vector3.new(2,3,1),
   Vector3.new(-3,3,0),Color3.fromRGB(152,179,177),Enum.Material.Metal)
 elseif job=="BARISTA" or job=="CHEF" then
  box("Kitchen Worktop",Vector3.new(7,.5,3),
   Vector3.new(0,3.1,0),Color3.fromRGB(189,193,188),Enum.Material.Marble)
  for x=-2,2,2 do
   tube("Kitchen Cup or Pot",Vector3.new(1.2,1.2,1.2),
    Vector3.new(x,4,0),Color3.fromRGB(221,225,217))
  end
 elseif job=="MECHANIC" then
  box("Vehicle Engine Block",Vector3.new(5,2,3),
   Vector3.new(0,3.2,0),Color3.fromRGB(76,88,98),Enum.Material.Metal)
  for x=-1,1 do
   tube("Engine Piston",Vector3.new(1,1.6,1.6),
    Vector3.new(x*1.3,4.6,0),Color3.fromRGB(144,153,157))
  end
 elseif job=="POLICE" then
  box("Police Dispatch Terminal",Vector3.new(3.2,2.3,.3),
   Vector3.new(0,4.3,0),Color3.fromRGB(44,77,111),Enum.Material.Glass)
 elseif job=="CONSTRUCTION" then
  for x=-2,2,2 do
   box("Stacked Bricks",Vector3.new(2,1.3,3),
    Vector3.new(x,3.3,0),Color3.fromRGB(164,112,85),Enum.Material.Brick)
  end
 elseif job=="FARMER" then
  for x=-2,2,2 do
   sphere(m,"Produce Harvest",Vector3.new(1.7,1.7,1.7),
    CFrame.new(pos+Vector3.new(x,3.2,0)),
    Color3.fromRGB(122,174,65),Enum.Material.Grass)
  end
 elseif job=="SANITATION" then
  for x=-2,2,2 do
   tube("Recycling Bin",Vector3.new(2.1,3,2.1),
    Vector3.new(x,3.1,0),Color3.fromRGB(74,146,110))
  end
 elseif job=="ELECTRICIAN" then
  box("Electrical Breaker Panel",Vector3.new(4,4,.8),
   Vector3.new(0,4.1,0),Color3.fromRGB(143,151,151),Enum.Material.Metal)
  for x=-1,1 do
   box("Circuit Breaker",Vector3.new(.6,.6,.2),
    Vector3.new(x,4.3,-.5),Color3.fromRGB(55,62,66),Enum.Material.Metal)
  end
 elseif job=="PLUMBER" then
  for x=-2,2,2 do
   tube("Pipe Fitting",Vector3.new(1.4,3,1.4),
    Vector3.new(x,3.5,0),Color3.fromRGB(169,172,173))
  end
 elseif job=="PHOTOGRAPHER" or job=="CREATOR" then
  box("Camera on Tripod",Vector3.new(2,1.4,1.2),
   Vector3.new(0,5,0),Color3.fromRGB(39,45,56),Enum.Material.Metal)
  for x=-2,2,2 do
   tube("Studio Tripod",Vector3.new(.25,4,.25),
    Vector3.new(x,3,0),Color3.fromRGB(80,86,90))
  end
 elseif job=="PILOT" then
  box("Flight Simulator Console",Vector3.new(6,2.5,2),
   Vector3.new(0,3.8,0),Color3.fromRGB(46,66,88),Enum.Material.Metal)
  box("Cockpit Display",Vector3.new(4,1.6,.15),
   Vector3.new(0,4.3,-1.1),Color3.fromRGB(56,145,184),Enum.Material.Glass)
 elseif job=="MUSICIAN" then
  box("Performance Speaker",Vector3.new(3,4,2),
   Vector3.new(0,4,0),Color3.fromRGB(49,51,60),Enum.Material.Metal)
  for y=-1,1,2 do
   cylinder(m,"Speaker Cone",Vector3.new(.3,1.2,1.2),
    CFrame.new(pos+Vector3.new(0,4+y,-1.1))*CFrame.Angles(0,0,math.pi/2),
    Color3.fromRGB(101,105,112),Enum.Material.Rubber)
  end
 elseif job=="TEACHER" then
  box("Classroom Whiteboard",Vector3.new(6,3,.2),
   Vector3.new(0,5,0),Color3.fromRGB(234,234,224),Enum.Material.SmoothPlastic)
 elseif job=="REAL_ESTATE_AGENT" then
  box("Home Staging Display",Vector3.new(5,2.5,3),
   Vector3.new(0,4,0),Color3.fromRGB(193,168,132),Enum.Material.Wood)
 else
  box("Workplace Parcel",Vector3.new(3,2,3),
   Vector3.new(0,3,0),Color3.fromRGB(164,130,96),Enum.Material.Wood)
 end
end
function Detail.Build(world)
 local folder=Instance.new("Folder"); folder.Name="Life City Architectural Details"
 folder.Parent=world
 local stores={
  {"TECH","Creator Technology Store",-112,-65},
  {"APPAREL","Clothing Boutique",-62,-65},
  {"HOME","Home Supply Store",-12,-65},
  {"VEHICLE","Vehicle and Marine Dealer",38,-65},
  {"PROPERTY","Real Estate Agency",88,-65},
  {"BUSINESS","Business Licensing Office",138,-65},
 }
 for _,row in ipairs(stores) do
  local category,name,x,z=unpack(row)
  local building=world:FindFirstChild(name,true)
  if building then
   decorateStore(folder,building,category,center+Vector3.new(x,0,z))
  end
 end
 -- City block landscaping and street furniture with actual collision where needed.
 for i,x in ipairs({-148,-100,-52,-4,44,92,148}) do
  local z=1538
  tree(folder,center+Vector3.new(x,3,z),i)
 end
 for _,x in ipairs({-135,-35,65,145}) do
  lampPost(folder,center+Vector3.new(x,3,17))
 end
 for _,x in ipairs({-135,-15,100}) do
  bench(folder,center+Vector3.new(x,3,-22))
 end
 for _,x in ipairs({-145,15,145}) do
  planter(folder,center+Vector3.new(x,3,36))
 end
 -- Pavement crossings, stop lines, sidewalk curb cuts and parking stalls.
 for _,x in ipairs({-90,90}) do
  for z=-10,10,4 do
   beam(folder,"Zebra Crossing Paint",Vector3.new(3,.09,2.5),
    center+Vector3.new(x,3.05,z),Color3.fromRGB(238,234,219))
  end
 end
 for i=-6,6 do
  local x=i*22
  beam(folder,"Parking Space Line",Vector3.new(.25,.1,16),
   center+Vector3.new(x,3.1,40),Color3.fromRGB(237,232,205))
 end
 for _,z in ipairs({-12,12}) do
  beam(folder,"Raised Sidewalk Curb",Vector3.new(328,.7,1),
   center+Vector3.new(0,3,z),Color3.fromRGB(184,185,181),Enum.Material.Concrete)
 end
 -- Career workstations show props for their particular profession, not bare buttons.
 for _,node in ipairs(world:GetDescendants()) do
  if node:IsA("BasePart") and node:GetAttribute("Job") and
   node:GetAttribute("Step") then
   decorateJobTask(folder,node)
  end
 end
 -- Public garden and pedestrian plaza for the job and home district.
 for _,x in ipairs({-150,-75,0,75,150}) do
  for _,z in ipairs({90,205}) do
   tree(folder,center+Vector3.new(x,3,z),math.floor(x+z))
  end
 end
 -- Curved architectural shapes using cylinders, spheres and wedge roofs.
 local plaza=beam(folder,"Employment Plaza",Vector3.new(90,.4,42),
  center+Vector3.new(-95,2.9,67),
  Color3.fromRGB(174,170,157),Enum.Material.Cobblestone)
 plaza.CanCollide=true
 local fountain=cylinder(folder,"Public Fountain Basin",Vector3.new(13,1.4,13),
  CFrame.new(center+Vector3.new(-30,3.8,105)),
  Color3.fromRGB(153,166,172),Enum.Material.Concrete)
 fountain.CanCollide=true
 cylinder(folder,"Fountain Pool",Vector3.new(11,.3,11),
  CFrame.new(center+Vector3.new(-30,4.65,105)),
  Color3.fromRGB(85,172,204),Enum.Material.Glass)
 local plume=part(folder,"Fountain Water Jet",Vector3.new(.9,7,.9),
  CFrame.new(center+Vector3.new(-30,8,105)),
  Color3.fromRGB(144,220,243),Enum.Material.Glass,false)
 plume.Transparency=.45
 local particles=Instance.new("ParticleEmitter")
 particles.Texture="rbxasset://textures/particles/sparkles_main.dds"
 particles.Rate=7; particles.Lifetime=NumberRange.new(.7,1.2)
 particles.Speed=NumberRange.new(2,5); particles.SpreadAngle=Vector2.new(15,15)
 particles.Parent=plume
 return folder
end
return Detail
]]></ProtectedString>
				<string name="ScriptGuid">{6d50e509-674e-4185-871a-114cb981216a}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">LifeCityVisuals</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2d8304864d25a21c0ae57211000003df</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="15">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- v0.6 LIFE CITY: in-game-only jobs, shops, creator career and law enforcement.
-- Server validates career, level, currency, ownership, cooldowns and proximity.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Terrain=workspace.Terrain
local Catalog=require(game:GetService("ReplicatedStorage"):WaitForChild("LifeCatalog"))
local Life={}
local context,world,folder
local stores={}
local workSites={}
local careerSites={}
local taskSites={}
-- v0.9: alternate interaction anchors embedded around the imported detailed
-- Modern Downtown. The original Life City remains fully functional.
local downtownStores={}
local downtownWorkSites={}
local downtownCareerSites={}
local downtownTaskSites={}
local downtownFineCounter=nil
local downtownFoodCounter=nil
local downtownRestCounter=nil
local policeUnits={}
local lastAction={}
local fineCounter=nil
local foodCounter=nil
local restCounter=nil
local publicMealCooldown={}
local propertySlots={}
local playerSlots={}
local playerProperties={}
local propertyBases={
 Vector3.new(-115,0,1712),Vector3.new(-69,0,1712),
 Vector3.new(-23,0,1712),Vector3.new(23,0,1712),
 Vector3.new(69,0,1712),Vector3.new(115,0,1712),
}
local jailCenter=Vector3.new(126,7,1655)
local townCenter=Vector3.new(0,0,1600)
local function part(parent,name,size,pos,color,material,collide)
 local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=pos
 p.Anchored=true; p.CanCollide=collide==true; p.CanTouch=false
 p.Material=material or Enum.Material.SmoothPlastic
 p.Color=color; p.Parent=parent
 return p
end
local function textSign(parent,name,position,color)
 local anchor=part(parent,"Store Sign Anchor",Vector3.one,position,color,nil,false)
 anchor.Transparency=1
 local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(260,55)
 gui.MaxDistance=160; gui.AlwaysOnTop=true; gui.Parent=anchor
 local t=Instance.new("TextLabel"); t.Size=UDim2.fromScale(1,1)
 t.BackgroundTransparency=1; t.Text=name; t.TextScaled=true
 t.TextColor3=color; t.TextStrokeTransparency=.2
 t.Font=Enum.Font.GothamBlack; t.Parent=gui
end
local function prompt(node,actionText,objectText,callback)
 local p=Instance.new("ProximityPrompt")
 p.ActionText=actionText; p.ObjectText=objectText
 p.MaxActivationDistance=13; p.HoldDuration=.5
 p.RequiresLineOfSight=false; p.Parent=node
 p.Triggered:Connect(callback)
end
local function root(player)
 return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end
local function nearby(player,anchor,distance)
 local r=root(player)
 return r and anchor and (r.Position-anchor.Position).Magnitude<=(distance or 20)
end
local function nearbyEither(player,a,b,distance)
 return nearby(player,a,distance) or nearby(player,b,distance)
end
local function profile(player)
 return context and context.getProfile(player)
end
local function tell(player,msg) context.tell(player,msg) end
function Life.Normalize(value)
 value=type(value)=="table" and value or {}
 return {
  career=Catalog.SanitizeCareer(value.career),
  owned=Catalog.SanitizeOwned(value.owned),
  followers=math.clamp(math.floor(tonumber(value.followers) or 0),0,10000000),
  uploads=math.clamp(math.floor(tonumber(value.uploads) or 0),0,1000000),
  shifts=math.clamp(math.floor(tonumber(value.shifts) or 0),0,1000000),
  reputation=math.clamp(math.floor(tonumber(value.reputation) or 0),0,1000000),
  fines=math.clamp(math.floor(tonumber(value.fines) or 0),0,1000000),
  arrests=math.clamp(math.floor(tonumber(value.arrests) or 0),0,100000),
  needs={
   hunger=math.clamp(math.floor(tonumber(type(value.needs)=="table" and value.needs.hunger) or 100),0,100),
   energy=math.clamp(math.floor(tonumber(type(value.needs)=="table" and value.needs.energy) or 100),0,100),
   hygiene=math.clamp(math.floor(tonumber(type(value.needs)=="table" and value.needs.hygiene) or 100),0,100),
  },
  lastWork=0,lastPost=0,lastBusiness=0,jailUntil=0,activeShift=nil,
 }
end
function Life.Serialize(value)
 local s=Life.Normalize(value)
 return {career=s.career,owned=s.owned,followers=s.followers,
  uploads=s.uploads,shifts=s.shifts,reputation=s.reputation,
  fines=s.fines,arrests=s.arrests,needs=s.needs}
end
function Life.Sync(player)
 local s=profile(player)
 if not s or not s.life then return end
 local life=s.life
 player:SetAttribute("RRLifeCareer",life.career)
 player:SetAttribute("RRLifeHunger",life.needs.hunger)
 player:SetAttribute("RRLifeEnergy",life.needs.energy)
 player:SetAttribute("RRLifeHygiene",life.needs.hygiene)
 player:SetAttribute("RRLifeFollowers",life.followers)
 player:SetAttribute("RRLifeUploads",life.uploads)
 player:SetAttribute("RRLifeShifts",life.shifts)
 player:SetAttribute("RRLifeReputation",life.reputation)
 player:SetAttribute("RRLifeFines",life.fines)
 player:SetAttribute("RRLifeArrests",life.arrests)
 player:SetAttribute("RRLifeJailed",os.clock()<life.jailUntil)
 player:SetAttribute("RRLifeJailRemaining",
  math.max(0,math.ceil(life.jailUntil-os.clock())))
 for _,item in ipairs(Catalog.Items) do
  player:SetAttribute("RRLifeOwn_"..item.id,life.owned[item.id]==true)
 end
 local shift=life.activeShift
 player:SetAttribute("RRLifeShift",shift and shift.id or "")
 player:SetAttribute("RRLifeTaskStep",shift and shift.progress or 0)
 local nextTarget=shift and taskSites[shift.id] and taskSites[shift.id][shift.progress+1]
 player:SetAttribute("RRLifeTaskName",nextTarget and
  nextTarget:GetAttribute("TaskLabel") or
  (shift and "RETURN TO YOUR WORKPLACE FOR WAGES" or ""))
 player:SetAttribute("RRLifeCarTier",
  life.owned.SPORTS_CAR and "SPORTS" or
  life.owned.SEDAN and "SEDAN" or "STARTER")
end
local function venue(parent,name,pos,shade)
 local building=Instance.new("Model"); building.Name=name
 building.Parent=parent
 local floor=part(building,"Floor",Vector3.new(36,1,32),
  pos+Vector3.new(0,2,0),Color3.fromRGB(135,137,139),Enum.Material.Concrete,true)
 part(building,"Back Wall",Vector3.new(36,14,1),
  pos+Vector3.new(0,9,15),shade,Enum.Material.Brick,true)
 for _,x in ipairs({-17.5,17.5}) do
  part(building,"Side Wall",Vector3.new(1,14,32),
   pos+Vector3.new(x,9,0),shade,Enum.Material.Brick,true)
 end
 for _,x in ipairs({-11,11}) do
  part(building,"Front Wall",Vector3.new(14,14,1),
   pos+Vector3.new(x,9,-15),shade,Enum.Material.Brick,true)
 end
 part(building,"Door Frame",Vector3.new(7,3,1),
  pos+Vector3.new(0,15,-15),Color3.fromRGB(63,76,91),Enum.Material.Metal,true)
 part(building,"Roof",Vector3.new(38,1.8,34),
  pos+Vector3.new(0,17,0),Color3.fromRGB(43,53,70),Enum.Material.Slate,true)
 for _,x in ipairs({-12,12}) do
  local glass=part(building,"Shopfront Glass",Vector3.new(7,7,.3),
   pos+Vector3.new(x,8,-15.6),Color3.fromRGB(157,206,228),Enum.Material.Glass,false)
  glass.Transparency=.35
 end
 local counter=part(building,"Shop Counter",Vector3.new(13,3,3),
  pos+Vector3.new(0,4,6),Color3.fromRGB(118,95,74),Enum.Material.Wood,true)
 textSign(building,name,pos+Vector3.new(0,22,-17),Color3.fromRGB(245,229,183))
 return counter
end
local function officer(parent,id,start)
 local m=Instance.new("Model"); m.Name="AI Police Officer "..id; m.Parent=parent
 m:SetAttribute("Behavior","Patrol")
 local torso=part(m,"Police Uniform",Vector3.new(2.4,3.2,1.5),
  start,Color3.fromRGB(32,51,92),Enum.Material.Fabric,false)
 m.PrimaryPart=torso
 part(m,"Head",Vector3.new(1.6,1.6,1.6),start+Vector3.new(0,2.4,0),
  Color3.fromRGB(191,144,110),Enum.Material.SmoothPlastic,false).Shape=Enum.PartType.Ball
 part(m,"Police Cap",Vector3.new(2,.45,2),start+Vector3.new(0,3.3,0),
  Color3.fromRGB(23,32,59),Enum.Material.Fabric,false)
 for _,x in ipairs({-1.5,1.5}) do
  part(m,"Arm",Vector3.new(.7,2.7,.9),start+Vector3.new(x,-.1,0),
   Color3.fromRGB(35,53,91),Enum.Material.Fabric,false)
 end
 for _,x in ipairs({-.6,.6}) do
  part(m,"Leg",Vector3.new(.9,2.6,1),start+Vector3.new(x,-2.9,0),
   Color3.fromRGB(35,40,51),Enum.Material.Fabric,false)
 end
 local city=start.Z>1500
 local route=city and {
  start,start+Vector3.new(-26,0,-8),start+Vector3.new(-40,0,24),
  start+Vector3.new(5,0,33)
 } or {
  start,start+Vector3.new(22,0,0),start+Vector3.new(22,0,18),
  start+Vector3.new(0,0,18)
 }
 table.insert(policeUnits,{model=m,home=start,position=start,target=nil,
  started=0,route=route,routeIndex=2})
end
function Life.Build(targetWorld,options)
 context=options; world=targetWorld
 folder=Instance.new("Folder"); folder.Name="Life City Simulation"; folder.Parent=world
 Terrain:FillBlock(CFrame.new(townCenter+Vector3.new(0,-4,0)),
  Vector3.new(350,12,580),Enum.Material.Grass)
 textSign(folder,"LIFE CITY • BUILD YOUR STORY",
  townCenter+Vector3.new(0,22,-8),Color3.fromRGB(251,226,162))
 textSign(folder,"JOBS • STORES • HOMES • CREATOR STUDIO • POLICE",
  townCenter+Vector3.new(0,16,-8),Color3.fromRGB(167,224,228))
 part(folder,"Life City Boulevard",Vector3.new(320,.8,20),
  townCenter+Vector3.new(0,2.5,0),Color3.fromRGB(59,63,69),Enum.Material.Asphalt,true)
 for i=-8,8 do
  part(folder,"Boulevard Lane Marking",Vector3.new(9,.08,.6),
   townCenter+Vector3.new(i*18,3,0),Color3.fromRGB(239,218,128),
   Enum.Material.SmoothPlastic,false)
 end
 local entries={
  {"TECH","Creator Technology Store",-112,-65,Color3.fromRGB(86,127,163)},
  {"APPAREL","Clothing Boutique",-62,-65,Color3.fromRGB(150,107,157)},
  {"HOME","Home Supply Store",-12,-65,Color3.fromRGB(140,127,104)},
  {"VEHICLE","Vehicle and Marine Dealer",38,-65,Color3.fromRGB(88,137,143)},
  {"PROPERTY","Real Estate Agency",88,-65,Color3.fromRGB(122,139,103)},
  {"BUSINESS","Business Licensing Office",138,-65,Color3.fromRGB(157,127,89)},
 }
 for _,entry in ipairs(entries) do
  local category,name,x,z,color=unpack(entry)
  local counter=venue(folder,name,townCenter+Vector3.new(x,0,z),color)
  stores[category]=counter
  prompt(counter,"BROWSE","Shop: "..name,function(player)
   tell(player,"OPEN LIFE SHOP • "..name.." • WALK NEAR THE COUNTER TO BUY")
  end)
 end
 local license=stores.BUSINESS
 prompt(license,"COLLECT REVENUE","Owned Business Earnings",function(player)
  Life.Process(player,"BusinessCollect")
 end)
 local careerCounter=venue(folder,"Career and Employment Center",
  townCenter+Vector3.new(-95,0,67),Color3.fromRGB(88,128,117))
 for i,career in ipairs(Catalog.Careers) do
  local row=math.floor((i-1)/7)
  local col=(i-1)%7
  local board=part(folder,"Career Board "..career.id,Vector3.new(4.6,4.6,1),
   careerCounter.Position+Vector3.new((col-3)*5.3,4,-12+row*8),
   Color3.fromRGB(57,83,115),Enum.Material.Metal,false)
  careerSites[career.id]=board
  prompt(board,"APPLY",career.name.." • Level "..career.level,function(player)
   Life.Process(player,"Career",career.id)
  end)
 end
 local sites={
  {"RETAIL","Retail Register",-62,69,Color3.fromRGB(110,169,133)},
  {"COURIER","Courier Dispatch",-30,69,Color3.fromRGB(118,148,181)},
  {"BARISTA","Cafe Counter",5,69,Color3.fromRGB(158,112,82)},
  {"MECHANIC","Repair Bay",42,69,Color3.fromRGB(119,133,150)},
  {"CONSTRUCTION","Construction Site",79,69,Color3.fromRGB(172,143,81)},
  {"POLICE","Police Patrol Desk",115,69,Color3.fromRGB(62,91,156)},
  {"CREATOR","Media Recording Studio",-8,24,Color3.fromRGB(145,95,160)},
  {"PARAMEDIC","Ambulance Medical Response",-123,135,Color3.fromRGB(232,228,220)},
  {"FIREFIGHTER","Fire and Rescue Station",-84,135,Color3.fromRGB(175,59,55)},
  {"CHEF","Restaurant Kitchen",-45,135,Color3.fromRGB(191,124,64)},
  {"FARMER","Greenhouse Farming",-6,135,Color3.fromRGB(88,154,91)},
  {"TEACHER","Community Classroom",33,135,Color3.fromRGB(122,145,184)},
  {"SANITATION","Recycling Depot",72,135,Color3.fromRGB(85,150,133)},
  {"ELECTRICIAN","Electrical Workshop",111,135,Color3.fromRGB(224,170,72)},
  {"PLUMBER","Plumbing Workshop",-123,184,Color3.fromRGB(93,153,197)},
  {"VETERINARIAN","Veterinary Clinic",-84,184,Color3.fromRGB(134,181,152)},
  {"REAL_ESTATE_AGENT","Property Sales Office",-45,184,Color3.fromRGB(166,143,111)},
  {"PHOTOGRAPHER","Photo Studio",-6,184,Color3.fromRGB(166,117,174)},
  {"PILOT","Flight Training Academy",33,184,Color3.fromRGB(91,133,174)},
  {"MUSICIAN","Recording and Rehearsal",72,184,Color3.fromRGB(179,99,141)},
 }
 for _,entry in ipairs(sites) do
  local id,name,x,z,color=unpack(entry)
  local node=part(folder,name,Vector3.new(8,5,5),
   townCenter+Vector3.new(x,5,z),color,Enum.Material.Metal,true)
  node:SetAttribute("CareerSite",id)
  workSites[id]=node
  prompt(node,id=="CREATOR" and "RECORD VIDEO" or "WORK SHIFT",name,
   function(player) Life.Process(player,id=="CREATOR" and "Publish" or "Work",id) end)
  textSign(folder,name,node.Position+Vector3.new(0,9,0),color)
  if id~="CREATOR" then
   local steps={
    RETAIL={"SCAN CUSTOMER ITEMS","STOCK DISPLAY SHELF"},
    COURIER={"PICK UP PARCEL","DELIVER TO CUSTOMER"},
    BARISTA={"PREPARE COFFEE ORDER","SERVE CUSTOMER"},
    MECHANIC={"INSPECT ENGINE","REPLACE WORN PART"},
    CONSTRUCTION={"MEASURE BUILD SITE","INSTALL BUILDING MATERIAL"},
    POLICE={"CHECK INCIDENT REPORT","INTERVIEW WITNESS"},
    PARAMEDIC={"CHECK PATIENT VITALS","APPLY FIRST AID"},
    FIREFIGHTER={"CHECK FIRE HOSE","EXTINGUISH TRAINING FIRE"},
    CHEF={"PREPARE INGREDIENTS","PLATE THE MEAL"},
    FARMER={"PLANT SEEDLINGS","HARVEST CROPS"},
    TEACHER={"PREPARE LESSON","TEACH CLASS"},
    SANITATION={"COLLECT RECYCLABLES","SORT WASTE"},
    ELECTRICIAN={"INSPECT CIRCUIT","RESTORE POWER"},
    PLUMBER={"INSPECT LEAK","REPAIR PIPE"},
    VETERINARIAN={"EXAMINE PET","ADMINISTER CARE"},
    REAL_ESTATE_AGENT={"STAGE PROPERTY","SHOW HOME TO CLIENT"},
    PHOTOGRAPHER={"SET UP LIGHTS","TAKE PORTRAIT"},
    PILOT={"RUN PRE-FLIGHT CHECK","CONFIRM LANDING PROCEDURE"},
    MUSICIAN={"TUNE INSTRUMENT","PERFORM ON STAGE"},
   }
   local actions=steps[id]
   taskSites[id]={}
   for step=1,2 do
    local pos=node.Position+Vector3.new(step==1 and -12 or 12,-.4,9)
    local target=part(folder,"Job Task "..id.." "..step,
     Vector3.new(6,3,4),pos,
     step==1 and Color3.fromRGB(116,169,190) or
     Color3.fromRGB(184,141,94),Enum.Material.Metal,true)
    target:SetAttribute("Job",id); target:SetAttribute("Step",step)
    target:SetAttribute("TaskLabel",actions[step])
    taskSites[id][step]=target
    textSign(folder,actions[step],pos+Vector3.new(0,6,0),
     Color3.fromRGB(255,240,187))
    prompt(target,actions[step],name,function(player)
     Life.Process(player,"Task",id,step)
    end)
   end
  end
 end
 local jail=Instance.new("Model"); jail.Name="Life City Jail"; jail.Parent=folder
 part(jail,"Jail Floor",Vector3.new(38,1,38),
  jailCenter-Vector3.new(0,4,0),Color3.fromRGB(100,109,119),Enum.Material.Concrete,true)
 for _,z in ipairs({-19,19}) do
  part(jail,"Jail Wall",Vector3.new(38,16,1),
   jailCenter+Vector3.new(0,3,z),Color3.fromRGB(98,111,127),Enum.Material.Concrete,true)
 end
 for _,x in ipairs({-19,19}) do
  part(jail,"Jail Wall",Vector3.new(1,16,38),
   jailCenter+Vector3.new(x,3,0),Color3.fromRGB(98,111,127),Enum.Material.Concrete,true)
 end
 for i=-3,3 do
  part(jail,"Cell Bars",Vector3.new(.55,12,.55),
   jailCenter+Vector3.new(i*3,3,-17.8),Color3.fromRGB(57,65,78),Enum.Material.Metal,true)
 end
 textSign(jail,"POLICE • JAIL • FINES",jailCenter+Vector3.new(0,17,0),
  Color3.fromRGB(254,188,126))
 local fines=part(folder,"Fine Payment Counter",Vector3.new(6,4,4),
  townCenter+Vector3.new(125,5,26),Color3.fromRGB(109,144,179),Enum.Material.Metal,true)
 fineCounter=fines
 prompt(fines,"PAY FINE","Life City Court",function(player)
  Life.Process(player,"PayFine")
 end)
 local meal=part(folder,"Community Meal Station",Vector3.new(8,4,5),
  townCenter+Vector3.new(-50,5,114),
  Color3.fromRGB(156,126,88),Enum.Material.Wood,true)
 foodCounter=meal
 textSign(folder,"COMMUNITY KITCHEN • MEALS",
  meal.Position+Vector3.new(0,8,0),Color3.fromRGB(241,223,176))
 prompt(meal,"EAT MEAL","Community Kitchen",function(player)
  Life.Process(player,"Eat","COMMUNITY")
 end)
 local bench=part(folder,"Public Rest Bench",Vector3.new(9,2,4),
  townCenter+Vector3.new(20,4,115),
  Color3.fromRGB(121,95,74),Enum.Material.Wood,true)
 restCounter=bench
 prompt(bench,"REST","Public Park Bench",function(player)
  Life.Process(player,"Rest","PUBLIC")
 end)
 policeUnits={}
 officer(folder,1,Vector3.new(180,7,18))
 officer(folder,2,townCenter+Vector3.new(113,7,23))
 return townCenter+Vector3.new(0,7,0)
end
-- Connect the life simulation to the imported official Modern City art.
-- These are intentionally tiny/invisible interaction anchors around real mesh
-- buildings; we do not build another fake city out of primitive cubes.
function Life.AttachDowntown(cityModel)
 if not folder or not cityModel or not cityModel.Parent then return false end
 local old=folder:FindFirstChild("Modern Downtown Life Services")
 if old then old:Destroy() end
 local services=Instance.new("Folder")
 services.Name="Modern Downtown Life Services"
 services.Parent=folder
 local function anchor(name,pos,visible)
  local node=part(services,name,Vector3.new(4.5,3,.5),pos,
   Color3.fromRGB(37,47,56),Enum.Material.Metal,false)
  node.Transparency=visible and .08 or 1
  node.CanQuery=true
  return node
 end
 local function plaque(name,pos,title,subtitle,color)
  local node=anchor(name,pos,true)
  node.Size=Vector3.new(7,4,.45)
  node.Color=color or Color3.fromRGB(39,54,64)
  local gui=Instance.new("SurfaceGui")
  gui.Name="Downtown Business Sign"
  gui.Face=Enum.NormalId.Front
  gui.CanvasSize=Vector2.new(700,400)
  gui.LightInfluence=.25
  gui.Parent=node
  local main=Instance.new("TextLabel")
  main.Size=UDim2.new(.94,0,.55,0); main.Position=UDim2.new(.03,0,.04,0)
  main.BackgroundTransparency=1; main.Text=title; main.TextWrapped=true
  main.TextScaled=true; main.Font=Enum.Font.GothamBold
  main.TextColor3=Color3.fromRGB(244,237,213); main.Parent=gui
  local sub=Instance.new("TextLabel")
  sub.Size=UDim2.new(.94,0,.27,0); sub.Position=UDim2.new(.03,0,.66,0)
  sub.BackgroundTransparency=1; sub.Text=subtitle; sub.TextWrapped=true
  sub.TextScaled=true; sub.Font=Enum.Font.Gotham
  sub.TextColor3=Color3.fromRGB(151,208,220); sub.Parent=gui
  return node
 end
 -- One clean employment office replaces 20 giant floating career boards.
 local employment=plaque("Downtown Employment Center",Vector3.new(-73,5,2247),
  "CITY EMPLOYMENT","20 CAREERS • APPLY IN LIFE MENU",Color3.fromRGB(47,78,82))
 prompt(employment,"BROWSE JOBS","Downtown Employment Center",function(player)
  tell(player,"OPEN LIFE • CHOOSE ANY CAREER YOU QUALIFY FOR • APPLY HERE")
 end)
 for _,career in ipairs(Catalog.Careers) do downtownCareerSites[career.id]=employment end
 -- Real storefront row. Shopping stays server-validated and paid with earned coins.
 local storefronts={
  {"APPAREL",-50,"THREADS","CLOTHING & FOOTWEAR"},
  {"TECH",-28,"CITY TECH","PHONES • COMPUTERS • CREATOR GEAR"},
  {"HOME",-6,"HOME & MORE","FURNITURE • TOOLS • GROCERIES"},
  {"VEHICLE",18,"MOTOR ROW","CARS • BIKES • BOATS"},
  {"PROPERTY",42,"METRO REALTY","APARTMENTS • HOMES • LAND"},
  {"BUSINESS",68,"CITY COMMERCE","BUY & RUN BUSINESSES"},
 }
 for _,entry in ipairs(storefronts) do
  local category,x,title,subtitle=unpack(entry)
  local node=plaque("Downtown Store "..category,Vector3.new(x,5,2247),
   title,subtitle,Color3.fromRGB(50,61,72))
  downtownStores[category]=node
  prompt(node,"SHOP",title,function(player)
   tell(player,"OPEN LIFE SHOP • "..title.." • PURCHASES USE EARNED IN-GAME COINS")
  end)
 end
 prompt(downtownStores.BUSINESS,"COLLECT REVENUE","Your Downtown Businesses",function(player)
  Life.Process(player,"BusinessCollect")
 end)
 -- Workplaces are spread around the actual imported city block. Invisible
 -- anchors preserve the official mesh art; prompts identify the real activity.
 local jobPositions={
  RETAIL=Vector3.new(-72,3,2263), BARISTA=Vector3.new(-36,3,2263),
  CREATOR=Vector3.new(0,3,2263), COURIER=Vector3.new(36,3,2263),
  MECHANIC=Vector3.new(72,3,2263),
  PARAMEDIC=Vector3.new(-100,3,2300), FIREFIGHTER=Vector3.new(-100,3,2340),
  CHEF=Vector3.new(-100,3,2380), FARMER=Vector3.new(-100,3,2420),
  CONSTRUCTION=Vector3.new(-100,3,2460),
  POLICE=Vector3.new(100,3,2300), TEACHER=Vector3.new(100,3,2340),
  SANITATION=Vector3.new(100,3,2380), ELECTRICIAN=Vector3.new(100,3,2420),
  PLUMBER=Vector3.new(100,3,2460),
  VETERINARIAN=Vector3.new(-70,3,2480), REAL_ESTATE_AGENT=Vector3.new(-35,3,2480),
  PHOTOGRAPHER=Vector3.new(0,3,2480), PILOT=Vector3.new(35,3,2480),
  MUSICIAN=Vector3.new(70,3,2480),
 }
 local taskLabels={
  RETAIL={"SCAN CUSTOMER ITEMS","STOCK DISPLAY SHELF"},
  COURIER={"PICK UP PARCEL","DELIVER TO CUSTOMER"},
  BARISTA={"PREPARE COFFEE ORDER","SERVE CUSTOMER"},
  MECHANIC={"INSPECT ENGINE","REPLACE WORN PART"},
  CONSTRUCTION={"MEASURE BUILD SITE","INSTALL BUILDING MATERIAL"},
  POLICE={"CHECK INCIDENT REPORT","INTERVIEW WITNESS"},
  PARAMEDIC={"CHECK PATIENT VITALS","APPLY FIRST AID"},
  FIREFIGHTER={"CHECK FIRE HOSE","EXTINGUISH TRAINING FIRE"},
  CHEF={"PREPARE INGREDIENTS","PLATE THE MEAL"},
  FARMER={"PLANT SEEDLINGS","HARVEST CROPS"},
  TEACHER={"PREPARE LESSON","TEACH CLASS"},
  SANITATION={"COLLECT RECYCLABLES","SORT WASTE"},
  ELECTRICIAN={"INSPECT CIRCUIT","RESTORE POWER"},
  PLUMBER={"INSPECT LEAK","REPAIR PIPE"},
  VETERINARIAN={"EXAMINE PET","ADMINISTER CARE"},
  REAL_ESTATE_AGENT={"STAGE PROPERTY","SHOW HOME TO CLIENT"},
  PHOTOGRAPHER={"SET UP LIGHTS","TAKE PORTRAIT"},
  PILOT={"RUN PRE-FLIGHT CHECK","CONFIRM LANDING PROCEDURE"},
  MUSICIAN={"TUNE INSTRUMENT","PERFORM ON STAGE"},
 }
 for _,career in ipairs(Catalog.Careers) do
  local pos=jobPositions[career.id]
  if pos then
   local site=anchor("Downtown Worksite "..career.id,pos,false)
   site:SetAttribute("CareerSite",career.id)
   downtownWorkSites[career.id]=site
   prompt(site,career.id=="CREATOR" and "RECORD VIDEO" or "WORK SHIFT",
    career.name,function(player)
     Life.Process(player,career.id=="CREATOR" and "Publish" or "Work",career.id)
    end)
   if career.id~="CREATOR" then
    downtownTaskSites[career.id]={}
    local labels=taskLabels[career.id]
    local tangent=(math.abs(pos.X)>90) and Vector3.new(0,0,8) or Vector3.new(8,0,0)
    for step=1,2 do
     local taskPos=pos+tangent*(step==1 and -1 or 1)
     local target=anchor("Downtown Job Task "..career.id.." "..step,taskPos,false)
     target:SetAttribute("Job",career.id); target:SetAttribute("Step",step)
     target:SetAttribute("TaskLabel",labels[step])
     downtownTaskSites[career.id][step]=target
     prompt(target,labels[step],career.name,function(player)
      Life.Process(player,"Task",career.id,step)
     end)
    end
   end
  end
 end
 -- Civic services integrated into the same walkable downtown block.
 downtownFineCounter=plaque("Downtown Court Payments",Vector3.new(88,5,2282),
  "CITY COURT","PAY FINES",Color3.fromRGB(66,76,91))
 prompt(downtownFineCounter,"PAY FINE","Downtown Court",function(player)
  Life.Process(player,"PayFine")
 end)
 downtownFoodCounter=anchor("Downtown Community Meal",Vector3.new(-88,3,2282),false)
 prompt(downtownFoodCounter,"EAT MEAL","Community Food Pantry",function(player)
  Life.Process(player,"Eat","COMMUNITY")
 end)
 downtownRestCounter=anchor("Downtown Public Rest",Vector3.new(0,3,2228),false)
 prompt(downtownRestCounter,"REST","Downtown Public Bench",function(player)
  Life.Process(player,"Rest","PUBLIC")
 end)
 -- Two additional officers make the detailed district participate in the law system.
 officer(services,3,Vector3.new(-92,7,2295))
 officer(services,4,Vector3.new(92,7,2395))
 cityModel:SetAttribute("LifeSimulationIntegrated",true)
 cityModel:SetAttribute("DowntownCareerCount",#Catalog.Careers)
 return true
end

function Life.RefreshProperty(player)
 local s=profile(player)
 if not s or not s.life then return end
 local owned=s.life.owned
 local tier=owned.MANSION and "MANSION" or
  owned.TOWNHOUSE and "TOWNHOUSE" or
  owned.APARTMENT and "APARTMENT" or nil
 local old=playerProperties[player]
 if old then old:Destroy(); playerProperties[player]=nil end
 if not tier then return end
 local slot=playerSlots[player]
 if not slot then return end
 local center=propertyBases[slot]
 local m=Instance.new("Model")
 m.Name="Owned "..tier.." "..player.UserId
 m:SetAttribute("OwnerUserId",player.UserId)
 m:SetAttribute("PropertyTier",tier)
 m.Parent=folder
 playerProperties[player]=m
 local width=tier=="MANSION" and 36 or tier=="TOWNHOUSE" and 29 or 24
 local floors=tier=="MANSION" and 3 or tier=="TOWNHOUSE" and 2 or 1
 local height=floors*10
 local color=tier=="MANSION" and Color3.fromRGB(216,211,199) or
  tier=="TOWNHOUSE" and Color3.fromRGB(183,143,115) or
  Color3.fromRGB(173,181,190)
 part(m,"Property Foundation",Vector3.new(width+3,1,30),
  center+Vector3.new(0,3,0),Color3.fromRGB(132,134,132),Enum.Material.Concrete,true)
 -- Walkable ground floor: four actual walls with an open doorway, not a solid cube.
 for _,x in ipairs({-width*.5,width*.5}) do
  part(m,"Property Side Wall",Vector3.new(1,height,26),
   center+Vector3.new(x,3+height*.5,0),color,Enum.Material.Brick,true)
 end
 part(m,"Property Rear Wall",Vector3.new(width,height,1),
  center+Vector3.new(0,3+height*.5,13),color,Enum.Material.Brick,true)
 for _,x in ipairs({-1,1}) do
  part(m,"Property Front Wall",Vector3.new((width-7)*.5,height,1),
   center+Vector3.new(x*(width+7)*.25,3+height*.5,-13),
   color,Enum.Material.Brick,true)
 end
 -- A player can enter, walk to furniture, and use the sofa/bed.
 local interior=Color3.fromRGB(204,194,175)
 part(m,"Interior Wood Floor",Vector3.new(width-2,.25,25),
  center+Vector3.new(0,3.65,0),Color3.fromRGB(145,105,77),
  Enum.Material.WoodPlanks,true)
 for _,x in ipairs({-width*.5+1,width*.5-1}) do
  part(m,"Interior Baseboard",Vector3.new(.2,.5,24),
   center+Vector3.new(x,4,0),interior,Enum.Material.Wood,false)
 end
 part(m,"Living Room Rug",Vector3.new(10,.1,7),
  center+Vector3.new(-width*.23,3.9,-2),
  Color3.fromRGB(122,137,148),Enum.Material.Fabric,false)
 part(m,"Sofa Seat",Vector3.new(7,1.3,3),
  center+Vector3.new(-width*.25,5,-2),
  Color3.fromRGB(94,123,127),Enum.Material.Fabric,true)
 part(m,"Sofa Back",Vector3.new(7,2.5,.9),
  center+Vector3.new(-width*.25,6,-.4),
  Color3.fromRGB(94,123,127),Enum.Material.Fabric,true)
 part(m,"Coffee Table",Vector3.new(5,.6,2.8),
  center+Vector3.new(-width*.25,4.7,-7),
  Color3.fromRGB(125,92,65),Enum.Material.Wood,true)
 part(m,"Bed Frame",Vector3.new(7,1,9),
  center+Vector3.new(width*.25,4.5,4),
  Color3.fromRGB(111,91,79),Enum.Material.Wood,true)
 part(m,"Bed Mattress",Vector3.new(6.6,.6,8.4),
  center+Vector3.new(width*.25,5.2,4),
  Color3.fromRGB(229,224,214),Enum.Material.Fabric,true)
 part(m,"Bed Pillow",Vector3.new(4,.5,1.8),
  center+Vector3.new(width*.25,5.8,7),
  Color3.fromRGB(243,241,230),Enum.Material.Fabric,false)
 part(m,"Kitchen Counter",Vector3.new(9,3,2.5),
  center+Vector3.new(-width*.25,5.3,9),
  Color3.fromRGB(159,160,154),Enum.Material.Marble,true)
 local kitchen=part(m,"Kitchen Sink",Vector3.new(2.2,.15,1.7),
  center+Vector3.new(-width*.25,6.9,8.9),
  Color3.fromRGB(91,104,110),Enum.Material.Metal,false)
 local sinkPrompt=Instance.new("ProximityPrompt")
 sinkPrompt.ActionText="WASH UP"; sinkPrompt.ObjectText="Home Kitchen"
 sinkPrompt.MaxActivationDistance=10; sinkPrompt.Parent=kitchen
 sinkPrompt.Triggered:Connect(function(p)
  if p==player then
   local state=profile(p)
   if state and state.life then
    state.life.needs.hygiene=100
    Life.Sync(p)
    tell(p,"SHOWERED AND FRESHENED UP • HYGIENE 100!")
   end
  end
 end)
 local bed=part(m,"Bed Interaction",Vector3.new(2,.2,2),
  center+Vector3.new(width*.25,6,4),
  Color3.fromRGB(229,224,214),Enum.Material.Fabric,false)
 bed.Transparency=1
 local restPrompt=Instance.new("ProximityPrompt")
 restPrompt.ActionText="REST"; restPrompt.ObjectText="Your Home"
 restPrompt.MaxActivationDistance=11; restPrompt.Parent=bed
 restPrompt.Triggered:Connect(function(p)
  if p==player then
   local state=profile(p)
   if state and state.life then
    state.life.needs.energy=100
    Life.Sync(p)
    tell(p,"SLEPT IN YOUR OWN BED • ENERGY 100!")
   end
  end
 end)
 for _,floorIndex in ipairs({2,3}) do
  if floorIndex<=floors then
   part(m,"Upper Level Floor",Vector3.new(width-1,.7,25),
    center+Vector3.new(0,3+(floorIndex-1)*10,0),
    Color3.fromRGB(145,105,77),Enum.Material.WoodPlanks,true)
  end
 end
 -- Gabled two-slope roof with overhang, ridge, chimney and front porch.
 for _,side in ipairs({-1,1}) do
  local wedge=Instance.new("WedgePart")
  wedge.Name="Sloped Architectural Roof"
  wedge.Size=Vector3.new(29,5,(width+3)*.5)
  wedge.CFrame=CFrame.new(center+Vector3.new(
   side*(width+3)*.25,6.5+height,0))*
   CFrame.Angles(0,side==1 and math.pi*.5 or -math.pi*.5,0)
  wedge.Anchored=true; wedge.CanCollide=true
  wedge.Material=Enum.Material.Slate
  wedge.Color=Color3.fromRGB(62,71,82); wedge.Parent=m
 end
 part(m,"Roof Ridge Cap",Vector3.new(1,1.1,31),
  center+Vector3.new(0,9.2+height,0),
  Color3.fromRGB(57,63,73),Enum.Material.Metal,false)
 part(m,"Brick Chimney",Vector3.new(3,7,3),
  center+Vector3.new(width*.29,9+height,5),
  Color3.fromRGB(151,101,91),Enum.Material.Brick,true)
 part(m,"Front Porch",Vector3.new(12,.7,7),
  center+Vector3.new(0,3.4,-17),
  Color3.fromRGB(173,167,155),Enum.Material.Concrete,true)
 for _,x in ipairs({-5,5}) do
  local column=part(m,"Porch Column",Vector3.new(1.2,9,1.2),
   center+Vector3.new(x,8,-19),
   Color3.fromRGB(226,222,207),Enum.Material.Limestone,true)
  column.Shape=Enum.PartType.Cylinder
 end
 part(m,"Porch Overhang",Vector3.new(13,.8,7),
  center+Vector3.new(0,12.8,-17),
  Color3.fromRGB(65,75,85),Enum.Material.Slate,true)
 for _,z in ipairs({-21,-23}) do
  part(m,"Front Steps",Vector3.new(9,.55,2),
   center+Vector3.new(0,z==-21 and 2.7 or 2.2,z),
   Color3.fromRGB(165,162,152),Enum.Material.Concrete,true)
 end
 part(m,"Home Driveway",Vector3.new(11,.3,20),
  center+Vector3.new(width*.28,2.2,-25),
  Color3.fromRGB(151,153,150),Enum.Material.Concrete,true)
 for _,x in ipairs({-width*.5+3,width*.5-3}) do
  local shrub=part(m,"Front Garden Shrub",Vector3.new(4,3,4),
   center+Vector3.new(x,4,-17),
   Color3.fromRGB(68,123,75),Enum.Material.Grass,false)
  shrub.Shape=Enum.PartType.Ball
 end
 local houseLight=part(m,"Porch Light",Vector3.new(1.3,1.3,1.3),
  center+Vector3.new(0,10.8,-13.5),
  Color3.fromRGB(252,224,175),Enum.Material.Neon,false)
 local bulb=Instance.new("PointLight"); bulb.Brightness=.8; bulb.Range=12
 bulb.Color=Color3.fromRGB(255,223,175); bulb.Parent=houseLight
 for floorIndex=1,floors do
  for _,x in ipairs({-width*.28,width*.28}) do
   for _,z in ipairs({-13.2,13.2}) do
    local glass=part(m,"Property Window",Vector3.new(5,5,.25),
     center+Vector3.new(x,5+floorIndex*9-5,z),
     Color3.fromRGB(115,182,210),Enum.Material.Glass,false)
    glass.Transparency=.23
   end
  end
 end
 part(m,"Property Entrance",Vector3.new(6,8,.5),
  center+Vector3.new(0,7,-13.5),
  Color3.fromRGB(76,92,108),Enum.Material.WoodPlanks,false)
 textSign(m,tier.." • "..player.DisplayName,
  center+Vector3.new(0,height+12,-15),Color3.fromRGB(255,235,169))
end
function Life.PlayerJoined(player)
 if playerSlots[player] then return end
 for i=1,#propertyBases do
  if not propertySlots[i] then
   propertySlots[i]=player; playerSlots[player]=i
   break
  end
 end
 Life.RefreshProperty(player)
end
function Life.PlayerRemoving(player)
 local slot=playerSlots[player]
 if slot then propertySlots[slot]=nil end
 playerSlots[player]=nil
 local m=playerProperties[player]
 if m then m:Destroy() end
 playerProperties[player]=nil
 lastAction[player]=nil
 publicMealCooldown[player]=nil
end
function Life.GiveCamera(player)
 local s=profile(player)
 if not s or not s.life or not s.life.owned.CAMERA then return end
 local backpack=player:FindFirstChildOfClass("Backpack")
 if not backpack then return end
 if backpack:FindFirstChild("Creator Camera") or
  (player.Character and player.Character:FindFirstChild("Creator Camera")) then return end
 local tool=Instance.new("Tool"); tool.Name="Creator Camera"
 tool.ToolTip="Equip at the Life City recording studio, then tap RECORD"
 tool.CanBeDropped=false; tool.RequiresHandle=true
 local handle=Instance.new("Part"); handle.Name="Handle"
 handle.Size=Vector3.new(2,1.4,1.3)
 handle.Material=Enum.Material.Metal; handle.Color=Color3.fromRGB(42,48,58)
 handle.CanCollide=false; handle.Massless=true; handle.Parent=tool
 local lens=Instance.new("Part"); lens.Name="Camera Lens"
 lens.Shape=Enum.PartType.Cylinder
 lens.Size=Vector3.new(.85,1.1,1.1)
 lens.Color=Color3.fromRGB(90,158,188)
 lens.Material=Enum.Material.Glass; lens.CanCollide=false; lens.Massless=true
 lens.CFrame=handle.CFrame*CFrame.new(0,0,-.85)*CFrame.Angles(0,0,math.rad(90))
 lens.Parent=tool
 local weld=Instance.new("WeldConstraint"); weld.Part0=handle
 weld.Part1=lens; weld.Parent=handle
 tool.Parent=backpack
end
function Life.IsJailed(player)
 local s=profile(player)
 return s and s.life and os.clock()<s.life.jailUntil or false
end
function Life.Process(player,kind,arg,step)
 local s=profile(player)
 if not s or not s.life or type(kind)~="string" then return false end
 local life=s.life
 if Life.IsJailed(player) then
  tell(player,"YOU ARE SERVING A SHORT IN-GAME JAIL SENTENCE.")
  return false
 end
 local now=os.clock()
 if now-(lastAction[player] or -100)<.35 then return false end
 lastAction[player]=now
 if kind=="Career" then
  local career=type(arg)=="string" and Catalog.CareerById[arg]
  if not career or not nearbyEither(player,careerSites[arg],downtownCareerSites[arg],17) then return false end
  if s.level<career.level then
   tell(player,"REACH LEVEL "..career.level.." TO APPLY."); return false
  end
  if s.heat>0 then tell(player,"CLEAR YOUR WANTED HEAT BEFORE APPLYING."); return false end
  life.career=arg
  life.activeShift=nil
  tell(player,"HIRED: "..career.name.."! FIND YOUR WORKPLACE.")
 elseif kind=="Work" then
  local career=type(arg)=="string" and Catalog.CareerById[arg]
  if not career or arg=="CREATOR" or life.career~=arg or
   not nearbyEither(player,workSites[arg],downtownWorkSites[arg],18) then return false end
  if life.needs.energy<10 or life.needs.hunger<10 then
   tell(player,"TOO TIRED OR HUNGRY TO WORK • REST OR EAT AT THE COMMUNITY KITCHEN.")
   return false
  end
  if now-life.lastWork<12 then
   tell(player,"SHIFT REST BREAK • TRY AGAIN SHORTLY."); return false
  end
  if arg=="POLICE" and s.heat>0 then
   tell(player,"POLICE OFFICERS MUST HAVE A CLEAR RECORD."); return false
  end
  if not life.activeShift or life.activeShift.id~=arg then
   life.activeShift={id=arg,started=now,progress=0,taskAt=0}
   tell(player,"SHIFT STARTED: "..career.name..
    " • COMPLETE THE TWO WORK TASKS MARKED NEARBY.")
   Life.Sync(player)
   return true
  end
  if life.activeShift.progress<2 then
   tell(player,"COMPLETE BOTH WORK TASKS BEFORE COLLECTING YOUR WAGES.")
   return false
  end
  life.activeShift=nil
  life.lastWork=now; life.shifts+=1
  life.needs.energy=math.max(0,life.needs.energy-5)
  life.needs.hunger=math.max(0,life.needs.hunger-4)
  life.needs.hygiene=math.max(0,life.needs.hygiene-2)
  life.reputation=math.min(1000000,life.reputation+1)
  context.reward(player,career.wage,14,0)
  tell(player,"SHIFT COMPLETED! +"..career.wage.." COINS • +14 XP")
 elseif kind=="Task" then
  local shift=life.activeShift
  if type(arg)~="string" or not Catalog.CareerById[arg] or
   not shift or shift.id~=arg or life.career~=arg then return false end
  local expected=shift.progress+1
  if type(step)~="number" or step~=expected or step>2 or
   (not taskSites[arg] and not downtownTaskSites[arg]) or
   not nearbyEither(player,taskSites[arg] and taskSites[arg][step],
    downtownTaskSites[arg] and downtownTaskSites[arg][step],15) then
   tell(player,"FOLLOW YOUR ASSIGNED WORK TASKS IN ORDER.")
   return false
  end
  if now-shift.started<1.5 or
   (shift.progress>0 and now-shift.taskAt<1.5) then
   tell(player,"TAKE TIME TO COMPLETE YOUR WORK SAFELY.")
   return false
  end
  if arg=="PHOTOGRAPHER" and not life.owned.CAMERA then
   tell(player,"PHOTOGRAPHERS NEED A CAMERA FROM THE TECH STORE.")
   return false
  end
  if arg=="MUSICIAN" and not life.owned.GUITAR then
   tell(player,"MUSICIANS NEED A GUITAR FROM THE TECH STORE.")
   return false
  end
  shift.progress=step; shift.taskAt=now
  tell(player,step==2 and "ALL TASKS DONE! RETURN TO THE WORK STATION FOR WAGES."
   or "FIRST TASK COMPLETE! FIND THE SECOND WORK TASK.")
  Life.Sync(player)
  return true
 elseif kind=="Eat" then
  if arg~="COMMUNITY" or not nearbyEither(player,foodCounter,downtownFoodCounter,17) then return false end
  if now-(publicMealCooldown[player] or -1000)<45 then
   tell(player,"THE KITCHEN IS PREPARING MORE MEALS • COME BACK SOON.")
   return false
  end
  publicMealCooldown[player]=now
  life.needs.hunger=math.min(100,life.needs.hunger+50)
  tell(player,"ATE A FREE COMMUNITY MEAL • HUNGER RESTORED!")
 elseif kind=="Rest" then
  if arg~="PUBLIC" or not nearbyEither(player,restCounter,downtownRestCounter,17) then return false end
  life.needs.energy=math.min(100,life.needs.energy+25)
  tell(player,"RESTED AT THE PARK • ENERGY RESTORED!")
 elseif kind=="Buy" then
  local item=type(arg)=="string" and Catalog.ById[arg]
  if not item or not nearbyEither(player,stores[item.category],downtownStores[item.category],24) then
   tell(player,"VISIT THE CORRECT LIFE CITY STORE TO PURCHASE."); return false
  end
  if life.owned[item.id] then tell(player,"YOU ALREADY OWN THIS ITEM."); return false end
  if s.level<item.level then
   tell(player,"REACH LEVEL "..item.level.." FIRST."); return false
  end
  if s.coins<item.price then
   tell(player,"YOU NEED "..(item.price-s.coins).." MORE COINS."); return false
  end
  s.coins-=item.price
  life.owned[item.id]=true
  if item.id=="CAMERA" then Life.GiveCamera(player) end
  if item.category=="PROPERTY" then Life.RefreshProperty(player) end
  tell(player,"PURCHASED: "..item.name.."! THIS IS AN IN-GAME ITEM.")
 elseif kind=="Publish" then
  if life.career~="CREATOR" or
   not nearbyEither(player,workSites.CREATOR,downtownWorkSites.CREATOR,18) then
   tell(player,"BECOME A CREATOR AND VISIT THE RECORDING STUDIO."); return false
  end
  if not life.owned.PHONE or not life.owned.CAMERA then
   tell(player,"BUY A PHONE AND CAMERA BEFORE RECORDING."); return false
  end
  if now-life.lastPost<24 then
   tell(player,"EDIT YOUR NEXT VIDEO • WAIT FOR THE POST COOLDOWN."); return false
  end
  local char=player.Character
  if not char or not char:FindFirstChild("Creator Camera") then
   tell(player,"EQUIP YOUR CREATOR CAMERA BEFORE RECORDING.")
   return false
  end
  life.lastPost=now; life.uploads+=1
  local production=life.owned.WORKSTATION and 4 or life.owned.MIC and 2 or 1
  local newFollowers=math.min(1500,10+production*12+math.floor(life.followers*.04))
  life.followers=math.min(10000000,life.followers+newFollowers)
  life.reputation=math.min(1000000,life.reputation+production)
  local revenue=math.min(220,8+math.floor(life.followers/100)+production*4)
  context.reward(player,revenue,20+production*4,0)
  tell(player,"VIDEO POSTED! +"..newFollowers.." FOLLOWERS • +"..revenue.." COINS")
 elseif kind=="BusinessCollect" then
  if not nearbyEither(player,stores.BUSINESS,downtownStores.BUSINESS,24) then return false end
  if now-life.lastBusiness<90 then
   tell(player,"YOUR BUSINESSES NEED TIME TO SERVE CUSTOMERS."); return false
  end
  local revenue=0
  for id,amount in pairs(Catalog.BusinessPayouts) do
   if life.owned[id] then revenue+=amount end
  end
  if revenue==0 then tell(player,"BUY A BUSINESS FIRST."); return false end
  life.lastBusiness=now
  context.reward(player,revenue,10,0)
  tell(player,"COLLECTED "..revenue.." COINS FROM YOUR BUSINESSES!")
 elseif kind=="PayFine" then
  if not nearbyEither(player,fineCounter,downtownFineCounter,20) then return false end
  if life.fines<=0 then tell(player,"NO UNPAID FINES."); return false end
  local amount=math.min(s.coins,life.fines)
  s.coins-=amount; life.fines-=amount
  tell(player,"PAID "..amount.." COINS TOWARD COURT FINES.")
 else return false end
 context.sync(player)
 return true
end
local function arrest(player,s,officerUnit)
 if Life.IsJailed(player) then return end
 local life=s.life
 local fine=math.min(s.coins,math.max(15,math.floor(s.heat*.6)))
 s.coins-=fine
 life.fines=math.min(1000000,life.fines+math.floor(s.heat*.3))
 life.arrests+=1
 life.jailUntil=os.clock()+20
 s.heat=0
 officerUnit.model:SetAttribute("Behavior","Arrest")
 local char=player.Character
 if char then char:PivotTo(CFrame.new(jailCenter+Vector3.new(0,2,0))) end
 context.sync(player)
 tell(player,"ARRESTED BY POLICE! 20s JAIL • "..fine..
  " COIN FINE • YOUR GEAR IS SAFE.")
end
function Life.Start()
 local elapsed=0
 local needsElapsed=0
 RunService.Heartbeat:Connect(function(dt)
  if not world or not world.Parent then return end
  elapsed+=dt
  needsElapsed+=dt
  if needsElapsed>=120 then
   needsElapsed=0
   for _,player in ipairs(Players:GetPlayers()) do
    local state=profile(player)
    if state and state.life then
     local needs=state.life.needs
     needs.energy=math.max(0,needs.energy-2)
     needs.hunger=math.max(0,needs.hunger-2)
     needs.hygiene=math.max(0,needs.hygiene-1)
     Life.Sync(player)
    end
   end
  end
  if elapsed<.2 then return end
  local step=math.min(elapsed,.25); elapsed=0
  local now=os.clock()
  for _,player in ipairs(Players:GetPlayers()) do
   local s=profile(player)
   if s and s.life and s.life.jailUntil>0 then
    if now>=s.life.jailUntil then
     s.life.jailUntil=0
     local char=player.Character
     if char then char:PivotTo(CFrame.new(townCenter+Vector3.new(105,7,12))) end
     context.sync(player)
     tell(player,"RELEASED! YOU CAN RETURN TO WORK AND REBUILD REPUTATION.")
    elseif not nearby(player,
      {Position=jailCenter},20) then
     local char=player.Character
     if char then char:PivotTo(CFrame.new(jailCenter+Vector3.new(0,2,0))) end
    end
   end
  end
  for _,unit in ipairs(policeUnits) do
   local closest,dist=nil,85
   for _,player in ipairs(Players:GetPlayers()) do
    local s=profile(player)
    local r=root(player)
    if s and s.life and not Life.IsJailed(player) and
     s.heat>=40 and r and (r.Position-unit.position).Magnitude<dist then
     closest=player; dist=(r.Position-unit.position).Magnitude
    end
   end
   if closest then
    if unit.target~=closest then unit.target=closest; unit.started=now end
    unit.model:SetAttribute("Behavior","Pursuit")
    local r=root(closest)
    if r then
     local delta=Vector3.new(r.Position.X-unit.position.X,0,
      r.Position.Z-unit.position.Z)
     if delta.Magnitude>1 then
      local direction=delta.Unit
      unit.position+=direction*math.min(delta.Magnitude,step*18)
      unit.model:PivotTo(CFrame.lookAt(unit.position,unit.position+direction))
     end
     if delta.Magnitude<8 and now-unit.started>5 then
      local s=profile(closest)
      if s then arrest(closest,s,unit) end
      unit.target=nil
     end
    end
   else
    unit.target=nil
    unit.model:SetAttribute("Behavior","Patrol")
    local goal=unit.route[unit.routeIndex]
    local delta=goal-unit.position
    if delta.Magnitude<2 then
     unit.routeIndex=unit.routeIndex%#unit.route+1
    else
     local direction=delta.Unit
     unit.position+=direction*math.min(delta.Magnitude,step*6)
     unit.model:PivotTo(CFrame.lookAt(unit.position,unit.position+direction))
    end
   end
  end
 end)
 Players.PlayerRemoving:Connect(Life.PlayerRemoving)
end
return Life
]]></ProtectedString>
				<string name="ScriptGuid">{8fc70e81-aaa4-4f73-ac62-42b6b3163c36}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">LifeSimulation</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2d8304864d25a21c0ae57211000003e0</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="16">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Official Roblox Modern City district integration.
-- Imported geometry and material variants originate from Roblox Studio's
-- built-in Modern City template. All imported executable scripts were removed.
-- World construction remains separate so this art can be reused in future games.
local Integration={}
local ORIGIN=Vector3.new(720,0,200)
local DESTINATION=Vector3.new(0,0,2350)
local DELTA=DESTINATION-ORIGIN

local function anchor(parent,name,size,position,color,material,collidable)
 local p=Instance.new("Part")
 p.Name=name; p.Anchored=true; p.CanCollide=collidable==true
 p.CanTouch=false; p.CanQuery=true
 p.Size=size; p.Position=position
 p.Material=material or Enum.Material.Metal
 p.Color=color or Color3.fromRGB(64,85,99)
 p.TopSurface=Enum.SurfaceType.Smooth
 p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=parent
 return p
end
local function board(parent,name,position,title,subtitle)
 local base=anchor(parent,name,Vector3.new(13,8,.8),position,
  Color3.fromRGB(33,47,62),Enum.Material.Metal,true)
 local face=Instance.new("SurfaceGui")
 face.Name="City Wayfinding Sign"
 face.Face=Enum.NormalId.Front
 face.CanvasSize=Vector2.new(850,520)
 face.LightInfluence=.25; face.Parent=base
 local main=Instance.new("TextLabel")
 main.BackgroundTransparency=1
 main.Size=UDim2.new(.94,0,.6,0)
 main.Position=UDim2.new(.03,0,.04,0)
 main.Text=title; main.TextWrapped=true
 main.Font=Enum.Font.GothamBold; main.TextScaled=true
 main.TextColor3=Color3.fromRGB(248,238,211); main.Parent=face
 local sub=Instance.new("TextLabel")
 sub.BackgroundTransparency=1
 sub.Size=UDim2.new(.94,0,.28,0)
 sub.Position=UDim2.new(.03,0,.65,0)
 sub.Text=subtitle; sub.TextWrapped=true
 sub.Font=Enum.Font.Gotham; sub.TextScaled=true
 sub.TextColor3=Color3.fromRGB(142,206,227); sub.Parent=face
 return base
end
local function portal(parent,position,title,description,callback)
 local base=board(parent,"Modern City Wayfinding Terminal",position,title,description)
 local prompt=Instance.new("ProximityPrompt")
 prompt.Name="Travel to "..title
 prompt.ActionText="TRAVEL"
 prompt.ObjectText=title
 prompt.HoldDuration=.3
 prompt.MaxActivationDistance=14
 prompt.RequiresLineOfSight=false
 prompt.Parent=base
 prompt.Triggered:Connect(callback)
 return base
end
function Integration.Build(world,spawn,tell)
 local imported=workspace:FindFirstChild("OfficialModernCityDistrict")
 if not imported or not imported:IsA("Model") then
  warn("Official Modern City art not loaded; leaving original hub spawn")
  return nil
 end
 -- The source art is a prebuilt street block around x=720,z=200. Move it
 -- to a new streaming-friendly region, keeping the original street layout.
 imported:PivotTo(imported:GetPivot()+DELTA)
 imported:SetAttribute("ArtSource","Official Roblox Studio Modern City Template")
 imported:SetAttribute("ImportedScriptsRemoved",true)
 imported:SetAttribute("OriginalCenter","720,0,200")
 imported:SetAttribute("WorldRegion","DOWNTOWN")
 imported.Name="OfficialModernCityDistrict"
 local folder=Instance.new("Folder")
 folder.Name="Downtown Wayfinding"
 folder.Parent=world
 -- The extracted city Model already contains its static asphalt foundation,
 -- so both edit mode and Play mode show buildings grounded in a real street.
 local pad=anchor(folder,"Downtown Arrival Sidewalk",Vector3.new(13,.35,11),
  Vector3.new(0,.68,2215),Color3.fromRGB(67,70,72),
  Enum.Material.Asphalt,true)
 -- Paint a recognizable pedestrian crossing at the welcome plaza.
 for i=-4,4 do
  anchor(folder,"Downtown Arrival Crosswalk",Vector3.new(2.5,.1,9),
   Vector3.new(i*3.8,.12,2196),
   Color3.fromRGB(233,230,215),Enum.Material.Concrete,false)
 end
 pad.Transparency=.12
 -- The city becomes the player's first impression, instead of the block arena.
 if spawn then
  spawn.CFrame=CFrame.new(0,1.5,2215)*CFrame.Angles(0,math.pi,0)
  spawn.Size=Vector3.new(9,1,9)
  spawn.Material=Enum.Material.Concrete
  spawn.Color=Color3.fromRGB(148,155,159)
  spawn.Transparency=1
  spawn.CanCollide=false
 end
 portal(folder,Vector3.new(23,7,2215),
  "LIFE CITY JOBS","20 CAREERS • STORES • HOMES",function(player)
   if player.Character then
    player.Character:PivotTo(CFrame.new(0,7,1600))
    tell(player,"WELCOME TO LIFE CITY • START YOUR CAREER!")
   end
  end)
 portal(folder,Vector3.new(-23,7,2215),
  "RIFT ADVENTURES","PORTALS • SPORTS • CASTLES",function(player)
   if player.Character then
    player.Character:PivotTo(CFrame.new(0,6,0))
    tell(player,"RIFT ADVENTURES • ENTER THE HUB!")
   end
  end)
 portal(folder,Vector3.new(0,7,1675),
  "MODERN DOWNTOWN","REAL 3D CITY • SHOPS • STREETS",function(player)
   if player.Character then
    player.Character:PivotTo(CFrame.new(0,8,2215))
    tell(player,"WELCOME TO MODERN DOWNTOWN!")
   end
  end)
 -- Street traffic and shop props are decorative; never claim drivable assets
 -- are actually usable unless server-owned physics controls are implemented.
 return Vector3.new(0,8,2215)
end
return Integration
]]></ProtectedString>
				<string name="ScriptGuid">{a4283fb6-fcff-4d42-b280-67a401f81ded}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ModernCityIntegration</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2d8304864d25a21c0ae57211000003e1</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="17">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- RIFT RAIDERS: CHAOS ISLANDS. Original, free-to-play multiplayer prototype.
-- All rewards, combat, abilities and progression are validated on the server.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local DataStoreService=game:GetService("DataStoreService")
local HttpService=game:GetService("HttpService")
local Debris=game:GetService("Debris")
local ServerScriptService=game:GetService("ServerScriptService")
local WorldKit=require(ServerScriptService:WaitForChild("WorldKit"))
local WorldExpansion=require(ServerScriptService:WaitForChild("WorldExpansion"))
local WorldActivities=require(ServerScriptService:WaitForChild("WorldActivities"))
local WorldPolish=require(ServerScriptService:WaitForChild("WorldPolish"))
local Life=require(ServerScriptService:WaitForChild("LifeSimulation"))
local LifeCityVisuals=require(ServerScriptService:WaitForChild("LifeCityVisuals"))
local ModernCityIntegration=require(ServerScriptService:WaitForChild("ModernCityIntegration"))
local DowntownPopulation=require(ServerScriptService:WaitForChild("DowntownPopulation"))
local Catalog=require(ReplicatedStorage:WaitForChild("PrestigeCatalog"))
local Vehicles=require(ServerScriptService:WaitForChild("VehicleService"))
local world=Instance.new("Folder"); world.Name="RiftRaidersWorld"; world.Parent=workspace
world:SetAttribute("Version","0.11.0")
world:SetAttribute("Phase","CALM")
world:SetAttribute("SecondsLeft",75)
local palette={Color3.fromRGB(54,232,244),Color3.fromRGB(255,96,164),Color3.fromRGB(171,110,255),Color3.fromRGB(255,209,75),Color3.fromRGB(91,244,149)}
local biomes={
 {id="CYBER",name="Neon Metropolis",center=Vector3.new(180,0,0),color=palette[1]},
 {id="CRYSTAL",name="Prism Wilds",center=Vector3.new(-180,0,0),color=palette[3]},
 {id="VOLCANO",name="Magma Outpost",center=Vector3.new(0,0,180),color=palette[2]},
 {id="SKY",name="Cloud Kingdom",center=Vector3.new(0,0,-180),color=palette[4]},
}
local function part(name,size,pos,color,material,collide)
 local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.Size=size; p.Position=pos
 p.Material=material or Enum.Material.SmoothPlastic; p.Color=color
 p.CanCollide=collide~=false; p.TopSurface=Enum.SurfaceType.Smooth
 p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=world; return p
end
local function sign(text,pos,color,width)
 local anchor=part("SignAnchor",Vector3.new(1,1,1),pos,color,nil,false)
 anchor.Transparency=1
 local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(width or 280,64)
 gui.MaxDistance=160; gui.AlwaysOnTop=true; gui.Parent=anchor
 local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(1,1)
 label.BackgroundTransparency=1; label.Text=text; label.TextScaled=true
 label.TextColor3=color; label.TextStrokeTransparency=.3
 label.Font=Enum.Font.GothamBlack; label.Parent=gui
 return anchor
end
local function glow(p,color,range)
 local light=Instance.new("PointLight"); light.Color=color; light.Range=range or 14
 light.Brightness=1.2; light.Parent=p
end
Lighting.ClockTime=16; Lighting.Brightness=2.5
Lighting.Ambient=Color3.fromRGB(120,132,179)
local atmosphere=Instance.new("Atmosphere"); atmosphere.Density=.18
atmosphere.Color=Color3.fromRGB(155,176,236); atmosphere.Parent=Lighting
local bloom=Instance.new("BloomEffect"); bloom.Intensity=.22; bloom.Threshold=1.8
bloom.Size=24; bloom.Parent=Lighting
part("Void Floor",Vector3.new(650,2,650),Vector3.new(0,-70,0),Color3.fromRGB(14,13,32),nil,false)
local hub=part("Central Hub",Vector3.new(120,4,120),Vector3.new(0,-1,0),Color3.fromRGB(38,45,85))
local spawn=Instance.new("SpawnLocation"); spawn.Name="RiftRaidersSpawn"
spawn.Neutral=true; spawn.Anchored=true; spawn.Size=Vector3.new(22,1,22)
spawn.Position=Vector3.new(0,2,0); spawn.Material=Enum.Material.Neon
spawn.Color=palette[5]; spawn.Parent=world
sign("RIFT RAIDERS | CHAOS ISLANDS",Vector3.new(0,23,0),palette[4],460)
sign("BLAST DRONES • COLLECT SHARDS • SEAL RIFTS",Vector3.new(0,15,0),palette[1],460)
-- Central arena, tower, rings and colored paths: readable on a small screen.
for i=1,8 do
 local angle=(i-1)*math.pi/4
 local pos=Vector3.new(math.cos(angle)*47,8,math.sin(angle)*47)
 local tower=part("Hub Beacon Pillar",Vector3.new(6,16,6),pos,palette[(i-1)%5+1],Enum.Material.Metal)
 local lamp=part("Hub Beacon Light",Vector3.new(8,2,8),pos+Vector3.new(0,9,0),palette[(i-1)%5+1],Enum.Material.Neon)
 glow(lamp,lamp.Color)
end
local bridgeData={
 {Vector3.new(90,0,0),Vector3.new(75,2,22)},
 {Vector3.new(-90,0,0),Vector3.new(75,2,22)},
 {Vector3.new(0,0,90),Vector3.new(22,2,75)},
 {Vector3.new(0,0,-90),Vector3.new(22,2,75)},
}
for i,b in ipairs(bridgeData) do
 local walkway=part("Safe Skybridge",b[2],b[1],palette[i],Enum.Material.SmoothPlastic)
 for side=-1,1,2 do
  local railSize=i<=2 and Vector3.new(75,3,2) or Vector3.new(2,3,75)
  local offset=i<=2 and Vector3.new(0,2,side*11) or Vector3.new(side*11,2,0)
  part("Bridge Rail",railSize,b[1]+offset,Color3.fromRGB(31,40,76),Enum.Material.Metal)
 end
end
local shards={}
local drones={}
local beacons={}
-- Co-op Chaos Titan: a shared boss that appears during Rift Surge.
local boss=part("Chaos Titan",Vector3.new(17,17,17),Vector3.new(0,17,0),
 palette[2],Enum.Material.Neon,false)
boss.Shape=Enum.PartType.Ball; boss.Transparency=1; boss.CanTouch=false
boss:SetAttribute("Health",0)
glow(boss,palette[2],35)
local bossActive=false; local bossHP=0; local bossContributors={}
local bossAttackAt=0
for index,biome in ipairs(biomes) do
 local center=biome.center
 local base=part(biome.id.." Island",Vector3.new(115,4,115),center+Vector3.new(0,-1,0),
  Color3.fromRGB(38+index*9,37+index*7,75+index*7))
 sign(biome.name:upper(),center+Vector3.new(0,22,0),biome.color,360)
 for i=1,8 do
  local angle=i*math.pi/4
  local x=math.cos(angle)*42; local z=math.sin(angle)*42
  local height=9+(i%3)*9
  local p=part(biome.id.." Landmark",Vector3.new(9,height,9),
   center+Vector3.new(x,height/2,z),Color3.fromRGB(30,40,74),Enum.Material.Metal)
  local cap=part(biome.id.." Glow Roof",Vector3.new(11,2,11),
   p.Position+Vector3.new(0,height/2+1,0),biome.color,Enum.Material.Neon,false)
  if index==2 then
   local crystal=part("Prism Spire",Vector3.new(5,height+8,5),
    p.Position+Vector3.new(0,7,0),biome.color,Enum.Material.Glass,false)
   crystal.CFrame=crystal.CFrame*CFrame.Angles(0,math.rad(i*30),math.rad(10))
  elseif index==3 then
   local fire=Instance.new("Fire"); fire.Size=7; fire.Heat=5; fire.Parent=cap
  elseif index==4 then
   local cloud=part("Cloud Platform",Vector3.new(16,2,16),
    p.Position+Vector3.new(0,height/2+8,0),Color3.fromRGB(235,239,255),nil,false)
   cloud.Shape=Enum.PartType.Ball
  end
 end
 local beacon=part("Rift Core "..biome.id,Vector3.new(10,13,10),
  center+Vector3.new(0,8,28),biome.color,Enum.Material.Neon,false)
 beacon.Shape=Enum.PartType.Ball; glow(beacon,biome.color,22)
 local prompt=Instance.new("ProximityPrompt"); prompt.ActionText="Seal Rift (12 shards)"
 prompt.ObjectText=biome.name; prompt.HoldDuration=1; prompt.MaxActivationDistance=14
 prompt.RequiresLineOfSight=false; prompt.Parent=beacon
 beacons[beacon]=biome
 sign("SEAL RIFT: 12 SHARDS",beacon.Position+Vector3.new(0,12,0),biome.color,280)
 for i=1,9 do
  local angle=i*math.pi*2/9
  local radius=20+(i%3)*10
  local orb=part("Rift Shard",Vector3.new(4,4,4),
   center+Vector3.new(math.cos(angle)*radius,5,math.sin(angle)*radius),
   palette[(index+i-2)%5+1],Enum.Material.Neon,false)
  orb.Shape=Enum.PartType.Ball; orb:SetAttribute("Biome",biome.id)
  glow(orb,orb.Color,10)
  table.insert(shards,orb)
 end
 for i=1,3 do
  local a=i*math.pi*2/3
  local spawnPos=center+Vector3.new(math.cos(a)*28,6,math.sin(a)*28)
  local drone=part("Rift Drone",Vector3.new(7,7,7),spawnPos,
   biome.color,Enum.Material.Neon,false)
  drone.Shape=Enum.PartType.Ball; drone:SetAttribute("Health",3)
  drone:SetAttribute("Biome",biome.id)
  glow(drone,biome.color)
  drones[drone]={home=spawnPos,health=3,alive=true,attackAt=0}
 end
end
