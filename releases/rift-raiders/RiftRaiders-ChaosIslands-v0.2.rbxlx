<roblox version="4">
  <Item class="ServerScriptService" referent="0">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="1">
      <Properties>
        <string name="Name">RiftRaidersServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- RIFT RAIDERS: CHAOS ISLANDS. Original, free-to-play multiplayer prototype.
-- All rewards, combat, abilities and progression are validated on the server.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local DataStoreService=game:GetService("DataStoreService")
local HttpService=game:GetService("HttpService")
local Debris=game:GetService("Debris")
local ServerScriptService=game:GetService("ServerScriptService")
local WorldKit=require(ServerScriptService:WaitForChild("WorldKit"))
local Vehicles=require(ServerScriptService:WaitForChild("VehicleService"))
local world=Instance.new("Folder"); world.Name="RiftRaidersWorld"; world.Parent=workspace
world:SetAttribute("Version","0.2.0")
world:SetAttribute("Phase","CALM")
world:SetAttribute("SecondsLeft",75)
local palette={Color3.fromRGB(54,232,244),Color3.fromRGB(255,96,164),Color3.fromRGB(171,110,255),Color3.fromRGB(255,209,75),Color3.fromRGB(91,244,149)}
local biomes={
 {id="CYBER",name="Neon Metropolis",center=Vector3.new(180,0,0),color=palette[1]},
 {id="CRYSTAL",name="Prism Wilds",center=Vector3.new(-180,0,0),color=palette[3]},
 {id="VOLCANO",name="Magma Outpost",center=Vector3.new(0,0,180),color=palette[2]},
 {id="SKY",name="Cloud Kingdom",center=Vector3.new(0,0,-180),color=palette[4]},
}
local function part(name,size,pos,color,material,collide)
 local p=Instance.new("Part"); p.Name=name; p.Anchored=true; p.Size=size; p.Position=pos
 p.Material=material or Enum.Material.SmoothPlastic; p.Color=color
 p.CanCollide=collide~=false; p.TopSurface=Enum.SurfaceType.Smooth
 p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=world; return p
end
local function sign(text,pos,color,width)
 local anchor=part("SignAnchor",Vector3.new(1,1,1),pos,color,nil,false)
 anchor.Transparency=1
 local gui=Instance.new("BillboardGui"); gui.Size=UDim2.fromOffset(width or 280,64)
 gui.MaxDistance=160; gui.AlwaysOnTop=true; gui.Parent=anchor
 local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(1,1)
 label.BackgroundTransparency=1; label.Text=text; label.TextScaled=true
 label.TextColor3=color; label.TextStrokeTransparency=.3
 label.Font=Enum.Font.GothamBlack; label.Parent=gui
 return anchor
end
local function glow(p,color,range)
 local light=Instance.new("PointLight"); light.Color=color; light.Range=range or 14
 light.Brightness=1.2; light.Parent=p
end
Lighting.ClockTime=16; Lighting.Brightness=2.5
Lighting.Ambient=Color3.fromRGB(120,132,179)
local atmosphere=Instance.new("Atmosphere"); atmosphere.Density=.18
atmosphere.Color=Color3.fromRGB(155,176,236); atmosphere.Parent=Lighting
local bloom=Instance.new("BloomEffect"); bloom.Intensity=.22; bloom.Threshold=1.8
bloom.Size=24; bloom.Parent=Lighting
part("Void Floor",Vector3.new(650,2,650),Vector3.new(0,-70,0),Color3.fromRGB(14,13,32),nil,false)
local hub=part("Central Hub",Vector3.new(120,4,120),Vector3.new(0,-1,0),Color3.fromRGB(38,45,85))
local spawn=Instance.new("SpawnLocation"); spawn.Name="RiftRaidersSpawn"
spawn.Neutral=true; spawn.Anchored=true; spawn.Size=Vector3.new(22,1,22)
spawn.Position=Vector3.new(0,2,0); spawn.Material=Enum.Material.Neon
spawn.Color=palette[5]; spawn.Parent=world
sign("RIFT RAIDERS | CHAOS ISLANDS",Vector3.new(0,23,0),palette[4],460)
sign("BLAST DRONES • COLLECT SHARDS • SEAL RIFTS",Vector3.new(0,15,0),palette[1],460)
-- Central arena, tower, rings and colored paths: readable on a small screen.
for i=1,8 do
 local angle=(i-1)*math.pi/4
 local pos=Vector3.new(math.cos(angle)*47,8,math.sin(angle)*47)
 local tower=part("Hub Beacon Pillar",Vector3.new(6,16,6),pos,palette[(i-1)%5+1],Enum.Material.Metal)
 local lamp=part("Hub Beacon Light",Vector3.new(8,2,8),pos+Vector3.new(0,9,0),palette[(i-1)%5+1],Enum.Material.Neon)
 glow(lamp,lamp.Color)
end
local bridgeData={
 {Vector3.new(90,0,0),Vector3.new(75,2,22)},
 {Vector3.new(-90,0,0),Vector3.new(75,2,22)},
 {Vector3.new(0,0,90),Vector3.new(22,2,75)},
 {Vector3.new(0,0,-90),Vector3.new(22,2,75)},
}
for i,b in ipairs(bridgeData) do
 local walkway=part("Safe Skybridge",b[2],b[1],palette[i],Enum.Material.SmoothPlastic)
 for side=-1,1,2 do
  local railSize=i<=2 and Vector3.new(75,3,2) or Vector3.new(2,3,75)
  local offset=i<=2 and Vector3.new(0,2,side*11) or Vector3.new(side*11,2,0)
  part("Bridge Rail",railSize,b[1]+offset,Color3.fromRGB(31,40,76),Enum.Material.Metal)
 end
end
local shards={}
local drones={}
local beacons={}
-- Co-op Chaos Titan: a shared boss that appears during Rift Surge.
local boss=part("Chaos Titan",Vector3.new(17,17,17),Vector3.new(0,17,0),
 palette[2],Enum.Material.Neon,false)
boss.Shape=Enum.PartType.Ball; boss.Transparency=1; boss.CanTouch=false
boss:SetAttribute("Health",0)
glow(boss,palette[2],35)
local bossActive=false; local bossHP=0; local bossContributors={}
local bossAttackAt=0
for index,biome in ipairs(biomes) do
 local center=biome.center
 local base=part(biome.id.." Island",Vector3.new(115,4,115),center+Vector3.new(0,-1,0),
  Color3.fromRGB(38+index*9,37+index*7,75+index*7))
 sign(biome.name:upper(),center+Vector3.new(0,22,0),biome.color,360)
 for i=1,8 do
  local angle=i*math.pi/4
  local x=math.cos(angle)*42; local z=math.sin(angle)*42
  local height=9+(i%3)*9
  local p=part(biome.id.." Landmark",Vector3.new(9,height,9),
   center+Vector3.new(x,height/2,z),Color3.fromRGB(30,40,74),Enum.Material.Metal)
  local cap=part(biome.id.." Glow Roof",Vector3.new(11,2,11),
   p.Position+Vector3.new(0,height/2+1,0),biome.color,Enum.Material.Neon,false)
  if index==2 then
   local crystal=part("Prism Spire",Vector3.new(5,height+8,5),
    p.Position+Vector3.new(0,7,0),biome.color,Enum.Material.Glass,false)
   crystal.CFrame=crystal.CFrame*CFrame.Angles(0,math.rad(i*30),math.rad(10))
  elseif index==3 then
   local fire=Instance.new("Fire"); fire.Size=7; fire.Heat=5; fire.Parent=cap
  elseif index==4 then
   local cloud=part("Cloud Platform",Vector3.new(16,2,16),
    p.Position+Vector3.new(0,height/2+8,0),Color3.fromRGB(235,239,255),nil,false)
   cloud.Shape=Enum.PartType.Ball
  end
 end
 local beacon=part("Rift Core "..biome.id,Vector3.new(10,13,10),
  center+Vector3.new(0,8,28),biome.color,Enum.Material.Neon,false)
 beacon.Shape=Enum.PartType.Ball; glow(beacon,biome.color,22)
 local prompt=Instance.new("ProximityPrompt"); prompt.ActionText="Seal Rift (12 shards)"
 prompt.ObjectText=biome.name; prompt.HoldDuration=1; prompt.MaxActivationDistance=14
 prompt.RequiresLineOfSight=false; prompt.Parent=beacon
 beacons[beacon]=biome
 sign("SEAL RIFT: 12 SHARDS",beacon.Position+Vector3.new(0,12,0),biome.color,280)
 for i=1,9 do
  local angle=i*math.pi*2/9
  local radius=20+(i%3)*10
  local orb=part("Rift Shard",Vector3.new(4,4,4),
   center+Vector3.new(math.cos(angle)*radius,5,math.sin(angle)*radius),
   palette[(index+i-2)%5+1],Enum.Material.Neon,false)
  orb.Shape=Enum.PartType.Ball; orb:SetAttribute("Biome",biome.id)
  glow(orb,orb.Color,10)
  table.insert(shards,orb)
 end
 for i=1,3 do
  local a=i*math.pi*2/3
  local spawnPos=center+Vector3.new(math.cos(a)*28,6,math.sin(a)*28)
  local drone=part("Rift Drone",Vector3.new(7,7,7),spawnPos,
   biome.color,Enum.Material.Neon,false)
  drone.Shape=Enum.PartType.Ball; drone:SetAttribute("Health",3)
  drone:SetAttribute("Biome",biome.id)
  glow(drone,biome.color)
  drones[drone]={home=spawnPos,health=3,alive=true,attackAt=0}
 end
end
-- Reusable hand-built asset kit populates the islands without external downloads.
WorldKit.Populate(world,biomes)
-- A small physical skill course with a real summit reward.
local sky=biomes[4].center
for i=1,5 do
 part("Cloud Jump "..i,Vector3.new(13,2,13),
  sky+Vector3.new(-27+i*10,4+i*5,-18+((i%2)*10)),
  Color3.fromRGB(228,239,255))
end
local summit=part("Cloud Summit",Vector3.new(13,3,13),
 sky+Vector3.new(23,32,-8),palette[4],Enum.Material.Neon,false)
sign("SUMMIT BONUS +80 COINS",summit.Position+Vector3.new(0,7,0),palette[4])
local event=Instance.new("RemoteEvent"); event.Name="RiftRaidersEvent"; event.Parent=ReplicatedStorage
local action=Instance.new("RemoteEvent"); action.Name="RiftRaidersAction"; action.Parent=ReplicatedStorage
-- Two reusable first-person/third-person sci-fi weapons. The server decides hits.
local ServerStorage=game:GetService("ServerStorage")
local function makeWeapon(name,color,length)
 local tool=Instance.new("Tool"); tool.Name=name
 tool.ToolTip="Aim with camera, tap or click to fire"
 tool.RequiresHandle=true; tool.CanBeDropped=false
 tool.Grip=CFrame.new(0,-.2,-.6)*CFrame.Angles(0,math.rad(90),0)
 local handle=Instance.new("Part"); handle.Name="Handle"
 handle.Size=Vector3.new(1,1.2,3.2); handle.Color=Color3.fromRGB(38,45,63)
 handle.Material=Enum.Material.Metal; handle.CanCollide=false; handle.Massless=true
 handle.Parent=tool
 local barrel=Instance.new("Part"); barrel.Name="Glowing Barrel"
 barrel.Size=Vector3.new(.7,.7,length); barrel.Material=Enum.Material.Neon
 barrel.Color=color; barrel.CanCollide=false; barrel.Massless=true
 barrel.CFrame=handle.CFrame*CFrame.new(0,0,-length*.45)
 barrel.Parent=tool
 local weld=Instance.new("WeldConstraint"); weld.Part0=handle; weld.Part1=barrel; weld.Parent=handle
 tool.Parent=ServerStorage
 return tool
end
local pulseTemplate=makeWeapon("Pulse Rifle",palette[1],4)
local scatterTemplate=makeWeapon("Scatter Blaster",palette[2],2.5)
local function grantWeapon(p,template)
 local backpack=p:FindFirstChildOfClass("Backpack")
 if not backpack then return end
 if backpack:FindFirstChild(template.Name) or (p.Character and p.Character:FindFirstChild(template.Name)) then return end
 template:Clone().Parent=backpack
end
local profiles={}
local store=nil
if not RunService:IsStudio() and game.GameId~=0 then
 store=DataStoreService:GetDataStore("RiftRaidersProfiles_v1")
end
local function cleanInt(n,max)
 return (type(n)=="number" and n==n and n>=0) and math.clamp(math.floor(n),0,max) or 0
end
local function tell(p,msg) event:FireClient(p,tostring(msg)) end
local function sync(p)
 local s=profiles[p]; if not s then return end
 p:SetAttribute("RRCoins",s.coins); p:SetAttribute("RRShards",s.shards)
 p:SetAttribute("RRLevel",s.level); p:SetAttribute("RRXP",s.xp)
 p:SetAttribute("RRBlaster",s.blaster); p:SetAttribute("RRShield",s.shieldOwned)
 p:SetAttribute("RRPet",s.petOwned); p:SetAttribute("RRSeals",s.seals)
 p:SetAttribute("RRScatter",s.scatterOwned)
 p:SetAttribute("RRQuestShards",s.quest.shards)
 p:SetAttribute("RRQuestDrones",s.quest.drones)
 p:SetAttribute("RRQuestSeals",s.quest.seals)
 local ls=p:FindFirstChild("leaderstats")
 if ls then
  ls.Level.Value=s.level; ls.Coins.Value=s.coins; ls.Rifts.Value=s.seals
 end
end
local function reward(p,coins,xp,shards)
 local s=profiles[p]; if not s then return end
 local boost=world:GetAttribute("Phase")=="SURGE" and 2 or 1
 s.coins=math.min(1000000,s.coins+math.max(0,coins or 0)*boost)
 s.shards=math.min(100000,s.shards+math.max(0,shards or 0))
 s.xp+=math.max(0,xp or 0)
 while s.xp>=80+s.level*25 and s.level<100 do
  s.xp-=80+s.level*25; s.level+=1
  s.coins=math.min(1000000,s.coins+50)
  tell(p,"LEVEL UP! LEVEL "..s.level.." +50 COINS")
 end
 sync(p)
end
local function quest(p,kind,n)
 local s=profiles[p]; if not s then return end
 s.quest[kind]=math.min(({shards=8,drones=3,seals=1})[kind],s.quest[kind]+(n or 1))
 if s.quest.shards==8 and s.quest.drones==3 and s.quest.seals==1 then
  s.quest={shards=0,drones=0,seals=0}
  reward(p,250,120,0); tell(p,"MISSION COMPLETE! +250 COINS +120 XP")
 end
 sync(p)
end
local function save(p)
 local s=profiles[p]
 if not store or not s or not s.loaded then return end
 local payload={version=1,coins=s.coins,shards=s.shards,level=s.level,xp=s.xp,
  blaster=s.blaster,shieldOwned=s.shieldOwned,petOwned=s.petOwned,
  scatterOwned=s.scatterOwned,seals=s.seals}
 local key="Player_"..p.UserId
 local ok,err=pcall(function()
  store:UpdateAsync(key,function(previous)
   local value=type(previous)=="table" and previous or {}
   -- Never regress an existing account to an older schema.
   if type(value.version)=="number" and value.version>1 then return nil end
   return payload
  end)
 end)
 if not ok then warn("RiftRaiders save failed",p.UserId,err) end
end
local function init(p)
 local s={coins=0,shards=0,level=1,xp=0,blaster=1,shieldOwned=false,
  petOwned=false,scatterOwned=false,seals=0,quest={shards=0,drones=0,seals=0},
  shardTimes={},beaconTimes={},summitAt=0,lastBlast=0,lastDash=0,lastShield=0,
  shieldUntil=0,travelAt=0,lastShoot=0,loaded=false,pet=nil}
 if store then
  local ok,data=pcall(function() return store:GetAsync("Player_"..p.UserId) end)
  if ok then
   if type(data)=="table" and (data.version==nil or data.version==1) then
    s.coins=cleanInt(data.coins,1000000); s.shards=cleanInt(data.shards,100000)
    s.level=math.max(1,cleanInt(data.level,100)); s.xp=cleanInt(data.xp,100000)
    s.blaster=math.clamp(cleanInt(data.blaster,4),1,4)
    s.shieldOwned=data.shieldOwned==true; s.petOwned=data.petOwned==true
    s.scatterOwned=data.scatterOwned==true
    s.seals=cleanInt(data.seals,1000000)
   end
   s.loaded=true
  else
   warn("RiftRaiders load failed; save disabled for session",p.UserId,data)
  end
 end
 if not p.Parent then return end
 profiles[p]=s
 local ls=Instance.new("Folder"); ls.Name="leaderstats"; ls.Parent=p
 for _,name in ipairs({"Level","Coins","Rifts"}) do
  local v=Instance.new("IntValue"); v.Name=name; v.Parent=ls
 end
 sync(p)
 task.defer(function()
  grantWeapon(p,pulseTemplate)
  if s.scatterOwned then grantWeapon(p,scatterTemplate) end
 end)
 p.CharacterAdded:Connect(function()
  task.wait(.25)
  if profiles[p] then
   sync(p)
   grantWeapon(p,pulseTemplate)
   if profiles[p].scatterOwned then grantWeapon(p,scatterTemplate) end
  end
 end)
 tell(p,"WELCOME! COLLECT SHARDS, BLAST DRONES, SEAL RIFTS!")
end
Players.PlayerAdded:Connect(init)
Players.PlayerRemoving:Connect(function(p)
 save(p)
 local s=profiles[p]; if s and s.pet then s.pet:Destroy() end
 profiles[p]=nil
end)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(init,p) end
task.spawn(function()
 while world.Parent do
  task.wait(90)
  for p in pairs(profiles) do task.spawn(save,p) end
 end
end)
if store then
 game:BindToClose(function()
  for p in pairs(profiles) do task.spawn(save,p) end
  task.wait(3)
 end)
end

local function rootFor(p)
 return p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end
local function spawnPet(p)
 local s=profiles[p]; if not s or not s.petOwned or s.pet then return end
 local pet=part("Riftling Companion",Vector3.new(3.4,3.4,3.4),
  Vector3.new(0,10,0),palette[3],Enum.Material.Neon,false)
 pet.Shape=Enum.PartType.Ball; pet.CanTouch=false; s.pet=pet
 glow(pet,pet.Color,12)
end
local destinations={HUB=Vector3.new(0,6,0)}
for _,b in ipairs(biomes) do destinations[b.id]=b.center+Vector3.new(0,6,0) end
local function blast(p)
 local s=profiles[p]; local root=rootFor(p)
 if not s or not root then return end
 local now=os.clock()
 if now-s.lastBlast<.55 then return end
 s.lastBlast=now
 if bossActive and (root.Position-boss.Position).Magnitude<48 then
  bossHP=math.max(0,bossHP-s.blaster)
  boss:SetAttribute("Health",bossHP)
  bossContributors[p]=true
  tell(p,"CHAOS TITAN HIT! "..bossHP.." HP LEFT!")
  if bossHP==0 then
   bossActive=false; boss.Transparency=1
   world:SetAttribute("BossHealth",0)
   for contributor in pairs(bossContributors) do
    if profiles[contributor] then
     reward(contributor,300,120,10)
     tell(contributor,"TITAN DEFEATED! +300 COINS +10 SHARDS!")
    end
   end
   bossContributors={}
  else
   world:SetAttribute("BossHealth",bossHP)
  end
  return
 end
 local target=nil; local best=32
 for drone,d in pairs(drones) do
  if d.alive then
   local delta=drone.Position-root.Position
   local distance=delta.Magnitude
   if distance<best then
    target=drone; best=distance
   end
  end
 end
 if not target then tell(p,"MOVE CLOSER TO A DRONE TO BLAST!"); return end
 local d=drones[target]
 d.health-=s.blaster
 target:SetAttribute("Health",math.max(0,d.health))
 tell(p,"ZAP! DRONE HIT "..s.blaster.." DAMAGE!")
 if d.health<=0 then
  d.alive=false; target.Transparency=1; target.CanTouch=false
  reward(p,30,25,2); quest(p,"drones",1)
  tell(p,"DRONE DEFEATED! +30 COINS +2 SHARDS!")
  task.delay(9,function()
   if target.Parent then
    d.alive=true; d.health=3; target.Position=d.home
    target.Transparency=0; target.CanTouch=true
    target:SetAttribute("Health",3)
   end
  end)
 end
end
-- Long-range pulse and scatter weapons: the client supplies aim, never a hit.
local function shoot(p,aim,weaponName)
 local s=profiles[p]; local root=rootFor(p)
 if not s or not root or typeof(aim)~="Vector3" then return end
 if aim.X~=aim.X or aim.Y~=aim.Y or aim.Z~=aim.Z then return end
 if aim.Magnitude<.9 or aim.Magnitude>1.1 then return end
 if weaponName~="Pulse Rifle" and weaponName~="Scatter Blaster" then return end
 if weaponName=="Scatter Blaster" and not s.scatterOwned then return end
 local backpack=p:FindFirstChildOfClass("Backpack")
 if not ((p.Character and p.Character:FindFirstChild(weaponName)) or
  (backpack and backpack:FindFirstChild(weaponName))) then return end
 local now=os.clock()
 local scatter=weaponName=="Scatter Blaster"
 if now-s.lastShoot<(scatter and .85 or .22) then return end
 s.lastShoot=now
 local origin=root.Position+Vector3.new(0,1.8,0)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={p.Character}
 params.IgnoreWater=true
 local count=scatter and 4 or 1
 local maxDistance=scatter and 70 or 125
 for i=1,count do
  local spread=scatter and Vector3.new((i-2.5)*.045,((i%2)*2-1)*.035,0) or Vector3.zero
  local direction=(aim+spread).Unit
  local hit=workspace:Raycast(origin,direction*maxDistance,params)
  local endpoint=hit and hit.Position or origin+direction*maxDistance
  local length=(endpoint-origin).Magnitude
  if length>.1 then
   local tracer=Instance.new("Part"); tracer.Name="Pulse Tracer"
   tracer.Size=Vector3.new(.17,.17,length)
   tracer.CFrame=CFrame.lookAt((origin+endpoint)*.5,endpoint)
   tracer.Material=Enum.Material.Neon
   tracer.Color=scatter and palette[2] or palette[1]
   tracer.CanCollide=false; tracer.CanTouch=false; tracer.CanQuery=false
   tracer.Anchored=true; tracer.Parent=world
   Debris:AddItem(tracer,.12)
  end
  local target=hit and hit.Instance
  if target==boss and bossActive then
   bossHP=math.max(0,bossHP-1)
   boss:SetAttribute("Health",bossHP)
   bossContributors[p]=true
   world:SetAttribute("BossHealth",bossHP)
   if bossHP==0 then
    bossActive=false; boss.Transparency=1
    for contributor in pairs(bossContributors) do
     if profiles[contributor] then
      reward(contributor,300,120,10)
      tell(contributor,"TITAN DEFEATED! +300 COINS +10 SHARDS!")
     end
    end
    bossContributors={}
   end
  elseif target and drones[target] and drones[target].alive then
   local d=drones[target]
   d.health-=1
   target:SetAttribute("Health",math.max(0,d.health))
   if d.health<=0 then
    d.alive=false; target.Transparency=1; target.CanTouch=false
    reward(p,30,25,2); quest(p,"drones",1)
    tell(p,"DRONE DOWN! +30 COINS +2 SHARDS!")
    task.delay(9,function()
     if target.Parent then
      d.alive=true; d.health=3; target.Position=d.home
      target.Transparency=0; target.CanTouch=true
      target:SetAttribute("Health",3)
     end
    end)
   end
  end
 end
end
for _,shard in ipairs(shards) do
 shard.Touched:Connect(function(hit)
  local char=hit:FindFirstAncestorOfClass("Model")
  local p=char and Players:GetPlayerFromCharacter(char)
  local s=p and profiles[p]; local root=p and rootFor(p)
  if not s or not root or (root.Position-shard.Position).Magnitude>14 then return end
  local now=os.clock()
  if s.shardTimes[shard] and now-s.shardTimes[shard]<25 then return end
  s.shardTimes[shard]=now
  reward(p,5,8,1); quest(p,"shards",1)
  tell(p,"+1 RIFT SHARD • +5 COINS")
 end)
end
for beacon,biome in pairs(beacons) do
 local prompt=beacon:FindFirstChildOfClass("ProximityPrompt")
 prompt.Triggered:Connect(function(p)
  local s=profiles[p]; local root=rootFor(p)
  if not s or not root or (root.Position-beacon.Position).Magnitude>17 then return end
  local now=os.clock()
  if s.beaconTimes[beacon] and now-s.beaconTimes[beacon]<50 then
   tell(p,"THIS RIFT NEEDS TIME TO RECHARGE!"); return
  end
  if s.shards<12 then tell(p,"NEED 12 SHARDS TO SEAL THIS RIFT!"); return end
  s.shards-=12; s.beaconTimes[beacon]=now; s.seals+=1
  reward(p,75,80,0); quest(p,"seals",1)
  tell(p,"RIFT SEALED! "..biome.name:upper().." +75 COINS!")
 end)
end
summit.Touched:Connect(function(hit)
 local char=hit:FindFirstAncestorOfClass("Model")
 local p=char and Players:GetPlayerFromCharacter(char)
 local s=p and profiles[p]; local root=p and rootFor(p)
 if not s or not root or (root.Position-summit.Position).Magnitude>15 then return end
 if root.Position.Y<26 then return end
 local now=os.clock()
 if now-s.summitAt<60 then return end
 s.summitAt=now
 reward(p,80,65,3)
 tell(p,"SKY SUMMIT! +80 COINS +3 SHARDS!")
end)
action.OnServerEvent:Connect(function(p,kind,arg,extra)
 local s=profiles[p]; local root=rootFor(p)
 if not s or not root or type(kind)~="string" then return end
 local now=os.clock()
 if kind=="Blast" then blast(p); return end
 if kind=="Shoot" then shoot(p,arg,extra); return end
 if kind=="SpawnCar" then
  local ok,message=Vehicles.Spawn(world,p)
  tell(p,message)
  return
 end
 if kind=="Dash" then
  if now-s.lastDash<6 then return end
  s.lastDash=now
  local direction=root.CFrame.LookVector
  root.AssemblyLinearVelocity=Vector3.new(direction.X*72,18,direction.Z*72)
  tell(p,"DASH!")
 elseif kind=="Shield" then
  if not s.shieldOwned then tell(p,"UNLOCK SHIELD IN SHOP FOR 150 COINS!"); return end
  if now-s.lastShield<20 then return end
  s.lastShield=now; s.shieldUntil=now+6
  local char=p.Character
  if char then
   local old=char:FindFirstChild("RiftShield")
   if old then old:Destroy() end
   local force=Instance.new("ForceField"); force.Name="RiftShield"
   force.Parent=char
   task.delay(6,function() if force.Parent then force:Destroy() end end)
  end
  tell(p,"SHIELD ACTIVE FOR 6 SECONDS!")
 elseif kind=="Travel" then
  if type(arg)~="string" or not destinations[arg] then return end
  if now-s.travelAt<2 then return end
  s.travelAt=now
  p.Character:PivotTo(CFrame.new(destinations[arg]))
  tell(p,"ARRIVED: "..arg)
 elseif kind=="Buy" then
  if arg=="BLASTER" then
   if s.blaster>=4 then tell(p,"BLASTER MAX LEVEL!"); return end
   local cost=s.blaster*90
   if s.coins<cost then tell(p,"NEED "..cost.." COINS!"); return end
   s.coins-=cost; s.blaster+=1
   tell(p,"BLASTER UPGRADED TO LEVEL "..s.blaster.."!")
  elseif arg=="SHIELD" then
   if s.shieldOwned then tell(p,"SHIELD ALREADY OWNED!"); return end
   if s.coins<150 then tell(p,"NEED 150 COINS!"); return end
   s.coins-=150; s.shieldOwned=true
   tell(p,"SHIELD UNLOCKED! PRESS SHIELD TO ACTIVATE!")
  elseif arg=="SCATTER" then
   if s.scatterOwned then tell(p,"SCATTER BLASTER ALREADY OWNED!"); return end
   if s.coins<175 then tell(p,"NEED 175 COINS!"); return end
   s.coins-=175; s.scatterOwned=true
   grantWeapon(p,scatterTemplate)
   tell(p,"SCATTER BLASTER UNLOCKED! EQUIP IT FROM BACKPACK!")
  elseif arg=="PET" then
   if s.petOwned then tell(p,"RIFTLING ALREADY OWNED!"); return end
   if s.coins<250 then tell(p,"NEED 250 COINS!"); return end
   s.coins-=250; s.petOwned=true; spawnPet(p)
   tell(p,"YOU ADOPTED A RIFTLING!")
  else return end
  sync(p)
 end
end)
local tickAccum=0
RunService.Heartbeat:Connect(function(dt)
 tickAccum+=dt
 if tickAccum<.18 then return end
 local step=math.min(tickAccum,.3); tickAccum=0
 for drone,d in pairs(drones) do
  if d.alive then
   local closest=nil; local best=52
   for p,s in pairs(profiles) do
    local root=rootFor(p)
    local hum=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    if root and hum and hum.Health>0 then
     local dist=(root.Position-drone.Position).Magnitude
     if dist<best then closest=p; best=dist end
    end
   end
   if closest then
    local root=rootFor(closest)
    local delta=root.Position-drone.Position
    if delta.Magnitude>4 then
     local nextPos=drone.Position+delta.Unit*math.min(delta.Magnitude,step*13)
     drone.Position=Vector3.new(nextPos.X,d.home.Y,nextPos.Z)
    elseif os.clock()-d.attackAt>2.2 then
     d.attackAt=os.clock()
     local s=profiles[closest]
     if s and os.clock()>s.shieldUntil then
      local hum=closest.Character and closest.Character:FindFirstChildOfClass("Humanoid")
      if hum then hum:TakeDamage(8) end
      tell(closest,"DRONE HIT! BLAST OR DASH TO ESCAPE!")
     end
    end
   else
    drone.Position=drone.Position:Lerp(d.home,.07)
   end
  end
 end
 if bossActive then
  boss.CFrame=boss.CFrame*CFrame.Angles(0,step*.5,0)
  if os.clock()-bossAttackAt>2.4 then
   bossAttackAt=os.clock()
   for p,s in pairs(profiles) do
    local root=rootFor(p)
    if root and (root.Position-boss.Position).Magnitude<24 and os.clock()>s.shieldUntil then
     local hum=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
     if hum then hum:TakeDamage(10) end
     tell(p,"CHAOS TITAN SHOCKWAVE! DASH AWAY!")
    end
   end
  end
 end
 for p,s in pairs(profiles) do
  if s.petOwned and not s.pet then spawnPet(p) end
  local root=rootFor(p)
  if root and s.pet then s.pet.CFrame=root.CFrame*CFrame.new(3,3,3) end
 end
end)
task.spawn(function()
 while world.Parent do
  for remaining=75,0,-1 do
   world:SetAttribute("Phase","CALM")
   world:SetAttribute("SecondsLeft",remaining)
   task.wait(1)
  end
  world:SetAttribute("Phase","SURGE")
  bossHP=26; bossActive=true; bossContributors={}
  boss.Transparency=0; boss:SetAttribute("Health",bossHP)
  world:SetAttribute("BossHealth",bossHP)
  for _,p in ipairs(Players:GetPlayers()) do
   tell(p,"RIFT SURGE! DOUBLE COINS! DEFEAT THE CHAOS TITAN AT HUB!")
  end
  Lighting.Ambient=Color3.fromRGB(180,75,210)
  for remaining=25,0,-1 do
   world:SetAttribute("SecondsLeft",remaining)
   task.wait(1)
  end
  bossActive=false; bossHP=0; bossContributors={}
  boss.Transparency=1; boss:SetAttribute("Health",0)
  world:SetAttribute("BossHealth",0)
  Lighting.Ambient=Color3.fromRGB(120,132,179)
 end
end)
print("SF_RIFT_RAIDERS_SERVER_READY v0.2.0")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">VehicleService</string>
        <string name="Source"><![CDATA[-- Reusable, server-controlled arcade hovercar service.
-- VehicleSeat supplies keyboard/gamepad/touch throttle and steering.
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local Kit=require(script.Parent:WaitForChild("WorldKit"))
local Cars={}
local active={}
local cooldown={}
local function permitted(v)
 if v.Y<2 or v.Y>40 then return false end
 local x,z=v.X,v.Z
 if math.abs(x)<52 and math.abs(z)<52 then return true end
 if math.abs(x-180)<52 and math.abs(z)<52 then return true end
 if math.abs(x+180)<52 and math.abs(z)<52 then return true end
 if math.abs(z-180)<52 and math.abs(x)<52 then return true end
 if math.abs(z+180)<52 and math.abs(x)<52 then return true end
 if math.abs(x)<129 and math.abs(z)<9 then return true end
 if math.abs(z)<129 and math.abs(x)<9 then return true end
 return false
end
function Cars.Spawn(world,player)
 local now=os.clock()
 if cooldown[player] and now-cooldown[player]<8 then return false,"WAIT BEFORE SPAWNING ANOTHER CAR" end
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if not root or not permitted(root.Position) then return false,"GO TO A SAFE ISLAND TO SPAWN A CAR" end
 cooldown[player]=now
 local previous=active[player]
 if previous and previous.model then previous.model:Destroy() end
 local direction=root.CFrame.LookVector
 local spot=root.Position+direction*17
 if not permitted(spot) then spot=root.Position end
 local cf=CFrame.lookAt(Vector3.new(spot.X,5,spot.Z),
  Vector3.new(spot.X+direction.X,5,spot.Z+direction.Z))
 local m,seat=Kit.Car(world,cf,Color3.fromRGB(74,215,245),true)
 m:SetAttribute("OwnerUserId",player.UserId)
 active[player]={model=m,seat=seat,owner=player,lastOccupied=now,speed=0}
 return true,"HOVERCAR SPAWNED! SIT IN THE DRIVER SEAT TO DRIVE."
end
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
 elapsed+=dt
 if elapsed<.06 then return end
 local step=math.min(elapsed,.12); elapsed=0
 for owner,car in pairs(active) do
  local m,seat=car.model,car.seat
  if not owner.Parent or not m.Parent then
   if m.Parent then m:Destroy() end
   active[owner]=nil
  else
   local hum=seat.Occupant
   local driver=hum and Players:GetPlayerFromCharacter(hum.Parent)
   if driver and hum.Health>0 then
    car.lastOccupied=os.clock()
    local throttle=math.clamp(seat.ThrottleFloat,-1,1)
    local steer=math.clamp(seat.SteerFloat,-1,1)
    car.speed+=(throttle*34-car.speed)*math.min(1,step*3)
    if math.abs(throttle)<.03 then car.speed*=math.max(0,1-step*2) end
    local current=m:GetPivot()
    local yaw=-steer*step*1.7*math.clamp(math.abs(car.speed)/20,.25,1)
    local turn=current*CFrame.Angles(0,yaw,0)
    local displacement=turn.LookVector*car.speed*step
    local target=turn+Vector3.new(displacement.X,0,displacement.Z)
    if permitted(target.Position) then
     m:PivotTo(target)
    else
     car.speed=0
    end
   elseif os.clock()-car.lastOccupied>240 then
    m:Destroy(); active[owner]=nil
   end
  end
 end
end)
Players.PlayerRemoving:Connect(function(p)
 local car=active[p]
 if car and car.model then car.model:Destroy() end
 active[p]=nil; cooldown[p]=nil
end)
return Cars
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">WorldKit</string>
        <string name="Source"><![CDATA[-- Reusable procedural asset kit for any SatisfyForge Roblox map.
-- Original geometry only; no external model IDs, untrusted free models or paid assets.
local Kit={}
local CollectionService=game:GetService("CollectionService")
local function piece(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
 p.Material=material or Enum.Material.SmoothPlastic
 p.Anchored=true; p.CanCollide=collide==true
 p.CanTouch=collide==true
 p.CastShadow=true; p.Parent=parent
 return p
end
local function model(parent,name,kind)
 local m=Instance.new("Model"); m.Name=name
 m:SetAttribute("AssetType",kind); m.Parent=parent
 CollectionService:AddTag(m,"RiftWorldAsset")
 return m
end
function Kit.Tree(parent,pos,variant,scale)
 scale=scale or 1; variant=variant or "oak"
 local m=model(parent,"Tree_"..variant,"Tree")
 local trunkColor=Color3.fromRGB(104,72,53)
 local trunk=piece(m,"Trunk",Vector3.new(2.8,14,2.8)*scale,
  CFrame.new(pos+Vector3.new(0,7*scale,0)),trunkColor,Enum.Material.Wood,true)
 m.PrimaryPart=trunk
 if variant=="pine" then
  for layer=1,3 do
   local cone=Instance.new("Part"); cone.Name="Pine Crown"
   cone.Shape=Enum.PartType.Ball
   cone.Size=Vector3.new(13,9,13)*scale
   cone.Position=pos+Vector3.new(0,(12+layer*4)*scale,0)
   cone.Color=Color3.fromRGB(29,110+layer*13,90)
   cone.Material=Enum.Material.Grass; cone.Anchored=true; cone.CanCollide=false
   cone.Parent=m
  end
 elseif variant=="crystal" then
  for i=1,4 do
   local a=i*math.pi/2
   local crown=piece(m,"Prism Branch",Vector3.new(3,13,3)*scale,
    CFrame.new(pos+Vector3.new(math.cos(a)*3*scale,16*scale,math.sin(a)*3*scale))*
     CFrame.Angles(0,a,math.rad(14)),
    Color3.fromRGB(139+15*i,70+20*i,240),Enum.Material.Glass,false)
  end
 else
  for i=1,5 do
   local angle=i*math.pi*2/5
   local leaf=piece(m,"Leaf Crown",Vector3.new(11,10,11)*scale,
    CFrame.new(pos+Vector3.new(math.cos(angle)*4*scale,17*scale,math.sin(angle)*4*scale)),
    Color3.fromRGB(40+i*6,137+i*10,85+i*5),Enum.Material.Grass,false)
   leaf.Shape=Enum.PartType.Ball
  end
 end
 return m
end
function Kit.Grass(parent,pos,color)
 local m=model(parent,"Grass Patch","Grass")
 for i=1,3 do
  local a=i*2.1
  piece(m,"Blade",Vector3.new(.65,2.4,.5),
   CFrame.new(pos+Vector3.new(math.cos(a)*.5,1.2,math.sin(a)*.5))*
    CFrame.Angles(math.sin(a)*.2,0,math.cos(a)*.3),
   color or Color3.fromRGB(69,171,86),Enum.Material.Grass,false)
 end
 return m
end
function Kit.Rock(parent,pos,color,scale)
 local m=model(parent,"Rock Cluster","Rock")
 scale=scale or 1
 for i=1,3 do
  local rock=piece(m,"Boulder",Vector3.new(5+i,3+i,4+i)*scale,
   CFrame.new(pos+Vector3.new(i*2,1.5*scale,i*.6))*
    CFrame.Angles(i*.3,i*.6,i*.15),
   color or Color3.fromRGB(96,106,129),Enum.Material.Slate,true)
  rock.Shape=Enum.PartType.Ball
 end
 return m
end
function Kit.Lamp(parent,pos,color)
 local m=model(parent,"Street Lamp","StreetLight")
 local pole=piece(m,"Pole",Vector3.new(1.1,16,1.1),
  CFrame.new(pos+Vector3.new(0,8,0)),Color3.fromRGB(46,57,78),Enum.Material.Metal,true)
 m.PrimaryPart=pole
 local light=piece(m,"Lamp Head",Vector3.new(4,1.5,4),
  CFrame.new(pos+Vector3.new(0,16,0)),color or Color3.fromRGB(67,235,255),Enum.Material.Neon,false)
 local point=Instance.new("PointLight"); point.Color=light.Color
 point.Brightness=1.4; point.Range=23; point.Parent=light
 return m
end
function Kit.Crate(parent,pos,color)
 local m=model(parent,"Supply Crate","Crate")
 local box=piece(m,"Box",Vector3.new(7,6,7),CFrame.new(pos+Vector3.new(0,3,0)),
  Color3.fromRGB(90,72,62),Enum.Material.WoodPlanks,true)
 m.PrimaryPart=box
 for _,x in ipairs({-3.6,3.6}) do
  piece(m,"Metal Strap",Vector3.new(.6,6.5,7.6),
   CFrame.new(pos+Vector3.new(x,3,0)),color or Color3.fromRGB(241,171,66),Enum.Material.Metal,false)
 end
 return m
end
function Kit.Road(parent,pos,size)
 local m=model(parent,"Road Segment","Road")
 local road=piece(m,"Asphalt",size,CFrame.new(pos),
  Color3.fromRGB(29,34,48),Enum.Material.Asphalt,true)
 m.PrimaryPart=road
 local longX=size.X>size.Z
 for offset=-1,1,2 do
  local stripeSize=longX and Vector3.new(6,.13,.6) or Vector3.new(.6,.13,6)
  local stripeOffset=longX and Vector3.new(offset*size.X*.25,size.Y/2+.1,0)
   or Vector3.new(0,size.Y/2+.1,offset*size.Z*.25)
  piece(m,"Road Stripe",stripeSize,CFrame.new(pos+stripeOffset),
   Color3.fromRGB(255,214,95),Enum.Material.Neon,false)
 end
 return m
end
function Kit.Car(parent,cf,paint,drivable)
 local m=model(parent,drivable and "Player Hovercar" or "Parked Future Car",
  drivable and "Vehicle" or "CarProp")
 local body=piece(m,"Chassis",Vector3.new(11,2.2,18),
  cf,paint or Color3.fromRGB(62,203,230),Enum.Material.Metal,true)
 m.PrimaryPart=body
 local cockpit=piece(m,"Cabin",Vector3.new(9,3.5,8),
  cf*CFrame.new(0,2.5,1.8),Color3.fromRGB(30,51,78),Enum.Material.Glass,false)
 local seat=Instance.new("VehicleSeat"); seat.Name="DriverSeat"
 seat.Size=Vector3.new(2,1,2); seat.CFrame=cf*CFrame.new(0,2.5,1.8)
 seat.Color=Color3.fromRGB(30,38,56); seat.Material=Enum.Material.SmoothPlastic
 seat.Anchored=true; seat.CanCollide=false; seat.Parent=m
 seat.HeadsUpDisplay=true; seat.MaxSpeed=40; seat.Torque=8; seat.TurnSpeed=2
 local function wheel(x,z)
  local w=piece(m,"Wheel",Vector3.new(4,2.5,4),
   cf*CFrame.new(x,-1.3,z)*CFrame.Angles(0,0,math.pi/2),
   Color3.fromRGB(24,29,44),Enum.Material.Rubber,true)
  w.Shape=Enum.PartType.Cylinder
  local hub=piece(m,"Wheel Glow",Vector3.new(4.2,.3,4.2),
   cf*CFrame.new(x*1.02,-1.3,z)*CFrame.Angles(0,0,math.pi/2),
   Color3.fromRGB(93,224,255),Enum.Material.Neon,false)
  hub.Shape=Enum.PartType.Cylinder
 end
 for _,x in ipairs({-5.1,5.1}) do
  for _,z in ipairs({-5.8,5.8}) do wheel(x,z) end
 end
 for _,x in ipairs({-3.4,3.4}) do
  piece(m,"Headlight",Vector3.new(2,1,.3),
   cf*CFrame.new(x,.4,-9.2),Color3.fromRGB(244,247,255),Enum.Material.Neon,false)
  piece(m,"Tail Light",Vector3.new(2,1,.3),
   cf*CFrame.new(x,.4,9.2),Color3.fromRGB(255,69,101),Enum.Material.Neon,false)
 end
 if drivable then
  -- Arcade handling: server moves an anchored model only while its real
  -- VehicleSeat is occupied. PivotTo moves the seat and attached rider.
  m:SetAttribute("Drivable",true)
 else
  seat.Disabled=true
 end
 return m,seat
end
function Kit.Bush(parent,pos,color)
 local m=model(parent,"Flowering Bush","Bush")
 for i=1,3 do
  local p=piece(m,"Foliage",Vector3.new(5,3.5,5),
   CFrame.new(pos+Vector3.new((i-2)*2.1,2,math.sin(i)*1.5)),
   color or Color3.fromRGB(65,165,95),Enum.Material.Grass,false)
  p.Shape=Enum.PartType.Ball
 end
 return m
end
function Kit.Flower(parent,pos,color)
 local m=model(parent,"Wild Flower","Flower")
 piece(m,"Stem",Vector3.new(.25,2,.25),
  CFrame.new(pos+Vector3.new(0,1,0)),Color3.fromRGB(57,161,73),Enum.Material.Grass,false)
 local head=piece(m,"Bloom",Vector3.new(1.6,1.6,1.6),
  CFrame.new(pos+Vector3.new(0,2.2,0)),color or Color3.fromRGB(255,131,190),
  Enum.Material.SmoothPlastic,false)
 head.Shape=Enum.PartType.Ball
 return m
end
function Kit.Bench(parent,pos,color)
 local m=model(parent,"Park Bench","Bench")
 local seat=piece(m,"Seat",Vector3.new(9,.8,3),
  CFrame.new(pos+Vector3.new(0,2.4,0)),color or Color3.fromRGB(135,91,61),
  Enum.Material.WoodPlanks,true)
 m.PrimaryPart=seat
 piece(m,"Backrest",Vector3.new(9,3,.8),
  CFrame.new(pos+Vector3.new(0,4,-1.2)),seat.Color,Enum.Material.WoodPlanks,true)
 for _,x in ipairs({-3.4,3.4}) do
  piece(m,"Bench Leg",Vector3.new(.8,2.4,.8),
   CFrame.new(pos+Vector3.new(x,1.2,0)),Color3.fromRGB(43,49,67),Enum.Material.Metal,true)
 end
 return m
end
function Kit.Fence(parent,pos,length,color)
 local m=model(parent,"Fence","Fence")
 length=math.max(8,length or 24)
 for i=0,math.floor(length/6) do
  local x=-length/2+i*6
  piece(m,"Fence Post",Vector3.new(.8,5,.8),
   CFrame.new(pos+Vector3.new(x,2.5,0)),
   color or Color3.fromRGB(102,81,70),Enum.Material.Wood,true)
 end
 for _,height in ipairs({1.6,3.5}) do
  piece(m,"Fence Rail",Vector3.new(length,.6,.65),
   CFrame.new(pos+Vector3.new(0,height,0)),
   color or Color3.fromRGB(102,81,70),Enum.Material.Wood,true)
 end
 return m
end
function Kit.House(parent,pos,color)
 local m=model(parent,"Modular House","Building")
 local foundation=piece(m,"House Base",Vector3.new(16,12,14),
  CFrame.new(pos+Vector3.new(0,6,0)),
  color or Color3.fromRGB(79,116,155),Enum.Material.Concrete,true)
 m.PrimaryPart=foundation
 local roof=piece(m,"Roof",Vector3.new(19,2,17),
  CFrame.new(pos+Vector3.new(0,13,0)),Color3.fromRGB(50,59,90),Enum.Material.Metal,true)
 piece(m,"Door",Vector3.new(3,6,.4),
  CFrame.new(pos+Vector3.new(0,3,-7.3)),
  Color3.fromRGB(44,47,66),Enum.Material.Wood,true)
 for _,x in ipairs({-5,5}) do
  piece(m,"Window",Vector3.new(3,3,.3),
   CFrame.new(pos+Vector3.new(x,8,-7.3)),
   Color3.fromRGB(119,236,255),Enum.Material.Glass,false)
 end
 return m
end
function Kit.Pond(parent,pos)
 local m=model(parent,"Crystal Pond","WaterFeature")
 local rim=piece(m,"Pond Rim",Vector3.new(21,.4,15),
  CFrame.new(pos+Vector3.new(0,.1,0)),
  Color3.fromRGB(87,112,140),Enum.Material.Slate,true)
 m.PrimaryPart=rim
 local water=piece(m,"Water Surface",Vector3.new(18,.15,12),
  CFrame.new(pos+Vector3.new(0,.35,0)),
  Color3.fromRGB(77,177,217),Enum.Material.Glass,false)
 water.Transparency=.3
 return m
end
function Kit.Populate(parent,biomes)
 local rng=Random.new(424242)
 local folder=Instance.new("Folder"); folder.Name="ReusableWorldKit"; folder.Parent=parent
 folder:SetAttribute("AssetLibrary","Trees,Grass,Rocks,Lamps,Crates,Roads,Cars,Bushes,Flowers,Benches,Fences,Buildings,Ponds")
 for index,biome in ipairs(biomes) do
  local area=Instance.new("Folder"); area.Name=biome.id.." Scenery"; area.Parent=folder
  local c=biome.center
  for i=1,9 do
   local angle=i*2.399
   local radius=36+(i%3)*6
   local p=c+Vector3.new(math.cos(angle)*radius,1,math.sin(angle)*radius)
   if index==1 then
    Kit.Lamp(area,p,Color3.fromRGB(74,223,252))
   elseif index==2 then
    Kit.Tree(area,p,"crystal",.7)
   elseif index==3 then
    Kit.Rock(area,p,Color3.fromRGB(94,65,67),.75)
   else
    Kit.Tree(area,p,"pine",.65)
   end
  end
  Kit.Bench(area,c+Vector3.new(24,1,-20),biome.color)
  Kit.Fence(area,c+Vector3.new(-30,1,-51),24,biome.color)
  for i=1,5 do
   Kit.Bush(area,c+Vector3.new(-46+i*14,1,49),biome.color)
  end
  if index==1 then
   Kit.House(area,c+Vector3.new(-38,1,26),Color3.fromRGB(85,128,164))
   Kit.House(area,c+Vector3.new(38,1,26),Color3.fromRGB(130,91,169))
   Kit.Road(area,c+Vector3.new(0,1,-42),Vector3.new(90,.35,12))
   for i=1,3 do
    Kit.Car(area,CFrame.new(c+Vector3.new(-33+i*20,4,-42)),
     Color3.fromRGB(85+i*35,99+i*25,225-i*30),false)
   end
  else
   if index==2 then Kit.Pond(area,c+Vector3.new(-33,1,-35)) end
   for i=1,45 do
    local x=rng:NextNumber(-52,52); local z=rng:NextNumber(-52,52)
    if x*x+z*z>24*24 then
     if i%7==0 then
      Kit.Flower(area,c+Vector3.new(x,1,z),biome.color)
     end
     Kit.Grass(area,c+Vector3.new(x,1,z),
      index==3 and Color3.fromRGB(217,101,64) or
       index==2 and Color3.fromRGB(159,113,225) or Color3.fromRGB(85,174,119))
    end
   end
  end
  for i=1,4 do
   Kit.Crate(area,c+Vector3.new(-44+i*17,1,43),biome.color)
  end
 end
 return folder
end
return Kit
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="4">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="5">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="6">
        <Properties>
          <string name="Name">RiftRaidersHUD</string>
          <string name="Source"><![CDATA[-- Rift Raiders responsive HUD; no Robux purchase prompts in the prototype.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local player=Players.LocalPlayer
local action=ReplicatedStorage:WaitForChild("RiftRaidersAction")
local event=ReplicatedStorage:WaitForChild("RiftRaidersEvent")
local world=workspace:WaitForChild("RiftRaidersWorld")
local gui=Instance.new("ScreenGui"); gui.Name="RiftRaidersHUD"
gui.ResetOnSpawn=false; gui.IgnoreGuiInset=false; gui.Parent=player:WaitForChild("PlayerGui")
local function round(object,radius)
 local corner=Instance.new("UICorner"); corner.CornerRadius=UDim.new(0,radius or 12)
 corner.Parent=object
 local stroke=Instance.new("UIStroke"); stroke.Color=Color3.fromRGB(100,151,220)
 stroke.Transparency=.5; stroke.Thickness=1.5; stroke.Parent=object
end
local function text(name,content,size,position,color)
 local label=Instance.new("TextLabel"); label.Name=name; label.Size=size; label.Position=position
 label.BackgroundColor3=Color3.fromRGB(18,24,53); label.BackgroundTransparency=.12
 label.TextColor3=color or Color3.new(1,1,1); label.Font=Enum.Font.GothamBold
 label.TextSize=15; label.Text=content; label.TextWrapped=true
 label.BorderSizePixel=0; label.Parent=gui; round(label,10)
 return label
end
local function button(name,content,size,position,color,parent)
 local b=Instance.new("TextButton"); b.Name=name; b.Size=size; b.Position=position
 b.BackgroundColor3=color; b.TextColor3=Color3.new(1,1,1)
 b.Font=Enum.Font.GothamBlack; b.TextSize=16; b.Text=content
 b.TextWrapped=true; b.BorderSizePixel=0; b.Parent=parent or gui; round(b,12)
 return b
end
local title=text("Title","RIFT RAIDERS  ⚡  CHAOS ISLANDS",
 UDim2.new(.62,0,0,39),UDim2.new(.02,0,0,8),Color3.fromRGB(255,222,97))
local stats=text("Stats","LEVEL 1  |  0 COINS  |  0 SHARDS",
 UDim2.new(.62,0,0,33),UDim2.new(.02,0,0,52),Color3.fromRGB(110,250,236))
local progression=text("Progression","BLASTER 1  |  RIFTS 0  |  XP 0",
 UDim2.new(.62,0,0,29),UDim2.new(.02,0,0,90),Color3.fromRGB(196,168,255))
local phase=text("Surge","CALM | NEXT SURGE: 75s",
 UDim2.new(.32,0,0,34),UDim2.new(.66,0,0,8),Color3.fromRGB(255,154,210))
local missions=text("Missions","MISSIONS: SHARDS 0/8 | DRONES 0/3 | RIFTS 0/1",
 UDim2.new(.96,0,0,34),UDim2.new(.02,0,0,130),Color3.fromRGB(255,221,119))
local hint=text("Hint","FIRE PULSE RIFLE • DRIVE HOVERCAR • COLLECT SHARDS • SEAL RIFTS",
 UDim2.new(.96,0,0,32),UDim2.new(.02,0,0,169),Color3.fromRGB(228,239,255))
local toast=text("Toast","",UDim2.new(.82,0,0,55),UDim2.new(.09,0,.68,0),Color3.fromRGB(255,222,99))
toast.Visible=false
local blast=button("Blast","⚡ BLAST",UDim2.fromOffset(112,62),
 UDim2.new(1,-126,1,-88),Color3.fromRGB(239,67,134))
blast.AnchorPoint=Vector2.new(0,0)
local dash=button("Dash","➤ DASH",UDim2.fromOffset(104,57),
 UDim2.new(1,-242,1,-85),Color3.fromRGB(56,178,239))
local shield=button("Shield","⬡ SHIELD",UDim2.fromOffset(108,51),
 UDim2.new(1,-126,1,-150),Color3.fromRGB(145,85,231))
local fireButton=button("Fire","FIRE",UDim2.fromOffset(108,56),
 UDim2.new(1,-126,1,-214),Color3.fromRGB(235,169,66))
local carButton=button("Car","SPAWN CAR",UDim2.fromOffset(110,44),
 UDim2.new(1,-118,0,50),Color3.fromRGB(60,148,177))
local crosshair=Instance.new("TextLabel"); crosshair.Name="Crosshair"
crosshair.Size=UDim2.fromOffset(22,22)
crosshair.Position=UDim2.new(.5,-11,.5,-11)
crosshair.BackgroundTransparency=1; crosshair.Text="+"
crosshair.TextSize=25; crosshair.Font=Enum.Font.GothamBlack
crosshair.TextColor3=Color3.fromRGB(255,246,166); crosshair.Parent=gui
local shopButton=button("ShopToggle","SHOP",UDim2.fromOffset(98,47),
 UDim2.new(.02,0,1,-145),Color3.fromRGB(90,194,128))
local mapButton=button("MapToggle","WORLD",UDim2.fromOffset(98,47),
 UDim2.new(.02,107,1,-145),Color3.fromRGB(87,149,229))
blast.Activated:Connect(function() action:FireServer("Blast") end)
dash.Activated:Connect(function() action:FireServer("Dash") end)
shield.Activated:Connect(function() action:FireServer("Shield") end)
carButton.Activated:Connect(function() action:FireServer("SpawnCar") end)
local function fireWeapon()
 local char=player.Character
 local root=char and char:FindFirstChild("HumanoidRootPart")
 local camera=workspace.CurrentCamera
 if not root or not camera then return end
 local equipped=char:FindFirstChildOfClass("Tool")
 local name=equipped and equipped.Name or "Pulse Rifle"
 if name~="Pulse Rifle" and name~="Scatter Blaster" then name="Pulse Rifle" end
 local viewport=camera.ViewportSize
 local ray=camera:ViewportPointToRay(viewport.X*.5,viewport.Y*.5)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={char}
 local result=workspace:Raycast(ray.Origin,ray.Direction*250,params)
 local target=result and result.Position or ray.Origin+ray.Direction*250
 local origin=root.Position+Vector3.new(0,1.8,0)
 local delta=target-origin
 if delta.Magnitude>.1 then action:FireServer("Shoot",delta.Unit,name) end
end
fireButton.Activated:Connect(fireWeapon)
local attached={}
local function bindTool(child)
 if not child:IsA("Tool") or attached[child] then return end
 if child.Name~="Pulse Rifle" and child.Name~="Scatter Blaster" then return end
 attached[child]=true
 child.Activated:Connect(fireWeapon)
 child.Destroying:Connect(function() attached[child]=nil end)
end
local backpack=player:WaitForChild("Backpack")
backpack.ChildAdded:Connect(bindTool)
for _,child in ipairs(backpack:GetChildren()) do bindTool(child) end
local function bindCharacter(char)
 char.ChildAdded:Connect(bindTool)
 for _,child in ipairs(char:GetChildren()) do bindTool(child) end
end
player.CharacterAdded:Connect(bindCharacter)
if player.Character then bindCharacter(player.Character) end
local function panel(name,heading)
 local f=Instance.new("Frame"); f.Name=name
 f.Size=UDim2.new(.86,0,.49,0); f.Position=UDim2.new(.07,0,.28,0)
 f.BackgroundColor3=Color3.fromRGB(19,27,61); f.BorderSizePixel=0
 f.Visible=false; f.Parent=gui; round(f,16)
 local header=Instance.new("TextLabel"); header.Size=UDim2.new(1,-55,0,48)
 header.Position=UDim2.fromOffset(12,2); header.BackgroundTransparency=1
 header.Font=Enum.Font.GothamBlack; header.TextSize=20; header.TextColor3=Color3.fromRGB(255,221,110)
 header.Text=heading; header.Parent=f
 local close=button("Close","X",UDim2.fromOffset(43,42),
  UDim2.new(1,-49,0,5),Color3.fromRGB(200,73,113),f)
 close.Activated:Connect(function() f.Visible=false end)
 local scroll=Instance.new("ScrollingFrame"); scroll.Name="Options"
 scroll.Size=UDim2.new(1,-24,1,-64); scroll.Position=UDim2.fromOffset(12,55)
 scroll.BackgroundTransparency=1; scroll.ScrollBarThickness=5
 scroll.BorderSizePixel=0; scroll.Parent=f
 local layout=Instance.new("UIListLayout"); layout.Padding=UDim.new(0,8); layout.Parent=scroll
 layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
  scroll.CanvasSize=UDim2.fromOffset(0,layout.AbsoluteContentSize.Y+12)
 end)
 return f,scroll
end
local shop,shopList=panel("ShopPanel","EARNED COIN SHOP")
local map,mapList=panel("MapPanel","CHOOSE AN ISLAND")
local function item(parent,name,content,color,fn)
 local b=button(name,content,UDim2.new(1,-12,0,53),UDim2.fromOffset(0,0),color,parent)
 b.Activated:Connect(fn)
 return b
end
local blasterItem=item(shopList,"Blaster","BLASTER LEVEL UP • COST: 90+ COINS",
 Color3.fromRGB(224,77,133),function() action:FireServer("Buy","BLASTER") end)
local shieldItem=item(shopList,"ShieldUpgrade","SHIELD ABILITY • 150 COINS",
 Color3.fromRGB(126,86,219),function() action:FireServer("Buy","SHIELD") end)
local scatterItem=item(shopList,"ScatterUpgrade","SCATTER BLASTER • 175 COINS",
 Color3.fromRGB(233,120,74),function() action:FireServer("Buy","SCATTER") end)
local petItem=item(shopList,"PetUpgrade","ADOPT RIFTLING PET • 250 COINS",
 Color3.fromRGB(71,172,153),function() action:FireServer("Buy","PET") end)
local places={
 {"HUB","CENTRAL HUB"},{"CYBER","NEON METROPOLIS"},{"CRYSTAL","PRISM WILDS"},
 {"VOLCANO","MAGMA OUTPOST"},{"SKY","CLOUD KINGDOM"},
}
for i,entry in ipairs(places) do
 item(mapList,"Map"..entry[1],entry[2],
  ({Color3.fromRGB(64,177,204),Color3.fromRGB(171,101,219),
    Color3.fromRGB(227,103,143)})[(i-1)%3+1],function()
   action:FireServer("Travel",entry[1]); map.Visible=false
  end)
end
shopButton.Activated:Connect(function()
 map.Visible=false; shop.Visible=not shop.Visible
end)
mapButton.Activated:Connect(function()
 shop.Visible=false; map.Visible=not map.Visible
end)
local seq=0
event.OnClientEvent:Connect(function(message)
 seq+=1; local current=seq
 toast.Text=tostring(message); toast.Visible=true
 task.delay(2.7,function() if current==seq then toast.Visible=false end end)
end)
local function update()
 local coins=player:GetAttribute("RRCoins") or 0
 local shards=player:GetAttribute("RRShards") or 0
 local level=player:GetAttribute("RRLevel") or 1
 local xp=player:GetAttribute("RRXP") or 0
 local blasterLevel=player:GetAttribute("RRBlaster") or 1
 local seals=player:GetAttribute("RRSeals") or 0
 stats.Text="LEVEL "..level.."  |  "..coins.." COINS  |  "..shards.." SHARDS"
 progression.Text="BLASTER "..blasterLevel.."  |  RIFTS "..seals.."  |  XP "..xp
 missions.Text="MISSIONS: SHARDS "..(player:GetAttribute("RRQuestShards") or 0)..
  "/8  •  DRONES "..(player:GetAttribute("RRQuestDrones") or 0)..
  "/3  •  RIFTS "..(player:GetAttribute("RRQuestSeals") or 0).."/1"
 blasterItem.Text=blasterLevel>=4 and "BLASTER MAXED" or
  "BLASTER LEVEL "..(blasterLevel+1).." • "..(blasterLevel*90).." COINS"
 shieldItem.Text=player:GetAttribute("RRShield") and "SHIELD OWNED • USE SHIELD BUTTON" or
  "UNLOCK SHIELD • 150 COINS"
 scatterItem.Text=player:GetAttribute("RRScatter") and "SCATTER BLASTER OWNED" or
  "UNLOCK SCATTER BLASTER • 175 COINS"
 petItem.Text=player:GetAttribute("RRPet") and "RIFTLING PET OWNED" or
  "ADOPT RIFTLING PET • 250 COINS"
end
for _,name in ipairs({"RRCoins","RRShards","RRLevel","RRXP","RRBlaster",
 "RRShield","RRPet","RRScatter","RRSeals","RRQuestShards","RRQuestDrones","RRQuestSeals"}) do
 player:GetAttributeChangedSignal(name):Connect(update)
end
local function phaseUpdate()
 local current=world:GetAttribute("Phase") or "CALM"
 phase.Text=current.." | "..(world:GetAttribute("SecondsLeft") or 0).."s"..
  (current=="SURGE" and (" TITAN HP: "..(world:GetAttribute("BossHealth") or 0)) or " TO SURGE")
end
world:GetAttributeChangedSignal("Phase"):Connect(phaseUpdate)
world:GetAttributeChangedSignal("SecondsLeft"):Connect(phaseUpdate)
world:GetAttributeChangedSignal("BossHealth"):Connect(phaseUpdate)
update(); phaseUpdate()
print("SF_RIFT_RAIDERS_CLIENT_READY")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>