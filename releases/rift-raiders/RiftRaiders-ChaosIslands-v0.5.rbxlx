   Color3.fromRGB(129,83,52),Enum.Material.Wood,true)
  part(area,"Scrap Metal Stack",Vector3.new(4,1+i,6),
   CFrame.new(Vector3.new(180-38+i*3,3+i*.5,-25)),
   Color3.fromRGB(92,105,123),Enum.Material.CorrodedMetal,true)
 end
 part(area,"Crafting Workbench",Vector3.new(11,2,5),
  CFrame.new(-23,2,25),Color3.fromRGB(145,103,68),Enum.Material.WoodPlanks,true)
 for i=1,3 do
  part(area,"Fish Market Crate",Vector3.new(5,4,5),
   CFrame.new(Vector3.new(520-31+i*5,4,520+37)),
   Color3.fromRGB(165,119,72),Enum.Material.WoodPlanks,true)
 end
 part(area,"Vault Security Light",Vector3.new(9,1,1),
  CFrame.new(211,11,11),Color3.fromRGB(255,75,83),Enum.Material.Neon,false)
 label(area,"SPORTS: FOOTBALL • BASEBALL • SOCCER",
  center+Vector3.new(0,18,18),Color3.fromRGB(249,242,198))
 label(area,"BANK HEIST • REQUIRES LEVEL 3 + TOOLKIT",
  Vector3.new(211,20,12),Color3.fromRGB(241,127,108))
 -- Server-only heat decay; no realistic death or gore.
 task.spawn(function()
  while world.Parent do
   task.wait(5)
   for _,player in ipairs(Players:GetPlayers()) do
    local s=profile(player)
    if s and (s.heat or 0)>0 then
     s.heat=math.max(0,s.heat-3)
     context.sync(player)
    end
   end
  end
 end)
 return {SPORTS=center+Vector3.new(0,8,0),HOMES=homeCenter+Vector3.new(0,8,0)}
end
function Kit.PlayerRemoving(player)
 sessions[player]=nil; cooldowns[player]=nil; stolen[player]=nil
 local slot=playerPlots[player]
 if slot then plotOwners[slot]=nil; playerPlots[player]=nil end
 if playerHouses[player] then playerHouses[player]:Destroy(); playerHouses[player]=nil end
end
function Kit.GetStation(id)
 return stations[id]
end
return Kit
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">WorldExpansion</string>
        <string name="Source"><![CDATA[-- RIFT RAIDERS: Multiworld Expansion. Original, reusable Roblox models and real terrain.
-- Keep portal destinations server-owned; never accept arbitrary player coordinates.
local Expansion={}
local Players=game:GetService("Players")
local Terrain=workspace.Terrain
local function part(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=cf; p.Anchored=true
 p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
 p.CanCollide=collide~=false; p.CanTouch=collide~=false
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 p.Parent=parent
 return p
end
local function group(parent,name,kind)
 local m=Instance.new("Model"); m.Name=name; m:SetAttribute("AssetType",kind)
 m.Parent=parent
 return m
end
local function label(parent,title,position,color)
 local anchor=part(parent,"Landmark Label",Vector3.new(1,1,1),
  CFrame.new(position),color,Enum.Material.Neon,false)
 anchor.Transparency=1
 local gui=Instance.new("BillboardGui")
 gui.Size=UDim2.fromOffset(280,62); gui.MaxDistance=155
 gui.AlwaysOnTop=true; gui.Parent=anchor
 local text=Instance.new("TextLabel")
 text.Size=UDim2.fromScale(1,1); text.BackgroundTransparency=1
 text.Text=title; text.TextScaled=true; text.Font=Enum.Font.GothamBlack
 text.TextColor3=color; text.TextStrokeTransparency=.2; text.Parent=gui
 return anchor
end
local function prompt(target,action,object,callback)
 local p=Instance.new("ProximityPrompt")
 p.Name="WorldAction"; p.ActionText=action; p.ObjectText=object
 p.HoldDuration=.4; p.MaxActivationDistance=13
 p.RequiresLineOfSight=false; p.Parent=target
 p.Triggered:Connect(function(player)
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if root and (root.Position-target.Position).Magnitude<=19 then
   callback(player)
  end
 end)
 return p
end
local function tower(parent,position,color)
 local m=group(parent,"Castle Tower","Castle")
 local wall=part(m,"Stone Tower",Vector3.new(18,33,18),
  CFrame.new(position+Vector3.new(0,16.5,0)),Color3.fromRGB(124,131,147),Enum.Material.Cobblestone,true)
 m.PrimaryPart=wall
 part(m,"Roof",Vector3.new(22,4,22),
  CFrame.new(position+Vector3.new(0,35,0)),color,Enum.Material.Slate,true)
 for i=1,4 do
  local a=i*math.pi/2
  part(m,"Battlement",Vector3.new(5,5,5),
   CFrame.new(position+Vector3.new(math.cos(a)*8,39,math.sin(a)*8)),
   Color3.fromRGB(150,153,169),Enum.Material.Cobblestone,true)
 end
 return m
end
local function castle(parent,center)
 local m=group(parent,"Royal Stone Castle","Castle")
 local wallColor=Color3.fromRGB(140,144,159)
 local keep=part(m,"Grand Keep",Vector3.new(39,31,35),
  CFrame.new(center+Vector3.new(0,15.5,0)),wallColor,Enum.Material.Cobblestone,true)
 m.PrimaryPart=keep
 part(m,"Royal Roof",Vector3.new(43,4,39),
  CFrame.new(center+Vector3.new(0,33,0)),Color3.fromRGB(96,72,141),Enum.Material.Slate,true)
 part(m,"Gate",Vector3.new(11,15,1),
  CFrame.new(center+Vector3.new(0,7.5,-18)),Color3.fromRGB(79,59,52),Enum.Material.WoodPlanks,true)
 for _,x in ipairs({-28,28}) do
  for _,z in ipairs({-26,26}) do tower(m,center+Vector3.new(x,0,z),Color3.fromRGB(95,75,160)) end
 end
 for _,x in ipairs({-16,16}) do
  part(m,"Stained Glass",Vector3.new(6,10,.5),
   CFrame.new(center+Vector3.new(x,19,-18)),
   Color3.fromRGB(114,221,255),Enum.Material.Glass,false)
 end
 return m
end
local function barn(parent,center)
 local m=group(parent,"Working Farm Barn","Farm")
 local body=part(m,"Red Barn",Vector3.new(33,19,27),
  CFrame.new(center+Vector3.new(0,9.5,0)),Color3.fromRGB(175,63,66),Enum.Material.WoodPlanks,true)
 m.PrimaryPart=body
 part(m,"Barn Roof",Vector3.new(37,3,31),
  CFrame.new(center+Vector3.new(0,20,0)),Color3.fromRGB(61,69,85),Enum.Material.Metal,true)
 part(m,"Sliding Door",Vector3.new(10,13,.6),
  CFrame.new(center+Vector3.new(0,6.5,-13.8)),Color3.fromRGB(230,217,180),Enum.Material.Wood,true)
 for _,x in ipairs({-12,12}) do
  part(m,"Hay Bale",Vector3.new(7,5,7),
   CFrame.new(center+Vector3.new(x,2.5,-21)),
   Color3.fromRGB(211,171,76),Enum.Material.Grass,true)
 end
 return m
end
local function crop(parent,pos,kind)
 local m=group(parent,"Harvest "..kind,"Crop")
 local dirt=part(m,"Soil",Vector3.new(6,.8,6),
  CFrame.new(pos+Vector3.new(0,.4,0)),Color3.fromRGB(111,76,51),Enum.Material.Ground,true)
 m.PrimaryPart=dirt
 for i=1,4 do
  local x=(i%2)*2.5-1.25; local z=math.floor((i-1)/2)*2.5-1.25
  local plant=part(m,"Growing "..kind,Vector3.new(1.2,3.2,1.2),
   CFrame.new(pos+Vector3.new(x,2.4,z)),
   kind=="Carrot" and Color3.fromRGB(63,175,77) or Color3.fromRGB(208,175,78),
   Enum.Material.Grass,false)
  if kind=="Carrot" then
   part(m,"Carrot",Vector3.new(.8,1.4,.8),
    CFrame.new(pos+Vector3.new(x,1.2,z)),
    Color3.fromRGB(241,125,44),Enum.Material.SmoothPlastic,false)
  end
 end
 return m,dirt
end
local function torii(parent,pos)
 local m=group(parent,"Japanese Torii Gate","Japan")
 local red=Color3.fromRGB(198,56,65)
 for _,x in ipairs({-9,9}) do
  part(m,"Torii Pillar",Vector3.new(2.3,19,2.3),
   CFrame.new(pos+Vector3.new(x,9.5,0)),red,Enum.Material.Wood,true)
 end
 local top=part(m,"Torii Roof Beam",Vector3.new(27,2.6,4),
  CFrame.new(pos+Vector3.new(0,20,0)),Color3.fromRGB(51,52,66),Enum.Material.Wood,true)
 m.PrimaryPart=top
 part(m,"Torii Crossbar",Vector3.new(21,2,2),
  CFrame.new(pos+Vector3.new(0,15,0)),red,Enum.Material.Wood,true)
 return m
end
local function pagoda(parent,pos)
 local m=group(parent,"Five-Level Pagoda","Japan")
 local body=part(m,"Pagoda Center",Vector3.new(18,38,18),
  CFrame.new(pos+Vector3.new(0,19,0)),
  Color3.fromRGB(220,195,164),Enum.Material.WoodPlanks,true)
 m.PrimaryPart=body
 for floor=1,5 do
  local width=29-(floor-1)*3.4
  part(m,"Pagoda Eaves",Vector3.new(width,2.2,width),
   CFrame.new(pos+Vector3.new(0,7.5*floor,0)),
   Color3.fromRGB(51,62,84),Enum.Material.Slate,true)
 end
 return m
end
local function airport(parent,pos)
 local m=group(parent,"Airport Terminal","Airport")
 local terminal=part(m,"Terminal Building",Vector3.new(62,15,30),
  CFrame.new(pos+Vector3.new(0,7.5,0)),
  Color3.fromRGB(144,169,183),Enum.Material.Concrete,true)
 m.PrimaryPart=terminal
 part(m,"Terminal Glass",Vector3.new(56,9,.5),
  CFrame.new(pos+Vector3.new(0,7,-15.3)),
  Color3.fromRGB(102,207,235),Enum.Material.Glass,false)
 part(m,"Terminal Roof",Vector3.new(66,2,34),
  CFrame.new(pos+Vector3.new(0,16,0)),
  Color3.fromRGB(53,72,92),Enum.Material.Metal,true)
 return m
end
local function plane(parent,pos)
 local m=group(parent,"Passenger Jet Display","Airplane")
 local body=part(m,"Fuselage",Vector3.new(9,8,55),
  CFrame.new(pos+Vector3.new(0,10,0)),
  Color3.fromRGB(226,235,241),Enum.Material.Metal,true)
 m.PrimaryPart=body
 part(m,"Main Wings",Vector3.new(57,1.5,13),
  CFrame.new(pos+Vector3.new(0,10,0)),
  Color3.fromRGB(164,191,213),Enum.Material.Metal,true)
 part(m,"Tail Fin",Vector3.new(2,14,8),
  CFrame.new(pos+Vector3.new(0,17,23)),
  Color3.fromRGB(52,142,211),Enum.Material.Metal,true)
 for _,x in ipairs({-14,14}) do
  part(m,"Jet Engine",Vector3.new(5,5,10),
   CFrame.new(pos+Vector3.new(x,7,2)),
   Color3.fromRGB(57,72,93),Enum.Material.Metal,true)
 end
 return m
end
local function snowmobile(parent,pos,drivable)
 local m=group(parent,"Snowmobile Display","Snowmobile")
 local body=part(m,"Snowmobile Body",Vector3.new(5,2.5,11),
  CFrame.new(pos+Vector3.new(0,3,0)),
  Color3.fromRGB(236,84,91),Enum.Material.Metal,true)
 m.PrimaryPart=body
 part(m,"Snow Track",Vector3.new(4,1.3,8),
  CFrame.new(pos+Vector3.new(0,1,1)),
  Color3.fromRGB(41,46,61),Enum.Material.Rubber,true)
 for _,x in ipairs({-2.3,2.3}) do
  part(m,"Front Ski",Vector3.new(.6,.7,8),
   CFrame.new(pos+Vector3.new(x,.5,-4)),
   Color3.fromRGB(36,48,63),Enum.Material.Metal,true)
 end
 part(m,"Windshield",Vector3.new(4,3,.4),
  CFrame.new(pos+Vector3.new(0,5,-2.5)),
  Color3.fromRGB(143,222,243),Enum.Material.Glass,false)
 if drivable then
  local seat=Instance.new("VehicleSeat"); seat.Name="DriverSeat"
  seat.Size=Vector3.new(2,1,2)
  seat.CFrame=CFrame.new(pos+Vector3.new(0,5.2,1))
  seat.Anchored=true; seat.CanCollide=false
  seat.Color=Color3.fromRGB(34,41,59); seat.Parent=m
  m.Name="Player Snowmobile"; m:SetAttribute("Drivable",true)
  return m,seat
 end
 return m
end
local function boat(parent,pos)
 local m=group(parent,"Marina Motorboat Display","Boat")
 local hull=part(m,"Boat Hull",Vector3.new(11,4,24),
  CFrame.new(pos+Vector3.new(0,2,0)),
  Color3.fromRGB(238,239,227),Enum.Material.SmoothPlastic,true)
 m.PrimaryPart=hull
 part(m,"Boat Cabin",Vector3.new(9,5,9),
  CFrame.new(pos+Vector3.new(0,6,3)),
  Color3.fromRGB(63,135,189),Enum.Material.Glass,false)
 part(m,"Motor",Vector3.new(4,4,4),
  CFrame.new(pos+Vector3.new(0,1.5,13)),
  Color3.fromRGB(38,50,65),Enum.Material.Metal,true)
 return m
end
local function bank(parent,pos)
 local m=group(parent,"City Bank","Bank")
 local base=part(m,"Bank Building",Vector3.new(39,20,29),
  CFrame.new(pos+Vector3.new(0,10,0)),
  Color3.fromRGB(191,196,203),Enum.Material.Concrete,true)
 m.PrimaryPart=base
 part(m,"Bank Roof",Vector3.new(43,3,33),
  CFrame.new(pos+Vector3.new(0,21.5,0)),
  Color3.fromRGB(66,84,113),Enum.Material.Slate,true)
 for _,x in ipairs({-13,-6,6,13}) do
  part(m,"Bank Column",Vector3.new(2,18,2),
   CFrame.new(pos+Vector3.new(x,9,-16)),
   Color3.fromRGB(238,237,219),Enum.Material.Marble,true)
 end
 part(m,"Vault Door",Vector3.new(9,11,.6),
  CFrame.new(pos+Vector3.new(0,5.5,-14.9)),
  Color3.fromRGB(75,91,108),Enum.Material.Metal,true)
 return m
end
local function animal(parent,pos,species)
 local m=group(parent,species.." Animal","Animal")
 local fur=species=="Deer" and Color3.fromRGB(151,100,70) or
  species=="Cow" and Color3.fromRGB(221,217,208) or Color3.fromRGB(179,147,100)
 local body=part(m,"Animal Body",Vector3.new(5,3.5,8),
  CFrame.new(pos+Vector3.new(0,4,0)),fur,Enum.Material.SmoothPlastic,true)
 m.PrimaryPart=body
 part(m,"Head",Vector3.new(3.5,3.5,3.5),
  CFrame.new(pos+Vector3.new(0,5.4,-4.3)),fur,Enum.Material.SmoothPlastic,false)
 for _,x in ipairs({-1.7,1.7}) do
  for _,z in ipairs({-2.5,2.5}) do
   part(m,"Leg",Vector3.new(1.1,2.5,1.1),
    CFrame.new(pos+Vector3.new(x,1.3,z)),fur,Enum.Material.SmoothPlastic,true)
  end
 end
 for _,x in ipairs({-1,1}) do
  part(m,"Eye",Vector3.new(.45,.45,.45),
   CFrame.new(pos+Vector3.new(x,5.9,-6.1)),
   Color3.fromRGB(22,28,33),Enum.Material.SmoothPlastic,false)
 end
 return m,body
end
local function jetpack(parent,pos)
 local m=group(parent,"Jetpack Station","Jetpack")
 local body=part(m,"Jetpack Core",Vector3.new(5,8,2),
  CFrame.new(pos+Vector3.new(0,4,0)),
  Color3.fromRGB(53,75,116),Enum.Material.Metal,true)
 m.PrimaryPart=body
 for _,x in ipairs({-3,3}) do
  part(m,"Thruster",Vector3.new(2,6,2),
   CFrame.new(pos+Vector3.new(x,3,0)),
   Color3.fromRGB(73,210,255),Enum.Material.Neon,false)
 end
 return m,body
end
local function portal(parent,pos,color,name)
 local m=group(parent,"Portal to "..name,"Portal")
 local frame=part(m,"Portal Frame",Vector3.new(8,12,2),
  CFrame.new(pos+Vector3.new(0,6,0)),color,Enum.Material.Neon,false)
 frame.Transparency=.55; m.PrimaryPart=frame
 part(m,"Portal Base",Vector3.new(12,1,7),
  CFrame.new(pos+Vector3.new(0,.5,0)),color,Enum.Material.Metal,true)
 local particle=Instance.new("ParticleEmitter")
 particle.Rate=6; particle.Lifetime=NumberRange.new(.5,1)
 particle.Speed=NumberRange.new(1,2); particle.Parent=frame
 return m,frame
end
Expansion.Prefabs={
 Castle=castle,Barn=barn,Crop=crop,Torii=torii,Pagoda=pagoda,
 Airport=airport,Plane=plane,Snowmobile=snowmobile,Boat=boat,
 Bank=bank,Animal=animal,Jetpack=jetpack,Portal=portal,
}
Expansion.Worlds={
 {id="CASTLE",name="Castle Kingdom",center=Vector3.new(520,0,0),ground=Enum.Material.Grass,color=Color3.fromRGB(177,136,255)},
 {id="FARM",name="Harvest Valley",center=Vector3.new(-520,0,0),ground=Enum.Material.Grass,color=Color3.fromRGB(116,213,93)},
 {id="JAPAN",name="Sakura Japan",center=Vector3.new(0,0,520),ground=Enum.Material.Grass,color=Color3.fromRGB(255,141,191)},
 {id="ARCTIC",name="Snowbound North",center=Vector3.new(0,0,-520),ground=Enum.Material.Snow,color=Color3.fromRGB(134,215,255)},
 {id="MARINA",name="Ocean Marina",center=Vector3.new(520,0,520),ground=Enum.Material.Sand,color=Color3.fromRGB(69,211,221)},
 {id="SAFARI",name="Wildlife Safari",center=Vector3.new(-520,0,-520),ground=Enum.Material.Grass,color=Color3.fromRGB(241,185,87)},
 {id="AIRPORT",name="International Airport",center=Vector3.new(-520,0,520),ground=Enum.Material.Ground,color=Color3.fromRGB(185,214,246)},
}
function Expansion.Build(world,kit,reward,tell,spawnVehicle)
 local folder=Instance.new("Folder"); folder.Name="Seven New Worlds"; folder.Parent=world
 local destinations={}
 local cooldown={}
 local deliveries={}
 local deliveryCompletedAt={}
 local rng=Random.new(71245)
 local function earn(id,player,coins,xp)
  cooldown[player]=cooldown[player] or {}
  local last=cooldown[player][id] or -math.huge
  if os.clock()-last<35 then tell(player,"COME BACK AFTER THIS ACTIVITY RECHARGES!"); return end
  cooldown[player][id]=os.clock()
  reward(player,coins,xp,0)
  tell(player,"ACTIVITY COMPLETE! +"..coins.." COINS!")
 end
 Players.PlayerRemoving:Connect(function(p)
  cooldown[p]=nil; deliveries[p]=nil; deliveryCompletedAt[p]=nil
 end)
 for i,region in ipairs(Expansion.Worlds) do
  local c=region.center
  local area=Instance.new("Folder"); area.Name=region.name; area.Parent=folder
  area:SetAttribute("WorldId",region.id)
  area:SetAttribute("Biome",region.name)
  -- True Roblox Terrain, not flat plastic tiles. Material supports sculpting in Studio.
  if region.id=="MARINA" then
   Terrain:FillBlock(CFrame.new(c+Vector3.new(0,-9,0)),
    Vector3.new(300,12,300),Enum.Material.Water)
   Terrain:FillBlock(CFrame.new(c+Vector3.new(0,-4,0)),
    Vector3.new(145,12,145),Enum.Material.Sand)
  else
   Terrain:FillBlock(CFrame.new(c+Vector3.new(0,-4,0)),
    Vector3.new(170,12,170),region.ground)
   for j=1,5 do
    local a=j*1.2566
    Terrain:FillBall(c+Vector3.new(math.cos(a)*76,-5,math.sin(a)*76),
     18,region.ground)
   end
  end
  local floor=part(area,"Walkable Arrival Plaza",Vector3.new(28,1,28),
   CFrame.new(c+Vector3.new(0,2.5,0)),region.color,Enum.Material.SmoothPlastic,true)
  floor.Transparency=.25
  label(area,region.name:upper(),c+Vector3.new(0,29,0),region.color)
  destinations[region.id]=c+Vector3.new(0,8,0)
  local deliveryPoint=part(area,"Interworld Delivery Point",Vector3.new(5,5,5),
   CFrame.new(c+Vector3.new(-20,4,13)),
   Color3.fromRGB(244,199,74),Enum.Material.Neon,false)
  prompt(deliveryPoint,"DELIVER","Interworld Courier",function(p)
   if deliveries[p]~=region.id then
    tell(p,"ACCEPT A DELIVERY FROM THE CENTRAL HUB FIRST!")
    return
   end
   deliveries[p]=nil
   deliveryCompletedAt[p]=os.clock()
   p:SetAttribute("RRDeliveryTarget","")
   p:SetAttribute("RRDeliveries",(p:GetAttribute("RRDeliveries") or 0)+1)
   reward(p,40,45,2)
   tell(p,"DELIVERY COMPLETE! +40 COINS +2 SHARDS!")
  end)
  local hubAngle=(i-1)*math.pi*2/#Expansion.Worlds
  local hubPos=Vector3.new(math.cos(hubAngle)*37,2,math.sin(hubAngle)*37)
  local _,hubFrame=portal(area,hubPos,region.color,region.name)
  prompt(hubFrame,"TRAVEL",region.name,function(p)
   local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
   if root and (root.Position-hubFrame.Position).Magnitude<19 then
    p.Character:PivotTo(CFrame.new(destinations[region.id]))
    tell(p,"WELCOME TO "..region.name:upper())
   end
  end)
  local _,returnFrame=portal(area,c+Vector3.new(0,2,36),region.color,"Central Hub")
  prompt(returnFrame,"RETURN","Central Hub",function(p)
   p.Character:PivotTo(CFrame.new(0,8,0))
   tell(p,"BACK AT THE CENTRAL HUB!")
  end)
  for j=1,11 do
   local a=j*2.39996
   local radius=45+(j%3)*9
   local pos=c+Vector3.new(math.cos(a)*radius,2,math.sin(a)*radius)
   if region.id=="ARCTIC" then
    kit.Tree(area,pos,"pine",.7)
   elseif region.id=="JAPAN" then
    kit.Tree(area,pos,"oak",.6)
   elseif region.id=="MARINA" or region.id=="AIRPORT" then
    if j%2==0 then kit.Lamp(area,pos,region.color) end
   else
    kit.Tree(area,pos,"oak",.55)
   end
  end
  for j=1,12 do
   local x=rng:NextNumber(-67,67); local z=rng:NextNumber(-67,67)
   if x*x+z*z>32*32 then
    if region.id=="ARCTIC" then
     kit.Rock(area,c+Vector3.new(x,2,z),Color3.fromRGB(202,222,239),.6)
    elseif region.id~="AIRPORT" and region.id~="MARINA" then
     kit.Grass(area,c+Vector3.new(x,2,z))
    end
   end
  end
  if region.id=="CASTLE" then
   castle(area,c+Vector3.new(0,2,-36))
   local relic=part(area,"Royal Relic",Vector3.new(4,6,4),
    CFrame.new(c+Vector3.new(32,6,-24)),region.color,Enum.Material.Neon,false)
   prompt(relic,"FIND RELIC","Castle Quest",function(p) earn("relic",p,22,24) end)
  elseif region.id=="FARM" then
   barn(area,c+Vector3.new(-33,2,-25))
   for j=1,12 do
    local x=(j%4)*9-14; local z=math.floor((j-1)/4)*9+10
    local _,soil=crop(area,c+Vector3.new(x,2,z),j%2==0 and "Wheat" or "Carrot")
    prompt(soil,"HARVEST","Farm Crops",function(p) earn("crop_"..j,p,8,8) end)
   end
   local cow,body=animal(area,c+Vector3.new(34,2,-25),"Cow")
   prompt(body,"FEED","Friendly Cow",function(p) earn("cow",p,10,10) end)
  elseif region.id=="JAPAN" then
   torii(area,c+Vector3.new(0,2,-33))
   pagoda(area,c+Vector3.new(0,2,34))
   for j=1,5 do
    local lantern=kit.Lamp(area,c+Vector3.new(-45+j*15,2,-9),region.color)
    if j==3 then
     prompt(lantern.PrimaryPart,"LIGHT","Sakura Lantern",function(p) earn("lantern",p,14,14) end)
    end
   end
  elseif region.id=="ARCTIC" then
   for j=1,4 do
    local display=snowmobile(area,c+Vector3.new(-36+j*17,2,-28))
    prompt(display.PrimaryPart,"RIDE","Spawn Snowmobile",function(p)
     if not spawnVehicle then return end
     local ok,message=spawnVehicle(world,p,"snowmobile")
     tell(p,message)
    end)
   end
   local pack,core=jetpack(area,c+Vector3.new(32,2,28))
   prompt(core,"ACTIVATE","Jetpack Launch",function(p)
    if p:GetAttribute("RROwn_JETPACK_LICENSE")~=true then
     tell(p,"EARN THE JETPACK LICENSE IN THE COIN SHOP FIRST!")
     return
    end
    local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local k="jetpack"
    cooldown[p]=cooldown[p] or {}
    if os.clock()-(cooldown[p][k] or -math.huge)<12 then
     tell(p,"JETPACK RECHARGING!"); return
    end
    cooldown[p][k]=os.clock()
    local attachment=Instance.new("Attachment"); attachment.Name="JetpackAttachment"
    attachment.Parent=root
    local lift=Instance.new("VectorForce")
    lift.Name="JetpackLift"; lift.Attachment0=attachment
    lift.RelativeTo=Enum.ActuatorRelativeTo.World
    lift.ApplyAtCenterOfMass=true
    lift.Force=Vector3.new(0,root.AssemblyMass*workspace.Gravity*1.25,0)
    lift.Parent=root
    root.AssemblyLinearVelocity=Vector3.new(root.AssemblyLinearVelocity.X,25,root.AssemblyLinearVelocity.Z)
    tell(p,"JETPACK LIFT ACTIVE FOR 3 SECONDS!")
    task.delay(3,function()
     if lift.Parent then lift:Destroy() end
     if attachment.Parent then attachment:Destroy() end
    end)
   end)
  elseif region.id=="MARINA" then
   local dock=part(area,"Marina Dock",Vector3.new(20,2,110),
    CFrame.new(c+Vector3.new(0,1,85)),
    Color3.fromRGB(129,95,70),Enum.Material.WoodPlanks,true)
   boat(area,c+Vector3.new(23,-1,113))
   boat(area,c+Vector3.new(-23,-1,105))
   local fishing=part(area,"Fishing Pier Marker",Vector3.new(5,3,5),
    CFrame.new(c+Vector3.new(0,4,115)),region.color,Enum.Material.Neon,false)
   prompt(fishing,"FISH","Ocean Fishing",function(p) earn("fishing",p,18,20) end)
  elseif region.id=="SAFARI" then
   local deer,body=animal(area,c+Vector3.new(22,2,-21),"Deer")
   prompt(body,"FEED","Friendly Deer",function(p) earn("deer",p,12,12) end)
   for j=1,4 do
    animal(area,c+Vector3.new(-35+j*14,2,29),j%2==0 and "Cow" or "Deer")
   end
   kit.Pond(area,c+Vector3.new(-30,2,-32))
  elseif region.id=="AIRPORT" then
   airport(area,c+Vector3.new(0,2,-35))
   local runway=part(area,"Airport Runway",Vector3.new(120,1,28),
    CFrame.new(c+Vector3.new(0,2,44)),
    Color3.fromRGB(41,48,58),Enum.Material.Asphalt,true)
   plane(area,c+Vector3.new(38,2,41))
   local bag=part(area,"Luggage Cart",Vector3.new(6,5,7),
    CFrame.new(c+Vector3.new(-32,4,12)),
    Color3.fromRGB(232,170,66),Enum.Material.Metal,true)
   prompt(bag,"DELIVER","Airport Luggage",function(p) earn("luggage",p,16,18) end)
  end
 end
 -- Cross-world courier missions turn exploration into a replayable gameplay loop.
 local dispatch=part(folder,"Courier Dispatch Terminal",Vector3.new(8,8,6),
  CFrame.new(0,6,23),Color3.fromRGB(244,190,69),Enum.Material.Metal,true)
 prompt(dispatch,"TAKE JOB","Interworld Courier",function(p)
  if deliveries[p] then
   tell(p,"CURRENT DELIVERY: "..tostring(p:GetAttribute("RRDeliveryTarget")))
   return
  end
  if os.clock()-(deliveryCompletedAt[p] or -math.huge)<25 then
   tell(p,"NEW COURIER JOB AVAILABLE SOON!")
   return
  end
  local count=p:GetAttribute("RRDeliveries") or 0
  local nextRegion=Expansion.Worlds[(count+p.UserId%7)%#Expansion.Worlds+1]
  deliveries[p]=nextRegion.id
  p:SetAttribute("RRDeliveryTarget",nextRegion.name)
  tell(p,"COURIER JOB: DELIVER PACKAGE TO "..nextRegion.name:upper())
 end)
 -- A bank belongs in the metropolitan island rather than an isolated world.
 local bankFolder=Instance.new("Folder"); bankFolder.Name="Metropolis Bank"; bankFolder.Parent=folder
 bank(bankFolder,Vector3.new(180+31,2,31))
 local atm=part(bankFolder,"Bank ATM",Vector3.new(4,7,3),
  CFrame.new(180+31,5,31-17),Color3.fromRGB(64,144,179),Enum.Material.Metal,true)
 prompt(atm,"COLLECT BANK PAYOUT","Bank ATM",function(p) earn("bank",p,12,12) end)
 return destinations
end
return Expansion
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="7">
      <Properties>
        <string name="Name">WorldKit</string>
        <string name="Source"><![CDATA[-- Reusable procedural asset kit for any SatisfyForge Roblox map.
-- Original geometry only; no external model IDs, untrusted free models or paid assets.
local Kit={}
local CollectionService=game:GetService("CollectionService")
local function piece(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
 p.Material=material or Enum.Material.SmoothPlastic
 p.Anchored=true; p.CanCollide=collide==true
 p.CanTouch=collide==true
 p.CastShadow=true; p.Parent=parent
 return p
end
local function model(parent,name,kind)
 local m=Instance.new("Model"); m.Name=name
 m:SetAttribute("AssetType",kind); m.Parent=parent
 CollectionService:AddTag(m,"RiftWorldAsset")
 return m
end
function Kit.Tree(parent,pos,variant,scale)
 scale=scale or 1; variant=variant or "oak"
 local m=model(parent,"Tree_"..variant,"Tree")
 local trunkColor=Color3.fromRGB(104,72,53)
 local trunk=piece(m,"Trunk",Vector3.new(2.8,14,2.8)*scale,
  CFrame.new(pos+Vector3.new(0,7*scale,0)),trunkColor,Enum.Material.Wood,true)
 m.PrimaryPart=trunk
 if variant=="pine" then
  for layer=1,3 do
   local cone=Instance.new("Part"); cone.Name="Pine Crown"
   cone.Shape=Enum.PartType.Ball
   cone.Size=Vector3.new(13,9,13)*scale
   cone.Position=pos+Vector3.new(0,(12+layer*4)*scale,0)
   cone.Color=Color3.fromRGB(29,110+layer*13,90)
   cone.Material=Enum.Material.Grass; cone.Anchored=true; cone.CanCollide=false
   cone.Parent=m
  end
 elseif variant=="crystal" then
  for i=1,4 do
   local a=i*math.pi/2
   local crown=piece(m,"Prism Branch",Vector3.new(3,13,3)*scale,
    CFrame.new(pos+Vector3.new(math.cos(a)*3*scale,16*scale,math.sin(a)*3*scale))*
     CFrame.Angles(0,a,math.rad(14)),
    Color3.fromRGB(139+15*i,70+20*i,240),Enum.Material.Glass,false)
  end
 else
  for i=1,5 do
   local angle=i*math.pi*2/5
   local leaf=piece(m,"Leaf Crown",Vector3.new(11,10,11)*scale,
    CFrame.new(pos+Vector3.new(math.cos(angle)*4*scale,17*scale,math.sin(angle)*4*scale)),
    Color3.fromRGB(40+i*6,137+i*10,85+i*5),Enum.Material.Grass,false)
   leaf.Shape=Enum.PartType.Ball
  end
 end
 return m
end
function Kit.Grass(parent,pos,color)
 local m=model(parent,"Grass Patch","Grass")
 for i=1,3 do
  local a=i*2.1
  piece(m,"Blade",Vector3.new(.65,2.4,.5),
   CFrame.new(pos+Vector3.new(math.cos(a)*.5,1.2,math.sin(a)*.5))*
    CFrame.Angles(math.sin(a)*.2,0,math.cos(a)*.3),
   color or Color3.fromRGB(69,171,86),Enum.Material.Grass,false)
 end
 return m
end
function Kit.Rock(parent,pos,color,scale)
 local m=model(parent,"Rock Cluster","Rock")
 scale=scale or 1
 for i=1,3 do
  local rock=piece(m,"Boulder",Vector3.new(5+i,3+i,4+i)*scale,
   CFrame.new(pos+Vector3.new(i*2,1.5*scale,i*.6))*
    CFrame.Angles(i*.3,i*.6,i*.15),
   color or Color3.fromRGB(96,106,129),Enum.Material.Slate,true)
  rock.Shape=Enum.PartType.Ball
 end
 return m
end
function Kit.Lamp(parent,pos,color)
 local m=model(parent,"Street Lamp","StreetLight")
 local pole=piece(m,"Pole",Vector3.new(1.1,16,1.1),
  CFrame.new(pos+Vector3.new(0,8,0)),Color3.fromRGB(46,57,78),Enum.Material.Metal,true)
 m.PrimaryPart=pole
 local light=piece(m,"Lamp Head",Vector3.new(4,1.5,4),
  CFrame.new(pos+Vector3.new(0,16,0)),color or Color3.fromRGB(67,235,255),Enum.Material.Neon,false)
 local point=Instance.new("PointLight"); point.Color=light.Color
 point.Brightness=1.4; point.Range=23; point.Parent=light
 return m
end
function Kit.Crate(parent,pos,color)
 local m=model(parent,"Supply Crate","Crate")
 local box=piece(m,"Box",Vector3.new(7,6,7),CFrame.new(pos+Vector3.new(0,3,0)),
  Color3.fromRGB(90,72,62),Enum.Material.WoodPlanks,true)
 m.PrimaryPart=box
 for _,x in ipairs({-3.6,3.6}) do
  piece(m,"Metal Strap",Vector3.new(.6,6.5,7.6),
   CFrame.new(pos+Vector3.new(x,3,0)),color or Color3.fromRGB(241,171,66),Enum.Material.Metal,false)
 end
 return m
end
function Kit.Road(parent,pos,size)
 local m=model(parent,"Road Segment","Road")
 local road=piece(m,"Asphalt",size,CFrame.new(pos),
  Color3.fromRGB(29,34,48),Enum.Material.Asphalt,true)
 m.PrimaryPart=road
 local longX=size.X>size.Z
 for offset=-1,1,2 do
  local stripeSize=longX and Vector3.new(6,.13,.6) or Vector3.new(.6,.13,6)
  local stripeOffset=longX and Vector3.new(offset*size.X*.25,size.Y/2+.1,0)
   or Vector3.new(0,size.Y/2+.1,offset*size.Z*.25)
  piece(m,"Road Stripe",stripeSize,CFrame.new(pos+stripeOffset),
   Color3.fromRGB(255,214,95),Enum.Material.Neon,false)
 end
 return m
end
function Kit.Car(parent,cf,paint,drivable)
 local m=model(parent,drivable and "Player Hovercar" or "Parked Future Car",
  drivable and "Vehicle" or "CarProp")
 local body=piece(m,"Chassis",Vector3.new(11,2.2,18),
  cf,paint or Color3.fromRGB(62,203,230),Enum.Material.Metal,true)
 m.PrimaryPart=body
 local cockpit=piece(m,"Cabin",Vector3.new(9,3.5,8),
  cf*CFrame.new(0,2.5,1.8),Color3.fromRGB(30,51,78),Enum.Material.Glass,false)
 local seat=Instance.new("VehicleSeat"); seat.Name="DriverSeat"
 seat.Size=Vector3.new(2,1,2); seat.CFrame=cf*CFrame.new(0,2.5,1.8)
 seat.Color=Color3.fromRGB(30,38,56); seat.Material=Enum.Material.SmoothPlastic
 seat.Anchored=true; seat.CanCollide=false; seat.Parent=m
 seat.HeadsUpDisplay=true; seat.MaxSpeed=40; seat.Torque=8; seat.TurnSpeed=2
 local function wheel(x,z)
  local w=piece(m,"Wheel",Vector3.new(4,2.5,4),
   cf*CFrame.new(x,-1.3,z)*CFrame.Angles(0,0,math.pi/2),
   Color3.fromRGB(24,29,44),Enum.Material.Rubber,true)
  w.Shape=Enum.PartType.Cylinder
  local hub=piece(m,"Wheel Glow",Vector3.new(4.2,.3,4.2),
   cf*CFrame.new(x*1.02,-1.3,z)*CFrame.Angles(0,0,math.pi/2),
   Color3.fromRGB(93,224,255),Enum.Material.Neon,false)
  hub.Shape=Enum.PartType.Cylinder
 end
 for _,x in ipairs({-5.1,5.1}) do
  for _,z in ipairs({-5.8,5.8}) do wheel(x,z) end
 end
 for _,x in ipairs({-3.4,3.4}) do
  piece(m,"Headlight",Vector3.new(2,1,.3),
   cf*CFrame.new(x,.4,-9.2),Color3.fromRGB(244,247,255),Enum.Material.Neon,false)
  piece(m,"Tail Light",Vector3.new(2,1,.3),
   cf*CFrame.new(x,.4,9.2),Color3.fromRGB(255,69,101),Enum.Material.Neon,false)
 end
 if drivable then
  -- Arcade handling: server moves an anchored model only while its real
  -- VehicleSeat is occupied. PivotTo moves the seat and attached rider.
  m:SetAttribute("Drivable",true)
 else
  seat.Disabled=true
 end
 return m,seat
end
function Kit.Bush(parent,pos,color)
 local m=model(parent,"Flowering Bush","Bush")
 for i=1,3 do
  local p=piece(m,"Foliage",Vector3.new(5,3.5,5),
   CFrame.new(pos+Vector3.new((i-2)*2.1,2,math.sin(i)*1.5)),
   color or Color3.fromRGB(65,165,95),Enum.Material.Grass,false)
  p.Shape=Enum.PartType.Ball
 end
 return m
end
function Kit.Flower(parent,pos,color)
 local m=model(parent,"Wild Flower","Flower")
 piece(m,"Stem",Vector3.new(.25,2,.25),
  CFrame.new(pos+Vector3.new(0,1,0)),Color3.fromRGB(57,161,73),Enum.Material.Grass,false)
 local head=piece(m,"Bloom",Vector3.new(1.6,1.6,1.6),
  CFrame.new(pos+Vector3.new(0,2.2,0)),color or Color3.fromRGB(255,131,190),
  Enum.Material.SmoothPlastic,false)
 head.Shape=Enum.PartType.Ball
 return m
end
function Kit.Bench(parent,pos,color)
 local m=model(parent,"Park Bench","Bench")
 local seat=piece(m,"Seat",Vector3.new(9,.8,3),
  CFrame.new(pos+Vector3.new(0,2.4,0)),color or Color3.fromRGB(135,91,61),
  Enum.Material.WoodPlanks,true)
 m.PrimaryPart=seat
 piece(m,"Backrest",Vector3.new(9,3,.8),
  CFrame.new(pos+Vector3.new(0,4,-1.2)),seat.Color,Enum.Material.WoodPlanks,true)
 for _,x in ipairs({-3.4,3.4}) do
  piece(m,"Bench Leg",Vector3.new(.8,2.4,.8),
   CFrame.new(pos+Vector3.new(x,1.2,0)),Color3.fromRGB(43,49,67),Enum.Material.Metal,true)
 end
 return m
end
function Kit.Fence(parent,pos,length,color)
 local m=model(parent,"Fence","Fence")
 length=math.max(8,length or 24)
 for i=0,math.floor(length/6) do
  local x=-length/2+i*6
  piece(m,"Fence Post",Vector3.new(.8,5,.8),
   CFrame.new(pos+Vector3.new(x,2.5,0)),
   color or Color3.fromRGB(102,81,70),Enum.Material.Wood,true)
 end
 for _,height in ipairs({1.6,3.5}) do
  piece(m,"Fence Rail",Vector3.new(length,.6,.65),
   CFrame.new(pos+Vector3.new(0,height,0)),
   color or Color3.fromRGB(102,81,70),Enum.Material.Wood,true)
 end
 return m
end
function Kit.House(parent,pos,color)
 local m=model(parent,"Modular House","Building")
 local foundation=piece(m,"House Base",Vector3.new(16,12,14),
  CFrame.new(pos+Vector3.new(0,6,0)),
  color or Color3.fromRGB(79,116,155),Enum.Material.Concrete,true)
 m.PrimaryPart=foundation
 local roof=piece(m,"Roof",Vector3.new(19,2,17),
  CFrame.new(pos+Vector3.new(0,13,0)),Color3.fromRGB(50,59,90),Enum.Material.Metal,true)
 piece(m,"Door",Vector3.new(3,6,.4),
  CFrame.new(pos+Vector3.new(0,3,-7.3)),
  Color3.fromRGB(44,47,66),Enum.Material.Wood,true)
 for _,x in ipairs({-5,5}) do
  piece(m,"Window",Vector3.new(3,3,.3),
   CFrame.new(pos+Vector3.new(x,8,-7.3)),
   Color3.fromRGB(119,236,255),Enum.Material.Glass,false)
 end
 return m
end
function Kit.Pond(parent,pos)
 local m=model(parent,"Crystal Pond","WaterFeature")
 local rim=piece(m,"Pond Rim",Vector3.new(21,.4,15),
  CFrame.new(pos+Vector3.new(0,.1,0)),
  Color3.fromRGB(87,112,140),Enum.Material.Slate,true)
 m.PrimaryPart=rim
 local water=piece(m,"Water Surface",Vector3.new(18,.15,12),
  CFrame.new(pos+Vector3.new(0,.35,0)),
  Color3.fromRGB(77,177,217),Enum.Material.Glass,false)
 water.Transparency=.3
 return m
end
function Kit.Populate(parent,biomes)
 local rng=Random.new(424242)
 local folder=Instance.new("Folder"); folder.Name="ReusableWorldKit"; folder.Parent=parent
 folder:SetAttribute("AssetLibrary","Trees,Grass,Rocks,Lamps,Crates,Roads,Cars,Bushes,Flowers,Benches,Fences,Buildings,Ponds")
 for index,biome in ipairs(biomes) do
  local area=Instance.new("Folder"); area.Name=biome.id.." Scenery"; area.Parent=folder
  local c=biome.center
  for i=1,9 do
   local angle=i*2.399
   local radius=36+(i%3)*6
   local p=c+Vector3.new(math.cos(angle)*radius,1,math.sin(angle)*radius)
   if index==1 then
    Kit.Lamp(area,p,Color3.fromRGB(74,223,252))
   elseif index==2 then
    Kit.Tree(area,p,"crystal",.7)
   elseif index==3 then
    Kit.Rock(area,p,Color3.fromRGB(94,65,67),.75)
   else
    Kit.Tree(area,p,"pine",.65)
   end
  end
  Kit.Bench(area,c+Vector3.new(24,1,-20),biome.color)
  Kit.Fence(area,c+Vector3.new(-30,1,-51),24,biome.color)
  for i=1,5 do
   Kit.Bush(area,c+Vector3.new(-46+i*14,1,49),biome.color)
  end
  if index==1 then
   Kit.House(area,c+Vector3.new(-38,1,26),Color3.fromRGB(85,128,164))
   Kit.House(area,c+Vector3.new(38,1,26),Color3.fromRGB(130,91,169))
   Kit.Road(area,c+Vector3.new(0,1,-42),Vector3.new(90,.35,12))
   for i=1,3 do
    Kit.Car(area,CFrame.new(c+Vector3.new(-33+i*20,4,-42)),
     Color3.fromRGB(85+i*35,99+i*25,225-i*30),false)
   end
  else
   if index==2 then Kit.Pond(area,c+Vector3.new(-33,1,-35)) end
   for i=1,45 do
    local x=rng:NextNumber(-52,52); local z=rng:NextNumber(-52,52)
    if x*x+z*z>24*24 then
     if i%7==0 then
      Kit.Flower(area,c+Vector3.new(x,1,z),biome.color)
     end
     Kit.Grass(area,c+Vector3.new(x,1,z),
      index==3 and Color3.fromRGB(217,101,64) or
       index==2 and Color3.fromRGB(159,113,225) or Color3.fromRGB(85,174,119))
    end
   end
  end
  for i=1,4 do
   Kit.Crate(area,c+Vector3.new(-44+i*17,1,43),biome.color)
  end
 end
 return folder
end
return Kit
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="8">
      <Properties>
        <string name="Name">WorldPolish</string>
        <string name="Source"><![CDATA[-- Original lightweight world atmosphere and ambient NPC behavior.
-- NPCs are decorative route-following pedestrians/traffic, not full pathfinding AI.
local Lighting=game:GetService("Lighting")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local Terrain=workspace.Terrain
local Polish={}
local function piece(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part")
 p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
 p.Material=material or Enum.Material.SmoothPlastic
 p.Anchored=true; p.CanCollide=collide==true; p.CanTouch=false
 p.CastShadow=true; p.Parent=parent
 return p
end
local function pedestrian(parent,id,center,waypoints)
 local colors={
  Color3.fromRGB(72,130,180),Color3.fromRGB(198,116,73),
  Color3.fromRGB(92,155,109),Color3.fromRGB(158,101,166),
  Color3.fromRGB(183,168,89),Color3.fromRGB(82,94,126)
 }
 local m=Instance.new("Model"); m.Name="Ambient Pedestrian "..id
 m:SetAttribute("NPCType","AmbientCitizen")
 m:SetAttribute("Behavior","Walking")
 m.Parent=parent
 local cf=CFrame.new(center+Vector3.new(0,3,0))
 local body=piece(m,"Torso",Vector3.new(2.1,3,1.2),cf,
  colors[(id-1)%#colors+1],Enum.Material.Fabric,false)
 m.PrimaryPart=body
 local skin=({Color3.fromRGB(219,170,131),Color3.fromRGB(124,91,69),
  Color3.fromRGB(178,123,95),Color3.fromRGB(236,200,161)})[(id-1)%4+1]
 piece(m,"Head",Vector3.new(1.6,1.6,1.6),cf*CFrame.new(0,2.3,0),
  skin,Enum.Material.SmoothPlastic,false).Shape=Enum.PartType.Ball
 piece(m,"Hair",Vector3.new(1.7,.45,1.65),cf*CFrame.new(0,3.05,0),
  Color3.fromRGB(40+id*11,34+id*8,35+id*7),Enum.Material.SmoothPlastic,false)
 local arms,legs={},{}
 for _,side in ipairs({-1,1}) do
  arms[side]=piece(m,"Arm",Vector3.new(.75,2.7,.85),
   cf*CFrame.new(side*1.5,0,0),skin,Enum.Material.SmoothPlastic,false)
  legs[side]=piece(m,"Leg",Vector3.new(.9,2.8,1),
   cf*CFrame.new(side*.56,-2.8,0),
   Color3.fromRGB(42,49,63),Enum.Material.Fabric,false)
 end
 local data={model=m,body=body,arms=arms,legs=legs,waypoints=waypoints,
  next=2,position=waypoints[1],wait=0,speed=5.5+(id%4),
  distance=0,seed=id*1.2}
 return data
end
function Polish.Build(world,kit)
 local folder=Instance.new("Folder"); folder.Name="Living World Atmosphere"
 folder.Parent=world
 local clouds=Terrain:FindFirstChildOfClass("Clouds")
 if not clouds then clouds=Instance.new("Clouds"); clouds.Parent=Terrain end
 clouds.Name="Dynamic Weather Clouds"; clouds.Cover=.25
 clouds.Density=.42; clouds.Color=Color3.fromRGB(240,241,250)
 local atmosphere=Lighting:FindFirstChildOfClass("Atmosphere")
 if not atmosphere then atmosphere=Instance.new("Atmosphere"); atmosphere.Parent=Lighting end
 atmosphere.Density=.19; atmosphere.Offset=.1; atmosphere.Haze=1.3
 atmosphere.Glare=.18
 Lighting.GlobalShadows=true
 Lighting.Brightness=2.3
 Lighting.EnvironmentDiffuseScale=.5
 Lighting.EnvironmentSpecularScale=.6
 Lighting.ExposureCompensation=-.1
 pcall(function() Lighting.LightingStyle=Enum.LightingStyle.Realistic end)
 local grading=Lighting:FindFirstChild("RiftNaturalColorGrade")
 if not grading then
  grading=Instance.new("ColorCorrectionEffect"); grading.Name="RiftNaturalColorGrade"
  grading.Parent=Lighting
 end
 grading.Brightness=.015; grading.Contrast=.08
 grading.Saturation=-.04; grading.TintColor=Color3.fromRGB(251,248,241)
 local rays=Lighting:FindFirstChild("RiftSunRays")
 if not rays then
  rays=Instance.new("SunRaysEffect"); rays.Name="RiftSunRays"; rays.Parent=Lighting
 end
 rays.Intensity=.055; rays.Spread=.75
 local people={}
 for i=1,6 do
  local c=Vector3.new(180,0,0)
  local x=-32+((i-1)%3)*32
  local z=(i<=3 and 22 or -20)
  local a=c+Vector3.new(x,0,z)
  local b=c+Vector3.new(x+11,0,z)
  local d=c+Vector3.new(x+11,0,z+7)
  table.insert(people,pedestrian(folder,i,a,{a,b,d,a}))
 end
 for i=1,4 do
  local c=Vector3.new(0,0,1260)
  local x=-125+(i-1)*80
  local a=c+Vector3.new(x,0,-6)
  local b=c+Vector3.new(x+32,0,-6)
  table.insert(people,pedestrian(folder,i+6,a,{a,b,a}))
 end
 local traffic={}
 local roadCenter=Vector3.new(180,2.3,0)
 for _,z in ipairs({-39,39}) do
  piece(folder,"City Ring Road",Vector3.new(92,.6,12),
   CFrame.new(roadCenter+Vector3.new(0,0,z)),
   Color3.fromRGB(52,57,65),Enum.Material.Asphalt,true)
 end
 for _,x in ipairs({-39,39}) do
  piece(folder,"City Ring Road",Vector3.new(12,.6,88),
   CFrame.new(roadCenter+Vector3.new(x,0,0)),
   Color3.fromRGB(52,57,65),Enum.Material.Asphalt,true)
 end
 for i=1,2 do
  local c=Vector3.new(180,0,0)
  local waypoints={
   c+Vector3.new(-39,5,-39),c+Vector3.new(39,5,-39),
   c+Vector3.new(39,5,39),c+Vector3.new(-39,5,39)
  }
  local start=i==1 and 1 or 3
  local car=kit.Car(folder,CFrame.new(waypoints[start]),
   i==1 and Color3.fromRGB(135,150,161) or Color3.fromRGB(189,98,77),false)
  car.Name="Ambient City Traffic "..i
  car:SetAttribute("NPCType","Traffic")
  for _,desc in ipairs(car:GetDescendants()) do
   if desc:IsA("BasePart") then desc.CanCollide=false; desc.CanTouch=false end
  end
  table.insert(traffic,{model=car,waypoints=waypoints,next=start%4+1,
   position=waypoints[start],speed=14+i*3,wait=0})
 end
 local weatherStates={"CLEAR","CLOUDY","RAIN","MIST"}
 local weatherIndex=1
 world:SetAttribute("Weather",weatherStates[weatherIndex])
 world:SetAttribute("TimeOfDay","DAY")
 local function setWeather(index)
  local state=weatherStates[index]
  world:SetAttribute("Weather",state)
  local cover=state=="CLEAR" and .18 or state=="CLOUDY" and .57
   or state=="RAIN" and .85 or .7
  local density=state=="MIST" and .38 or state=="RAIN" and .27 or .19
  TweenService:Create(clouds,TweenInfo.new(5),{Cover=cover}):Play()
  TweenService:Create(atmosphere,TweenInfo.new(5),{
   Density=density,Haze=state=="MIST" and 2.9 or 1.3
  }):Play()
  TweenService:Create(grading,TweenInfo.new(5),{
   Saturation=state=="RAIN" and -.22 or -.04,
   Brightness=state=="RAIN" and -.05 or .015
  }):Play()
 end
 task.spawn(function()
  while world.Parent do
   task.wait(115)
   weatherIndex=weatherIndex%#weatherStates+1
   setWeather(weatherIndex)
  end
 end)
 task.spawn(function()
  local time=8
  while world.Parent do
   task.wait(1)
   time=(time+.025)%24
   Lighting.ClockTime=time
   local night=time>=19 or time<6
   world:SetAttribute("TimeOfDay",night and "NIGHT" or "DAY")
   Lighting.OutdoorAmbient=night and Color3.fromRGB(52,68,92)
    or Color3.fromRGB(122,131,148)
  end
 end)
 local accumulator=0
 RunService.Heartbeat:Connect(function(dt)
  if not world.Parent then return end
  accumulator+=dt
  if accumulator<.14 then return end
  local step=math.min(accumulator,.2); accumulator=0
  local now=os.clock()
  for _,npc in ipairs(people) do
   if npc.wait>now then continue end
   local goal=npc.waypoints[npc.next]
   local delta=goal-npc.position
   if delta.Magnitude<1 then
    npc.wait=now+1+(npc.seed%3)
    npc.next=npc.next%#npc.waypoints+1
    npc.model:SetAttribute("Behavior","Waiting")
   else
    npc.model:SetAttribute("Behavior","Walking")
    local direction=delta.Unit
    npc.position+=direction*math.min(delta.Magnitude,step*npc.speed)
    local cf=CFrame.lookAt(npc.position+Vector3.new(0,3,0),
     npc.position+Vector3.new(0,3,0)+direction)
    npc.model:PivotTo(cf)
    local stride=math.sin(now*8+npc.seed)*.55
    for _,side in ipairs({-1,1}) do
     npc.arms[side].CFrame=cf*CFrame.new(side*1.5,0,0)*
      CFrame.Angles(side*stride,0,0)
     npc.legs[side].CFrame=cf*CFrame.new(side*.56,-2.8,0)*
      CFrame.Angles(-side*stride,0,0)
    end
   end
  end
  for _,car in ipairs(traffic) do
   if car.wait>now then continue end
   local goal=car.waypoints[car.next]
   local delta=goal-car.position
   if delta.Magnitude<1 then
    car.wait=now+1.2
    car.next=car.next%#car.waypoints+1
   else
    local direction=delta.Unit
    car.position+=direction*math.min(delta.Magnitude,car.speed*step)
    car.model:PivotTo(CFrame.lookAt(car.position,car.position+direction))
   end
  end
 end)
 return folder
end
return Polish
]]></string>
      </Properties>
    </Item>
  </Item>
